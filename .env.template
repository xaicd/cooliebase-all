# ============================================================================
# {{PLATFORM_TITLE}} ({{PROJECT_NAME}}) — 蓝图环境变量模板 (.env.template)
# 由 Coolie工坊 或 `node scripts/blueprint-engine.cjs render` 渲染生成 .env
# ============================================================================

# 1. 工程与服务网络坐标
PORT={{ADMIN_PORT}}
NEXT_PUBLIC_APP_TITLE="{{PLATFORM_TITLE}}"
NEXT_PUBLIC_SHORT_NAME="{{SHORT_NAME}}"
PREVIEW_BASE_PATH="{{PREVIEW_BASE_PATH}}"

# 2. 数据库驱动与持久化连接 (sqlite | postgres | memory)
DB_DRIVER={{DB_DIALECT}}
DB_NAME={{DB_NAME}}
DB_HOST={{DB_HOST}}
DB_PORT={{DB_PORT}}
DB_USER={{DB_USER}}
DB_PASSWORD={{DB_PASSWORD}}
TABLE_PREFIX={{TABLE_PREFIX}}
SQLITE_DB_PATH={{SQLITE_DB_PATH}}
DATABASE_URL="postgresql://{{DB_USER}}:{{DB_PASSWORD}}@{{DB_HOST}}:{{DB_PORT}}/{{DB_NAME}}?schema=public"

# 3. 多租户与初始引导凭据 (生产环境严禁开启 ADMIN_LOGIN_PREFILL)
TENANT_MODE=isolated
DEFAULT_TENANT_CODE={{DEFAULT_TENANT_CODE}}
ADMIN_BOOTSTRAP_USERNAME={{BOOTSTRAP_ADMIN_USERNAME}}
ADMIN_LOGIN_PREFILL=0

# 4. 多端客户端与行业预设
INDUSTRY_PRESET={{INDUSTRY_PRESET}}
WECHAT_MINIPROGRAM_APP_ID={{WECHAT_APP_ID}}
