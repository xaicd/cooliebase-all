{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@/shared/*": [
        "packages/shared/*"
      ],
      "@/plugins/*": [
        "packages/plugins/*"
      ],
      "@/domains/*": [
        "packages/domains/*"
      ],
      "@prisma/*": [
        "prisma/*"
      ],
      "@/modules/shared": [
        "packages/shared"
      ],
      "@/modules/shared/*": [
        "packages/shared/*"
      ],
      "@/modules/*": [
        "packages/domains/*"
      ],
      "@/modules/pay/*": [
        "packages/plugins/plugin-pay/*"
      ],
      "@/modules/pay": [
        "packages/plugins/plugin-pay"
      ],
      "@/modules/report/*": [
        "packages/plugins/plugin-report/*"
      ],
      "@/modules/report": [
        "packages/plugins/plugin-report"
      ],
      "@/modules/bpm/*": [
        "packages/plugins/plugin-bpm/*"
      ],
      "@/modules/bpm": [
        "packages/plugins/plugin-bpm"
      ],
      "@/modules/mp/*": [
        "packages/plugins/plugin-mp/*"
      ],
      "@/modules/mp": [
        "packages/plugins/plugin-mp"
      ],
      "@/modules/member/*": [
        "packages/plugins/plugin-member/*"
      ],
      "@/modules/member": [
        "packages/plugins/plugin-member"
      ],
      "@/modules/iot/*": [
        "packages/plugins/plugin-iot/*"
      ],
      "@/modules/iot": [
        "packages/plugins/plugin-iot"
      ],
      "@/modules/erp/*": [
        "packages/plugins/plugin-erp/*"
      ],
      "@/modules/erp": [
        "packages/plugins/plugin-erp"
      ],
      "@/modules/im/*": [
        "packages/plugins/plugin-im/*"
      ],
      "@/modules/im": [
        "packages/plugins/plugin-im"
      ],
      "@/modules/aigw/*": [
        "packages/plugins/plugin-aigw/*"
      ],
      "@/modules/aigw": [
        "packages/plugins/plugin-aigw"
      ],
      "@/modules/ai/*": [
        "packages/plugins/plugin-ai/*"
      ],
      "@/modules/ai": [
        "packages/plugins/plugin-ai"
      ],
      "@/modules/crm/*": [
        "packages/plugins/plugin-crm/*"
      ],
      "@/modules/crm": [
        "packages/plugins/plugin-crm"
      ],
      "@/modules/wms/*": [
        "packages/plugins/plugin-wms/*"
      ],
      "@/modules/wms": [
        "packages/plugins/plugin-wms"
      ],
      "@/modules/online/*": [
        "packages/plugins/plugin-online/*"
      ],
      "@/modules/online": [
        "packages/plugins/plugin-online"
      ],
      "@/modules/mall/*": [
        "packages/plugins/plugin-mall/*"
      ],
      "@/modules/mall": [
        "packages/plugins/plugin-mall"
      ],
      "@/modules/mes/*": [
        "packages/plugins/plugin-mes/*"
      ],
      "@/modules/mes": [
        "packages/plugins/plugin-mes"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    ".next-cooliebase/types/**/*.ts",
    ".next-cooliebase/dev/types/**/*.ts",
    "next.config.mjs",
    "**/*.mts",
    "**/*.ts",
    "**/*.tsx",
    ".next-cooliebase/dev/dev/types/**/*.ts"
  ],
  "exclude": [
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "node_modules",
    "scripts",
    ".next-cooliebase"
  ]
}
