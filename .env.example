# ============================================================
# cooliebase-all-base 数据库配置
# ============================================================
# 复制此文件为 .env.local 并修改配置

# === 数据库驱动 ===
# 支持: postgresql | mysql | mariadb | sqlserver | sqlite | tidb | oceanbase | opengauss | gaussdb | kingbase | dm | memory
# 不设置则自动从 DATABASE_URL 检测，无 URL 时 fallback 到 memory 模式
DB_DRIVER=postgresql

# Prisma schema 与迁移默认固定使用 PostgreSQL；DB_DRIVER 仅控制运行时 Kysely 驱动。
# MySQL 等异构数据库需要使用独立 Prisma schema 与迁移历史，不能通过环境变量切换 provider。

# === 数据库连接 URL ===
# PostgreSQL:  postgresql://user:pass@localhost:5433/cooliebase?schema=public
# Redis:       redis://localhost:6380
# MySQL:       mysql://user:pass@localhost:3306/cooliebase
# MariaDB:     mysql://user:pass@localhost:3306/cooliebase
# SQL Server:  sqlserver://localhost:1433;database=cooliebase;user=sa;password=pass
# SQLite:      file:./dev.db
# TiDB:        mysql://user:pass@tidb-host:4000/cooliebase
# OceanBase:   mysql://user:pass@ob-host:2883/cooliebase
# openGauss:   postgresql://user:pass@opengauss-host:5432/cooliebase
# KingbaseES:  postgresql://user:pass@kingbase-host:54321/cooliebase
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cooliebase_next?schema=public

# === 连接池 ===
DB_POOL_SIZE=10
DB_TIMEZONE=UTC

# === 开发模式（不配置任何 DB 时自动启用内存存储） ===
# 设置为 memory 可强制使用内存模式
# DB_DRIVER=memory

# === JWT 鉴权 ===
# 生产环境必须设置至少 32 字节且非默认值的 JWT_SECRET
JWT_SECRET=replace-with-a-32-byte-or-longer-production-secret
JWT_EXPIRES_IN=86400
# JWT_ISSUER=cooliebase-all-base
# JWT_AUDIENCE=cooliebase-admin

# === 本地文件存储 ===
# FILE_STORAGE_DIR=.data/uploads

# === 全局多租户 ===
# disabled: 迁移期兼容；required: 所有非平台身份必须携带已验证 tenantId
TENANT_MODE=disabled
# 具备此角色的已验签身份可以调用 platform/control-plane 路由
TENANT_PLATFORM_ROLE=platform-admin
# 可选：本地域名/登录租户尚未完成解析前的迁移期默认租户
# TENANT_DEFAULT_ID=1
# Comma-separated platform control-plane accounts (登录时不需要 tenantCode 的身份)。
# 有两条种子路径，用户名不同，务必与实际使用的种子保持一致，否则新库根本登录不了：
#   - sql/init/*.sql（compose / 全新初始化的标准入口）-> vps_adm,roma_ops
#   - npm run db:seed (ADMIN_BOOTSTRAP_USERNAME)      -> 设为同一个值
TENANT_PLATFORM_USERNAMES=admin

# === Local PostgreSQL bootstrap administrator ===
# Required by `npm run db:seed` / start.bat / start.sh. Put real values in ignored .env.local.
# Username/password stay here; display nickname is `packages/shared/contract/project-profile.json`.
# Use a unique account name and a 12+ character password with upper/lowercase, number and symbol.
# ADMIN_BOOTSTRAP_USERNAME=vps_adm
# ADMIN_BOOTSTRAP_PASSWORD=use-a-unique-local-password
# ADMIN_BOOTSTRAP_SALT=generate-16-random-hex-characters
