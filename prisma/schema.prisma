  targetRelease  OnlineRelease? @relation("OnlineRelationTargetRelease", fields: [targetReleaseId], references: [id], onDelete: Restrict)

  @@unique([tenantId, revisionId, code])
  @@index([tenantId, targetReleaseId])
  @@map("online_relation")
}

model OnlineView {
  id              String         @id @default(cuid())
  revisionId      String         @map("revision_id")
