// cooliebase-all Prisma Schema
// 用途：schema 定义 + migration 管理
// 运行时查询由 Kysely 完成，Prisma 不用于 runtime query

generator client {
  provider = "prisma-client-js"
}

// Prisma schema 与迁移默认使用 PostgreSQL。运行时驱动选择由 DB_DRIVER 管理；
// MySQL 等异构数据库需要独立 schema 与迁移历史，不能动态切换 Prisma provider。
// 注: Prisma ORM v7 起连接串不再放在此处, 见仓库根 prisma.config.ts。
datasource db {
  provider = "postgresql"
}

// ============================================================
// SYSTEM 域 - 核心表
// ============================================================

/// 系统用户
model SystemUser {
  id        String   @id @default(cuid())
  username  String   @unique @db.VarChar(30)
  nickname  String   @db.VarChar(30)
  password  String   @db.VarChar(100)
  salt      String   @db.VarChar(100)
  phone     String?  @db.VarChar(20)
  email     String?  @db.VarChar(50)
  avatar    String?  @db.VarChar(500)
  status    String   @default("ACTIVE") @db.VarChar(10) // ACTIVE | DISABLED
  deptId    String?  @map("dept_id")
  remark    String?  @db.VarChar(500)
  loginIp   String?  @map("login_ip") @db.VarChar(50)
  loginDate DateTime? @map("login_date")
  tenantId  String?  @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deleted   Boolean  @default(false)

  // Relations
  dept          SystemDept?          @relation(fields: [deptId], references: [id])
  roleUsers     SystemUserRole[]
  postUsers     SystemUserPost[]

  @@map("system_user")
  @@index([tenantId])
  @@index([deptId])
  @@index([status])
}

/// 角色
model SystemRole {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(30)
  code      String   @unique @db.VarChar(100)
  sort      Int      @default(0)
  status    String   @default("ACTIVE") @db.VarChar(10)
  remark    String?  @db.VarChar(500)
  dataScope String   @default("ALL") @map("data_scope") @db.VarChar(20)
  tenantId  String?  @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deleted   Boolean  @default(false)

  roleUsers SystemUserRole[]
  roleMenus SystemRoleMenu[]

  @@map("system_role")
  @@index([tenantId])
}

/// 用户-角色关联
model SystemUserRole {
  id     String @id @default(cuid())
  userId String @map("user_id")
  roleId String @map("role_id")

  user SystemUser @relation(fields: [userId], references: [id])
  role SystemRole @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@map("system_user_role")
}

/// 菜单/权限
model SystemMenu {
  id         String   @id @default(cuid())
  name       String   @db.VarChar(50)
  permission String?  @db.VarChar(100)
  type       String   @db.VarChar(10) // DIR | MENU | BUTTON
  parentId   String?  @map("parent_id")
  path       String?  @db.VarChar(200)
  component  String?  @db.VarChar(200)
  icon       String?  @db.VarChar(100)
  sort       Int      @default(0)
  status     String   @default("ACTIVE") @db.VarChar(10)
  visible    Boolean  @default(true)
  keepAlive  Boolean  @default(true) @map("keep_alive")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  deleted    Boolean  @default(false)

  parent       SystemMenu?              @relation("MenuTree", fields: [parentId], references: [id])
  children     SystemMenu[]             @relation("MenuTree")
  roleMenus    SystemRoleMenu[]
  packageMenus SystemTenantPackageMenu[]

  @@map("system_menu")
  @@index([parentId])
}

/// 角色-菜单关联
model SystemRoleMenu {
  id     String @id @default(cuid())
  roleId String @map("role_id")
  menuId String @map("menu_id")

  role SystemRole @relation(fields: [roleId], references: [id])
  menu SystemMenu @relation(fields: [menuId], references: [id])

  @@unique([roleId, menuId])
  @@map("system_role_menu")
}

/// 部门
model SystemDept {
  id       String  @id @default(cuid())
  name     String  @db.VarChar(50)
  parentId String? @map("parent_id")
  sort     Int     @default(0)
  leaderId String? @map("leader_id")
  phone    String? @db.VarChar(20)
  email    String? @db.VarChar(50)
  status   String  @default("ACTIVE") @db.VarChar(10)
  tenantId String? @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deleted   Boolean  @default(false)

  parent   SystemDept?  @relation("DeptTree", fields: [parentId], references: [id])
  children SystemDept[] @relation("DeptTree")
  users    SystemUser[]

  @@map("system_dept")
  @@index([parentId])
  @@index([tenantId])
}

/// 岗位
model SystemPost {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(50)
  code      String   @unique @db.VarChar(64)
  sort      Int      @default(0)
  status    String   @default("ACTIVE") @db.VarChar(10)
  remark    String?  @db.VarChar(500)
  tenantId  String?  @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deleted   Boolean  @default(false)

  postUsers SystemUserPost[]

  @@map("system_post")
  @@index([tenantId])
}

/// 用户-岗位关联
model SystemUserPost {
  id     String @id @default(cuid())
  userId String @map("user_id")
  postId String @map("post_id")

  user SystemUser @relation(fields: [userId], references: [id])
  post SystemPost @relation(fields: [postId], references: [id])

  @@unique([userId, postId])
  @@map("system_user_post")
}

/// 字典类型
model SystemDictType {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(100)
  type      String   @unique @db.VarChar(100)
  status    String   @default("ACTIVE") @db.VarChar(10)
  remark    String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deleted   Boolean  @default(false)

  dictData SystemDictData[]

  @@map("system_dict_type")
}

/// 字典数据
model SystemDictData {
  id         String   @id @default(cuid())
  dictTypeId String   @map("dict_type_id")
  label      String   @db.VarChar(100)
  value      String   @db.VarChar(100)
  sort       Int      @default(0)
  status     String   @default("ACTIVE") @db.VarChar(10)
  colorType  String?  @map("color_type") @db.VarChar(20)
  remark     String?  @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  deleted    Boolean  @default(false)

  dictType SystemDictType @relation(fields: [dictTypeId], references: [id])

  @@map("system_dict_data")
  @@index([dictTypeId])
}

/// 租户
model SystemTenant {
  id           String               @id @default(cuid())
  tenantCode   String               @unique @map("tenant_code") @db.VarChar(32)
  name         String               @db.VarChar(50)
  contactName  String?              @map("contact_name") @db.VarChar(30)
  contactPhone String?              @map("contact_phone") @db.VarChar(20)
  domain       String?              @db.VarChar(100)
  packageId    String?              @map("package_id")
  package      SystemTenantPackage? @relation(fields: [packageId], references: [id], onDelete: Restrict)
  status       String               @default("ACTIVE") @db.VarChar(10)
  effectiveAt  DateTime             @map("effective_at")
  expireTime   DateTime?            @map("expire_time")
  accountLimit Int?                 @map("account_limit")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  deleted      Boolean              @default(false)

  subscriptions SystemTenantSubscription[]
  onlineDefinitions OnlineDefinition[]
  onlineRevisions OnlineRevision[]
  onlineFields OnlineField[]
  onlineIndexes OnlineIndex[]
  onlineRelations OnlineRelation[]
  onlineViews OnlineView[]
  onlineActions OnlineAction[]
  onlinePolicies OnlinePolicy[]
  onlineWorkflowBindings OnlineWorkflowBinding[]
  onlineReleases OnlineRelease[]
  onlineSchemaChanges OnlineSchemaChange[]
  onlineManagedTables OnlineManagedTable[]
  onlineTestSessions OnlineTestSession[]
  onlineRecords OnlineRecord[]
  dataSourceConfigs InfraDataSourceConfig[]

  @@map("system_tenant")
  @@index([packageId])
}

/// 租户订阅历史；当前有效权益同时保留在 SystemTenant 以便鉴权快速读取。
model SystemTenantSubscription {
  id           String              @id @default(cuid())
  tenantId     String              @map("tenant_id")
  packageId    String              @map("package_id")
  effectiveAt  DateTime            @map("effective_at")
  expireAt     DateTime?           @map("expire_at")
  accountLimit Int?                @map("account_limit")
  status       String              @default("ACTIVE") @db.VarChar(20)
  changeType   String              @map("change_type") @db.VarChar(20)
  remark       String?             @db.VarChar(500)
  createdBy    String?             @map("created_by")
  createdAt    DateTime            @default(now()) @map("created_at")
  tenant       SystemTenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  package      SystemTenantPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([status])
  @@map("system_tenant_subscription")
}

/// 平台全局租户套餐
model SystemTenantPackage {
  id          String                    @id @default(cuid())
  name        String                    @unique @db.VarChar(50)
  status      String                    @default("ACTIVE") @db.VarChar(10)
  accountLimit Int?                     @map("account_limit")
  remark      String?                   @db.VarChar(500)
  createdAt   DateTime                  @default(now()) @map("created_at")
  updatedAt   DateTime                  @updatedAt @map("updated_at")
  deleted     Boolean                   @default(false)

  tenants      SystemTenant[]
  subscriptions SystemTenantSubscription[]
  packageMenus SystemTenantPackageMenu[]

  @@map("system_tenant_package")
  @@index([status])
}

/// 租户套餐可用菜单关联
model SystemTenantPackageMenu {
  id        String              @id @default(cuid())
  packageId String              @map("package_id")
  menuId    String              @map("menu_id")
  package   SystemTenantPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  menu      SystemMenu          @relation(fields: [menuId], references: [id], onDelete: Restrict)

  @@unique([packageId, menuId])
  @@index([menuId])
  @@map("system_tenant_package_menu")
}

/// 通知公告
model SystemNotice {
  id        String   @id @default(cuid())
  title     String   @db.VarChar(100)
  content   String
  type      String   @db.VarChar(10) // INFO | WARN | ALERT
  status    String   @default("ACTIVE") @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deleted   Boolean  @default(false)

  @@map("system_notice")
}

/// 行政区划
model SystemArea {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(50)
  parentId  String?  @map("parent_id")
  level     Int      @default(1)
  status    String   @default("ACTIVE") @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deleted   Boolean  @default(false)

  @@map("system_area")
  @@index([parentId])
}

/// 站内信/短信/邮件模板
model SystemNotifyTemplate {
  id        String   @id @default(cuid())
  code      String   @unique @db.VarChar(64)
  name      String   @db.VarChar(100)
  channel   String   @db.VarChar(10)
  content   String   @default("")
  params    String   @default("[]")
  status    String   @default("ACTIVE") @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deleted   Boolean  @default(false)

  @@map("system_notify_template")
}

/// 通知发送记录
model SystemNotifyMessage {
  id           String   @id @default(cuid())
  templateCode String   @map("template_code") @db.VarChar(64)
  templateName String   @map("template_name") @db.VarChar(100)
  channel      String   @db.VarChar(10)
  receiver     String   @db.VarChar(100)
  content      String   @default("")
  readStatus   Boolean  @default(false) @map("read_status")
  createdAt    DateTime @default(now()) @map("created_at")
  deleted      Boolean  @default(false)

  @@map("system_notify_message")
  @@index([templateCode])
}

/// 登录日志
model SystemLoginLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  username  String   @db.VarChar(50)
  userIp    String   @map("user_ip") @db.VarChar(50)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  result    String   @db.VarChar(10) // SUCCESS | FAIL
  remark    String?  @db.VarChar(500)
  tenantId  String?  @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("system_login_log")
  @@index([userId])
  @@index([createdAt])
}

/// 操作日志
model SystemOperateLog {
  id            String   @id @default(cuid())
  userId        String?  @map("user_id")
  module        String   @db.VarChar(50)
  name          String   @db.VarChar(100)
  type          String   @db.VarChar(20) // CREATE | UPDATE | DELETE | EXPORT | IMPORT | OTHER
  requestMethod String   @map("request_method") @db.VarChar(10)
  requestUrl    String   @map("request_url") @db.VarChar(500)
  content       String?
  resultCode    Int      @default(0) @map("result_code")
  duration      Int      @default(0) // 毫秒
  userIp        String?  @map("user_ip") @db.VarChar(50)
  tenantId      String?  @map("tenant_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("system_operate_log")
  @@index([userId])
  @@index([module])
  @@index([createdAt])
}

/// 兼容旧服务的管理员账户（逐步迁移至 SystemUser）
model Admin {
  id        String   @id
  username  String   @unique @db.VarChar(100)
  phone     String?  @unique @db.VarChar(20)
  password  String   @db.VarChar(255)
  salt      String?  @db.VarChar(100)
  status    String   @default("ACTIVE") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admin")
}

/// 通用 JSON 配置存储，供验证码与集成配置使用
model Setting {
  key       String   @id @db.VarChar(200)
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("setting")
}

/// C 端会员用户（app 端注册/登录主体）。SQLite 侧建表见 scripts/bootstrap-sqlite.ts（运行时真源）。
model MemberUser {
  id           String    @id @default(cuid())
  account      String    @db.VarChar(64)
  email        String?   @db.VarChar(120)
  passwordHash String    @map("password_hash") @db.VarChar(200)
  passwordSalt String    @map("password_salt") @db.VarChar(100)
  nickname     String    @db.VarChar(60)
  avatarUrl    String?   @map("avatar_url") @db.VarChar(500)
  status       String    @default("ACTIVE") @db.VarChar(10)
  memberLevel  String    @default("normal") @map("member_level") @db.VarChar(30)
  extraFields  Json?     @map("extra_fields")
  tenantId     String    @map("tenant_id") @db.VarChar(64)
  createdBy    String    @default("system") @map("created_by") @db.VarChar(64)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedBy    String    @default("system") @map("updated_by") @db.VarChar(64)
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deleted      Int       @default(0)
  deletedAt    DateTime? @map("deleted_at")
  remark       String?   @db.VarChar(500)

  @@unique([tenantId, account])
  @@unique([tenantId, email])
  @@map("member_user")
}

/// BPM 审批任务
model ApprovalTask {
  id            String    @id
  bizType       String    @map("biz_type") @db.VarChar(100)
  title         String?   @db.VarChar(500)
  applicantName String?   @map("applicant_name") @db.VarChar(100)
  status        String    @default("PENDING") @db.VarChar(20)
  reviewedAt    DateTime? @map("reviewed_at")
  reviewRemark  String?   @map("review_remark") @db.VarChar(1000)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("approval_task")
  @@index([bizType])
  @@index([status])
  @@index([createdAt])
}

// ============================================================
// INFRA 域 - 基础设施表
// ============================================================

/// 系统配置
model InfraConfig {
  id        String   @id @default(cuid())
  category  String   @default("DEFAULT") @db.VarChar(50)
  name      String   @db.VarChar(100)
  configKey String   @unique @map("config_key") @db.VarChar(100)
  value     String   @db.VarChar(500)
  visible   Boolean  @default(true)
  remark    String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deleted   Boolean  @default(false)

  @@map("infra_config")
}

/// 定时任务
model InfraJob {
  id             String   @id @default(cuid())
  name           String   @db.VarChar(100)
  handlerName    String   @map("handler_name") @db.VarChar(200)
  handlerParam   String?  @map("handler_param") @db.VarChar(500)
  cronExpression String   @map("cron_expression") @db.VarChar(50)
  retryCount     Int      @default(0) @map("retry_count")
  retryInterval  Int      @default(0) @map("retry_interval")
  status         String   @default("ACTIVE") @db.VarChar(10)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deleted        Boolean  @default(false)

  logs InfraJobLog[]

  @@map("infra_job")
}

/// 定时任务日志
model InfraJobLog {
  id          String   @id @default(cuid())
  jobId       String   @map("job_id")
  handlerName String   @map("handler_name") @db.VarChar(200)
  beginTime   DateTime @map("begin_time")
  endTime     DateTime? @map("end_time")
  duration    Int      @default(0)
  status      String   @db.VarChar(10) // SUCCESS | FAIL
  result      String?
  createdAt   DateTime @default(now()) @map("created_at")

  job InfraJob @relation(fields: [jobId], references: [id])

  @@map("infra_job_log")
  @@index([jobId])
  @@index([createdAt])
}

/// API 访问日志
model InfraApiAccessLog {
  id              String   @id @default(cuid())
  traceId         String?  @map("trace_id") @db.VarChar(64)
  userId          String?  @map("user_id")
  tenantId        String?  @map("tenant_id") @db.VarChar(64)
  applicationName String   @map("application_name") @db.VarChar(50)
  requestMethod   String   @map("request_method") @db.VarChar(10)
  requestUrl      String   @map("request_url") @db.VarChar(500)
  requestParams   String?  @map("request_params")
  responseBody    String?  @map("response_body")
  resultCode      Int      @default(0) @map("result_code")
  duration        Int      @default(0)
  userIp          String?  @map("user_ip") @db.VarChar(50)
  userAgent       String?  @map("user_agent") @db.VarChar(500)
  operation       String?  @db.VarChar(200)
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("infra_api_access_log")
  @@index([userId])
  @@index([traceId])
  @@index([tenantId, createdAt])
  @@index([createdAt])
}

/// API 错误日志
model InfraApiErrorLog {
  id               String   @id @default(cuid())
  traceId          String?  @map("trace_id") @db.VarChar(64)
  userId           String?  @map("user_id")
  tenantId         String?  @map("tenant_id") @db.VarChar(64)
  applicationName  String   @map("application_name") @db.VarChar(50)
  requestMethod    String   @map("request_method") @db.VarChar(10)
  requestUrl       String   @map("request_url") @db.VarChar(500)
  requestParams    String?  @map("request_params")
  exceptionName    String   @map("exception_name") @db.VarChar(200)
  exceptionMessage String   @map("exception_message")
  exceptionStack   String?  @map("exception_stack")
  errorCode        String?  @map("error_code") @db.VarChar(64)
  rootCause        String?  @map("root_cause")
  status           String   @default("UNPROCESSED") @db.VarChar(20)
  processedAt      DateTime? @map("processed_at")
  processedBy      String?  @map("processed_by")
  processNote      String?  @map("process_note") @db.VarChar(500)
  userIp           String?  @map("user_ip") @db.VarChar(50)
  userAgent        String?  @map("user_agent") @db.VarChar(500)
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("infra_api_error_log")
  @@index([userId])
  @@index([traceId])
  @@index([tenantId, createdAt])
  @@index([status])
  @@index([createdAt])
}

/// 文件配置
model InfraFileConfig {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(100)
  storage   String   @db.VarChar(20) // LOCAL | S3 | OSS | COS | MINIO
  config    String   // JSON config
  master    Boolean  @default(false)
  remark    String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deleted   Boolean  @default(false)

  @@map("infra_file_config")
}

/// 数据源配置（归属单一租户，密码以密文保存）
model InfraDataSourceConfig {
  id                String   @id @default(cuid())
  tenantId          String?  @map("tenant_id")
  tenant            SystemTenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name              String   @db.VarChar(100)
  driver            String   @db.VarChar(30)
  url               String   @db.VarChar(1024)
  username          String   @db.VarChar(255)
  encryptedPassword String   @map("encrypted_password") @db.VarChar(2048)
  remark            String?  @db.VarChar(500)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  deleted           Boolean  @default(false)

  @@map("infra_data_source_config")
  @@index([name])
  @@index([deleted])
  @@index([tenantId, deleted, updatedAt])
}

/// 文件
model InfraFile {
  id        String   @id @default(cuid())
  configId  String   @map("config_id")
  name      String?  @db.VarChar(200)
  path      String   @db.VarChar(500)
  url       String   @db.VarChar(1024)
  type      String?  @db.VarChar(100) // MIME type
  size      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("infra_file")
  @@index([configId])
}

/// 可靠跨域事件 outbox（与业务写同事务；payload/headers 用 TEXT JSON 兼容多方言）
model InfraMessageOutbox {
  id          String    @id
  eventId     String    @unique @map("event_id") @db.VarChar(64)
  subject     String    @db.VarChar(200)
  type        String    @db.VarChar(120)
  source      String    @db.VarChar(64)
  payload     String
  headers     String
  status      String    @db.VarChar(20)
  attempts    Int       @default(0)
  tenantId    String?   @map("tenant_id") @db.VarChar(64)
  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")

  @@index([status, createdAt])
  @@index([tenantId, status])
  @@map("infra_message_outbox")
}

/// 可靠跨域事件 inbox（consumer + eventId 去重）
model InfraMessageInbox {
  id          String   @id
  consumer    String   @db.VarChar(120)
  eventId     String   @map("event_id") @db.VarChar(64)
  processedAt DateTime @default(now()) @map("processed_at")

  @@unique([consumer, eventId])
  @@map("infra_message_inbox")
}

// ============================================================
// ONLINE 域 - 版本化低代码元数据
// ============================================================

model OnlineDefinition {
  id                     String         @id @default(cuid())
  tenantId               String         @map("tenant_id")
  code                   String         @db.VarChar(64)
  name                   String         @db.VarChar(100)
  modelType              String         @map("model_type") @db.VarChar(20)
  status                 String         @default("DRAFT") @db.VarChar(20)
  currentDraftRevisionId String?        @unique @map("current_draft_revision_id")
  publishedReleaseId     String?        @unique @map("published_release_id")
  lockVersion            Int            @default(1) @map("lock_version")
  createdBy              String         @map("created_by")
  updatedBy              String         @map("updated_by")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")
  deleted                Boolean        @default(false)
  tenant                 SystemTenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  revisions              OnlineRevision[] @relation("OnlineDefinitionRevisions")
  releases               OnlineRelease[] @relation("OnlineDefinitionReleases")
  schemaChanges          OnlineSchemaChange[]
  managedTable           OnlineManagedTable?
  testSessions           OnlineTestSession[]
  records                OnlineRecord[]
  currentDraftRevision   OnlineRevision? @relation("OnlineDefinitionCurrentDraft", fields: [currentDraftRevisionId], references: [id], onDelete: SetNull)
  publishedRelease       OnlineRelease? @relation("OnlineDefinitionPublishedRelease", fields: [publishedReleaseId], references: [id], onDelete: SetNull)

  @@unique([tenantId, code])
  @@index([tenantId, status, updatedAt])
  @@map("online_definition")
}

model OnlineRevision {
  id               String               @id @default(cuid())
  definitionId     String               @map("definition_id")
  tenantId         String               @map("tenant_id")
  sequence         Int
  status           String               @default("DRAFT") @db.VarChar(20)
  schemaRevision   Int                  @default(0) @map("schema_revision")
  modelJson        Json                 @default("{}") @map("model_json")
  interactionJson  Json                 @default("{}") @map("interaction_json")
  policyJson       Json                 @default("{}") @map("policy_json")
  workflowJson     Json                 @default("{}") @map("workflow_json")
  validationReport Json?                @map("validation_report")
  createdBy        String               @map("created_by")
  publishedBy      String?              @map("published_by")
  publishedAt      DateTime?            @map("published_at")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  definition       OnlineDefinition     @relation("OnlineDefinitionRevisions", fields: [definitionId], references: [id], onDelete: Cascade)
  tenant           SystemTenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  currentForDefinition OnlineDefinition? @relation("OnlineDefinitionCurrentDraft")
  fields           OnlineField[]
  indexes          OnlineIndex[]
  relations        OnlineRelation[]
  views            OnlineView[]
  actions          OnlineAction[]
  policies         OnlinePolicy[]
  workflowBindings OnlineWorkflowBinding[]
  releases         OnlineRelease[]
  schemaChanges    OnlineSchemaChange[]
  testSessions     OnlineTestSession[]

  @@unique([tenantId, definitionId, sequence])
  @@index([tenantId, definitionId, status])
  @@map("online_revision")
}

model OnlineField {
  id           String         @id @default(cuid())
  revisionId   String         @map("revision_id")
  tenantId     String         @map("tenant_id")
  code         String         @db.VarChar(64)
  label        String         @db.VarChar(100)
  fieldType    String         @map("field_type") @db.VarChar(30)
  required     Boolean        @default(false)
  length       Int?
  sort         Int            @default(0)
  defaultValue String?        @map("default_value")
  config       Json           @default("{}")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  deleted      Boolean        @default(false)
  revision     OnlineRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  tenant       SystemTenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, revisionId, code])
  @@index([tenantId, revisionId, sort])
  @@map("online_field")
}

model OnlineIndex {
  id           String         @id @default(cuid())
  revisionId   String         @map("revision_id")
  tenantId     String         @map("tenant_id")
  code         String         @db.VarChar(64)
  fieldsJson   Json           @map("fields_json")
  unique       Boolean        @default(false)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  deleted      Boolean        @default(false)
  revision     OnlineRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  tenant       SystemTenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, revisionId, code])
  @@map("online_index")
}

model OnlineRelation {
  id             String         @id @default(cuid())
  revisionId     String         @map("revision_id")
  tenantId       String         @map("tenant_id")
  code           String         @db.VarChar(64)
  relationType   String         @map("relation_type") @db.VarChar(30)
