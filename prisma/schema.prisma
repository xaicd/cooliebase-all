/// AI 上游渠道
model AiChannel {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(100)
  provider    String   @db.VarChar(50)
  baseUrl     String?  @map("base_url") @db.VarChar(500)
  apiKey      String?  @map("api_key") @db.VarChar(500)
  models      Json     @default("[]")
  modelMap    Json     @default("{}") @map("model_map")
  weight      Int      @default(100)
  priority    Int      @default(1)
  status      String   @default("ACTIVE") @db.VarChar(20)
  autoDisable Boolean  @default(true) @map("auto_disable")
  failCount   Int      @default(0) @map("fail_count")
  protocol    String   @default("openai") @db.VarChar(20)
  tenantId    String?  @map("tenant_id")
  createdBy   String?  @map("created_by") @db.VarChar(64)
  updatedBy   String?  @map("updated_by") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deleted     Boolean  @default(false)

  usages      AiUsage[]

  @@index([tenantId])
  @@index([status, priority])
  @@map("ai_channel")
}

/// AI 调用令牌 (API Key / Access Token)
model AiAccessToken {
  id          String    @id @default(cuid())
  name        String    @db.VarChar(100)
  key         String    @unique @db.VarChar(100)
  status      String    @default("ACTIVE") @db.VarChar(20)
  remainQuota BigInt    @default(500000) @map("remain_quota")
  unlimited   Boolean   @default(false)
  models      Json      @default("[]")
  ipAllowlist Json      @default("[]") @map("ip_allowlist")
  group       String    @default("default") @db.VarChar(50)
  expiresAt   DateTime? @map("expires_at")
  tenantId    String?   @map("tenant_id")
  createdBy   String?   @map("created_by") @db.VarChar(64)
  updatedBy   String?   @map("updated_by") @db.VarChar(64)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deleted     Boolean   @default(false)

  usages      AiUsage[]

  @@index([tenantId])
  @@index([key])
  @@map("ai_access_token")
}

/// AI 用量流水审计
model AiUsage {
  id               String         @id @default(cuid())
  tokenId          String?        @map("token_id")
  channelId        String?        @map("channel_id")
  model            String         @db.VarChar(100)
  promptTokens     Int            @default(0) @map("prompt_tokens")
  completionTokens Int            @default(0) @map("completion_tokens")
  totalTokens      Int            @default(0) @map("total_tokens")
  success          Boolean        @default(true)
  latencyMs        Int            @default(0) @map("latency_ms")
  error            String?        @db.VarChar(500)
  tenantId         String?        @map("tenant_id")
  createdAt        DateTime       @default(now()) @map("created_at")

  token            AiAccessToken? @relation(fields: [tokenId], references: [id])
  channel          AiChannel?     @relation(fields: [channelId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tokenId])
  @@index([channelId])
  @@map("ai_usage")
}

/// AI 模型目录与定价基准
model AiModel {
  id           String   @id @default(cuid())
  name         String   @db.VarChar(100)
  modelKey     String   @unique @map("model_key") @db.VarChar(100)
  provider     String   @db.VarChar(50)
  inputRatio   Float    @default(1.0) @map("input_ratio")
  outputRatio  Float    @default(2.0) @map("output_ratio")
  status       String   @default("ACTIVE") @db.VarChar(20)
  sort         Int      @default(0)
  description  String?  @db.VarChar(500)
  tenantId     String?  @map("tenant_id")
  createdBy    String?  @map("created_by") @db.VarChar(64)
  updatedBy    String?  @map("updated_by") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  deleted      Boolean  @default(false)

  @@index([tenantId])
  @@index([status])
  @@map("ai_model")
}

/// AI 对话会话
model AiChatConversation {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  title        String   @db.VarChar(200)
  model        String   @db.VarChar(100)
  systemPrompt String?  @map("system_prompt") @db.Text
  pinned       Boolean  @default(false)
  tenantId     String?  @map("tenant_id")
  createdBy    String?  @map("created_by") @db.VarChar(64)
  updatedBy    String?  @map("updated_by") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  deleted      Boolean  @default(false)

  messages     AiChatMessage[]

  @@index([tenantId, userId])
  @@map("ai_chat_conversation")
}

/// AI 对话消息
model AiChatMessage {
  id             String             @id @default(cuid())
  conversationId String             @map("conversation_id")
  role           String             @db.VarChar(20)
  content        String             @db.Text
  tokens         Int                @default(0)
  tenantId       String?            @map("tenant_id")
  createdAt      DateTime           @default(now()) @map("created_at")

  conversation   AiChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_chat_message")
}



// ============================================================
// PLUGIN 域 —— §6.2 可安装插件
//
// 注意: 与 §6.1 的 Platform Module(即 packages/domains/<domain>)是**两个不同的扩展类**。
// 域是可信/进程内/一方表; 插件是 capability-gated/独立 worker/通用扩展表。
// 因此插件**不给每个插件开自己的表**, 而是统一落 plugin_state 的 scoped KV,
// 且首个插件系统不允许任意第三方迁移（插件数据先走通用扩展表，scoped 到既有对象）
// 与 docs/architecture/cooliebase-all-module-to-plugin-migration.md
// ============================================================

/// 已安装插件(实例级)。对应 PLUGIN_SPEC §21.3 的 plugins
model Plugin {
  id           String    @id @default(cuid())
  pluginKey    String    @unique @map("plugin_key") @db.VarChar(128)
  packageName  String    @map("package_name") @db.VarChar(200)
  packagePath  String?   @map("package_path") @db.VarChar(500)
  version      String    @db.VarChar(50)
  apiVersion   Int       @map("api_version")
  categories   String[]
  manifestJson Json      @map("manifest_json")
  /// installed | ready | error | upgrade_pending (§21.3)
  status       String    @default("installed") @db.VarChar(20)
  /// 插件来源: builtin(内置/平台模块, 如各业务域) | installed(外部安装的插件包)。
  /// 统一注册表把两者放在一起管理, 但 builtin 由代码/契约派生, 不落库(见注册表服务)。
  kind         String    @default("installed") @db.VarChar(20)
  /// 运行形态: isolated(独立进程, 默认) | merged(同进程加载)。
  /// 合并会让插件崩溃带走宿主, 故属**运营显式选择**, 不是插件 manifest 单方面决定。
  runtimeMode  String    @default("isolated") @map("runtime_mode") @db.VarChar(20)
  installOrder Int?      @map("install_order")
  lastError    String?   @map("last_error") @db.VarChar(1000)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deleted      Boolean   @default(false)

  states       PluginState[]
  configs      PluginConfig[]

  @@index([status])
  @@map("plugin")
}

/// 插件状态(五段复合键 scoped KV)。对应 PLUGIN_SPEC §21.3 的 plugin_state
///
/// 这是插件数据的**默认落点**: §21.1 要求"插件数据先落通用扩展表, 并先 scope 到既有对象",
/// 而不是给插件开自有表(§21.5 首个插件系统不允许任意第三方迁移)。
model PluginState {
  id         String   @id @default(cuid())
  pluginId   String   @map("plugin_id")
  /// instance | tenant | project | agent | issue | run (§21.3)
  scopeKind  String   @map("scope_kind") @db.VarChar(30)
  /// 作用域对象标识; **instance 作用域用空串而非 NULL** ——
  /// PG 的唯一索引视 NULL 互不相等, 用 NULL 会让 instance 作用域失去唯一性保证。
  scopeId    String   @default("") @map("scope_id") @db.VarChar(128)
  namespace  String   @default("default") @db.VarChar(100)
  stateKey   String   @map("state_key") @db.VarChar(200)
  valueJson  Json     @map("value_json")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  plugin     Plugin   @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@unique([pluginId, scopeKind, scopeId, namespace, stateKey])
  @@map("plugin_state")
}

/// 第一方插件自带迁移的应用记录。
///
/// 只记"哪个插件的哪个迁移文件已应用过"，用于幂等；**不记 checksum** ——
/// 迁移是插件自己的资产，宿主不假定它们不可变（改了文件就按新文件重新应用，
/// 是否安全由插件作者负责，宿主只保证不重复执行同名文件）。
model PluginMigration {
  id        String   @id @default(cuid())
  pluginKey String   @map("plugin_key") @db.VarChar(128)
  /// 迁移文件名（如 001_init.sql）
  name      String   @db.VarChar(200)
  /// 执行时所在的 schema（plugin_<key>），便于排查
  schema    String   @db.VarChar(100)
  appliedAt DateTime @default(now()) @map("applied_at")

  @@unique([pluginKey, name])
  @@map("plugin_migration")
}

/// 插件按租户配置。对应 PLUGIN_SPEC §21.3 的 plugin_config
///
/// 术语说明: 本仓统一用 tenant_id（多租户术语），不用 company_id;
/// 且按 AGENTS.md §4.8, 租户必须取自全局上下文, 禁止由调用方显式透传。
model PluginConfig {
  id         String   @id @default(cuid())
  pluginId   String   @map("plugin_id")
  tenantId   String   @map("tenant_id") @db.VarChar(64)
  configJson Json     @map("config_json")
  lastError  String?  @map("last_error") @db.VarChar(1000)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  plugin     Plugin   @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@unique([pluginId, tenantId])
  @@map("plugin_config")
}
