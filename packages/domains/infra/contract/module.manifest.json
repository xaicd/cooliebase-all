{
  "$schema": "cooliebase-module-manifest/v1",
  "domain": "infra",
  "id": "cooliebase.infra",
  "apiVersion": 1,
  "displayName": "基础设施",
  "kind": "platform",
  "stage": "A",
  "owner": "infra",
  "contractVersion": "v1",
  "implementation": "local-ts",
  "minimumHostVersion": "1.0.0",
  "capabilities": [
    "api.routes.register",
    "facade.invoke",
    "rpc.serve",
    "cmd.dispatch",
    "pack.independent"
  ],
  "entrypoints": {
    "facade": [
      "packages/domains/infra/contract/infra.facade.ts"
    ],
    "proto": "packages/domains/infra/contract/infra.proto",
    "actions": "packages/domains/infra/contract/actions.ts"
  },
  "apiRoutes": {
    "publicPrefix": [
      "/api/v1/admin/infra"
    ],
    "adminPrefix": "/api/v1/admin/infra"
  },
  "auth": {
    "audience": "admin",
    "tenantPolicy": "required"
  },
  "messaging": {
    "queueGroup": "cooliebase.infra",
    "commandSubject": "cooliebase.cmd.infra.>",
    "eventSubject": "cooliebase.evt.infra.>"
  },
  "invoke": {
    "colocated": "sdk",
    "remote": "rpc",
    "protocol": "nats-rr",
    "serialization": "json"
  },
  "upstream": {
    "env": "RUOYI_DOMAIN_INFRA_UPSTREAM",
    "protocol": "http",
    "defaultPort": 3211
  },
  "resilience": {
    "timeoutMs": 8000,
    "retry": {
      "maxAttempts": 1,
      "safeMethodsOnly": true
    },
    "idempotencyRequired": false
