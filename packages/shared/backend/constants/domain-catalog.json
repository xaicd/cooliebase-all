{
  "version": 1,
  "description": "Native domain pack/run/deploy catalog. Source of truth for route manifests, BFF upstream switching, and domain images.",
  "layers": {
    "foundation": {
      "modules": [
        "shared"
      ],
      "deployable": false,
      "invoke": "sdk",
      "description": "Runtime SDK packed into every process. Never a microservice, never RPC.",
      "ontologyNote": "基础设施域按『契约面 + 可切换 + 被依赖(扇入) + 稳定等级』建模，而非业务域的『边界/端口/RPC』。节点分三层 L0-driver(可切换资源) / L1-fabric(域间通信编织) / L2-aspect(横切全局)。fanIn 为真实 import 计数(排除测试/自引)，是改动破坏半径的客观信号；state=load-bearing(已承重, 改=破坏性) 或 provisioned(已就绪但消费方尚未接入, 是新域应采用的接缝)。真源勿手改 fanIn/dependents，随代码演进由扫描更新。",
      "capabilityTiers": {
        "L0-driver": "直连外部资源、必须可切换且有本地零配置兜底(interface + manager get/reset + memory默认驱动 + prod驱动 + ENV开关)",
        "L1-fabric": "域间通信的神经，无外部资源但高扇入；契约必须版本化(contractVersion)、向下兼容",
        "L2-aspect": "贯穿所有调用的切面，隐式全局(不出现在业务签名里)；改动前必须评估 scope 与全量 dependents"
      },
      "capabilities": [
        {
          "id": "domain-log",
          "tier": "L2-aspect",
          "dir": "packages/shared/backend/lib/domain-log.ts",
          "contract": [
            "domainLog.event",
            "domainLog.audit",
            "getDomainEventBuffer",
            "getDomainAuditBuffer"
          ],
          "swappable": false,
          "fallback": "in-memory buffer",
          "stability": "stable",
          "fanIn": 0,
          "state": "provisioned",
          "scope": "几乎所有 service 层",
          "changeRisk": "极高：扇入最广，签名/语义变更波及全域",
          "dependents": []
        },
        {
          "id": "database",
          "tier": "L0-driver",
          "dir": "packages/shared/backend/lib/database",
          "contract": [
            "getDataSourceConfig",
            "getProtocolFamily",
            "getKyselyDb",
            "hasRealDatabase",
            "BaseMapper",
            "QueryWrapper",
            "BaseService",
            "dynamic-table.*",
            "resetDataSourceConfig"
          ],
          "swappable": {
            "env": "DB_DRIVER",
            "urlAutodetect": "DATABASE_URL",
            "default": "memory",
            "prod": [
              "postgresql",
              "mysql",
              "mariadb",
              "sqlserver",
              "sqlite",
              "tidb",
              "oceanbase",
              "opengauss",
              "gaussdb",
              "kingbase",
              "dm",
              "oracle"
            ],
            "fallback": "memory→sqlite族",
            "productionGuard": "assertProductionDataSourceConfiguration()"
          },
          "stability": "stable",
          "fanIn": 4,
          "state": "load-bearing",
          "changeRisk": "高：全库方言 + 71 扇入，改方言映射需回归国产库",
          "dependents": [
            "packages/shared/backend/lib/agent-autopilot.ts",
            "packages/shared/backend/lib/api-log-persistence.ts",
            "packages/shared/backend/lib/outbox-kysely-store.ts",
            "packages/shared/backend/lib/outbox-store.ts"
          ]
        },
        {
          "id": "biz-tenant",
          "tier": "L2-aspect",
          "dir": "packages/shared/backend/lib/biz-tenant.ts",
          "contract": [
            "getTenantContext",
            "runWithTenant",
            "tenant-scope.*"
          ],
          "swappable": false,
          "fallback": "default tenant",
          "stability": "stable",
          "fanIn": 12,
          "state": "load-bearing",
          "scope": "多租户隔离路径(查询/写入自动注入 tenant_id)",
          "changeRisk": "高：34 扇入 + 租户隔离语义，破坏=越权风险",
          "dependents": [
            "packages/shared/backend/auth/guards.ts",
            "packages/shared/backend/auth/tenant.ts",
            "packages/shared/backend/http/admin-route.ts",
            "packages/shared/backend/http/app-route.ts",
            "packages/shared/backend/lib/cache-store.ts",
            "packages/shared/backend/lib/database/base-mapper.ts",
            "packages/shared/backend/lib/database/tenant-isolation-plugin.ts",
            "packages/shared/backend/lib/domain-log.ts",
            "packages/shared/backend/lib/event-bus.ts",
            "packages/shared/backend/lib/service-broker.ts",
            "packages/shared/backend/lib/tenant-scope.ts",
            "packages/shared/backend/lib/transactional-outbox.ts"
          ]
        },
        {
          "id": "cache",
          "tier": "L0-driver",
          "dir": "packages/shared/backend/lib/cache",
          "contract": [
            "getCache",
            "getCacheDriverName",
            "resetCache",
            "CacheDriver"
          ],
          "swappable": {
            "env": "CACHE_DRIVER",
            "default": "memory",
            "prod": "redis",
            "prodUrlEnv": [
              "CACHE_REDIS_URL",
              "REDIS_URL"
            ],
            "fallback": "in-memory(类H2)",
            "optionalDep": "ioredis(懒加载)"
          },
          "stability": "stable",
          "fanIn": 0,
          "state": "provisioned",
          "changeRisk": "低(暂无消费方)：是新域需要分布式缓存时应采用的接缝",
          "dependents": []
        },
        {
          "id": "storage",
          "tier": "L0-driver",
          "dir": "packages/shared/backend/lib/storage",
          "contract": [
            "getStorage",
            "getStorageDriverName",
            "resetStorage",
            "StorageDriver"
          ],
          "swappable": {
            "env": "STORAGE_DRIVER",
            "default": "local",
            "prod": "s3(AWS/MinIO/OSS)",
            "prodEnv": [
              "S3_BUCKET",
              "S3_ENDPOINT",
              "S3_REGION"
            ],
            "fallback": "local disk(.data/uploads)",
            "optionalDep": "@aws-sdk/client-s3(懒加载)"
          },
          "stability": "stable",
          "fanIn": 0,
          "state": "provisioned",
          "changeRisk": "低：目前仅 infra/file.service 消费",
          "dependents": []
        },
        {
          "id": "mq",
          "tier": "L0-driver",
          "dir": "packages/shared/backend/lib/mq",
          "contract": [
            "getMq",
            "getMqDriverName",
            "resetMq",
            "MqDriver"
          ],
          "swappable": {
            "env": "MQ_DRIVER",
            "default": "memory",
            "prod": "redis(Pub/Sub)",
            "prodUrlEnv": [
              "MQ_REDIS_URL",
              "REDIS_URL"
            ],
            "fallback": "进程内 pub/sub",
            "optionalDep": "ioredis(懒加载)"
          },
          "stability": "stable",
          "fanIn": 0,
          "state": "provisioned",
          "changeRisk": "低(暂无消费方)：是新域需要跨进程消息时应采用的接缝；平级 platform-mq.ts 为同步基元(向下兼容)",
          "dependents": []
        },
        {
          "id": "event-bus",
          "tier": "L1-fabric",
          "dir": "packages/shared/backend/lib/event-bus.ts",
          "contract": [
            "eventBus.publish",
            "eventBus.broadcast",
            "eventBus.emit",
            "eventBus.subscribe",
            "eventBus.publishReliable"
          ],
          "swappable": false,
          "fallback": "in-process fan-out(+ nats-fabric 接缝)",
          "stability": "stable",
          "fanIn": 1,
          "state": "load-bearing",
          "changeRisk": "中：被 service-broker 编织，域应通过它发领域事件(架构文档强制)",
          "dependents": [
            "packages/shared/backend/lib/service-broker.ts"
          ]
        },
        {
          "id": "service-broker",
          "tier": "L1-fabric",
          "dir": "packages/shared/backend/lib/service-broker.ts",
          "contract": [
            "broker.call",
            "broker.emit",
            "broker.broadcast(+ broker-cache/context/invoke/registry/resilience/validator)"
          ],
          "swappable": false,
          "fallback": "in-process(local sdk) → nats-rr(remote)",
          "stability": "stable",
          "fanIn": 2,
          "state": "load-bearing",
          "changeRisk": "中：跨域调用统一入口，域拆分/远程化时的核心接缝(依赖 event-bus + messaging-protocol)",
          "dependents": [
            "packages/shared/backend/lib/rpc-facade.ts",
            "packages/shared/backend/lib/service-bus.ts"
          ]
        },
        {
          "id": "messaging-protocol",
          "tier": "L1-fabric",
          "dir": "packages/shared/backend/lib/messaging-protocol.ts",
          "contract": [
            "Command/Query/Event/Stream 信封",
            "contractVersion 契约版本",
            "headerKeys(traceId/tenantId/actorId/idempotencyKey)"
          ],
          "swappable": false,
          "fallback": "v1 in-process",
          "stability": "versioned-contract",
          "fanIn": 5,
          "state": "load-bearing",
          "changeRisk": "高(契约级)：变更必须 contractVersion 递增 + 向下兼容 + grep 全量 dependents",
          "dependents": [
            "packages/shared/backend/lib/event-bus.ts",
            "packages/shared/backend/lib/nats-fabric.ts",
            "packages/shared/backend/lib/nats-stream.ts",
            "packages/shared/backend/lib/service-broker.ts",
            "packages/shared/backend/lib/transactional-outbox.ts"
          ]
        },
        {
          "id": "transactional-outbox",
          "tier": "L1-fabric",
          "dir": "packages/shared/backend/lib/transactional-outbox.ts",
          "contract": [
            "runUnitOfWork",
            "appendOutbox",
            "outbox-store/outbox-kysely-store"
          ],
          "swappable": false,
          "fallback": "kysely outbox 表",
          "stability": "stable",
          "fanIn": 5,
          "state": "load-bearing",
          "changeRisk": "中：可靠事件(publishReliable)的落地，依赖 database + messaging-protocol",
          "dependents": [
            "packages/shared/backend/lib/agent-autopilot.ts",
            "packages/shared/backend/lib/event-bus.ts",
            "packages/shared/backend/lib/outbox-kysely-store.ts",
            "packages/shared/backend/lib/outbox-store.ts",
            "packages/shared/backend/lib/service-broker.ts"
          ]
        },
        {
          "id": "trace-context",
          "tier": "L2-aspect",
          "dir": "packages/shared/backend/lib/trace-context.ts",
          "contract": [
            "getTraceId",
            "runWithTrace(traceId 透传)"
          ],
          "swappable": false,
          "fallback": "AsyncLocalStorage",
          "stability": "stable",
          "fanIn": 7,
          "state": "load-bearing",
          "scope": "全链路 traceId 透传(编排/消息节点必带)",
          "changeRisk": "中：隐式全局切面",
          "dependents": [
            "packages/shared/backend/http/admin-route.ts",
            "packages/shared/backend/http/api-error.ts",
            "packages/shared/backend/http/app-route.ts",
            "packages/shared/backend/lib/event-bus.ts",
            "packages/shared/backend/lib/observability.ts",
            "packages/shared/backend/lib/service-broker.ts",
            "packages/shared/backend/lib/transactional-outbox.ts"
          ]
        }
      ]
    },
    "platform": {
      "domains": [
        "system",
        "infra"
      ],
      "deployable": true,
      "defaultColocateWith": "bff",
      "publicRpc": "system: getDictDataByType + getPermissionInfoByUser; infra: none"
    },
    "business": {
      "domains": [],
      "deployable": true
    },
    "plugin": {
      "domains": [
        "ai",
        "aigw",
        "bpm",
        "crm",
        "erp",
        "im",
        "iot",
        "mall",
        "member",
        "mes",
        "mp",
        "online",
        "pay",
        "report",
        "wms"
      ],
      "description": "第一方插件: 保留域级特征(可独立打包), 但不属于平台/业务层"
    }
  },
  "rpc": {
    "local": {
      "mode": "sdk",
      "protocol": "in-process",
      "serialization": "none",
      "facadeRequired": true
    },
    "remote": {
      "mode": "rpc",
      "protocol": "nats-rr",
      "serialization": "json",
      "facadeRequired": true,
      "httpPath": "/api/internal/rpc"
    },
    "stageC": {
      "protocol": "grpc",
      "serialization": "protobuf"
    },
    "rejected": [
      "dubbo",
      "thrift",
      "hessian",
      "moleculer",
      "nestjs"
    ]
  },
  "messaging": {
    "protocolVersion": "v1",
    "defaultTransport": "in-process",
    "commandSubjectPrefix": "cooliebase.cmd",
    "eventSubjectPrefix": "cooliebase.evt",
    "headerKeys": {
      "contractVersion": "x-contract-version",
      "traceId": "x-trace-id",
      "tenantId": "x-tenant-id",
      "actorId": "x-actor-id",
      "idempotencyKey": "x-idempotency-key",
      "sourceDomain": "x-source-domain"
    }
  },
  "domains": [
    {
      "name": "system",
      "owner": "system",
      "kind": "platform",
      "stage": "A",
      "contractVersion": "v1",
      "publicPrefixes": [
        "/api/v1/admin/system"
      ],
      "implementation": "local-ts",
      "upstreamEnv": "COOLIEBASE_DOMAIN_SYSTEM_UPSTREAM",
      "defaultPort": 3210,
      "packable": true,
      "packKind": "api-only",
      "dependsOnModules": [
        "shared"
      ],
      "independentDatabase": false,
      "auth": {
        "audience": "admin",
        "tenantPolicy": "required"
      },
      "resilience": {
        "timeoutMs": 5000,
        "retryMaxAttempts": 1,
        "safeMethodsOnly": true,
        "idempotencyRequired": false
