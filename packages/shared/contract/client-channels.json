{
  "version": "v1",
  "channelHeader": "X-Client-Channel",
  "identity": {
    "profilePath": "/api/v1/open/meta/project-profile",
    "channelsPath": "/api/v1/open/meta/client-channels",
    "errorCatalogPath": "/api/v1/open/meta/error-catalog",
    "openapiPath": "/api/v1/open/openapi"
  },
  "surfaces": [
    {
      "id": "admin",
      "prefix": "/api/v1/admin",
      "auth": "admin-jwt",
      "audience": "admin",
      "usedBy": [
        "admin-web"
      ]
    },
    {
      "id": "app",
      "prefix": "/api/v1/app",
      "auth": "member-jwt",
      "audience": "app",
      "usedBy": [
        "expo"
      ]
    },
    {
      "id": "open",
      "prefix": "/api/v1/open",
      "auth": "public-or-signature",
      "audience": "open",
      "usedBy": [
        "admin-web"
      ]
    },
    {
      "id": "internal",
      "prefix": "/api/internal",
      "auth": "service-token",
      "audience": "internal",
      "usedBy": []
    }
  ],
  "channels": [
    {
      "id": "admin-web",
      "name": "管理端 PC",
      "kind": "web",
      "surface": "admin",
      "workspace": "src/app",
      "runtime": "next-app-router",
      "status": "ga",
      "platforms": [
        "windows",
        "macos",
        "linux"
      ],
      "tokenStore": "localStorage",
      "packageKind": "in-repo-admin",
      "notes": "当前管理后台真源。域 UI 落在 packages/domains/<domain>/frontend，不进 clients/。"
    },
    {
      "id": "expo",
      "name": "Expo 移动端",
      "kind": "native",
      "surface": "app",
      "workspace": "clients/expo",
      "runtime": "expo",
      "status": "ga",
      "platforms": [
        "android",
        "ios",
        "web"
      ],
      "tokenStore": "expo-secure-store",
      "packageKind": "standalone",
      "notes": "本仓标准多端移动/Web 同构客户端包，严格遵循 src/{app,shared,modules/<domain>} 三层架构与 PageBlockDSL v2 同源渲染。"
    }
  ],
  "rules": [
    "同一业务能力只定义一份版本化 DTO，多端不得分叉字段名。",
    "admin JWT 与 member JWT 不得混用。",
    "客户端禁止 import Next Service、Repository 或 Prisma 类型。",
    "平台名称与 Logo 只来自 project-profile，禁止各端再写一套品牌常量。",
    "新客户端请求应带 X-Client-Channel，取值必须是 channels[].id。",
    "C 端默认走 /api/v1/app；第三方回调与公开元数据走 /api/v1/open。",
    "每个渠道一个独立包；包内按后端域名建 modules/<domain>，禁止把新域堆进 pages 或 shared。",
    "本标准不表示 H5 / uni-app / Flutter / 桌面客户端已经交付。"
  ],
  "packageLayout": {
    "requiredSourceDirs": [
      "app",
      "shared",
      "modules"
    ],
    "moduleSubdirs": [
      "api",
      "models",
      "pages",
      "components"
    ],
    "sourceRootByRuntime": {
      "next-app-router": "src",
      "uni-app-h5-or-next": "src",
      "uni-app": "src",
      "flutter": "lib",
      "tauri": "src",
      "expo": "src"
    },
    "manifestByRuntime": {
      "next-app-router": "package.json",
      "uni-app-h5-or-next": "package.json",
      "uni-app": "package.json",
      "flutter": "pubspec.yaml",
      "tauri": "package.json",
      "expo": "app.json"
    }
  }
}
