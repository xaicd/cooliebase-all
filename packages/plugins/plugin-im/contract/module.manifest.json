{
  "$schema": "cooliebase-module-manifest/v1",
  "domain": "im",
  "id": "cooliebase.im",
  "apiVersion": 1,
  "displayName": "消息中心",
  "kind": "plugin",
  "stage": "B",
  "owner": "im",
  "contractVersion": "v1",
  "implementation": "local-ts",
  "minimumHostVersion": "1.0.0",
  "capabilities": [
    "api.routes.register",
    "facade.invoke",
    "rpc.serve",
    "cmd.dispatch",
    "pack.independent"
  ],
  "entrypoints": {
    "facade": [
      "packages/plugins/plugin-im/contract/im.facade.ts"
    ],
    "proto": "packages/plugins/plugin-im/contract/im.proto",
    "actions": "packages/plugins/plugin-im/contract/actions.ts"
  },
  "apiRoutes": {
    "publicPrefix": [
      "/api/v1/admin/im"
    ],
    "adminPrefix": "/api/v1/admin/im"
  },
  "auth": {
    "audience": "admin",
    "tenantPolicy": "required"
  },
  "messaging": {
    "queueGroup": "cooliebase.im",
    "commandSubject": "cooliebase.cmd.im.>",
    "eventSubject": "cooliebase.evt.im.>"
  },
  "invoke": {
    "colocated": "sdk",
    "remote": "rpc",
    "protocol": "nats-rr",
    "serialization": "json"
  },
  "upstream": {
    "env": "COOLIEBASE_DOMAIN_IM_UPSTREAM",
    "protocol": "http",
    "defaultPort": 3225
  },
  "resilience": {
    "timeoutMs": 5000,
    "retry": {
      "maxAttempts": 1,
      "safeMethodsOnly": true
    },
    "idempotencyRequired": true
  },
  "facadeMethods": [
    "ping",
    "listConversations",
    "auditMessage"
  ],
  "rpc": [
    {
      "service": "ImService",
      "method": "Ping"
    },
    {
      "service": "ImService",
      "method": "ListConversations"
    },
    {
      "service": "ImService",
      "method": "AuditMessage"
    }
  ],
  "actions": [
    "im.ping",
    "im.listConversations",
    "im.auditMessage"
  ],
  "permissions": [
    "im:channel-material:create",
    "im:channel-material:delete",
    "im:channel-material:query",
    "im:channel-material:update",
    "im:channel-message:create",
    "im:channel-message:delete",
    "im:channel-message:query",
    "im:channel-message:update",
    "im:channel:create",
    "im:channel:delete",
    "im:channel:query",
    "im:channel:update",
    "im:conversation-read:create",
    "im:conversation-read:delete",
    "im:conversation-read:query",
    "im:conversation-read:update",
    "im:conversation:view",
    "im:face-pack-item:create",
    "im:face-pack-item:delete",
    "im:face-pack-item:query",
    "im:face-pack-item:update",
    "im:face-pack:create",
    "im:face-pack:delete",
    "im:face-pack:query",
    "im:face-pack:update",
    "im:face-user-item:create",
    "im:face-user-item:delete",
    "im:face-user-item:query",
    "im:face-user-item:update",
    "im:friend-request:create",
    "im:friend-request:delete",
    "im:friend-request:query",
    "im:friend-request:update",
    "im:friend:create",
    "im:friend:delete",
    "im:friend:query",
    "im:friend:update",
    "im:group-member:create",
    "im:group-member:delete",
    "im:group-member:query",
    "im:group-member:update",
    "im:group-message:create",
    "im:group-message:delete",
    "im:group-message:query",
    "im:group-message:update",
    "im:group-request:create",
    "im:group-request:delete",
    "im:group-request:query",
    "im:group-request:update",
    "im:group:create",
    "im:group:delete",
    "im:group:query",
    "im:group:update",
    "im:message:audit",
    "im:private-message:create",
    "im:private-message:delete",
    "im:private-message:query",
    "im:private-message:update",
    "im:rtc-call:create",
    "im:rtc-call:delete",
    "im:rtc-call:query",
    "im:rtc-call:update",
    "im:rtc-participant:create",
    "im:rtc-participant:delete",
    "im:rtc-participant:query",
    "im:rtc-participant:update",
    "im:sensitive-word:create",
    "im:sensitive-word:delete",
    "im:sensitive-word:query",
    "im:sensitive-word:update"
  ],
  "dependsOn": [
    "shared"
  ],
  "pack": {
    "enabled": true,
    "kind": "api-only",
    "independentDatabase": false
  }
}
