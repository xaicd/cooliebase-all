{
  "$schema": "cooliebase-plugin-manifest/v1",
  "id": "cooliebase.im",
  "apiVersion": 1,
  "version": "0.1.0",
  "displayName": "im",
  "description": "im 域（由 scripts/scaffold-domain-plugin.cjs 生成的第一方插件声明）",
  "author": "CoolieBase All",
  "categories": [
    "automation"
  ],
  "capabilities": [
    "api.routes.register"
  ],
  "entrypoints": {
    "merged": "./plugin-entry.ts"
  },
  "domain": {
    "kind": "business",
    "stage": "B",
    "contractVersion": "v1",
    "publicPrefixes": [
      "/api/v1/admin/im"
    ],
    "upstreamEnv": "COOLIEBASE_DOMAIN_IM_UPSTREAM",
    "defaultPort": 3225,
    "packable": true,
    "independentDatabase": false,
    "dependsOnModules": [
      "shared"
    ],
    "auth": {
      "audience": "admin",
      "tenantPolicy": "required"
    },
    "resilience": {
      "timeoutMs": 5000,
      "retryMaxAttempts": 1,
      "safeMethodsOnly": true,
      "idempotencyRequired": true
    }
  },
