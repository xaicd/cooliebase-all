{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "im",
  "entity": "ImGroupMessage",
  "kebab": "im-group-message",
  "businessName": "IM 群聊消息",
  "permissionPrefix": "im:im_group_message",
  "page": {
    "route": "/admin/im/im-group-message",
    "title": "IM 群聊消息管理",
    "titleSelector": "[data-testid=\"im-group-message-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.im/api",
    "bffMount": "/api/v1/admin/im",
    "resource": "im-group-message",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/im-group-message",
        "query": [
          "page",
          "pageSize",
          "client_message_id",
          "sender_id",
          "group_id",
          "type",
          "status"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/im-group-message/:id"
      },
      "create": {
        "http": "POST",
        "path": "/im-group-message"
      },
      "update": {
        "http": "PUT",
        "path": "/im-group-message/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/im-group-message/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"im-group-message-title\"]",
    "refresh": "[data-testid=\"im-group-message-refresh\"]",
    "createButton": "[data-testid=\"im-group-message-create\"]",
    "searchForm": "[data-testid=\"im-group-message-search\"]",
    "searchSubmit": "[data-testid=\"im-group-message-search-submit\"]",
    "searchReset": "[data-testid=\"im-group-message-search-reset\"]",
    "total": "[data-testid=\"im-group-message-total\"]",
    "table": "[data-testid=\"im-group-message-table\"]",
    "row": "[data-testid=\"im-group-message-row\"]",
    "editButton": "[data-testid=\"im-group-message-edit\"]",
    "deleteButton": "[data-testid=\"im-group-message-delete\"]",
    "form": "[data-testid=\"im-group-message-form\"]",
    "formError": "[data-testid=\"im-group-message-form-error\"]",
    "formSubmit": "[data-testid=\"im-group-message-form-submit\"]",
    "formCancel": "[data-testid=\"im-group-message-form-cancel\"]",
    "formClose": "[data-testid=\"im-group-message-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "IM 群聊消息列表",
    "dialogLabel": {
      "create": "新增IM 群聊消息",
      "edit": "编辑IM 群聊消息"
    },
    "searchFields": [
      {
        "name": "client_message_id",
        "label": "客户端消息编号，用于发送幂等",
        "testId": "search-client_message_id",
        "selector": "[data-testid=\"search-client_message_id\"]"
      },
      {
        "name": "sender_id",
        "label": "发送人编号",
        "testId": "search-sender_id",
        "selector": "[data-testid=\"search-sender_id\"]"
      },
      {
        "name": "group_id",
        "label": "群编号",
        "testId": "search-group_id",
        "selector": "[data-testid=\"search-group_id\"]"
      },
      {
        "name": "type",
        "label": "消息类型",
        "testId": "search-type",
        "selector": "[data-testid=\"search-type\"]"
      },
      {
        "name": "status",
        "label": "消息状态",
        "testId": "search-status",
        "selector": "[data-testid=\"search-status\"]"
      }
    ],
    "fields": [
      {
        "name": "client_message_id",
        "label": "客户端消息编号，用于发送幂等",
        "type": "string",
        "required": false,
        "testId": "field-client_message_id",
        "selector": "[data-testid=\"field-client_message_id\"]"
      },
      {
        "name": "sender_id",
        "label": "发送人编号",
        "type": "string",
        "required": false,
        "testId": "field-sender_id",
        "selector": "[data-testid=\"field-sender_id\"]"
      },
      {
        "name": "group_id",
        "label": "群编号",
        "type": "string",
        "required": false,
        "testId": "field-group_id",
        "selector": "[data-testid=\"field-group_id\"]"
      },
      {
        "name": "type",
        "label": "消息类型",
        "type": "number",
        "required": false,
        "testId": "field-type",
        "selector": "[data-testid=\"field-type\"]"
      },
      {
        "name": "content",
        "label": "消息内容，JSON 格式",
        "type": "string",
        "required": false,
        "testId": "field-content",
        "selector": "[data-testid=\"field-content\"]"
      },
      {
        "name": "status",
        "label": "消息状态",
        "type": "number",
        "required": false,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      },
      {
        "name": "send_time",
        "label": "发送时间",
        "type": "string",
        "required": false,
        "testId": "field-send_time",
        "selector": "[data-testid=\"field-send_time\"]"
      },
      {
        "name": "receiver_user_ids",
        "label": "定向接收用户编号列表，以逗号分隔",
        "type": "string",
        "required": false,
        "testId": "field-receiver_user_ids",
        "selector": "[data-testid=\"field-receiver_user_ids\"]"
      },
      {
        "name": "at_user_ids",
        "label": "@ 目标用户编号列表，以逗号分隔",
        "type": "string",
        "required": false,
        "testId": "field-at_user_ids",
        "selector": "[data-testid=\"field-at_user_ids\"]"
      },
      {
        "name": "receipt_status",
        "label": "回执状态",
        "type": "number",
        "required": false,
        "testId": "field-receipt_status",
        "selector": "[data-testid=\"field-receipt_status\"]"
      },
      {
        "name": "read_count",
        "label": "离线拉取等场景下回算的已读人数",
        "type": "number",
        "required": false,
        "testId": "field-read_count",
        "selector": "[data-testid=\"field-read_count\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "im-group-message",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"im-group-message\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"im-group-message-form-overlay\"]",
      "dialog": "[data-testid=\"im-group-message-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "im-group-message:search",
      "reset": "im-group-message:reset",
      "refresh": "im-group-message:refresh",
      "create": "im-group-message:create",
      "edit": "im-group-message:edit",
      "delete": "im-group-message:delete",
      "submit": "im-group-message:submit",
      "cancel": "im-group-message:cancel",
      "close": "im-group-message:close",
      "row": "im-group-message:row",
      "pagination": "im-group-message:pagination",
      "fields": {
        "client_message_id": "im-group-message:field:client_message_id",
        "sender_id": "im-group-message:field:sender_id",
        "group_id": "im-group-message:field:group_id",
        "type": "im-group-message:field:type",
        "content": "im-group-message:field:content",
        "status": "im-group-message:field:status",
        "send_time": "im-group-message:field:send_time",
        "receiver_user_ids": "im-group-message:field:receiver_user_ids",
        "at_user_ids": "im-group-message:field:at_user_ids",
        "receipt_status": "im-group-message:field:receipt_status",
        "read_count": "im-group-message:field:read_count"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "im.im-group-message",
      "examples": [
        "im.im-group-message__List__Refresh",
        "im.im-group-message__ListItem__Open",
        "im.im-group-message__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
