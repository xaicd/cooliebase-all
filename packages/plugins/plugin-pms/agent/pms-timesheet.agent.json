{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "pms",
  "entity": "PmsTimesheet",
  "kebab": "pms-timesheet",
  "businessName": "任务工时",
  "permissionPrefix": "pms:timesheet",
  "page": {
    "route": "/admin/pms/pms-timesheet",
    "menuTitle": "任务工时",
    "title": "任务工时管理",
    "titleSelector": "[data-testid=\"pms-timesheet-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.pms/api",
    "bffMount": "/api/v1/admin/pms",
    "resource": "pms-timesheet",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/pms-timesheet",
        "query": [
          "page",
          "pageSize",
          "project_id",
          "member_id",
          "work_date",
          "status"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/pms-timesheet/:id"
      },
      "create": {
        "http": "POST",
        "path": "/pms-timesheet"
      },
      "update": {
        "http": "PUT",
        "path": "/pms-timesheet/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/pms-timesheet/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"pms-timesheet-title\"]",
    "refresh": "[data-testid=\"pms-timesheet-refresh\"]",
    "createButton": "[data-testid=\"pms-timesheet-create\"]",
    "searchForm": "[data-testid=\"pms-timesheet-search\"]",
    "searchSubmit": "[data-testid=\"pms-timesheet-search-submit\"]",
    "searchReset": "[data-testid=\"pms-timesheet-search-reset\"]",
    "total": "[data-testid=\"pms-timesheet-total\"]",
    "table": "[data-testid=\"pms-timesheet-table\"]",
    "row": "[data-testid=\"pms-timesheet-row\"]",
    "editButton": "[data-testid=\"pms-timesheet-edit\"]",
    "deleteButton": "[data-testid=\"pms-timesheet-delete\"]",
    "form": "[data-testid=\"pms-timesheet-form\"]",
    "formError": "[data-testid=\"pms-timesheet-form-error\"]",
    "formSubmit": "[data-testid=\"pms-timesheet-form-submit\"]",
    "formCancel": "[data-testid=\"pms-timesheet-form-cancel\"]",
    "formClose": "[data-testid=\"pms-timesheet-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "任务工时列表",
    "dialogLabel": {
      "create": "新增任务工时",
      "edit": "编辑任务工时"
    },
    "searchFields": [
      {
        "name": "project_id",
        "label": "所属项目ID",
        "testId": "search-project_id",
        "selector": "[data-testid=\"search-project_id\"]"
      },
      {
        "name": "member_id",
        "label": "成员ID",
        "testId": "search-member_id",
        "selector": "[data-testid=\"search-member_id\"]"
      },
      {
        "name": "work_date",
        "label": "工作日期",
        "testId": "search-work_date",
        "selector": "[data-testid=\"search-work_date\"]"
      },
      {
        "name": "status",
        "label": "核准状态",
        "testId": "search-status",
        "selector": "[data-testid=\"search-status\"]"
      }
    ],
    "fields": [
      {
        "name": "project_id",
        "label": "所属项目ID",
        "type": "string",
        "required": true,
        "testId": "field-project_id",
        "selector": "[data-testid=\"field-project_id\"]"
      },
      {
        "name": "member_id",
        "label": "成员ID",
        "type": "string",
        "required": true,
        "testId": "field-member_id",
        "selector": "[data-testid=\"field-member_id\"]"
      },
      {
        "name": "work_date",
        "label": "工作日期",
        "type": "string",
        "required": true,
        "testId": "field-work_date",
        "selector": "[data-testid=\"field-work_date\"]"
      },
      {
        "name": "hours",
        "label": "投入工时",
        "type": "number",
        "required": true,
        "testId": "field-hours",
        "selector": "[data-testid=\"field-hours\"]"
      },
      {
        "name": "cost_amount",
        "label": "工时折算成本",
        "type": "number",
        "required": true,
        "testId": "field-cost_amount",
        "selector": "[data-testid=\"field-cost_amount\"]"
      },
      {
        "name": "remark",
        "label": "工作内容说明",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      },
      {
        "name": "status",
        "label": "核准状态",
        "type": "string",
        "required": true,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "pms-timesheet",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"pms-timesheet\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"pms-timesheet-form-overlay\"]",
      "dialog": "[data-testid=\"pms-timesheet-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "pms-timesheet:search",
      "reset": "pms-timesheet:reset",
      "refresh": "pms-timesheet:refresh",
      "create": "pms-timesheet:create",
      "edit": "pms-timesheet:edit",
      "delete": "pms-timesheet:delete",
      "submit": "pms-timesheet:submit",
      "cancel": "pms-timesheet:cancel",
      "close": "pms-timesheet:close",
      "row": "pms-timesheet:row",
      "pagination": "pms-timesheet:pagination",
      "fields": {
        "project_id": "pms-timesheet:field:project_id",
        "member_id": "pms-timesheet:field:member_id",
        "work_date": "pms-timesheet:field:work_date",
        "hours": "pms-timesheet:field:hours",
        "cost_amount": "pms-timesheet:field:cost_amount",
        "remark": "pms-timesheet:field:remark",
        "status": "pms-timesheet:field:status"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "pms.pms-timesheet",
      "examples": [
        "pms.pms-timesheet__List__Refresh",
        "pms.pms-timesheet__ListItem__Open",
        "pms.pms-timesheet__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
