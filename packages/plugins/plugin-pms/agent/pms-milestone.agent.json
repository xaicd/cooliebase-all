{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "pms",
  "entity": "PmsMilestone",
  "kebab": "pms-milestone",
  "businessName": "里程碑",
  "permissionPrefix": "pms:milestone",
  "page": {
    "route": "/admin/pms/pms-milestone",
    "menuTitle": "里程碑",
    "title": "里程碑管理",
    "titleSelector": "[data-testid=\"pms-milestone-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.pms/api",
    "bffMount": "/api/v1/admin/pms",
    "resource": "pms-milestone",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/pms-milestone",
        "query": [
          "page",
          "pageSize",
          "project_id",
          "name",
          "owner_id",
          "status"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/pms-milestone/:id"
      },
      "create": {
        "http": "POST",
        "path": "/pms-milestone"
      },
      "update": {
        "http": "PUT",
        "path": "/pms-milestone/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/pms-milestone/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"pms-milestone-title\"]",
    "refresh": "[data-testid=\"pms-milestone-refresh\"]",
    "createButton": "[data-testid=\"pms-milestone-create\"]",
    "searchForm": "[data-testid=\"pms-milestone-search\"]",
    "searchSubmit": "[data-testid=\"pms-milestone-search-submit\"]",
    "searchReset": "[data-testid=\"pms-milestone-search-reset\"]",
    "total": "[data-testid=\"pms-milestone-total\"]",
    "table": "[data-testid=\"pms-milestone-table\"]",
    "row": "[data-testid=\"pms-milestone-row\"]",
    "editButton": "[data-testid=\"pms-milestone-edit\"]",
    "deleteButton": "[data-testid=\"pms-milestone-delete\"]",
    "form": "[data-testid=\"pms-milestone-form\"]",
    "formError": "[data-testid=\"pms-milestone-form-error\"]",
    "formSubmit": "[data-testid=\"pms-milestone-form-submit\"]",
    "formCancel": "[data-testid=\"pms-milestone-form-cancel\"]",
    "formClose": "[data-testid=\"pms-milestone-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "里程碑列表",
    "dialogLabel": {
      "create": "新增里程碑",
      "edit": "编辑里程碑"
    },
    "searchFields": [
      {
        "name": "project_id",
        "label": "所属项目ID",
        "testId": "search-project_id",
        "selector": "[data-testid=\"search-project_id\"]"
      },
      {
        "name": "name",
        "label": "节点名称",
        "testId": "search-name",
        "selector": "[data-testid=\"search-name\"]"
      },
      {
        "name": "owner_id",
        "label": "负责人ID",
        "testId": "search-owner_id",
        "selector": "[data-testid=\"search-owner_id\"]"
      },
      {
        "name": "status",
        "label": "达成状态",
        "testId": "search-status",
        "selector": "[data-testid=\"search-status\"]"
      }
    ],
    "fields": [
      {
        "name": "project_id",
        "label": "所属项目ID",
        "type": "string",
        "required": true,
        "testId": "field-project_id",
        "selector": "[data-testid=\"field-project_id\"]"
      },
      {
        "name": "name",
        "label": "节点名称",
        "type": "string",
        "required": true,
        "testId": "field-name",
        "selector": "[data-testid=\"field-name\"]"
      },
      {
        "name": "owner_id",
        "label": "负责人ID",
        "type": "string",
        "required": true,
        "testId": "field-owner_id",
        "selector": "[data-testid=\"field-owner_id\"]"
      },
      {
        "name": "due_time",
        "label": "截止时间",
        "type": "string",
        "required": true,
        "testId": "field-due_time",
        "selector": "[data-testid=\"field-due_time\"]"
      },
      {
        "name": "status",
        "label": "达成状态",
        "type": "string",
        "required": true,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "pms-milestone",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"pms-milestone\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"pms-milestone-form-overlay\"]",
      "dialog": "[data-testid=\"pms-milestone-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "pms-milestone:search",
      "reset": "pms-milestone:reset",
      "refresh": "pms-milestone:refresh",
      "create": "pms-milestone:create",
      "edit": "pms-milestone:edit",
      "delete": "pms-milestone:delete",
      "submit": "pms-milestone:submit",
      "cancel": "pms-milestone:cancel",
      "close": "pms-milestone:close",
      "row": "pms-milestone:row",
      "pagination": "pms-milestone:pagination",
      "fields": {
        "project_id": "pms-milestone:field:project_id",
        "name": "pms-milestone:field:name",
        "owner_id": "pms-milestone:field:owner_id",
        "due_time": "pms-milestone:field:due_time",
        "status": "pms-milestone:field:status"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "pms.pms-milestone",
      "examples": [
        "pms.pms-milestone__List__Refresh",
        "pms.pms-milestone__ListItem__Open",
        "pms.pms-milestone__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
