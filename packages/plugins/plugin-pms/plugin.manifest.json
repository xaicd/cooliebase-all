{
  "$schema": "cooliebase-plugin-manifest/v1",
  "id": "cooliebase.pms",
  "apiVersion": 1,
  "version": "0.1.0",
  "displayName": "pms",
  "description": "pms 域（由 scripts/scaffold-domain-plugin.cjs 生成的第一方插件声明）",
  "author": "CoolieBase All",
  "categories": [
    "automation"
  ],
  "capabilities": [
    "api.routes.register"
  ],
  "entrypoints": {
    "merged": "./plugin-entry.ts"
  },
  "domain": {
    "kind": "plugin",
    "stage": "B",
    "contractVersion": "v1",
    "publicPrefixes": [
      "/api/v1/admin/pms"
    ],
    "upstreamEnv": "COOLIEBASE_DOMAIN_PMS_UPSTREAM",
    "defaultPort": 3229,
    "packable": true,
    "independentDatabase": false,
    "dependsOnModules": [
      "shared"
    ],
    "auth": {
      "audience": "admin",
      "tenantPolicy": "required"
    },
    "resilience": {
      "timeoutMs": 15000,
      "retryMaxAttempts": 1,
      "safeMethodsOnly": true,
      "idempotencyRequired": true
    }
  },
  "apiRoutes": [
