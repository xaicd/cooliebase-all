{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "pay",
  "entity": "PayApp",
  "kebab": "pay-app",
  "businessName": "支付应用 DO一个商户下，可能会有多个支付应用。例如说，京东有京东商城、京东到家等等不过一般来说，一个商户，只有一个应用哈~即 PayMerchantDO : PayAppDO = 1 : n",
  "permissionPrefix": "pay:pay_app",
  "page": {
    "route": "/admin/pay/pay-app",
    "title": "支付应用 DO一个商户下，可能会有多个支付应用。例如说，京东有京东商城、京东到家等等不过一般来说，一个商户，只有一个应用哈~即 PayMerchantDO : PayAppDO = 1 : n管理",
    "titleSelector": "[data-testid=\"pay-app-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.pay/api",
    "bffMount": "/api/v1/admin/pay",
    "resource": "pay-app",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/pay-app",
        "query": [
          "page",
          "pageSize"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/pay-app/:id"
      },
      "create": {
        "http": "POST",
        "path": "/pay-app"
      },
      "update": {
        "http": "PUT",
        "path": "/pay-app/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/pay-app/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"pay-app-title\"]",
    "refresh": "[data-testid=\"pay-app-refresh\"]",
    "createButton": "[data-testid=\"pay-app-create\"]",
    "searchForm": "[data-testid=\"pay-app-search\"]",
    "searchSubmit": "[data-testid=\"pay-app-search-submit\"]",
    "searchReset": "[data-testid=\"pay-app-search-reset\"]",
    "total": "[data-testid=\"pay-app-total\"]",
    "table": "[data-testid=\"pay-app-table\"]",
    "row": "[data-testid=\"pay-app-row\"]",
    "editButton": "[data-testid=\"pay-app-edit\"]",
    "deleteButton": "[data-testid=\"pay-app-delete\"]",
    "form": "[data-testid=\"pay-app-form\"]",
    "formError": "[data-testid=\"pay-app-form-error\"]",
    "formSubmit": "[data-testid=\"pay-app-form-submit\"]",
    "formCancel": "[data-testid=\"pay-app-form-cancel\"]",
    "formClose": "[data-testid=\"pay-app-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "支付应用 DO一个商户下，可能会有多个支付应用。例如说，京东有京东商城、京东到家等等不过一般来说，一个商户，只有一个应用哈~即 PayMerchantDO : PayAppDO = 1 : n列表",
    "dialogLabel": {
      "create": "新增支付应用 DO一个商户下，可能会有多个支付应用。例如说，京东有京东商城、京东到家等等不过一般来说，一个商户，只有一个应用哈~即 PayMerchantDO : PayAppDO = 1 : n",
      "edit": "编辑支付应用 DO一个商户下，可能会有多个支付应用。例如说，京东有京东商城、京东到家等等不过一般来说，一个商户，只有一个应用哈~即 PayMerchantDO : PayAppDO = 1 : n"
    },
    "searchFields": [],
    "fields": [
      {
        "name": "app_key",
        "label": "应用标识",
        "type": "string",
        "required": false,
        "testId": "field-app_key",
        "selector": "[data-testid=\"field-app_key\"]"
      },
      {
        "name": "name",
        "label": "应用名",
        "type": "string",
        "required": false,
        "testId": "field-name",
        "selector": "[data-testid=\"field-name\"]"
      },
      {
        "name": "status",
        "label": "状态",
        "type": "number",
        "required": false,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      },
      {
        "name": "order_notify_url",
        "label": "支付结果的回调地址",
        "type": "string",
        "required": false,
        "testId": "field-order_notify_url",
        "selector": "[data-testid=\"field-order_notify_url\"]"
      },
      {
        "name": "refund_notify_url",
        "label": "退款结果的回调地址",
        "type": "string",
        "required": false,
        "testId": "field-refund_notify_url",
        "selector": "[data-testid=\"field-refund_notify_url\"]"
      },
      {
        "name": "transfer_notify_url",
        "label": "转账结果的回调地址",
        "type": "string",
        "required": false,
        "testId": "field-transfer_notify_url",
        "selector": "[data-testid=\"field-transfer_notify_url\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "pay-app",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"pay-app\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"pay-app-form-overlay\"]",
      "dialog": "[data-testid=\"pay-app-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "pay-app:search",
      "reset": "pay-app:reset",
      "refresh": "pay-app:refresh",
      "create": "pay-app:create",
      "edit": "pay-app:edit",
      "delete": "pay-app:delete",
      "submit": "pay-app:submit",
      "cancel": "pay-app:cancel",
      "close": "pay-app:close",
      "row": "pay-app:row",
      "pagination": "pay-app:pagination",
      "fields": {
        "app_key": "pay-app:field:app_key",
        "name": "pay-app:field:name",
        "status": "pay-app:field:status",
        "remark": "pay-app:field:remark",
        "order_notify_url": "pay-app:field:order_notify_url",
        "refund_notify_url": "pay-app:field:refund_notify_url",
        "transfer_notify_url": "pay-app:field:transfer_notify_url"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "pay.pay-app",
      "examples": [
        "pay.pay-app__List__Refresh",
        "pay.pay-app__ListItem__Open",
        "pay.pay-app__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
