{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "pay",
  "entity": "PayWalletRecharge",
  "kebab": "pay-wallet-recharge",
  "businessName": "会员钱包充值",
  "permissionPrefix": "pay:pay_wallet_recharge",
  "page": {
    "route": "/admin/pay/pay-wallet-recharge",
    "title": "会员钱包充值管理",
    "titleSelector": "[data-testid=\"pay-wallet-recharge-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.pay/api",
    "bffMount": "/api/v1/admin/pay",
    "resource": "pay-wallet-recharge",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/pay-wallet-recharge",
        "query": [
          "page",
          "pageSize"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/pay-wallet-recharge/:id"
      },
      "create": {
        "http": "POST",
        "path": "/pay-wallet-recharge"
      },
      "update": {
        "http": "PUT",
        "path": "/pay-wallet-recharge/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/pay-wallet-recharge/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"pay-wallet-recharge-title\"]",
    "refresh": "[data-testid=\"pay-wallet-recharge-refresh\"]",
    "createButton": "[data-testid=\"pay-wallet-recharge-create\"]",
    "searchForm": "[data-testid=\"pay-wallet-recharge-search\"]",
    "searchSubmit": "[data-testid=\"pay-wallet-recharge-search-submit\"]",
    "searchReset": "[data-testid=\"pay-wallet-recharge-search-reset\"]",
    "total": "[data-testid=\"pay-wallet-recharge-total\"]",
    "table": "[data-testid=\"pay-wallet-recharge-table\"]",
    "row": "[data-testid=\"pay-wallet-recharge-row\"]",
    "editButton": "[data-testid=\"pay-wallet-recharge-edit\"]",
    "deleteButton": "[data-testid=\"pay-wallet-recharge-delete\"]",
    "form": "[data-testid=\"pay-wallet-recharge-form\"]",
    "formError": "[data-testid=\"pay-wallet-recharge-form-error\"]",
    "formSubmit": "[data-testid=\"pay-wallet-recharge-form-submit\"]",
    "formCancel": "[data-testid=\"pay-wallet-recharge-form-cancel\"]",
    "formClose": "[data-testid=\"pay-wallet-recharge-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "会员钱包充值列表",
    "dialogLabel": {
      "create": "新增会员钱包充值",
      "edit": "编辑会员钱包充值"
    },
    "searchFields": [],
    "fields": [
      {
        "name": "wallet_id",
        "label": "钱包编号",
        "type": "number",
        "required": false,
        "testId": "field-wallet_id",
        "selector": "[data-testid=\"field-wallet_id\"]"
      },
      {
        "name": "total_price",
        "label": "用户实际到账余额",
        "type": "number",
        "required": false,
        "testId": "field-total_price",
        "selector": "[data-testid=\"field-total_price\"]"
      },
      {
        "name": "pay_price",
        "label": "实际支付金额",
        "type": "number",
        "required": false,
        "testId": "field-pay_price",
        "selector": "[data-testid=\"field-pay_price\"]"
      },
      {
        "name": "bonus_price",
        "label": "钱包赠送金额",
        "type": "number",
        "required": false,
        "testId": "field-bonus_price",
        "selector": "[data-testid=\"field-bonus_price\"]"
      },
      {
        "name": "package_id",
        "label": "充值套餐编号",
        "type": "number",
        "required": false,
        "testId": "field-package_id",
        "selector": "[data-testid=\"field-package_id\"]"
      },
      {
        "name": "pay_status",
        "label": "是否已支付",
        "type": "boolean",
        "required": false,
        "testId": "field-pay_status",
        "selector": "[data-testid=\"field-pay_status\"]"
      },
      {
        "name": "pay_order_id",
        "label": "支付订单编号",
        "type": "number",
        "required": false,
        "testId": "field-pay_order_id",
        "selector": "[data-testid=\"field-pay_order_id\"]"
      },
      {
        "name": "pay_channel_code",
        "label": "支付成功的支付渠道",
        "type": "string",
        "required": false,
        "testId": "field-pay_channel_code",
        "selector": "[data-testid=\"field-pay_channel_code\"]"
      },
      {
        "name": "pay_time",
        "label": "订单支付时间",
        "type": "string",
        "required": false,
        "testId": "field-pay_time",
        "selector": "[data-testid=\"field-pay_time\"]"
      },
      {
        "name": "pay_refund_id",
        "label": "支付退款单编号",
        "type": "number",
        "required": false,
        "testId": "field-pay_refund_id",
        "selector": "[data-testid=\"field-pay_refund_id\"]"
      },
      {
        "name": "refund_total_price",
        "label": "退款金额，包含赠送金额",
        "type": "number",
        "required": false,
        "testId": "field-refund_total_price",
        "selector": "[data-testid=\"field-refund_total_price\"]"
      },
      {
        "name": "refund_pay_price",
        "label": "退款支付金额",
        "type": "number",
        "required": false,
        "testId": "field-refund_pay_price",
        "selector": "[data-testid=\"field-refund_pay_price\"]"
      },
      {
        "name": "refund_bonus_price",
        "label": "退款钱包赠送金额",
        "type": "number",
        "required": false,
        "testId": "field-refund_bonus_price",
        "selector": "[data-testid=\"field-refund_bonus_price\"]"
      },
      {
        "name": "refund_time",
        "label": "退款时间",
        "type": "string",
        "required": false,
        "testId": "field-refund_time",
        "selector": "[data-testid=\"field-refund_time\"]"
      },
      {
        "name": "refund_status",
        "label": "退款状态",
        "type": "number",
        "required": false,
        "testId": "field-refund_status",
        "selector": "[data-testid=\"field-refund_status\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "pay-wallet-recharge",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"pay-wallet-recharge\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"pay-wallet-recharge-form-overlay\"]",
      "dialog": "[data-testid=\"pay-wallet-recharge-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "pay-wallet-recharge:search",
      "reset": "pay-wallet-recharge:reset",
      "refresh": "pay-wallet-recharge:refresh",
      "create": "pay-wallet-recharge:create",
      "edit": "pay-wallet-recharge:edit",
      "delete": "pay-wallet-recharge:delete",
      "submit": "pay-wallet-recharge:submit",
      "cancel": "pay-wallet-recharge:cancel",
      "close": "pay-wallet-recharge:close",
      "row": "pay-wallet-recharge:row",
      "pagination": "pay-wallet-recharge:pagination",
      "fields": {
        "wallet_id": "pay-wallet-recharge:field:wallet_id",
        "total_price": "pay-wallet-recharge:field:total_price",
        "pay_price": "pay-wallet-recharge:field:pay_price",
        "bonus_price": "pay-wallet-recharge:field:bonus_price",
        "package_id": "pay-wallet-recharge:field:package_id",
        "pay_status": "pay-wallet-recharge:field:pay_status",
        "pay_order_id": "pay-wallet-recharge:field:pay_order_id",
        "pay_channel_code": "pay-wallet-recharge:field:pay_channel_code",
        "pay_time": "pay-wallet-recharge:field:pay_time",
        "pay_refund_id": "pay-wallet-recharge:field:pay_refund_id",
        "refund_total_price": "pay-wallet-recharge:field:refund_total_price",
        "refund_pay_price": "pay-wallet-recharge:field:refund_pay_price",
        "refund_bonus_price": "pay-wallet-recharge:field:refund_bonus_price",
        "refund_time": "pay-wallet-recharge:field:refund_time",
        "refund_status": "pay-wallet-recharge:field:refund_status"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "pay.pay-wallet-recharge",
      "examples": [
        "pay.pay-wallet-recharge__List__Refresh",
        "pay.pay-wallet-recharge__ListItem__Open",
        "pay.pay-wallet-recharge__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
