{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "pay",
  "entity": "PayRefund",
  "kebab": "pay-refund",
  "businessName": "支付退款单 DO一个支付订单，可以拥有多个支付退款单即 PayOrderDO :",
  "permissionPrefix": "pay:pay_refund",
  "page": {
    "route": "/admin/pay/pay-refund",
    "title": "支付退款单 DO一个支付订单，可以拥有多个支付退款单即 PayOrderDO :管理",
    "titleSelector": "[data-testid=\"pay-refund-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.pay/api",
    "bffMount": "/api/v1/admin/pay",
    "resource": "pay-refund",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/pay-refund",
        "query": [
          "page",
          "pageSize",
          "no",
          "app_id",
          "channel_id",
          "order_id",
          "user_id"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/pay-refund/:id"
      },
      "create": {
        "http": "POST",
        "path": "/pay-refund"
      },
      "update": {
        "http": "PUT",
        "path": "/pay-refund/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/pay-refund/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"pay-refund-title\"]",
    "refresh": "[data-testid=\"pay-refund-refresh\"]",
    "createButton": "[data-testid=\"pay-refund-create\"]",
    "searchForm": "[data-testid=\"pay-refund-search\"]",
    "searchSubmit": "[data-testid=\"pay-refund-search-submit\"]",
    "searchReset": "[data-testid=\"pay-refund-search-reset\"]",
    "total": "[data-testid=\"pay-refund-total\"]",
    "table": "[data-testid=\"pay-refund-table\"]",
    "row": "[data-testid=\"pay-refund-row\"]",
    "editButton": "[data-testid=\"pay-refund-edit\"]",
    "deleteButton": "[data-testid=\"pay-refund-delete\"]",
    "form": "[data-testid=\"pay-refund-form\"]",
    "formError": "[data-testid=\"pay-refund-form-error\"]",
    "formSubmit": "[data-testid=\"pay-refund-form-submit\"]",
    "formCancel": "[data-testid=\"pay-refund-form-cancel\"]",
    "formClose": "[data-testid=\"pay-refund-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "支付退款单 DO一个支付订单，可以拥有多个支付退款单即 PayOrderDO :列表",
    "dialogLabel": {
      "create": "新增支付退款单 DO一个支付订单，可以拥有多个支付退款单即 PayOrderDO :",
      "edit": "编辑支付退款单 DO一个支付订单，可以拥有多个支付退款单即 PayOrderDO :"
    },
    "searchFields": [
      {
        "name": "no",
        "label": "外部退款号，根据规则生成",
        "testId": "search-no",
        "selector": "[data-testid=\"search-no\"]"
      },
      {
        "name": "app_id",
        "label": "应用编号",
        "testId": "search-app_id",
        "selector": "[data-testid=\"search-app_id\"]"
      },
      {
        "name": "channel_id",
        "label": "渠道编号",
        "testId": "search-channel_id",
        "selector": "[data-testid=\"search-channel_id\"]"
      },
      {
        "name": "order_id",
        "label": "订单编号",
        "testId": "search-order_id",
        "selector": "[data-testid=\"search-order_id\"]"
      },
      {
        "name": "user_id",
        "label": "用户编号",
        "testId": "search-user_id",
        "selector": "[data-testid=\"search-user_id\"]"
      }
    ],
    "fields": [
      {
        "name": "no",
        "label": "外部退款号，根据规则生成",
        "type": "string",
        "required": false,
        "testId": "field-no",
        "selector": "[data-testid=\"field-no\"]"
      },
      {
        "name": "app_id",
        "label": "应用编号",
        "type": "string",
        "required": false,
        "testId": "field-app_id",
        "selector": "[data-testid=\"field-app_id\"]"
      },
      {
        "name": "channel_id",
        "label": "渠道编号",
        "type": "string",
        "required": false,
        "testId": "field-channel_id",
        "selector": "[data-testid=\"field-channel_id\"]"
      },
      {
        "name": "channel_code",
        "label": "渠道编码",
        "type": "string",
        "required": false,
        "testId": "field-channel_code",
        "selector": "[data-testid=\"field-channel_code\"]"
      },
      {
        "name": "order_id",
        "label": "订单编号",
        "type": "string",
        "required": false,
        "testId": "field-order_id",
        "selector": "[data-testid=\"field-order_id\"]"
      },
      {
        "name": "order_no",
        "label": "支付订单编号",
        "type": "string",
        "required": false,
        "testId": "field-order_no",
        "selector": "[data-testid=\"field-order_no\"]"
      },
      {
        "name": "user_id",
        "label": "用户编号",
        "type": "string",
        "required": false,
        "testId": "field-user_id",
        "selector": "[data-testid=\"field-user_id\"]"
      },
      {
        "name": "user_type",
        "label": "用户类型",
        "type": "number",
        "required": false,
        "testId": "field-user_type",
        "selector": "[data-testid=\"field-user_type\"]"
      },
      {
        "name": "merchant_order_id",
        "label": "商户订单编号",
        "type": "string",
        "required": false,
        "testId": "field-merchant_order_id",
        "selector": "[data-testid=\"field-merchant_order_id\"]"
      },
      {
        "name": "merchant_refund_id",
        "label": "商户退款订单号",
        "type": "string",
        "required": false,
        "testId": "field-merchant_refund_id",
        "selector": "[data-testid=\"field-merchant_refund_id\"]"
      },
      {
        "name": "notify_url",
        "label": "异步通知地址",
        "type": "string",
        "required": false,
        "testId": "field-notify_url",
        "selector": "[data-testid=\"field-notify_url\"]"
      },
      {
        "name": "status",
        "label": "退款状态",
        "type": "number",
        "required": false,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      },
      {
        "name": "pay_price",
        "label": "支付金额，单位：分",
        "type": "number",
        "required": false,
        "testId": "field-pay_price",
        "selector": "[data-testid=\"field-pay_price\"]"
      },
      {
        "name": "refund_price",
        "label": "退款金额，单位：分",
        "type": "number",
        "required": false,
        "testId": "field-refund_price",
        "selector": "[data-testid=\"field-refund_price\"]"
      },
      {
        "name": "reason",
        "label": "退款原因",
        "type": "string",
        "required": false,
        "testId": "field-reason",
        "selector": "[data-testid=\"field-reason\"]"
      },
      {
        "name": "user_ip",
        "label": "用户 IP",
        "type": "string",
        "required": false,
        "testId": "field-user_ip",
        "selector": "[data-testid=\"field-user_ip\"]"
      },
      {
        "name": "channel_order_no",
        "label": "渠道订单号",
        "type": "string",
        "required": false,
        "testId": "field-channel_order_no",
        "selector": "[data-testid=\"field-channel_order_no\"]"
      },
      {
        "name": "channel_refund_no",
        "label": "渠道退款单号",
        "type": "string",
        "required": false,
        "testId": "field-channel_refund_no",
        "selector": "[data-testid=\"field-channel_refund_no\"]"
      },
      {
        "name": "success_time",
        "label": "退款成功时间",
        "type": "string",
        "required": false,
        "testId": "field-success_time",
        "selector": "[data-testid=\"field-success_time\"]"
      },
      {
        "name": "channel_error_code",
        "label": "调用渠道的错误码",
        "type": "string",
        "required": false,
        "testId": "field-channel_error_code",
        "selector": "[data-testid=\"field-channel_error_code\"]"
      },
      {
        "name": "channel_error_msg",
        "label": "调用渠道的错误提示",
        "type": "string",
        "required": false,
        "testId": "field-channel_error_msg",
        "selector": "[data-testid=\"field-channel_error_msg\"]"
      },
      {
        "name": "channel_notify_data",
        "label": "支付渠道的同步/异步通知的内容",
        "type": "string",
        "required": false,
        "testId": "field-channel_notify_data",
        "selector": "[data-testid=\"field-channel_notify_data\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "pay-refund",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"pay-refund\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"pay-refund-form-overlay\"]",
      "dialog": "[data-testid=\"pay-refund-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "pay-refund:search",
      "reset": "pay-refund:reset",
      "refresh": "pay-refund:refresh",
      "create": "pay-refund:create",
      "edit": "pay-refund:edit",
      "delete": "pay-refund:delete",
      "submit": "pay-refund:submit",
      "cancel": "pay-refund:cancel",
      "close": "pay-refund:close",
      "row": "pay-refund:row",
      "pagination": "pay-refund:pagination",
      "fields": {
        "no": "pay-refund:field:no",
        "app_id": "pay-refund:field:app_id",
        "channel_id": "pay-refund:field:channel_id",
        "channel_code": "pay-refund:field:channel_code",
        "order_id": "pay-refund:field:order_id",
        "order_no": "pay-refund:field:order_no",
        "user_id": "pay-refund:field:user_id",
        "user_type": "pay-refund:field:user_type",
        "merchant_order_id": "pay-refund:field:merchant_order_id",
        "merchant_refund_id": "pay-refund:field:merchant_refund_id",
        "notify_url": "pay-refund:field:notify_url",
        "status": "pay-refund:field:status",
        "pay_price": "pay-refund:field:pay_price",
        "refund_price": "pay-refund:field:refund_price",
        "reason": "pay-refund:field:reason",
        "user_ip": "pay-refund:field:user_ip",
        "channel_order_no": "pay-refund:field:channel_order_no",
        "channel_refund_no": "pay-refund:field:channel_refund_no",
        "success_time": "pay-refund:field:success_time",
        "channel_error_code": "pay-refund:field:channel_error_code",
        "channel_error_msg": "pay-refund:field:channel_error_msg",
        "channel_notify_data": "pay-refund:field:channel_notify_data"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "pay.pay-refund",
      "examples": [
        "pay.pay-refund__List__Refresh",
        "pay.pay-refund__ListItem__Open",
        "pay.pay-refund__Form__Submit"
      ]
    }
  },
  "enums": {
    "status": {
      "type": "enum",
      "values": [
        "0",
        "20",
        "10"
      ],
      "labels": {
        "0": "等待退款",
        "10": "退款成功",
        "20": "退款失败"
      },
      "description": "退款状态"
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
