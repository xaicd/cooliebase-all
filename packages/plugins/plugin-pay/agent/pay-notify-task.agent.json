{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "pay",
  "entity": "PayNotifyTask",
  "kebab": "pay-notify-task",
  "businessName": "支付通知在支付系统收到支付渠道的支付、退款的结果后，需要不断的通知到业务系统，直到成功。",
  "permissionPrefix": "pay:pay_notify_task",
  "page": {
    "route": "/admin/pay/pay-notify-task",
    "title": "支付通知在支付系统收到支付渠道的支付、退款的结果后，需要不断的通知到业务系统，直到成功。管理",
    "titleSelector": "[data-testid=\"pay-notify-task-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.pay/api",
    "bffMount": "/api/v1/admin/pay",
    "resource": "pay-notify-task",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/pay-notify-task",
        "query": [
          "page",
          "pageSize"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/pay-notify-task/:id"
      },
      "create": {
        "http": "POST",
        "path": "/pay-notify-task"
      },
      "update": {
        "http": "PUT",
        "path": "/pay-notify-task/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/pay-notify-task/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"pay-notify-task-title\"]",
    "refresh": "[data-testid=\"pay-notify-task-refresh\"]",
    "createButton": "[data-testid=\"pay-notify-task-create\"]",
    "searchForm": "[data-testid=\"pay-notify-task-search\"]",
    "searchSubmit": "[data-testid=\"pay-notify-task-search-submit\"]",
    "searchReset": "[data-testid=\"pay-notify-task-search-reset\"]",
    "total": "[data-testid=\"pay-notify-task-total\"]",
    "table": "[data-testid=\"pay-notify-task-table\"]",
    "row": "[data-testid=\"pay-notify-task-row\"]",
    "editButton": "[data-testid=\"pay-notify-task-edit\"]",
    "deleteButton": "[data-testid=\"pay-notify-task-delete\"]",
    "form": "[data-testid=\"pay-notify-task-form\"]",
    "formError": "[data-testid=\"pay-notify-task-form-error\"]",
    "formSubmit": "[data-testid=\"pay-notify-task-form-submit\"]",
    "formCancel": "[data-testid=\"pay-notify-task-form-cancel\"]",
    "formClose": "[data-testid=\"pay-notify-task-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "支付通知在支付系统收到支付渠道的支付、退款的结果后，需要不断的通知到业务系统，直到成功。列表",
    "dialogLabel": {
      "create": "新增支付通知在支付系统收到支付渠道的支付、退款的结果后，需要不断的通知到业务系统，直到成功。",
      "edit": "编辑支付通知在支付系统收到支付渠道的支付、退款的结果后，需要不断的通知到业务系统，直到成功。"
    },
    "searchFields": [],
    "fields": [
      {
        "name": "app_id",
        "label": "应用编号",
        "type": "number",
        "required": false,
        "testId": "field-app_id",
        "selector": "[data-testid=\"field-app_id\"]"
      },
      {
        "name": "type",
        "label": "通知类型",
        "type": "number",
        "required": false,
        "testId": "field-type",
        "selector": "[data-testid=\"field-type\"]"
      },
      {
        "name": "data_id",
        "label": "数据编号，根据不同 type 进行关联：",
        "type": "number",
        "required": false,
        "testId": "field-data_id",
        "selector": "[data-testid=\"field-data_id\"]"
      },
      {
        "name": "merchant_order_id",
        "label": "商户订单编号",
        "type": "string",
        "required": false,
        "testId": "field-merchant_order_id",
        "selector": "[data-testid=\"field-merchant_order_id\"]"
      },
      {
        "name": "merchant_refund_id",
        "label": "商户退款编号",
        "type": "string",
        "required": false,
        "testId": "field-merchant_refund_id",
        "selector": "[data-testid=\"field-merchant_refund_id\"]"
      },
      {
        "name": "merchant_transfer_id",
        "label": "商户转账编号",
        "type": "string",
        "required": false,
        "testId": "field-merchant_transfer_id",
        "selector": "[data-testid=\"field-merchant_transfer_id\"]"
      },
      {
        "name": "status",
        "label": "通知状态",
        "type": "number",
        "required": false,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      },
      {
        "name": "next_notify_time",
        "label": "下一次通知时间",
        "type": "string",
        "required": false,
        "testId": "field-next_notify_time",
        "selector": "[data-testid=\"field-next_notify_time\"]"
      },
      {
        "name": "last_execute_time",
        "label": "最后一次执行时间",
        "type": "string",
        "required": false,
        "testId": "field-last_execute_time",
        "selector": "[data-testid=\"field-last_execute_time\"]"
      },
      {
        "name": "notify_times",
        "label": "当前通知次数",
        "type": "number",
        "required": false,
        "testId": "field-notify_times",
        "selector": "[data-testid=\"field-notify_times\"]"
      },
      {
        "name": "max_notify_times",
        "label": "最大可通知次数",
        "type": "number",
        "required": false,
        "testId": "field-max_notify_times",
        "selector": "[data-testid=\"field-max_notify_times\"]"
      },
      {
        "name": "notify_url",
        "label": "通知地址",
        "type": "string",
        "required": false,
        "testId": "field-notify_url",
        "selector": "[data-testid=\"field-notify_url\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "pay-notify-task",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"pay-notify-task\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"pay-notify-task-form-overlay\"]",
      "dialog": "[data-testid=\"pay-notify-task-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "pay-notify-task:search",
      "reset": "pay-notify-task:reset",
      "refresh": "pay-notify-task:refresh",
      "create": "pay-notify-task:create",
      "edit": "pay-notify-task:edit",
      "delete": "pay-notify-task:delete",
      "submit": "pay-notify-task:submit",
      "cancel": "pay-notify-task:cancel",
      "close": "pay-notify-task:close",
      "row": "pay-notify-task:row",
      "pagination": "pay-notify-task:pagination",
      "fields": {
        "app_id": "pay-notify-task:field:app_id",
        "type": "pay-notify-task:field:type",
        "data_id": "pay-notify-task:field:data_id",
        "merchant_order_id": "pay-notify-task:field:merchant_order_id",
        "merchant_refund_id": "pay-notify-task:field:merchant_refund_id",
        "merchant_transfer_id": "pay-notify-task:field:merchant_transfer_id",
        "status": "pay-notify-task:field:status",
        "next_notify_time": "pay-notify-task:field:next_notify_time",
        "last_execute_time": "pay-notify-task:field:last_execute_time",
        "notify_times": "pay-notify-task:field:notify_times",
        "max_notify_times": "pay-notify-task:field:max_notify_times",
        "notify_url": "pay-notify-task:field:notify_url"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "pay.pay-notify-task",
      "examples": [
        "pay.pay-notify-task__List__Refresh",
        "pay.pay-notify-task__ListItem__Open",
        "pay.pay-notify-task__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
