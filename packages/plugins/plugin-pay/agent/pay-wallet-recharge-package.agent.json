{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "pay",
  "entity": "PayWalletRechargePackage",
  "kebab": "pay-wallet-recharge-package",
  "businessName": "会员钱包充值套餐 DO通过充值套餐时，可以赠送一定金额；",
  "permissionPrefix": "pay:pay_wallet_recharge_package",
  "page": {
    "route": "/admin/pay/pay-wallet-recharge-package",
    "title": "会员钱包充值套餐 DO通过充值套餐时，可以赠送一定金额；管理",
    "titleSelector": "[data-testid=\"pay-wallet-recharge-package-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.pay/api",
    "bffMount": "/api/v1/admin/pay",
    "resource": "pay-wallet-recharge-package",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/pay-wallet-recharge-package",
        "query": [
          "page",
          "pageSize",
          "name",
          "status"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/pay-wallet-recharge-package/:id"
      },
      "create": {
        "http": "POST",
        "path": "/pay-wallet-recharge-package"
      },
      "update": {
        "http": "PUT",
        "path": "/pay-wallet-recharge-package/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/pay-wallet-recharge-package/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"pay-wallet-recharge-package-title\"]",
    "refresh": "[data-testid=\"pay-wallet-recharge-package-refresh\"]",
    "createButton": "[data-testid=\"pay-wallet-recharge-package-create\"]",
    "searchForm": "[data-testid=\"pay-wallet-recharge-package-search\"]",
    "searchSubmit": "[data-testid=\"pay-wallet-recharge-package-search-submit\"]",
    "searchReset": "[data-testid=\"pay-wallet-recharge-package-search-reset\"]",
    "total": "[data-testid=\"pay-wallet-recharge-package-total\"]",
    "table": "[data-testid=\"pay-wallet-recharge-package-table\"]",
    "row": "[data-testid=\"pay-wallet-recharge-package-row\"]",
    "editButton": "[data-testid=\"pay-wallet-recharge-package-edit\"]",
    "deleteButton": "[data-testid=\"pay-wallet-recharge-package-delete\"]",
    "form": "[data-testid=\"pay-wallet-recharge-package-form\"]",
    "formError": "[data-testid=\"pay-wallet-recharge-package-form-error\"]",
    "formSubmit": "[data-testid=\"pay-wallet-recharge-package-form-submit\"]",
    "formCancel": "[data-testid=\"pay-wallet-recharge-package-form-cancel\"]",
    "formClose": "[data-testid=\"pay-wallet-recharge-package-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "会员钱包充值套餐 DO通过充值套餐时，可以赠送一定金额；列表",
    "dialogLabel": {
      "create": "新增会员钱包充值套餐 DO通过充值套餐时，可以赠送一定金额；",
      "edit": "编辑会员钱包充值套餐 DO通过充值套餐时，可以赠送一定金额；"
    },
    "searchFields": [
      {
        "name": "name",
        "label": "套餐名",
        "testId": "search-name",
        "selector": "[data-testid=\"search-name\"]"
      },
      {
        "name": "status",
        "label": "状态",
        "testId": "search-status",
        "selector": "[data-testid=\"search-status\"]"
      }
    ],
    "fields": [
      {
        "name": "name",
        "label": "套餐名",
        "type": "string",
        "required": false,
        "testId": "field-name",
        "selector": "[data-testid=\"field-name\"]"
      },
      {
        "name": "pay_price",
        "label": "支付金额",
        "type": "number",
        "required": false,
        "testId": "field-pay_price",
        "selector": "[data-testid=\"field-pay_price\"]"
      },
      {
        "name": "bonus_price",
        "label": "赠送金额",
        "type": "number",
        "required": false,
        "testId": "field-bonus_price",
        "selector": "[data-testid=\"field-bonus_price\"]"
      },
      {
        "name": "status",
        "label": "状态",
        "type": "number",
        "required": false,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "pay-wallet-recharge-package",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"pay-wallet-recharge-package\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"pay-wallet-recharge-package-form-overlay\"]",
      "dialog": "[data-testid=\"pay-wallet-recharge-package-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "pay-wallet-recharge-package:search",
      "reset": "pay-wallet-recharge-package:reset",
      "refresh": "pay-wallet-recharge-package:refresh",
      "create": "pay-wallet-recharge-package:create",
      "edit": "pay-wallet-recharge-package:edit",
      "delete": "pay-wallet-recharge-package:delete",
      "submit": "pay-wallet-recharge-package:submit",
      "cancel": "pay-wallet-recharge-package:cancel",
      "close": "pay-wallet-recharge-package:close",
      "row": "pay-wallet-recharge-package:row",
      "pagination": "pay-wallet-recharge-package:pagination",
      "fields": {
        "name": "pay-wallet-recharge-package:field:name",
        "pay_price": "pay-wallet-recharge-package:field:pay_price",
        "bonus_price": "pay-wallet-recharge-package:field:bonus_price",
        "status": "pay-wallet-recharge-package:field:status"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "pay.pay-wallet-recharge-package",
      "examples": [
        "pay.pay-wallet-recharge-package__List__Refresh",
        "pay.pay-wallet-recharge-package__ListItem__Open",
        "pay.pay-wallet-recharge-package__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
