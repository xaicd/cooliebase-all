{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "pay",
  "entity": "PayOrder",
  "kebab": "pay-order",
  "businessName": "支付订单",
  "permissionPrefix": "pay:pay_order",
  "page": {
    "route": "/admin/pay/pay-order",
    "title": "支付订单管理",
    "titleSelector": "[data-testid=\"pay-order-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.pay/api",
    "bffMount": "/api/v1/admin/pay",
    "resource": "pay-order",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/pay-order",
        "query": [
          "page",
          "pageSize",
          "app_id",
          "channel_id",
          "user_id",
          "merchant_order_id",
          "subject"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/pay-order/:id"
      },
      "create": {
        "http": "POST",
        "path": "/pay-order"
      },
      "update": {
        "http": "PUT",
        "path": "/pay-order/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/pay-order/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"pay-order-title\"]",
    "refresh": "[data-testid=\"pay-order-refresh\"]",
    "createButton": "[data-testid=\"pay-order-create\"]",
    "searchForm": "[data-testid=\"pay-order-search\"]",
    "searchSubmit": "[data-testid=\"pay-order-search-submit\"]",
    "searchReset": "[data-testid=\"pay-order-search-reset\"]",
    "total": "[data-testid=\"pay-order-total\"]",
    "table": "[data-testid=\"pay-order-table\"]",
    "row": "[data-testid=\"pay-order-row\"]",
    "editButton": "[data-testid=\"pay-order-edit\"]",
    "deleteButton": "[data-testid=\"pay-order-delete\"]",
    "form": "[data-testid=\"pay-order-form\"]",
    "formError": "[data-testid=\"pay-order-form-error\"]",
    "formSubmit": "[data-testid=\"pay-order-form-submit\"]",
    "formCancel": "[data-testid=\"pay-order-form-cancel\"]",
    "formClose": "[data-testid=\"pay-order-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "支付订单列表",
    "dialogLabel": {
      "create": "新增支付订单",
      "edit": "编辑支付订单"
    },
    "searchFields": [
      {
        "name": "app_id",
        "label": "应用编号",
        "testId": "search-app_id",
        "selector": "[data-testid=\"search-app_id\"]"
      },
      {
        "name": "channel_id",
        "label": "渠道编号",
        "testId": "search-channel_id",
        "selector": "[data-testid=\"search-channel_id\"]"
      },
      {
        "name": "user_id",
        "label": "用户编号",
        "testId": "search-user_id",
        "selector": "[data-testid=\"search-user_id\"]"
      },
      {
        "name": "merchant_order_id",
        "label": "商户订单编号",
        "testId": "search-merchant_order_id",
        "selector": "[data-testid=\"search-merchant_order_id\"]"
      },
      {
        "name": "subject",
        "label": "商品标题",
        "testId": "search-subject",
        "selector": "[data-testid=\"search-subject\"]"
      }
    ],
    "fields": [
      {
        "name": "app_id",
        "label": "应用编号",
        "type": "string",
        "required": false,
        "testId": "field-app_id",
        "selector": "[data-testid=\"field-app_id\"]"
      },
      {
        "name": "channel_id",
        "label": "渠道编号",
        "type": "string",
        "required": false,
        "testId": "field-channel_id",
        "selector": "[data-testid=\"field-channel_id\"]"
      },
      {
        "name": "channel_code",
        "label": "渠道编码",
        "type": "string",
        "required": false,
        "testId": "field-channel_code",
        "selector": "[data-testid=\"field-channel_code\"]"
      },
      {
        "name": "user_id",
        "label": "用户编号",
        "type": "string",
        "required": false,
        "testId": "field-user_id",
        "selector": "[data-testid=\"field-user_id\"]"
      },
      {
        "name": "user_type",
        "label": "用户类型",
        "type": "number",
        "required": false,
        "testId": "field-user_type",
        "selector": "[data-testid=\"field-user_type\"]"
      },
      {
        "name": "merchant_order_id",
        "label": "商户订单编号",
        "type": "string",
        "required": false,
        "testId": "field-merchant_order_id",
        "selector": "[data-testid=\"field-merchant_order_id\"]"
      },
      {
        "name": "subject",
        "label": "商品标题",
        "type": "string",
        "required": false,
        "testId": "field-subject",
        "selector": "[data-testid=\"field-subject\"]"
      },
      {
        "name": "body",
        "label": "商品描述信息",
        "type": "string",
        "required": false,
        "testId": "field-body",
        "selector": "[data-testid=\"field-body\"]"
      },
      {
        "name": "notify_url",
        "label": "异步通知地址",
        "type": "string",
        "required": false,
        "testId": "field-notify_url",
        "selector": "[data-testid=\"field-notify_url\"]"
      },
      {
        "name": "price",
        "label": "支付金额，单位：分",
        "type": "number",
        "required": false,
        "testId": "field-price",
        "selector": "[data-testid=\"field-price\"]"
      },
      {
        "name": "channel_fee_rate",
        "label": "渠道手续费，单位：百分比",
        "type": "number",
        "required": false,
        "testId": "field-channel_fee_rate",
        "selector": "[data-testid=\"field-channel_fee_rate\"]"
      },
      {
        "name": "channel_fee_price",
        "label": "渠道手续金额，单位：分",
        "type": "number",
        "required": false,
        "testId": "field-channel_fee_price",
        "selector": "[data-testid=\"field-channel_fee_price\"]"
      },
      {
        "name": "status",
        "label": "支付状态（字符串状态机 WAITING/SUCCESS/CLOSED，见 pay-order-lifecycle.ts）",
        "type": "string",
        "required": false,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      },
      {
        "name": "user_ip",
        "label": "用户 IP",
        "type": "string",
        "required": false,
        "testId": "field-user_ip",
        "selector": "[data-testid=\"field-user_ip\"]"
      },
      {
        "name": "expire_time",
        "label": "订单失效时间",
        "type": "string",
        "required": false,
        "testId": "field-expire_time",
        "selector": "[data-testid=\"field-expire_time\"]"
      },
      {
        "name": "success_time",
        "label": "订单支付成功时间",
        "type": "string",
        "required": false,
        "testId": "field-success_time",
        "selector": "[data-testid=\"field-success_time\"]"
      },
      {
        "name": "extension_id",
        "label": "支付成功的订单拓展单编号",
        "type": "string",
        "required": false,
        "testId": "field-extension_id",
        "selector": "[data-testid=\"field-extension_id\"]"
      },
      {
        "name": "no",
        "label": "支付成功的外部订单号",
        "type": "string",
        "required": false,
        "testId": "field-no",
        "selector": "[data-testid=\"field-no\"]"
      },
      {
        "name": "refund_price",
        "label": "退款总金额，单位：分",
        "type": "number",
        "required": false,
        "testId": "field-refund_price",
        "selector": "[data-testid=\"field-refund_price\"]"
      },
      {
        "name": "channel_user_id",
        "label": "渠道用户编号",
        "type": "string",
        "required": false,
        "testId": "field-channel_user_id",
        "selector": "[data-testid=\"field-channel_user_id\"]"
      },
      {
        "name": "channel_order_no",
        "label": "渠道订单号",
        "type": "string",
        "required": false,
        "testId": "field-channel_order_no",
        "selector": "[data-testid=\"field-channel_order_no\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "pay-order",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"pay-order\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"pay-order-form-overlay\"]",
      "dialog": "[data-testid=\"pay-order-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "pay-order:search",
      "reset": "pay-order:reset",
      "refresh": "pay-order:refresh",
      "create": "pay-order:create",
      "edit": "pay-order:edit",
      "delete": "pay-order:delete",
      "submit": "pay-order:submit",
      "cancel": "pay-order:cancel",
      "close": "pay-order:close",
      "row": "pay-order:row",
      "pagination": "pay-order:pagination",
      "fields": {
        "app_id": "pay-order:field:app_id",
        "channel_id": "pay-order:field:channel_id",
        "channel_code": "pay-order:field:channel_code",
        "user_id": "pay-order:field:user_id",
        "user_type": "pay-order:field:user_type",
        "merchant_order_id": "pay-order:field:merchant_order_id",
        "subject": "pay-order:field:subject",
        "body": "pay-order:field:body",
        "notify_url": "pay-order:field:notify_url",
        "price": "pay-order:field:price",
        "channel_fee_rate": "pay-order:field:channel_fee_rate",
        "channel_fee_price": "pay-order:field:channel_fee_price",
        "status": "pay-order:field:status",
        "user_ip": "pay-order:field:user_ip",
        "expire_time": "pay-order:field:expire_time",
        "success_time": "pay-order:field:success_time",
        "extension_id": "pay-order:field:extension_id",
        "no": "pay-order:field:no",
        "refund_price": "pay-order:field:refund_price",
        "channel_user_id": "pay-order:field:channel_user_id",
        "channel_order_no": "pay-order:field:channel_order_no"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "pay.pay-order",
      "examples": [
        "pay.pay-order__List__Refresh",
        "pay.pay-order__ListItem__Open",
        "pay.pay-order__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
