{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "pay",
  "entity": "PayDemoOrder",
  "kebab": "pay-demo-order",
  "businessName": "示例订单演示业务系统的订单，如何接入 pay 系统的支付与退款",
  "permissionPrefix": "pay:pay_demo_order",
  "page": {
    "route": "/admin/pay/pay-demo-order",
    "title": "示例订单演示业务系统的订单，如何接入 pay 系统的支付与退款管理",
    "titleSelector": "[data-testid=\"pay-demo-order-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.pay/api",
    "bffMount": "/api/v1/admin/pay",
    "resource": "pay-demo-order",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/pay-demo-order",
        "query": [
          "page",
          "pageSize"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/pay-demo-order/:id"
      },
      "create": {
        "http": "POST",
        "path": "/pay-demo-order"
      },
      "update": {
        "http": "PUT",
        "path": "/pay-demo-order/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/pay-demo-order/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"pay-demo-order-title\"]",
    "refresh": "[data-testid=\"pay-demo-order-refresh\"]",
    "createButton": "[data-testid=\"pay-demo-order-create\"]",
    "searchForm": "[data-testid=\"pay-demo-order-search\"]",
    "searchSubmit": "[data-testid=\"pay-demo-order-search-submit\"]",
    "searchReset": "[data-testid=\"pay-demo-order-search-reset\"]",
    "total": "[data-testid=\"pay-demo-order-total\"]",
    "table": "[data-testid=\"pay-demo-order-table\"]",
    "row": "[data-testid=\"pay-demo-order-row\"]",
    "editButton": "[data-testid=\"pay-demo-order-edit\"]",
    "deleteButton": "[data-testid=\"pay-demo-order-delete\"]",
    "form": "[data-testid=\"pay-demo-order-form\"]",
    "formError": "[data-testid=\"pay-demo-order-form-error\"]",
    "formSubmit": "[data-testid=\"pay-demo-order-form-submit\"]",
    "formCancel": "[data-testid=\"pay-demo-order-form-cancel\"]",
    "formClose": "[data-testid=\"pay-demo-order-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "示例订单演示业务系统的订单，如何接入 pay 系统的支付与退款列表",
    "dialogLabel": {
      "create": "新增示例订单演示业务系统的订单，如何接入 pay 系统的支付与退款",
      "edit": "编辑示例订单演示业务系统的订单，如何接入 pay 系统的支付与退款"
    },
    "searchFields": [],
    "fields": [
      {
        "name": "user_id",
        "label": "用户编号",
        "type": "number",
        "required": false,
        "testId": "field-user_id",
        "selector": "[data-testid=\"field-user_id\"]"
      },
      {
        "name": "spu_id",
        "label": "商品编号",
        "type": "number",
        "required": false,
        "testId": "field-spu_id",
        "selector": "[data-testid=\"field-spu_id\"]"
      },
      {
        "name": "spu_name",
        "label": "商品名称",
        "type": "string",
        "required": false,
        "testId": "field-spu_name",
        "selector": "[data-testid=\"field-spu_name\"]"
      },
      {
        "name": "price",
        "label": "价格，单位：分",
        "type": "number",
        "required": false,
        "testId": "field-price",
        "selector": "[data-testid=\"field-price\"]"
      },
      {
        "name": "pay_status",
        "label": "是否支付",
        "type": "boolean",
        "required": false,
        "testId": "field-pay_status",
        "selector": "[data-testid=\"field-pay_status\"]"
      },
      {
        "name": "pay_order_id",
        "label": "支付订单编号",
        "type": "number",
        "required": false,
        "testId": "field-pay_order_id",
        "selector": "[data-testid=\"field-pay_order_id\"]"
      },
      {
        "name": "pay_time",
        "label": "付款时间",
        "type": "string",
        "required": false,
        "testId": "field-pay_time",
        "selector": "[data-testid=\"field-pay_time\"]"
      },
      {
        "name": "pay_channel_code",
        "label": "支付渠道",
        "type": "string",
        "required": false,
        "testId": "field-pay_channel_code",
        "selector": "[data-testid=\"field-pay_channel_code\"]"
      },
      {
        "name": "pay_refund_id",
        "label": "支付退款单号",
        "type": "number",
        "required": false,
        "testId": "field-pay_refund_id",
        "selector": "[data-testid=\"field-pay_refund_id\"]"
      },
      {
        "name": "refund_price",
        "label": "退款金额，单位：分",
        "type": "number",
        "required": false,
        "testId": "field-refund_price",
        "selector": "[data-testid=\"field-refund_price\"]"
      },
      {
        "name": "refund_time",
        "label": "退款完成时间",
        "type": "string",
        "required": false,
        "testId": "field-refund_time",
        "selector": "[data-testid=\"field-refund_time\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "pay-demo-order",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"pay-demo-order\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"pay-demo-order-form-overlay\"]",
      "dialog": "[data-testid=\"pay-demo-order-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "pay-demo-order:search",
      "reset": "pay-demo-order:reset",
      "refresh": "pay-demo-order:refresh",
      "create": "pay-demo-order:create",
      "edit": "pay-demo-order:edit",
      "delete": "pay-demo-order:delete",
      "submit": "pay-demo-order:submit",
      "cancel": "pay-demo-order:cancel",
      "close": "pay-demo-order:close",
      "row": "pay-demo-order:row",
      "pagination": "pay-demo-order:pagination",
      "fields": {
        "user_id": "pay-demo-order:field:user_id",
        "spu_id": "pay-demo-order:field:spu_id",
        "spu_name": "pay-demo-order:field:spu_name",
        "price": "pay-demo-order:field:price",
        "pay_status": "pay-demo-order:field:pay_status",
        "pay_order_id": "pay-demo-order:field:pay_order_id",
        "pay_time": "pay-demo-order:field:pay_time",
        "pay_channel_code": "pay-demo-order:field:pay_channel_code",
        "pay_refund_id": "pay-demo-order:field:pay_refund_id",
        "refund_price": "pay-demo-order:field:refund_price",
        "refund_time": "pay-demo-order:field:refund_time"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "pay.pay-demo-order",
      "examples": [
        "pay.pay-demo-order__List__Refresh",
        "pay.pay-demo-order__ListItem__Open",
        "pay.pay-demo-order__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
