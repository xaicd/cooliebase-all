{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "pay",
  "entity": "PayNotifyLog",
  "kebab": "pay-notify-log",
  "businessName": "商户支付、退款等的通知 Log每次通知时，都会在该表中，记录一次 Log，方便排查问题",
  "permissionPrefix": "pay:pay_notify_log",
  "page": {
    "route": "/admin/pay/pay-notify-log",
    "title": "商户支付、退款等的通知 Log每次通知时，都会在该表中，记录一次 Log，方便排查问题管理",
    "titleSelector": "[data-testid=\"pay-notify-log-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.pay/api",
    "bffMount": "/api/v1/admin/pay",
    "resource": "pay-notify-log",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/pay-notify-log",
        "query": [
          "page",
          "pageSize"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/pay-notify-log/:id"
      },
      "create": {
        "http": "POST",
        "path": "/pay-notify-log"
      },
      "update": {
        "http": "PUT",
        "path": "/pay-notify-log/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/pay-notify-log/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"pay-notify-log-title\"]",
    "refresh": "[data-testid=\"pay-notify-log-refresh\"]",
    "createButton": "[data-testid=\"pay-notify-log-create\"]",
    "searchForm": "[data-testid=\"pay-notify-log-search\"]",
    "searchSubmit": "[data-testid=\"pay-notify-log-search-submit\"]",
    "searchReset": "[data-testid=\"pay-notify-log-search-reset\"]",
    "total": "[data-testid=\"pay-notify-log-total\"]",
    "table": "[data-testid=\"pay-notify-log-table\"]",
    "row": "[data-testid=\"pay-notify-log-row\"]",
    "editButton": "[data-testid=\"pay-notify-log-edit\"]",
    "deleteButton": "[data-testid=\"pay-notify-log-delete\"]",
    "form": "[data-testid=\"pay-notify-log-form\"]",
    "formError": "[data-testid=\"pay-notify-log-form-error\"]",
    "formSubmit": "[data-testid=\"pay-notify-log-form-submit\"]",
    "formCancel": "[data-testid=\"pay-notify-log-form-cancel\"]",
    "formClose": "[data-testid=\"pay-notify-log-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "商户支付、退款等的通知 Log每次通知时，都会在该表中，记录一次 Log，方便排查问题列表",
    "dialogLabel": {
      "create": "新增商户支付、退款等的通知 Log每次通知时，都会在该表中，记录一次 Log，方便排查问题",
      "edit": "编辑商户支付、退款等的通知 Log每次通知时，都会在该表中，记录一次 Log，方便排查问题"
    },
    "searchFields": [],
    "fields": [
      {
        "name": "task_id",
        "label": "通知任务编号",
        "type": "number",
        "required": false,
        "testId": "field-task_id",
        "selector": "[data-testid=\"field-task_id\"]"
      },
      {
        "name": "notify_times",
        "label": "第几次被通知",
        "type": "number",
        "required": false,
        "testId": "field-notify_times",
        "selector": "[data-testid=\"field-notify_times\"]"
      },
      {
        "name": "response",
        "label": "HTTP 响应结果",
        "type": "string",
        "required": false,
        "testId": "field-response",
        "selector": "[data-testid=\"field-response\"]"
      },
      {
        "name": "status",
        "label": "支付通知状态",
        "type": "number",
        "required": false,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "pay-notify-log",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"pay-notify-log\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"pay-notify-log-form-overlay\"]",
      "dialog": "[data-testid=\"pay-notify-log-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "pay-notify-log:search",
      "reset": "pay-notify-log:reset",
      "refresh": "pay-notify-log:refresh",
      "create": "pay-notify-log:create",
      "edit": "pay-notify-log:edit",
      "delete": "pay-notify-log:delete",
      "submit": "pay-notify-log:submit",
      "cancel": "pay-notify-log:cancel",
      "close": "pay-notify-log:close",
      "row": "pay-notify-log:row",
      "pagination": "pay-notify-log:pagination",
      "fields": {
        "task_id": "pay-notify-log:field:task_id",
        "notify_times": "pay-notify-log:field:notify_times",
        "response": "pay-notify-log:field:response",
        "status": "pay-notify-log:field:status"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "pay.pay-notify-log",
      "examples": [
        "pay.pay-notify-log__List__Refresh",
        "pay.pay-notify-log__ListItem__Open",
        "pay.pay-notify-log__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
