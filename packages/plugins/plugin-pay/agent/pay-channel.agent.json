{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "pay",
  "entity": "PayChannel",
  "kebab": "pay-channel",
  "businessName": "支付渠道 DO一个应用下，会有多种支付渠道，例如说微信支付、支付宝支付等等即 P",
  "permissionPrefix": "pay:pay_channel",
  "page": {
    "route": "/admin/pay/pay-channel",
    "title": "支付渠道 DO一个应用下，会有多种支付渠道，例如说微信支付、支付宝支付等等即 P管理",
    "titleSelector": "[data-testid=\"pay-channel-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.pay/api",
    "bffMount": "/api/v1/admin/pay",
    "resource": "pay-channel",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/pay-channel",
        "query": [
          "page",
          "pageSize",
          "code",
          "status",
          "app_id"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/pay-channel/:id"
      },
      "create": {
        "http": "POST",
        "path": "/pay-channel"
      },
      "update": {
        "http": "PUT",
        "path": "/pay-channel/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/pay-channel/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"pay-channel-title\"]",
    "refresh": "[data-testid=\"pay-channel-refresh\"]",
    "createButton": "[data-testid=\"pay-channel-create\"]",
    "searchForm": "[data-testid=\"pay-channel-search\"]",
    "searchSubmit": "[data-testid=\"pay-channel-search-submit\"]",
    "searchReset": "[data-testid=\"pay-channel-search-reset\"]",
    "total": "[data-testid=\"pay-channel-total\"]",
    "table": "[data-testid=\"pay-channel-table\"]",
    "row": "[data-testid=\"pay-channel-row\"]",
    "editButton": "[data-testid=\"pay-channel-edit\"]",
    "deleteButton": "[data-testid=\"pay-channel-delete\"]",
    "form": "[data-testid=\"pay-channel-form\"]",
    "formError": "[data-testid=\"pay-channel-form-error\"]",
    "formSubmit": "[data-testid=\"pay-channel-form-submit\"]",
    "formCancel": "[data-testid=\"pay-channel-form-cancel\"]",
    "formClose": "[data-testid=\"pay-channel-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "支付渠道 DO一个应用下，会有多种支付渠道，例如说微信支付、支付宝支付等等即 P列表",
    "dialogLabel": {
      "create": "新增支付渠道 DO一个应用下，会有多种支付渠道，例如说微信支付、支付宝支付等等即 P",
      "edit": "编辑支付渠道 DO一个应用下，会有多种支付渠道，例如说微信支付、支付宝支付等等即 P"
    },
    "searchFields": [
      {
        "name": "code",
        "label": "渠道编码",
        "testId": "search-code",
        "selector": "[data-testid=\"search-code\"]"
      },
      {
        "name": "status",
        "label": "状态",
        "testId": "search-status",
        "selector": "[data-testid=\"search-status\"]"
      },
      {
        "name": "app_id",
        "label": "应用编号",
        "testId": "search-app_id",
        "selector": "[data-testid=\"search-app_id\"]"
      }
    ],
    "fields": [
      {
        "name": "code",
        "label": "渠道编码",
        "type": "string",
        "required": false,
        "testId": "field-code",
        "selector": "[data-testid=\"field-code\"]"
      },
      {
        "name": "status",
        "label": "状态",
        "type": "number",
        "required": false,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      },
      {
        "name": "fee_rate",
        "label": "渠道费率，单位：百分比",
        "type": "number",
        "required": false,
        "testId": "field-fee_rate",
        "selector": "[data-testid=\"field-fee_rate\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      },
      {
        "name": "app_id",
        "label": "应用编号",
        "type": "string",
        "required": false,
        "testId": "field-app_id",
        "selector": "[data-testid=\"field-app_id\"]"
      },
      {
        "name": "config",
        "label": "支付渠道配置",
        "type": "string",
        "required": false,
        "testId": "field-config",
        "selector": "[data-testid=\"field-config\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "pay-channel",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"pay-channel\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"pay-channel-form-overlay\"]",
      "dialog": "[data-testid=\"pay-channel-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "pay-channel:search",
      "reset": "pay-channel:reset",
      "refresh": "pay-channel:refresh",
      "create": "pay-channel:create",
      "edit": "pay-channel:edit",
      "delete": "pay-channel:delete",
      "submit": "pay-channel:submit",
      "cancel": "pay-channel:cancel",
      "close": "pay-channel:close",
      "row": "pay-channel:row",
      "pagination": "pay-channel:pagination",
      "fields": {
        "code": "pay-channel:field:code",
        "status": "pay-channel:field:status",
        "fee_rate": "pay-channel:field:fee_rate",
        "remark": "pay-channel:field:remark",
        "app_id": "pay-channel:field:app_id",
        "config": "pay-channel:field:config"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "pay.pay-channel",
      "examples": [
        "pay.pay-channel__List__Refresh",
        "pay.pay-channel__ListItem__Open",
        "pay.pay-channel__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
