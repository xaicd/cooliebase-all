{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "pay",
  "entity": "PayWallet",
  "kebab": "pay-wallet",
  "businessName": "会员钱包",
  "permissionPrefix": "pay:pay_wallet",
  "page": {
    "route": "/admin/pay/pay-wallet",
    "title": "会员钱包管理",
    "titleSelector": "[data-testid=\"pay-wallet-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.pay/api",
    "bffMount": "/api/v1/admin/pay",
    "resource": "pay-wallet",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/pay-wallet",
        "query": [
          "page",
          "pageSize"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/pay-wallet/:id"
      },
      "create": {
        "http": "POST",
        "path": "/pay-wallet"
      },
      "update": {
        "http": "PUT",
        "path": "/pay-wallet/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/pay-wallet/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"pay-wallet-title\"]",
    "refresh": "[data-testid=\"pay-wallet-refresh\"]",
    "createButton": "[data-testid=\"pay-wallet-create\"]",
    "searchForm": "[data-testid=\"pay-wallet-search\"]",
    "searchSubmit": "[data-testid=\"pay-wallet-search-submit\"]",
    "searchReset": "[data-testid=\"pay-wallet-search-reset\"]",
    "total": "[data-testid=\"pay-wallet-total\"]",
    "table": "[data-testid=\"pay-wallet-table\"]",
    "row": "[data-testid=\"pay-wallet-row\"]",
    "editButton": "[data-testid=\"pay-wallet-edit\"]",
    "deleteButton": "[data-testid=\"pay-wallet-delete\"]",
    "form": "[data-testid=\"pay-wallet-form\"]",
    "formError": "[data-testid=\"pay-wallet-form-error\"]",
    "formSubmit": "[data-testid=\"pay-wallet-form-submit\"]",
    "formCancel": "[data-testid=\"pay-wallet-form-cancel\"]",
    "formClose": "[data-testid=\"pay-wallet-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "会员钱包列表",
    "dialogLabel": {
      "create": "新增会员钱包",
      "edit": "编辑会员钱包"
    },
    "searchFields": [],
    "fields": [
      {
        "name": "user_id",
        "label": "用户 id",
        "type": "number",
        "required": false,
        "testId": "field-user_id",
        "selector": "[data-testid=\"field-user_id\"]"
      },
      {
        "name": "user_type",
        "label": "用户类型, 预留 多商户转帐可能需要用到",
        "type": "number",
        "required": false,
        "testId": "field-user_type",
        "selector": "[data-testid=\"field-user_type\"]"
      },
      {
        "name": "balance",
        "label": "余额，单位分",
        "type": "number",
        "required": false,
        "testId": "field-balance",
        "selector": "[data-testid=\"field-balance\"]"
      },
      {
        "name": "freeze_price",
        "label": "冻结金额，单位分",
        "type": "number",
        "required": false,
        "testId": "field-freeze_price",
        "selector": "[data-testid=\"field-freeze_price\"]"
      },
      {
        "name": "total_expense",
        "label": "累计支出，单位分",
        "type": "number",
        "required": false,
        "testId": "field-total_expense",
        "selector": "[data-testid=\"field-total_expense\"]"
      },
      {
        "name": "total_recharge",
        "label": "累计充值，单位分",
        "type": "number",
        "required": false,
        "testId": "field-total_recharge",
        "selector": "[data-testid=\"field-total_recharge\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "pay-wallet",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"pay-wallet\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"pay-wallet-form-overlay\"]",
      "dialog": "[data-testid=\"pay-wallet-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "pay-wallet:search",
      "reset": "pay-wallet:reset",
      "refresh": "pay-wallet:refresh",
      "create": "pay-wallet:create",
      "edit": "pay-wallet:edit",
      "delete": "pay-wallet:delete",
      "submit": "pay-wallet:submit",
      "cancel": "pay-wallet:cancel",
      "close": "pay-wallet:close",
      "row": "pay-wallet:row",
      "pagination": "pay-wallet:pagination",
      "fields": {
        "user_id": "pay-wallet:field:user_id",
        "user_type": "pay-wallet:field:user_type",
        "balance": "pay-wallet:field:balance",
        "freeze_price": "pay-wallet:field:freeze_price",
        "total_expense": "pay-wallet:field:total_expense",
        "total_recharge": "pay-wallet:field:total_recharge"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "pay.pay-wallet",
      "examples": [
        "pay.pay-wallet__List__Refresh",
        "pay.pay-wallet__ListItem__Open",
        "pay.pay-wallet__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
