{
  "$schema": "cooliebase-module-manifest/v1",
  "domain": "pay",
  "id": "cooliebase.pay",
  "apiVersion": 1,
  "displayName": "支付中心",
  "kind": "plugin",
  "stage": "B",
  "owner": "pay",
  "contractVersion": "v1",
  "implementation": "local-ts",
  "minimumHostVersion": "1.0.0",
  "capabilities": [
    "api.routes.register",
    "facade.invoke",
    "rpc.serve",
    "cmd.dispatch",
    "pack.independent"
  ],
  "entrypoints": {
    "facade": [
      "packages/plugins/plugin-pay/contract/pay.facade.ts"
    ],
    "proto": "packages/plugins/plugin-pay/contract/pay.proto",
    "actions": "packages/plugins/plugin-pay/contract/actions.ts"
  },
  "apiRoutes": {
    "publicPrefix": [
      "/api/v1/admin/pay",
      "/api/v1/app/pay",
      "/api/v1/open/pay"
    ],
    "adminPrefix": "/api/v1/admin/pay"
  },
  "auth": {
    "audience": "admin",
    "tenantPolicy": "required"
  },
  "messaging": {
    "queueGroup": "cooliebase.pay",
    "commandSubject": "cooliebase.cmd.pay.>",
    "eventSubject": "cooliebase.evt.pay.>"
  },
  "invoke": {
    "colocated": "sdk",
    "remote": "rpc",
    "protocol": "nats-rr",
    "serialization": "json"
  },
  "upstream": {
    "env": "COOLIEBASE_DOMAIN_PAY_UPSTREAM",
    "protocol": "http",
    "defaultPort": 3214
  },
  "resilience": {
    "timeoutMs": 5000,
    "retry": {
      "maxAttempts": 1,
      "safeMethodsOnly": true
    },
    "idempotencyRequired": true
  },
  "facadeMethods": [
    "ping",
    "listOrders",
    "createOrder",
    "createRefund",
    "listRefunds"
  ],
  "rpc": [
    {
      "service": "PayService",
      "method": "Ping"
    },
    {
      "service": "PayService",
      "method": "ListOrders"
    },
    {
      "service": "PayService",
      "method": "CreateOrder"
    },
    {
      "service": "PayService",
      "method": "CreateRefund"
    },
    {
      "service": "PayService",
      "method": "ListRefunds"
    }
  ],
  "actions": [
    "pay.ping",
    "pay.listOrders",
    "pay.createOrder",
    "pay.createRefund",
    "pay.listRefunds"
  ],
  "permissions": [
    "pay:app:create",
    "pay:app:delete",
    "pay:app:query",
    "pay:app:update",
    "pay:channel:create",
    "pay:channel:delete",
    "pay:channel:query",
    "pay:channel:update",
    "pay:demo-order:create",
    "pay:demo-order:delete",
    "pay:demo-order:query",
    "pay:demo-order:update",
    "pay:demo-withdraw:create",
    "pay:demo-withdraw:delete",
    "pay:demo-withdraw:query",
    "pay:demo-withdraw:update",
    "pay:notify-log:create",
    "pay:notify-log:delete",
    "pay:notify-log:query",
    "pay:notify-log:update",
    "pay:notify-task:create",
    "pay:notify-task:delete",
    "pay:notify-task:query",
    "pay:notify-task:update",
    "pay:notify:query",
    "pay:order-extension:create",
    "pay:order-extension:delete",
    "pay:order-extension:query",
    "pay:order-extension:update",
    "pay:order:create",
    "pay:order:delete",
    "pay:order:query",
    "pay:order:update",
    "pay:refund:create",
    "pay:refund:delete",
    "pay:refund:query",
    "pay:refund:update",
    "pay:transfer:create",
    "pay:transfer:delete",
    "pay:transfer:query",
    "pay:transfer:update",
    "pay:wallet-recharge-package:create",
    "pay:wallet-recharge-package:delete",
    "pay:wallet-recharge-package:query",
    "pay:wallet-recharge-package:update",
    "pay:wallet-recharge:create",
    "pay:wallet-recharge:delete",
    "pay:wallet-recharge:query",
    "pay:wallet-recharge:update",
    "pay:wallet-transaction:create",
    "pay:wallet-transaction:delete",
    "pay:wallet-transaction:query",
    "pay:wallet-transaction:update",
    "pay:wallet:create",
    "pay:wallet:delete",
    "pay:wallet:query",
    "pay:wallet:update"
  ],
  "dependsOn": [
    "shared"
  ],
  "pack": {
    "enabled": true,
    "kind": "api-only",
    "independentDatabase": false
  }
}
