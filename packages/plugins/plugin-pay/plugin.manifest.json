{
  "$schema": "cooliebase-plugin-manifest/v1",
  "id": "cooliebase.pay",
  "apiVersion": 1,
  "version": "0.1.0",
  "displayName": "pay",
  "description": "pay 域（由 scripts/scaffold-domain-plugin.cjs 生成的第一方插件声明）",
  "author": "CoolieBase All",
  "categories": [
    "automation"
  ],
  "capabilities": [
    "api.routes.register"
  ],
  "entrypoints": {
    "merged": "./plugin-entry.ts"
  },
  "domain": {
    "kind": "plugin",
    "stage": "B",
    "contractVersion": "v1",
    "publicPrefixes": [
      "/api/v1/admin/pay",
      "/api/v1/app/pay",
      "/api/v1/open/pay"
    ],
    "upstreamEnv": "COOLIEBASE_DOMAIN_PAY_UPSTREAM",
    "defaultPort": 3214,
    "packable": true,
    "independentDatabase": false,
    "dependsOnModules": [
      "shared"
    ],
    "auth": {
      "audience": "admin",
      "tenantPolicy": "required"
    },
    "resilience": {
      "timeoutMs": 5000,
      "retryMaxAttempts": 1,
      "safeMethodsOnly": true,
      "idempotencyRequired": true
    }
  },
  "apiRoutes": [
