{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "ai",
  "entity": "AiTool",
  "kebab": "ai-tool",
  "businessName": "AI 工具",
  "permissionPrefix": "ai:ai_tool",
  "page": {
    "route": "/admin/ai/ai-tool",
    "title": "AI 工具管理",
    "titleSelector": "[data-testid=\"ai-tool-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.ai/api",
    "bffMount": "/api/v1/admin/ai",
    "resource": "ai-tool",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/ai-tool",
        "query": [
          "page",
          "pageSize"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/ai-tool/:id"
      },
      "create": {
        "http": "POST",
        "path": "/ai-tool"
      },
      "update": {
        "http": "PUT",
        "path": "/ai-tool/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/ai-tool/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"ai-tool-title\"]",
    "refresh": "[data-testid=\"ai-tool-refresh\"]",
    "createButton": "[data-testid=\"ai-tool-create\"]",
    "searchForm": "[data-testid=\"ai-tool-search\"]",
    "searchSubmit": "[data-testid=\"ai-tool-search-submit\"]",
    "searchReset": "[data-testid=\"ai-tool-search-reset\"]",
    "total": "[data-testid=\"ai-tool-total\"]",
    "table": "[data-testid=\"ai-tool-table\"]",
    "row": "[data-testid=\"ai-tool-row\"]",
    "editButton": "[data-testid=\"ai-tool-edit\"]",
    "deleteButton": "[data-testid=\"ai-tool-delete\"]",
    "form": "[data-testid=\"ai-tool-form\"]",
    "formError": "[data-testid=\"ai-tool-form-error\"]",
    "formSubmit": "[data-testid=\"ai-tool-form-submit\"]",
    "formCancel": "[data-testid=\"ai-tool-form-cancel\"]",
    "formClose": "[data-testid=\"ai-tool-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "AI 工具列表",
    "dialogLabel": {
      "create": "新增AI 工具",
      "edit": "编辑AI 工具"
    },
    "searchFields": [],
    "fields": [
      {
        "name": "name",
        "label": "工具名称",
        "type": "string",
        "required": false,
        "testId": "field-name",
        "selector": "[data-testid=\"field-name\"]"
      },
      {
        "name": "description",
        "label": "工具描述",
        "type": "string",
        "required": false,
        "testId": "field-description",
        "selector": "[data-testid=\"field-description\"]"
      },
      {
        "name": "status",
        "label": "状态",
        "type": "number",
        "required": false,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "ai-tool",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"ai-tool\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"ai-tool-form-overlay\"]",
      "dialog": "[data-testid=\"ai-tool-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "ai-tool:search",
      "reset": "ai-tool:reset",
      "refresh": "ai-tool:refresh",
      "create": "ai-tool:create",
      "edit": "ai-tool:edit",
      "delete": "ai-tool:delete",
      "submit": "ai-tool:submit",
      "cancel": "ai-tool:cancel",
      "close": "ai-tool:close",
      "row": "ai-tool:row",
      "pagination": "ai-tool:pagination",
      "fields": {
        "name": "ai-tool:field:name",
        "description": "ai-tool:field:description",
        "status": "ai-tool:field:status"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "ai.ai-tool",
      "examples": [
        "ai.ai-tool__List__Refresh",
        "ai.ai-tool__ListItem__Open",
        "ai.ai-tool__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
