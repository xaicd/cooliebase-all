{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "hrm",
  "entity": "HrmPayroll",
  "kebab": "hrm-payroll",
  "businessName": "薪资核算",
  "permissionPrefix": "hrm:payroll",
  "page": {
    "route": "/admin/hrm/hrm-payroll",
    "menuTitle": "薪资核算",
    "title": "薪资核算管理",
    "titleSelector": "[data-testid=\"hrm-payroll-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.hrm/api",
    "bffMount": "/api/v1/admin/hrm",
    "resource": "hrm-payroll",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/hrm-payroll",
        "query": [
          "page",
          "pageSize",
          "payroll_no",
          "employee_id",
          "period",
          "status"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/hrm-payroll/:id"
      },
      "create": {
        "http": "POST",
        "path": "/hrm-payroll"
      },
      "update": {
        "http": "PUT",
        "path": "/hrm-payroll/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/hrm-payroll/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"hrm-payroll-title\"]",
    "refresh": "[data-testid=\"hrm-payroll-refresh\"]",
    "createButton": "[data-testid=\"hrm-payroll-create\"]",
    "searchForm": "[data-testid=\"hrm-payroll-search\"]",
    "searchSubmit": "[data-testid=\"hrm-payroll-search-submit\"]",
    "searchReset": "[data-testid=\"hrm-payroll-search-reset\"]",
    "total": "[data-testid=\"hrm-payroll-total\"]",
    "table": "[data-testid=\"hrm-payroll-table\"]",
    "row": "[data-testid=\"hrm-payroll-row\"]",
    "editButton": "[data-testid=\"hrm-payroll-edit\"]",
    "deleteButton": "[data-testid=\"hrm-payroll-delete\"]",
    "form": "[data-testid=\"hrm-payroll-form\"]",
    "formError": "[data-testid=\"hrm-payroll-form-error\"]",
    "formSubmit": "[data-testid=\"hrm-payroll-form-submit\"]",
    "formCancel": "[data-testid=\"hrm-payroll-form-cancel\"]",
    "formClose": "[data-testid=\"hrm-payroll-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "薪资核算列表",
    "dialogLabel": {
      "create": "新增薪资核算",
      "edit": "编辑薪资核算"
    },
    "searchFields": [
      {
        "name": "payroll_no",
        "label": "核算单号",
        "testId": "search-payroll_no",
        "selector": "[data-testid=\"search-payroll_no\"]"
      },
      {
        "name": "employee_id",
        "label": "员工ID",
        "testId": "search-employee_id",
        "selector": "[data-testid=\"search-employee_id\"]"
      },
      {
        "name": "period",
        "label": "发薪期间",
        "testId": "search-period",
        "selector": "[data-testid=\"search-period\"]"
      },
      {
        "name": "status",
        "label": "发放状态",
        "testId": "search-status",
        "selector": "[data-testid=\"search-status\"]"
      }
    ],
    "fields": [
      {
        "name": "payroll_no",
        "label": "核算单号",
        "type": "string",
        "required": true,
        "testId": "field-payroll_no",
        "selector": "[data-testid=\"field-payroll_no\"]"
      },
      {
        "name": "employee_id",
        "label": "员工ID",
        "type": "string",
        "required": true,
        "testId": "field-employee_id",
        "selector": "[data-testid=\"field-employee_id\"]"
      },
      {
        "name": "period",
        "label": "发薪期间",
        "type": "string",
        "required": true,
        "testId": "field-period",
        "selector": "[data-testid=\"field-period\"]"
      },
      {
        "name": "base_amount",
        "label": "基本薪资",
        "type": "number",
        "required": true,
        "testId": "field-base_amount",
        "selector": "[data-testid=\"field-base_amount\"]"
      },
      {
        "name": "bonus_amount",
        "label": "绩效奖金",
        "type": "number",
        "required": true,
        "testId": "field-bonus_amount",
        "selector": "[data-testid=\"field-bonus_amount\"]"
      },
      {
        "name": "deduct_amount",
        "label": "代扣社保个税",
        "type": "number",
        "required": true,
        "testId": "field-deduct_amount",
        "selector": "[data-testid=\"field-deduct_amount\"]"
      },
      {
        "name": "net_amount",
        "label": "实发金额",
        "type": "number",
        "required": true,
        "testId": "field-net_amount",
        "selector": "[data-testid=\"field-net_amount\"]"
      },
      {
        "name": "status",
        "label": "发放状态",
        "type": "string",
        "required": true,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "hrm-payroll",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"hrm-payroll\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"hrm-payroll-form-overlay\"]",
      "dialog": "[data-testid=\"hrm-payroll-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "hrm-payroll:search",
      "reset": "hrm-payroll:reset",
      "refresh": "hrm-payroll:refresh",
      "create": "hrm-payroll:create",
      "edit": "hrm-payroll:edit",
      "delete": "hrm-payroll:delete",
      "submit": "hrm-payroll:submit",
      "cancel": "hrm-payroll:cancel",
      "close": "hrm-payroll:close",
      "row": "hrm-payroll:row",
      "pagination": "hrm-payroll:pagination",
      "fields": {
        "payroll_no": "hrm-payroll:field:payroll_no",
        "employee_id": "hrm-payroll:field:employee_id",
        "period": "hrm-payroll:field:period",
        "base_amount": "hrm-payroll:field:base_amount",
        "bonus_amount": "hrm-payroll:field:bonus_amount",
        "deduct_amount": "hrm-payroll:field:deduct_amount",
        "net_amount": "hrm-payroll:field:net_amount",
        "status": "hrm-payroll:field:status"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "hrm.hrm-payroll",
      "examples": [
        "hrm.hrm-payroll__List__Refresh",
        "hrm.hrm-payroll__ListItem__Open",
        "hrm.hrm-payroll__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
