{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "hrm",
  "entity": "HrmPosition",
  "kebab": "hrm-position",
  "businessName": "岗位编制",
  "permissionPrefix": "hrm:position",
  "page": {
    "route": "/admin/hrm/hrm-position",
    "menuTitle": "岗位编制",
    "title": "岗位编制管理",
    "titleSelector": "[data-testid=\"hrm-position-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.hrm/api",
    "bffMount": "/api/v1/admin/hrm",
    "resource": "hrm-position",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/hrm-position",
        "query": [
          "page",
          "pageSize",
          "code",
          "name",
          "dept_id",
          "status"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/hrm-position/:id"
      },
      "create": {
        "http": "POST",
        "path": "/hrm-position"
      },
      "update": {
        "http": "PUT",
        "path": "/hrm-position/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/hrm-position/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"hrm-position-title\"]",
    "refresh": "[data-testid=\"hrm-position-refresh\"]",
    "createButton": "[data-testid=\"hrm-position-create\"]",
    "searchForm": "[data-testid=\"hrm-position-search\"]",
    "searchSubmit": "[data-testid=\"hrm-position-search-submit\"]",
    "searchReset": "[data-testid=\"hrm-position-search-reset\"]",
    "total": "[data-testid=\"hrm-position-total\"]",
    "table": "[data-testid=\"hrm-position-table\"]",
    "row": "[data-testid=\"hrm-position-row\"]",
    "editButton": "[data-testid=\"hrm-position-edit\"]",
    "deleteButton": "[data-testid=\"hrm-position-delete\"]",
    "form": "[data-testid=\"hrm-position-form\"]",
    "formError": "[data-testid=\"hrm-position-form-error\"]",
    "formSubmit": "[data-testid=\"hrm-position-form-submit\"]",
    "formCancel": "[data-testid=\"hrm-position-form-cancel\"]",
    "formClose": "[data-testid=\"hrm-position-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "岗位编制列表",
    "dialogLabel": {
      "create": "新增岗位编制",
      "edit": "编辑岗位编制"
    },
    "searchFields": [
      {
        "name": "code",
        "label": "岗位编码",
        "testId": "search-code",
        "selector": "[data-testid=\"search-code\"]"
      },
      {
        "name": "name",
        "label": "岗位名称",
        "testId": "search-name",
        "selector": "[data-testid=\"search-name\"]"
      },
      {
        "name": "dept_id",
        "label": "归属部门ID",
        "testId": "search-dept_id",
        "selector": "[data-testid=\"search-dept_id\"]"
      },
      {
        "name": "status",
        "label": "状态",
        "testId": "search-status",
        "selector": "[data-testid=\"search-status\"]"
      }
    ],
    "fields": [
      {
        "name": "code",
        "label": "岗位编码",
        "type": "string",
        "required": true,
        "testId": "field-code",
        "selector": "[data-testid=\"field-code\"]"
      },
      {
        "name": "name",
        "label": "岗位名称",
        "type": "string",
        "required": true,
        "testId": "field-name",
        "selector": "[data-testid=\"field-name\"]"
      },
      {
        "name": "dept_id",
        "label": "归属部门ID",
        "type": "string",
        "required": true,
        "testId": "field-dept_id",
        "selector": "[data-testid=\"field-dept_id\"]"
      },
      {
        "name": "headcount",
        "label": "核定编制数",
        "type": "number",
        "required": true,
        "testId": "field-headcount",
        "selector": "[data-testid=\"field-headcount\"]"
      },
      {
        "name": "grade",
        "label": "职级序列",
        "type": "string",
        "required": false,
        "testId": "field-grade",
        "selector": "[data-testid=\"field-grade\"]"
      },
      {
        "name": "status",
        "label": "状态",
        "type": "string",
        "required": true,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "hrm-position",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"hrm-position\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"hrm-position-form-overlay\"]",
      "dialog": "[data-testid=\"hrm-position-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "hrm-position:search",
      "reset": "hrm-position:reset",
      "refresh": "hrm-position:refresh",
      "create": "hrm-position:create",
      "edit": "hrm-position:edit",
      "delete": "hrm-position:delete",
      "submit": "hrm-position:submit",
      "cancel": "hrm-position:cancel",
      "close": "hrm-position:close",
      "row": "hrm-position:row",
      "pagination": "hrm-position:pagination",
      "fields": {
        "code": "hrm-position:field:code",
        "name": "hrm-position:field:name",
        "dept_id": "hrm-position:field:dept_id",
        "headcount": "hrm-position:field:headcount",
        "grade": "hrm-position:field:grade",
        "status": "hrm-position:field:status"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "hrm.hrm-position",
      "examples": [
        "hrm.hrm-position__List__Refresh",
        "hrm.hrm-position__ListItem__Open",
        "hrm.hrm-position__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
