{
  "$schema": "cooliebase-module-manifest/v1",
  "domain": "mp",
  "id": "cooliebase.mp",
  "apiVersion": 1,
  "displayName": "微信公号",
  "kind": "plugin",
  "stage": "B",
  "owner": "mp",
  "contractVersion": "v1",
  "implementation": "local-ts",
  "minimumHostVersion": "1.0.0",
  "capabilities": [
    "api.routes.register",
    "facade.invoke",
    "rpc.serve",
    "cmd.dispatch",
    "pack.independent"
  ],
  "entrypoints": {
    "facade": [
      "packages/plugins/plugin-mp/contract/mp.facade.ts"
    ],
    "proto": "packages/plugins/plugin-mp/contract/mp.proto",
    "actions": "packages/plugins/plugin-mp/contract/actions.ts"
  },
  "apiRoutes": {
    "publicPrefix": [
      "/api/v1/admin/mp"
    ],
    "adminPrefix": "/api/v1/admin/mp"
  },
  "auth": {
    "audience": "admin",
    "tenantPolicy": "required"
  },
  "messaging": {
    "queueGroup": "cooliebase.mp",
    "commandSubject": "cooliebase.cmd.mp.>",
    "eventSubject": "cooliebase.evt.mp.>"
  },
  "invoke": {
    "colocated": "sdk",
    "remote": "rpc",
    "protocol": "nats-rr",
    "serialization": "json"
  },
  "upstream": {
    "env": "COOLIEBASE_DOMAIN_MP_UPSTREAM",
    "protocol": "http",
    "defaultPort": 3216
  },
  "resilience": {
    "timeoutMs": 8000,
    "retry": {
      "maxAttempts": 1,
      "safeMethodsOnly": true
    },
    "idempotencyRequired": true
  },
  "facadeMethods": [
    "ping",
    "listAccounts",
    "listFans",
    "sendMessage"
  ],
  "rpc": [
    {
      "service": "MpService",
      "method": "Ping"
    },
    {
      "service": "MpService",
      "method": "ListAccounts"
    },
    {
      "service": "MpService",
      "method": "ListFans"
    },
    {
      "service": "MpService",
      "method": "SendMessage"
    }
  ],
  "actions": [
    "mp.ping",
    "mp.listAccounts",
    "mp.listFans",
    "mp.sendMessage"
  ],
  "permissions": [
    "mp:account:view",
    "mp:fan:view",
    "mp:message:send",
    "mp:mp-account:create",
    "mp:mp-account:delete",
    "mp:mp-account:query",
    "mp:mp-account:update",
    "mp:mp-auto-reply:create",
    "mp:mp-auto-reply:delete",
    "mp:mp-auto-reply:query",
    "mp:mp-auto-reply:update",
    "mp:mp-material:create",
    "mp:mp-material:delete",
    "mp:mp-material:query",
    "mp:mp-material:update",
    "mp:mp-menu:create",
    "mp:mp-menu:delete",
    "mp:mp-menu:query",
    "mp:mp-menu:update",
    "mp:mp-message-template:create",
    "mp:mp-message-template:delete",
    "mp:mp-message-template:query",
    "mp:mp-message-template:update",
    "mp:mp-message:create",
    "mp:mp-message:delete",
    "mp:mp-message:query",
    "mp:mp-message:update",
    "mp:mp-tag:create",
    "mp:mp-tag:delete",
    "mp:mp-tag:query",
    "mp:mp-tag:update",
    "mp:mp-user:create",
    "mp:mp-user:delete",
    "mp:mp-user:query",
    "mp:mp-user:update"
  ],
  "dependsOn": [
    "shared"
  ],
  "pack": {
    "enabled": true,
    "kind": "api-only",
    "independentDatabase": false
  }
}
