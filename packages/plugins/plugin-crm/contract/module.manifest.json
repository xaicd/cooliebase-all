{
  "$schema": "cooliebase-module-manifest/v1",
  "domain": "crm",
  "id": "cooliebase.crm",
  "apiVersion": 1,
  "displayName": "客户中心",
  "kind": "plugin",
  "stage": "B",
  "owner": "crm",
  "contractVersion": "v1",
  "implementation": "local-ts",
  "minimumHostVersion": "1.0.0",
  "capabilities": [
    "api.routes.register",
    "facade.invoke",
    "rpc.serve",
    "cmd.dispatch",
    "pack.independent"
  ],
  "entrypoints": {
    "facade": [
      "packages/plugins/plugin-crm/contract/crm.facade.ts"
    ],
    "proto": "packages/plugins/plugin-crm/contract/crm.proto",
    "actions": "packages/plugins/plugin-crm/contract/actions.ts"
  },
  "apiRoutes": {
    "publicPrefix": [
      "/api/v1/admin/crm"
    ],
    "adminPrefix": "/api/v1/admin/crm"
  },
  "auth": {
    "audience": "admin",
    "tenantPolicy": "required"
  },
  "messaging": {
    "queueGroup": "cooliebase.crm",
    "commandSubject": "cooliebase.cmd.crm.>",
    "eventSubject": "cooliebase.evt.crm.>"
  },
  "invoke": {
    "colocated": "sdk",
    "remote": "rpc",
    "protocol": "nats-rr",
    "serialization": "json"
  },
  "upstream": {
    "env": "COOLIEBASE_DOMAIN_CRM_UPSTREAM",
    "protocol": "http",
    "defaultPort": 3219
  },
  "resilience": {
    "timeoutMs": 5000,
    "retry": {
      "maxAttempts": 1,
      "safeMethodsOnly": true
    },
    "idempotencyRequired": true
  },
  "facadeMethods": [
    "ping",
    "listCustomers",
    "listClues",
    "createFollowup"
  ],
  "rpc": [
    {
      "service": "CrmService",
      "method": "Ping"
    },
    {
      "service": "CrmService",
      "method": "ListCustomers"
    },
    {
      "service": "CrmService",
      "method": "ListClues"
    },
    {
      "service": "CrmService",
      "method": "CreateFollowup"
    }
  ],
  "actions": [
    "crm.ping",
    "crm.listCustomers",
    "crm.listClues",
    "crm.createFollowup"
  ],
  "permissions": [
    "crm:clue:view",
    "crm:crm-business-product:create",
    "crm:crm-business-product:delete",
    "crm:crm-business-product:query",
    "crm:crm-business-product:update",
    "crm:crm-business-status-type:create",
    "crm:crm-business-status-type:delete",
    "crm:crm-business-status-type:query",
    "crm:crm-business-status-type:update",
    "crm:crm-business-status:create",
    "crm:crm-business-status:delete",
    "crm:crm-business-status:query",
    "crm:crm-business-status:update",
    "crm:crm-business:create",
    "crm:crm-business:delete",
    "crm:crm-business:query",
    "crm:crm-business:update",
    "crm:crm-clue:create",
    "crm:crm-clue:delete",
    "crm:crm-clue:query",
    "crm:crm-clue:update",
    "crm:crm-contact-business:create",
    "crm:crm-contact-business:delete",
    "crm:crm-contact-business:query",
    "crm:crm-contact-business:update",
    "crm:crm-contact:create",
    "crm:crm-contact:delete",
    "crm:crm-contact:query",
    "crm:crm-contact:update",
    "crm:crm-contract-config:create",
    "crm:crm-contract-config:delete",
    "crm:crm-contract-config:query",
    "crm:crm-contract-config:update",
    "crm:crm-contract-product:create",
    "crm:crm-contract-product:delete",
    "crm:crm-contract-product:query",
    "crm:crm-contract-product:update",
    "crm:crm-contract:create",
    "crm:crm-contract:delete",
    "crm:crm-contract:query",
    "crm:crm-contract:update",
    "crm:crm-customer-limit-config:create",
    "crm:crm-customer-limit-config:delete",
    "crm:crm-customer-limit-config:query",
    "crm:crm-customer-limit-config:update",
    "crm:crm-customer-pool-config:create",
    "crm:crm-customer-pool-config:delete",
    "crm:crm-customer-pool-config:query",
    "crm:crm-customer-pool-config:update",
    "crm:crm-customer:create",
    "crm:crm-customer:delete",
    "crm:crm-customer:query",
    "crm:crm-customer:update",
    "crm:crm-follow-up-record:create",
    "crm:crm-follow-up-record:delete",
    "crm:crm-follow-up-record:query",
    "crm:crm-follow-up-record:update",
    "crm:crm-owner-record:create",
    "crm:crm-owner-record:delete",
    "crm:crm-owner-record:query",
    "crm:crm-owner-record:update",
    "crm:crm-performance-config:create",
    "crm:crm-performance-config:delete",
    "crm:crm-performance-config:query",
    "crm:crm-performance-config:update",
    "crm:crm-permission:create",
    "crm:crm-permission:delete",
    "crm:crm-permission:query",
    "crm:crm-permission:update",
    "crm:crm-product-category:create",
    "crm:crm-product-category:delete",
    "crm:crm-product-category:query",
    "crm:crm-product-category:update",
    "crm:crm-product:create",
    "crm:crm-product:delete",
    "crm:crm-product:query",
    "crm:crm-product:update",
    "crm:crm-receivable-plan:create",
    "crm:crm-receivable-plan:delete",
    "crm:crm-receivable-plan:query",
    "crm:crm-receivable-plan:update",
    "crm:crm-receivable:create",
    "crm:crm-receivable:delete",
    "crm:crm-receivable:query",
    "crm:crm-receivable:update",
    "crm:customer:view",
    "crm:followup:create"
  ],
  "dependsOn": [
    "shared"
  ],
  "pack": {
    "enabled": true,
    "kind": "api-only",
    "independentDatabase": false
  }
}
