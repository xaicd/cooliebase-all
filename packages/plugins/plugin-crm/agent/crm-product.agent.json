{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "crm",
  "entity": "CrmProduct",
  "kebab": "crm-product",
  "businessName": "CRM 产品",
  "permissionPrefix": "crm:crm_product",
  "page": {
    "route": "/admin/crm/crm-product",
    "title": "CRM 产品管理",
    "titleSelector": "[data-testid=\"crm-product-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.crm/api",
    "bffMount": "/api/v1/admin/crm",
    "resource": "crm-product",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/crm-product",
        "query": [
          "page",
          "pageSize",
          "name",
          "no",
          "status",
          "category_id",
          "owner_user_id"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/crm-product/:id"
      },
      "create": {
        "http": "POST",
        "path": "/crm-product"
      },
      "update": {
        "http": "PUT",
        "path": "/crm-product/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/crm-product/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"crm-product-title\"]",
    "refresh": "[data-testid=\"crm-product-refresh\"]",
    "createButton": "[data-testid=\"crm-product-create\"]",
    "searchForm": "[data-testid=\"crm-product-search\"]",
    "searchSubmit": "[data-testid=\"crm-product-search-submit\"]",
    "searchReset": "[data-testid=\"crm-product-search-reset\"]",
    "total": "[data-testid=\"crm-product-total\"]",
    "table": "[data-testid=\"crm-product-table\"]",
    "row": "[data-testid=\"crm-product-row\"]",
    "editButton": "[data-testid=\"crm-product-edit\"]",
    "deleteButton": "[data-testid=\"crm-product-delete\"]",
    "form": "[data-testid=\"crm-product-form\"]",
    "formError": "[data-testid=\"crm-product-form-error\"]",
    "formSubmit": "[data-testid=\"crm-product-form-submit\"]",
    "formCancel": "[data-testid=\"crm-product-form-cancel\"]",
    "formClose": "[data-testid=\"crm-product-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "CRM 产品列表",
    "dialogLabel": {
      "create": "新增CRM 产品",
      "edit": "编辑CRM 产品"
    },
    "searchFields": [
      {
        "name": "name",
        "label": "产品名称",
        "testId": "search-name",
        "selector": "[data-testid=\"search-name\"]"
      },
      {
        "name": "no",
        "label": "产品编码",
        "testId": "search-no",
        "selector": "[data-testid=\"search-no\"]"
      },
      {
        "name": "status",
        "label": "状态",
        "testId": "search-status",
        "selector": "[data-testid=\"search-status\"]"
      },
      {
        "name": "category_id",
        "label": "产品分类 ID",
        "testId": "search-category_id",
        "selector": "[data-testid=\"search-category_id\"]"
      },
      {
        "name": "owner_user_id",
        "label": "负责人的用户编号",
        "testId": "search-owner_user_id",
        "selector": "[data-testid=\"search-owner_user_id\"]"
      }
    ],
    "fields": [
      {
        "name": "name",
        "label": "产品名称",
        "type": "string",
        "required": false,
        "testId": "field-name",
        "selector": "[data-testid=\"field-name\"]"
      },
      {
        "name": "no",
        "label": "产品编码",
        "type": "string",
        "required": false,
        "testId": "field-no",
        "selector": "[data-testid=\"field-no\"]"
      },
      {
        "name": "unit",
        "label": "单位",
        "type": "number",
        "required": true,
        "testId": "field-unit",
        "selector": "[data-testid=\"field-unit\"]"
      },
      {
        "name": "price",
        "label": "价格，单位：元",
        "type": "number",
        "required": false,
        "testId": "field-price",
        "selector": "[data-testid=\"field-price\"]"
      },
      {
        "name": "status",
        "label": "状态",
        "type": "number",
        "required": false,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      },
      {
        "name": "category_id",
        "label": "产品分类 ID",
        "type": "string",
        "required": false,
        "testId": "field-category_id",
        "selector": "[data-testid=\"field-category_id\"]"
      },
      {
        "name": "description",
        "label": "产品描述",
        "type": "string",
        "required": false,
        "testId": "field-description",
        "selector": "[data-testid=\"field-description\"]"
      },
      {
        "name": "owner_user_id",
        "label": "负责人的用户编号",
        "type": "string",
        "required": false,
        "testId": "field-owner_user_id",
        "selector": "[data-testid=\"field-owner_user_id\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "crm-product",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"crm-product\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"crm-product-form-overlay\"]",
      "dialog": "[data-testid=\"crm-product-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "crm-product:search",
      "reset": "crm-product:reset",
      "refresh": "crm-product:refresh",
      "create": "crm-product:create",
      "edit": "crm-product:edit",
      "delete": "crm-product:delete",
      "submit": "crm-product:submit",
      "cancel": "crm-product:cancel",
      "close": "crm-product:close",
      "row": "crm-product:row",
      "pagination": "crm-product:pagination",
      "fields": {
        "name": "crm-product:field:name",
        "no": "crm-product:field:no",
        "unit": "crm-product:field:unit",
        "price": "crm-product:field:price",
        "status": "crm-product:field:status",
        "category_id": "crm-product:field:category_id",
        "description": "crm-product:field:description",
        "owner_user_id": "crm-product:field:owner_user_id"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "crm.crm-product",
      "examples": [
        "crm.crm-product__List__Refresh",
        "crm.crm-product__ListItem__Open",
        "crm.crm-product__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
