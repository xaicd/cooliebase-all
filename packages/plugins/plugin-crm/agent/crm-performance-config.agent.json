      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "crm-performance-config",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"crm-performance-config\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"crm-performance-config-form-overlay\"]",
      "dialog": "[data-testid=\"crm-performance-config-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "crm-performance-config:search",
      "reset": "crm-performance-config:reset",
      "refresh": "crm-performance-config:refresh",
      "create": "crm-performance-config:create",
      "edit": "crm-performance-config:edit",
      "delete": "crm-performance-config:delete",
      "submit": "crm-performance-config:submit",
      "cancel": "crm-performance-config:cancel",
      "close": "crm-performance-config:close",
      "row": "crm-performance-config:row",
      "pagination": "crm-performance-config:pagination",
      "fields": {
        "biz_type": "crm-performance-config:field:biz_type",
        "object_id": "crm-performance-config:field:object_id",
        "object_type": "crm-performance-config:field:object_type",
        "year": "crm-performance-config:field:year",
        "year_target_price": "crm-performance-config:field:year_target_price",
        "january_target_price": "crm-performance-config:field:january_target_price",
        "february_target_price": "crm-performance-config:field:february_target_price",
        "march_target_price": "crm-performance-config:field:march_target_price",
        "april_target_price": "crm-performance-config:field:april_target_price",
        "may_target_price": "crm-performance-config:field:may_target_price",
        "june_target_price": "crm-performance-config:field:june_target_price",
        "july_target_price": "crm-performance-config:field:july_target_price",
        "august_target_price": "crm-performance-config:field:august_target_price",
        "september_target_price": "crm-performance-config:field:september_target_price",
        "october_target_price": "crm-performance-config:field:october_target_price",
        "november_target_price": "crm-performance-config:field:november_target_price",
        "december_target_price": "crm-performance-config:field:december_target_price"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "crm.crm-performance-config",
      "examples": [
        "crm.crm-performance-config__List__Refresh",
        "crm.crm-performance-config__ListItem__Open",
        "crm.crm-performance-config__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
