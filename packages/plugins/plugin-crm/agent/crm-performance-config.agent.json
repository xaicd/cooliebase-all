{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "crm",
  "entity": "CrmPerformanceConfig",
  "kebab": "crm-performance-config",
  "businessName": "CRM 业绩目标",
  "permissionPrefix": "crm:crm_performance_config",
  "page": {
    "route": "/admin/crm/crm-performance-config",
    "title": "CRM 业绩目标管理",
    "titleSelector": "[data-testid=\"crm-performance-config-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.crm/api",
    "bffMount": "/api/v1/admin/crm",
    "resource": "crm-performance-config",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/crm-performance-config",
        "query": [
          "page",
          "pageSize",
          "biz_type",
          "object_id"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/crm-performance-config/:id"
      },
      "create": {
        "http": "POST",
        "path": "/crm-performance-config"
      },
      "update": {
        "http": "PUT",
        "path": "/crm-performance-config/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/crm-performance-config/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"crm-performance-config-title\"]",
    "refresh": "[data-testid=\"crm-performance-config-refresh\"]",
    "createButton": "[data-testid=\"crm-performance-config-create\"]",
    "searchForm": "[data-testid=\"crm-performance-config-search\"]",
    "searchSubmit": "[data-testid=\"crm-performance-config-search-submit\"]",
    "searchReset": "[data-testid=\"crm-performance-config-search-reset\"]",
    "total": "[data-testid=\"crm-performance-config-total\"]",
    "table": "[data-testid=\"crm-performance-config-table\"]",
    "row": "[data-testid=\"crm-performance-config-row\"]",
    "editButton": "[data-testid=\"crm-performance-config-edit\"]",
    "deleteButton": "[data-testid=\"crm-performance-config-delete\"]",
    "form": "[data-testid=\"crm-performance-config-form\"]",
    "formError": "[data-testid=\"crm-performance-config-form-error\"]",
    "formSubmit": "[data-testid=\"crm-performance-config-form-submit\"]",
    "formCancel": "[data-testid=\"crm-performance-config-form-cancel\"]",
    "formClose": "[data-testid=\"crm-performance-config-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "CRM 业绩目标列表",
    "dialogLabel": {
      "create": "新增CRM 业绩目标",
      "edit": "编辑CRM 业绩目标"
    },
    "searchFields": [
      {
        "name": "biz_type",
        "label": "目标类型",
        "testId": "search-biz_type",
        "selector": "[data-testid=\"search-biz_type\"]"
      },
      {
        "name": "object_id",
        "label": "目标对象编号",
        "testId": "search-object_id",
        "selector": "[data-testid=\"search-object_id\"]"
      }
    ],
    "fields": [
      {
        "name": "biz_type",
        "label": "目标类型",
        "type": "number",
        "required": false,
        "testId": "field-biz_type",
        "selector": "[data-testid=\"field-biz_type\"]"
      },
      {
        "name": "object_id",
        "label": "目标对象编号",
        "type": "string",
        "required": false,
        "testId": "field-object_id",
        "selector": "[data-testid=\"field-object_id\"]"
      },
      {
        "name": "object_type",
        "label": "目标对象类型",
        "type": "number",
        "required": false,
        "testId": "field-object_type",
        "selector": "[data-testid=\"field-object_type\"]"
      },
      {
        "name": "year",
        "label": "年份",
        "type": "number",
        "required": false,
        "testId": "field-year",
        "selector": "[data-testid=\"field-year\"]"
      },
      {
        "name": "year_target_price",
        "label": "年度目标金额",
        "type": "number",
        "required": false,
