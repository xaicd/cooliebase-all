{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "crm",
  "entity": "CrmBusinessStatusType",
  "kebab": "crm-business-status-type",
  "businessName": "CRM 商机状态组 DO注意，它是个配置表",
  "permissionPrefix": "crm:crm_business_status_type",
  "page": {
    "route": "/admin/crm/crm-business-status-type",
    "title": "CRM 商机状态组 DO注意，它是个配置表管理",
    "titleSelector": "[data-testid=\"crm-business-status-type-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.crm/api",
    "bffMount": "/api/v1/admin/crm",
    "resource": "crm-business-status-type",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/crm-business-status-type",
        "query": [
          "page",
          "pageSize",
          "name",
          "dept_ids"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/crm-business-status-type/:id"
      },
      "create": {
        "http": "POST",
        "path": "/crm-business-status-type"
      },
      "update": {
        "http": "PUT",
        "path": "/crm-business-status-type/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/crm-business-status-type/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"crm-business-status-type-title\"]",
    "refresh": "[data-testid=\"crm-business-status-type-refresh\"]",
    "createButton": "[data-testid=\"crm-business-status-type-create\"]",
    "searchForm": "[data-testid=\"crm-business-status-type-search\"]",
    "searchSubmit": "[data-testid=\"crm-business-status-type-search-submit\"]",
    "searchReset": "[data-testid=\"crm-business-status-type-search-reset\"]",
    "total": "[data-testid=\"crm-business-status-type-total\"]",
    "table": "[data-testid=\"crm-business-status-type-table\"]",
    "row": "[data-testid=\"crm-business-status-type-row\"]",
    "editButton": "[data-testid=\"crm-business-status-type-edit\"]",
    "deleteButton": "[data-testid=\"crm-business-status-type-delete\"]",
    "form": "[data-testid=\"crm-business-status-type-form\"]",
    "formError": "[data-testid=\"crm-business-status-type-form-error\"]",
    "formSubmit": "[data-testid=\"crm-business-status-type-form-submit\"]",
    "formCancel": "[data-testid=\"crm-business-status-type-form-cancel\"]",
    "formClose": "[data-testid=\"crm-business-status-type-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "CRM 商机状态组 DO注意，它是个配置表列表",
    "dialogLabel": {
      "create": "新增CRM 商机状态组 DO注意，它是个配置表",
      "edit": "编辑CRM 商机状态组 DO注意，它是个配置表"
    },
    "searchFields": [
      {
        "name": "name",
        "label": "状态类型名",
        "testId": "search-name",
        "selector": "[data-testid=\"search-name\"]"
      },
      {
        "name": "dept_ids",
        "label": "使用的部门编号",
        "testId": "search-dept_ids",
        "selector": "[data-testid=\"search-dept_ids\"]"
      }
    ],
    "fields": [
      {
        "name": "name",
        "label": "状态类型名",
        "type": "string",
        "required": false,
        "testId": "field-name",
        "selector": "[data-testid=\"field-name\"]"
      },
      {
        "name": "dept_ids",
        "label": "使用的部门编号",
        "type": "string",
        "required": false,
        "testId": "field-dept_ids",
        "selector": "[data-testid=\"field-dept_ids\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "crm-business-status-type",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"crm-business-status-type\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"crm-business-status-type-form-overlay\"]",
      "dialog": "[data-testid=\"crm-business-status-type-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "crm-business-status-type:search",
      "reset": "crm-business-status-type:reset",
      "refresh": "crm-business-status-type:refresh",
      "create": "crm-business-status-type:create",
      "edit": "crm-business-status-type:edit",
      "delete": "crm-business-status-type:delete",
      "submit": "crm-business-status-type:submit",
      "cancel": "crm-business-status-type:cancel",
      "close": "crm-business-status-type:close",
      "row": "crm-business-status-type:row",
      "pagination": "crm-business-status-type:pagination",
      "fields": {
        "name": "crm-business-status-type:field:name",
        "dept_ids": "crm-business-status-type:field:dept_ids"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "crm.crm-business-status-type",
      "examples": [
        "crm.crm-business-status-type__List__Refresh",
        "crm.crm-business-status-type__ListItem__Open",
        "crm.crm-business-status-type__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
