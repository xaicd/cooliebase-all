{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "iot",
  "entity": "IotDataRule",
  "kebab": "iot-data-rule",
  "businessName": "IoT 数据流转规则 DO监听 数据源，转发到 数据目的",
  "permissionPrefix": "iot:iot_data_rule",
  "page": {
    "route": "/admin/iot/iot-data-rule",
    "title": "IoT 数据流转规则 DO监听 数据源，转发到 数据目的管理",
    "titleSelector": "[data-testid=\"iot-data-rule-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.iot/api",
    "bffMount": "/api/v1/admin/iot",
    "resource": "iot-data-rule",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/iot-data-rule",
        "query": [
          "page",
          "pageSize",
          "name",
          "status",
          "sink_ids",
          "product_id",
          "device_id"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/iot-data-rule/:id"
      },
      "create": {
        "http": "POST",
        "path": "/iot-data-rule"
      },
      "update": {
        "http": "PUT",
        "path": "/iot-data-rule/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/iot-data-rule/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"iot-data-rule-title\"]",
    "refresh": "[data-testid=\"iot-data-rule-refresh\"]",
    "createButton": "[data-testid=\"iot-data-rule-create\"]",
    "searchForm": "[data-testid=\"iot-data-rule-search\"]",
    "searchSubmit": "[data-testid=\"iot-data-rule-search-submit\"]",
    "searchReset": "[data-testid=\"iot-data-rule-search-reset\"]",
    "total": "[data-testid=\"iot-data-rule-total\"]",
    "table": "[data-testid=\"iot-data-rule-table\"]",
    "row": "[data-testid=\"iot-data-rule-row\"]",
    "editButton": "[data-testid=\"iot-data-rule-edit\"]",
    "deleteButton": "[data-testid=\"iot-data-rule-delete\"]",
    "form": "[data-testid=\"iot-data-rule-form\"]",
    "formError": "[data-testid=\"iot-data-rule-form-error\"]",
    "formSubmit": "[data-testid=\"iot-data-rule-form-submit\"]",
    "formCancel": "[data-testid=\"iot-data-rule-form-cancel\"]",
    "formClose": "[data-testid=\"iot-data-rule-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "IoT 数据流转规则 DO监听 数据源，转发到 数据目的列表",
    "dialogLabel": {
      "create": "新增IoT 数据流转规则 DO监听 数据源，转发到 数据目的",
      "edit": "编辑IoT 数据流转规则 DO监听 数据源，转发到 数据目的"
    },
    "searchFields": [
      {
        "name": "name",
        "label": "数据流转规格名称",
        "testId": "search-name",
        "selector": "[data-testid=\"search-name\"]"
      },
      {
        "name": "status",
        "label": "数据流转规格状态",
        "testId": "search-status",
        "selector": "[data-testid=\"search-status\"]"
      },
      {
        "name": "sink_ids",
        "label": "数据目的编号数组",
        "testId": "search-sink_ids",
        "selector": "[data-testid=\"search-sink_ids\"]"
      },
      {
        "name": "product_id",
        "label": "产品编号",
        "testId": "search-product_id",
        "selector": "[data-testid=\"search-product_id\"]"
      },
      {
        "name": "device_id",
        "label": "设备编号",
        "testId": "search-device_id",
        "selector": "[data-testid=\"search-device_id\"]"
      }
    ],
    "fields": [
      {
        "name": "name",
        "label": "数据流转规格名称",
        "type": "string",
        "required": false,
        "testId": "field-name",
        "selector": "[data-testid=\"field-name\"]"
      },
      {
        "name": "description",
        "label": "数据流转规格描述",
        "type": "string",
        "required": false,
        "testId": "field-description",
        "selector": "[data-testid=\"field-description\"]"
      },
      {
        "name": "status",
        "label": "数据流转规格状态",
        "type": "number",
        "required": false,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      },
      {
        "name": "source_configs",
        "label": "数据源配置数组",
        "type": "string",
        "required": false,
        "testId": "field-source_configs",
        "selector": "[data-testid=\"field-source_configs\"]"
      },
      {
        "name": "sink_ids",
        "label": "数据目的编号数组",
        "type": "string",
        "required": false,
        "testId": "field-sink_ids",
        "selector": "[data-testid=\"field-sink_ids\"]"
      },
      {
        "name": "method",
        "label": "消息方法",
        "type": "string",
        "required": false,
        "testId": "field-method",
        "selector": "[data-testid=\"field-method\"]"
      },
      {
        "name": "product_id",
        "label": "产品编号",
        "type": "string",
        "required": false,
        "testId": "field-product_id",
        "selector": "[data-testid=\"field-product_id\"]"
      },
      {
        "name": "device_id",
        "label": "设备编号",
        "type": "string",
        "required": false,
        "testId": "field-device_id",
        "selector": "[data-testid=\"field-device_id\"]"
      },
      {
        "name": "identifier",
        "label": "标识符",
        "type": "string",
        "required": false,
        "testId": "field-identifier",
        "selector": "[data-testid=\"field-identifier\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "iot-data-rule",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"iot-data-rule\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"iot-data-rule-form-overlay\"]",
      "dialog": "[data-testid=\"iot-data-rule-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "iot-data-rule:search",
      "reset": "iot-data-rule:reset",
      "refresh": "iot-data-rule:refresh",
      "create": "iot-data-rule:create",
      "edit": "iot-data-rule:edit",
      "delete": "iot-data-rule:delete",
      "submit": "iot-data-rule:submit",
      "cancel": "iot-data-rule:cancel",
      "close": "iot-data-rule:close",
      "row": "iot-data-rule:row",
      "pagination": "iot-data-rule:pagination",
      "fields": {
        "name": "iot-data-rule:field:name",
        "description": "iot-data-rule:field:description",
        "status": "iot-data-rule:field:status",
        "source_configs": "iot-data-rule:field:source_configs",
        "sink_ids": "iot-data-rule:field:sink_ids",
        "method": "iot-data-rule:field:method",
        "product_id": "iot-data-rule:field:product_id",
        "device_id": "iot-data-rule:field:device_id",
        "identifier": "iot-data-rule:field:identifier"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "iot.iot-data-rule",
      "examples": [
        "iot.iot-data-rule__List__Refresh",
        "iot.iot-data-rule__ListItem__Open",
        "iot.iot-data-rule__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
