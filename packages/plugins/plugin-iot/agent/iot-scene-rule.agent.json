{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "iot",
  "entity": "IotSceneRule",
  "kebab": "iot-scene-rule",
  "businessName": "IoT 场景联动规则",
  "permissionPrefix": "iot:iot_scene_rule",
  "page": {
    "route": "/admin/iot/iot-scene-rule",
    "title": "IoT 场景联动规则管理",
    "titleSelector": "[data-testid=\"iot-scene-rule-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.iot/api",
    "bffMount": "/api/v1/admin/iot",
    "resource": "iot-scene-rule",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/iot-scene-rule",
        "query": [
          "page",
          "pageSize",
          "name",
          "status",
          "type",
          "product_id",
          "device_id"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/iot-scene-rule/:id"
      },
      "create": {
        "http": "POST",
        "path": "/iot-scene-rule"
      },
      "update": {
        "http": "PUT",
        "path": "/iot-scene-rule/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/iot-scene-rule/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"iot-scene-rule-title\"]",
    "refresh": "[data-testid=\"iot-scene-rule-refresh\"]",
    "createButton": "[data-testid=\"iot-scene-rule-create\"]",
    "searchForm": "[data-testid=\"iot-scene-rule-search\"]",
    "searchSubmit": "[data-testid=\"iot-scene-rule-search-submit\"]",
    "searchReset": "[data-testid=\"iot-scene-rule-search-reset\"]",
    "total": "[data-testid=\"iot-scene-rule-total\"]",
    "table": "[data-testid=\"iot-scene-rule-table\"]",
    "row": "[data-testid=\"iot-scene-rule-row\"]",
    "editButton": "[data-testid=\"iot-scene-rule-edit\"]",
    "deleteButton": "[data-testid=\"iot-scene-rule-delete\"]",
    "form": "[data-testid=\"iot-scene-rule-form\"]",
    "formError": "[data-testid=\"iot-scene-rule-form-error\"]",
    "formSubmit": "[data-testid=\"iot-scene-rule-form-submit\"]",
    "formCancel": "[data-testid=\"iot-scene-rule-form-cancel\"]",
    "formClose": "[data-testid=\"iot-scene-rule-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "IoT 场景联动规则列表",
    "dialogLabel": {
      "create": "新增IoT 场景联动规则",
      "edit": "编辑IoT 场景联动规则"
    },
    "searchFields": [
      {
        "name": "name",
        "label": "场景联动名称",
        "testId": "search-name",
        "selector": "[data-testid=\"search-name\"]"
      },
      {
        "name": "status",
        "label": "场景联动状态",
        "testId": "search-status",
        "selector": "[data-testid=\"search-status\"]"
      },
      {
        "name": "type",
        "label": "场景事件类型",
        "testId": "search-type",
        "selector": "[data-testid=\"search-type\"]"
      },
      {
        "name": "product_id",
        "label": "产品编号",
        "testId": "search-product_id",
        "selector": "[data-testid=\"search-product_id\"]"
      },
      {
        "name": "device_id",
        "label": "设备编号",
        "testId": "search-device_id",
        "selector": "[data-testid=\"search-device_id\"]"
      }
    ],
    "fields": [
      {
        "name": "name",
        "label": "场景联动名称",
        "type": "string",
        "required": false,
        "testId": "field-name",
        "selector": "[data-testid=\"field-name\"]"
      },
      {
        "name": "description",
        "label": "场景联动描述",
        "type": "string",
        "required": false,
        "testId": "field-description",
        "selector": "[data-testid=\"field-description\"]"
      },
      {
        "name": "status",
        "label": "场景联动状态",
        "type": "number",
        "required": false,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      },
      {
        "name": "last_trigger_time",
        "label": "最后触发时间",
        "type": "string",
        "required": false,
        "testId": "field-last_trigger_time",
        "selector": "[data-testid=\"field-last_trigger_time\"]"
      },
      {
        "name": "triggers",
        "label": "场景定义配置",
        "type": "string",
        "required": false,
        "testId": "field-triggers",
        "selector": "[data-testid=\"field-triggers\"]"
      },
      {
        "name": "actions",
        "label": "场景动作配置",
        "type": "string",
        "required": false,
        "testId": "field-actions",
        "selector": "[data-testid=\"field-actions\"]"
      },
      {
        "name": "type",
        "label": "场景事件类型",
        "type": "number",
        "required": false,
        "testId": "field-type",
        "selector": "[data-testid=\"field-type\"]"
      },
      {
        "name": "product_id",
        "label": "产品编号",
        "type": "string",
        "required": false,
        "testId": "field-product_id",
        "selector": "[data-testid=\"field-product_id\"]"
      },
      {
        "name": "device_id",
        "label": "设备编号",
        "type": "string",
        "required": false,
        "testId": "field-device_id",
        "selector": "[data-testid=\"field-device_id\"]"
      },
      {
        "name": "identifier",
        "label": "物模型标识符",
        "type": "string",
        "required": false,
        "testId": "field-identifier",
        "selector": "[data-testid=\"field-identifier\"]"
      },
      {
        "name": "operator",
        "label": "操作符",
        "type": "string",
        "required": false,
        "testId": "field-operator",
        "selector": "[data-testid=\"field-operator\"]"
      },
      {
        "name": "value",
        "label": "参数（属性值、在线状态）",
        "type": "string",
        "required": false,
        "testId": "field-value",
        "selector": "[data-testid=\"field-value\"]"
      },
      {
        "name": "cron_expression",
        "label": "CRON 表达式",
        "type": "string",
        "required": false,
        "testId": "field-cron_expression",
        "selector": "[data-testid=\"field-cron_expression\"]"
      },
      {
        "name": "condition_groups",
        "label": "触发条件分组（状态条件分组）的数组",
        "type": "string",
        "required": false,
        "testId": "field-condition_groups",
        "selector": "[data-testid=\"field-condition_groups\"]"
      },
      {
        "name": "param",
        "label": "参数",
        "type": "string",
        "required": false,
        "testId": "field-param",
        "selector": "[data-testid=\"field-param\"]"
      },
      {
        "name": "params",
        "label": "请求参数",
        "type": "string",
        "required": false,
        "testId": "field-params",
        "selector": "[data-testid=\"field-params\"]"
      },
      {
        "name": "alert_config_id",
        "label": "告警配置编号",
        "type": "string",
        "required": false,
        "testId": "field-alert_config_id",
        "selector": "[data-testid=\"field-alert_config_id\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "iot-scene-rule",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"iot-scene-rule\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"iot-scene-rule-form-overlay\"]",
      "dialog": "[data-testid=\"iot-scene-rule-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "iot-scene-rule:search",
      "reset": "iot-scene-rule:reset",
      "refresh": "iot-scene-rule:refresh",
      "create": "iot-scene-rule:create",
      "edit": "iot-scene-rule:edit",
      "delete": "iot-scene-rule:delete",
      "submit": "iot-scene-rule:submit",
      "cancel": "iot-scene-rule:cancel",
      "close": "iot-scene-rule:close",
      "row": "iot-scene-rule:row",
      "pagination": "iot-scene-rule:pagination",
      "fields": {
        "name": "iot-scene-rule:field:name",
        "description": "iot-scene-rule:field:description",
        "status": "iot-scene-rule:field:status",
        "last_trigger_time": "iot-scene-rule:field:last_trigger_time",
        "triggers": "iot-scene-rule:field:triggers",
        "actions": "iot-scene-rule:field:actions",
        "type": "iot-scene-rule:field:type",
        "product_id": "iot-scene-rule:field:product_id",
        "device_id": "iot-scene-rule:field:device_id",
        "identifier": "iot-scene-rule:field:identifier",
        "operator": "iot-scene-rule:field:operator",
        "value": "iot-scene-rule:field:value",
        "cron_expression": "iot-scene-rule:field:cron_expression",
        "condition_groups": "iot-scene-rule:field:condition_groups",
        "param": "iot-scene-rule:field:param",
        "params": "iot-scene-rule:field:params",
        "alert_config_id": "iot-scene-rule:field:alert_config_id"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "iot.iot-scene-rule",
      "examples": [
        "iot.iot-scene-rule__List__Refresh",
        "iot.iot-scene-rule__ListItem__Open",
        "iot.iot-scene-rule__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
