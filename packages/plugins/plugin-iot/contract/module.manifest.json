{
  "$schema": "cooliebase-module-manifest/v1",
  "domain": "iot",
  "id": "cooliebase.iot",
  "apiVersion": 1,
  "displayName": "物联中台",
  "kind": "plugin",
  "stage": "B",
  "owner": "iot",
  "contractVersion": "v1",
  "implementation": "local-ts",
  "minimumHostVersion": "1.0.0",
  "capabilities": [
    "api.routes.register",
    "facade.invoke",
    "rpc.serve",
    "cmd.dispatch",
    "pack.independent"
  ],
  "entrypoints": {
    "facade": [
      "packages/plugins/plugin-iot/contract/iot.facade.ts"
    ],
    "proto": "packages/plugins/plugin-iot/contract/iot.proto",
    "actions": "packages/plugins/plugin-iot/contract/actions.ts"
  },
  "apiRoutes": {
    "publicPrefix": [
      "/api/v1/admin/iot"
    ],
    "adminPrefix": "/api/v1/admin/iot"
  },
  "auth": {
    "audience": "admin",
    "tenantPolicy": "required"
  },
  "messaging": {
    "queueGroup": "cooliebase.iot",
    "commandSubject": "cooliebase.cmd.iot.>",
    "eventSubject": "cooliebase.evt.iot.>"
  },
  "invoke": {
    "colocated": "sdk",
    "remote": "rpc",
    "protocol": "nats-rr",
    "serialization": "json"
  },
  "upstream": {
    "env": "COOLIEBASE_DOMAIN_IOT_UPSTREAM",
    "protocol": "http",
    "defaultPort": 3224
  },
  "resilience": {
    "timeoutMs": 5000,
    "retry": {
      "maxAttempts": 1,
      "safeMethodsOnly": true
    },
    "idempotencyRequired": true
  },
  "facadeMethods": [
    "ping",
    "listDevices",
    "createDevice",
    "listAlerts",
    "handleAlert"
  ],
  "rpc": [
    {
      "service": "IotService",
      "method": "Ping"
    },
    {
      "service": "IotService",
      "method": "ListDevices"
    },
    {
      "service": "IotService",
      "method": "CreateDevice"
    },
    {
      "service": "IotService",
      "method": "ListAlerts"
    },
    {
      "service": "IotService",
      "method": "HandleAlert"
    }
  ],
  "actions": [
    "iot.ping",
    "iot.listDevices",
    "iot.createDevice",
    "iot.listAlerts",
    "iot.handleAlert"
  ],
  "permissions": [
    "iot:alert:view",
    "iot:device:view",
    "iot:iot-alert-config:create",
    "iot:iot-alert-config:delete",
    "iot:iot-alert-config:query",
    "iot:iot-alert-config:update",
    "iot:iot-alert-record:create",
    "iot:iot-alert-record:delete",
    "iot:iot-alert-record:query",
    "iot:iot-alert-record:update",
    "iot:iot-data-rule:create",
    "iot:iot-data-rule:delete",
    "iot:iot-data-rule:query",
    "iot:iot-data-rule:update",
    "iot:iot-data-sink:create",
    "iot:iot-data-sink:delete",
    "iot:iot-data-sink:query",
    "iot:iot-data-sink:update",
    "iot:iot-device-group:create",
    "iot:iot-device-group:delete",
    "iot:iot-device-group:query",
    "iot:iot-device-group:update",
    "iot:iot-device-modbus-config:create",
    "iot:iot-device-modbus-config:delete",
    "iot:iot-device-modbus-config:query",
    "iot:iot-device-modbus-config:update",
    "iot:iot-device-modbus-point:create",
    "iot:iot-device-modbus-point:delete",
    "iot:iot-device-modbus-point:query",
    "iot:iot-device-modbus-point:update",
    "iot:iot-device:create",
    "iot:iot-device:delete",
    "iot:iot-device:query",
    "iot:iot-device:update",
    "iot:iot-ota-firmware:create",
    "iot:iot-ota-firmware:delete",
    "iot:iot-ota-firmware:query",
    "iot:iot-ota-firmware:update",
    "iot:iot-ota-task-record:create",
    "iot:iot-ota-task-record:delete",
    "iot:iot-ota-task-record:query",
    "iot:iot-ota-task-record:update",
    "iot:iot-ota-task:create",
    "iot:iot-ota-task:delete",
    "iot:iot-ota-task:query",
    "iot:iot-ota-task:update",
    "iot:iot-product-category:create",
    "iot:iot-product-category:delete",
    "iot:iot-product-category:query",
    "iot:iot-product-category:update",
    "iot:iot-product:create",
    "iot:iot-product:delete",
    "iot:iot-product:query",
    "iot:iot-product:update",
    "iot:iot-scene-rule:create",
    "iot:iot-scene-rule:delete",
    "iot:iot-scene-rule:query",
    "iot:iot-scene-rule:update",
    "iot:iot-thing-model:create",
    "iot:iot-thing-model:delete",
    "iot:iot-thing-model:query",
    "iot:iot-thing-model:update"
  ],
  "dependsOn": [
    "shared"
  ],
  "pack": {
    "enabled": true,
    "kind": "api-only",
    "independentDatabase": false
  }
}
