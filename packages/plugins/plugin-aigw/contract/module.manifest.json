{
  "$schema": "cooliebase-module-manifest/v1",
  "domain": "aigw",
  "id": "cooliebase.aigw",
  "apiVersion": 1,
  "displayName": "aigw",
  "kind": "plugin",
  "stage": "B",
  "owner": "aigw",
  "contractVersion": "v1",
  "implementation": "local-ts",
  "minimumHostVersion": "1.0.0",
  "capabilities": [
    "api.routes.register",
    "facade.invoke",
    "rpc.serve",
    "cmd.dispatch",
    "pack.independent"
  ],
  "entrypoints": {
    "facade": [
      "packages/plugins/plugin-aigw/contract/aigw.facade.ts"
    ],
    "proto": "packages/plugins/plugin-aigw/contract/aigw.proto",
    "actions": "packages/plugins/plugin-aigw/contract/actions.ts"
  },
  "apiRoutes": {
    "publicPrefix": [
      "/api/v1/admin/aigw",
      "/api/v1/open/aigw"
    ],
    "adminPrefix": "/api/v1/admin/aigw"
  },
  "auth": {
    "audience": "admin",
    "tenantPolicy": "required"
  },
  "messaging": {
    "queueGroup": "cooliebase.aigw",
    "commandSubject": "cooliebase.cmd.aigw.>",
    "eventSubject": "cooliebase.evt.aigw.>"
  },
  "invoke": {
    "colocated": "sdk",
    "remote": "rpc",
    "protocol": "nats-rr",
    "serialization": "json"
  },
  "upstream": {
    "env": "RUOYI_DOMAIN_AIGW_UPSTREAM",
    "protocol": "http",
    "defaultPort": 3226
  },
  "resilience": {
    "timeoutMs": 15000,
    "retry": {
      "maxAttempts": 1,
      "safeMethodsOnly": true
    },
    "idempotencyRequired": true
  },
  "facadeMethods": [
    "ping",
    "listChannels",
    "createChannel",
    "listTokens",
    "createToken",
    "listModels",
    "relayChat",
    "listPublicModels",
    "embed"
  ],
  "rpc": [
    {
      "service": "AigwService",
      "method": "Ping"
    },
    {
      "service": "AigwService",
      "method": "ListChannels"
    },
    {
      "service": "AigwService",
      "method": "CreateChannel"
    },
    {
      "service": "AigwService",
      "method": "ListTokens"
    },
    {
      "service": "AigwService",
      "method": "CreateToken"
    },
    {
      "service": "AigwService",
      "method": "ListModels"
    },
    {
      "service": "AigwService",
      "method": "RelayChat"
    },
    {
      "service": "AigwService",
      "method": "ListPublicModels"
    },
    {
      "service": "AigwService",
      "method": "Embed"
    }
  ],
  "actions": [
    "aigw.ping",
    "aigw.listChannels",
    "aigw.createChannel",
    "aigw.listTokens",
    "aigw.createToken",
    "aigw.listModels",
    "aigw.relayChat",
    "aigw.listPublicModels",
    "aigw.embed"
  ],
  "permissions": [
    "aigw:channel:create",
    "aigw:channel:delete",
    "aigw:channel:update",
    "aigw:channel:view",
    "aigw:model:create",
    "aigw:model:delete",
    "aigw:model:update",
    "aigw:model:view",
    "aigw:playground:view",
    "aigw:token:create",
    "aigw:token:delete",
    "aigw:token:update",
    "aigw:token:view",
    "aigw:usage:view"
  ],
  "dependsOn": [
    "shared"
  ],
  "pack": {
    "enabled": true,
    "kind": "api-only",
    "independentDatabase": false
  }
}
