{
  "$schema": "cooliebase-plugin-manifest/v1",
  "id": "cooliebase.aigw",
  "apiVersion": 1,
  "version": "0.1.0",
  "displayName": "aigw",
  "description": "aigw 域（由 scripts/scaffold-domain-plugin.cjs 生成的第一方插件声明）",
  "author": "CoolieBase All Base",
  "categories": [
    "automation"
  ],
  "capabilities": [
    "api.routes.register"
  ],
  "entrypoints": {
    "merged": "./plugin-entry.ts"
  },
  "domain": {
    "kind": "plugin",
    "stage": "B",
    "contractVersion": "v1",
    "publicPrefixes": [
      "/api/v1/admin/aigw",
      "/api/v1/open/aigw"
    ],
    "upstreamEnv": "COOLIEBASE_DOMAIN_AIGW_UPSTREAM",
    "defaultPort": 3226,
    "packable": true,
    "independentDatabase": false,
    "dependsOnModules": [
      "shared"
    ],
    "auth": {
      "audience": "admin",
      "tenantPolicy": "required"
    },
    "resilience": {
      "timeoutMs": 15000,
      "retryMaxAttempts": 1,
      "safeMethodsOnly": true,
      "idempotencyRequired": true
    }
  },
  "apiRoutes": [
    {
      "routeKey": "admin:channels:delete",
      "method": "DELETE",
      "path": "/channels",
      "auth": "operator"
    },
    {
      "routeKey": "admin:channels:get",
      "method": "GET",
      "path": "/channels",
      "auth": "operator"
    },
    {
      "routeKey": "admin:channels:post",
      "method": "POST",
      "path": "/channels",
      "auth": "operator"
    },
    {
      "routeKey": "admin:channels:put",
      "method": "PUT",
      "path": "/channels",
      "auth": "operator"
    },
    {
      "routeKey": "admin:models:delete",
      "method": "DELETE",
      "path": "/models",
      "auth": "operator"
    },
    {
      "routeKey": "admin:models:get",
      "method": "GET",
      "path": "/models",
      "auth": "operator"
    },
    {
      "routeKey": "admin:models:post",
      "method": "POST",
      "path": "/models",
      "auth": "operator"
    },
    {
      "routeKey": "admin:models:put",
      "method": "PUT",
      "path": "/models",
      "auth": "operator"
    },
    {
      "routeKey": "admin:tokens:delete",
      "method": "DELETE",
      "path": "/tokens",
      "auth": "operator"
    },
    {
      "routeKey": "admin:tokens:get",
      "method": "GET",
      "path": "/tokens",
      "auth": "operator"
    },
    {
      "routeKey": "admin:tokens:post",
      "method": "POST",
      "path": "/tokens",
      "auth": "operator"
    },
    {
      "routeKey": "admin:tokens:put",
      "method": "PUT",
      "path": "/tokens",
      "auth": "operator"
    },
    {
      "routeKey": "admin:usages:get",
      "method": "GET",
      "path": "/usages",
      "auth": "operator"
    },
    {
      "routeKey": "open:chat/completions:post",
      "method": "POST",
      "path": "/chat/completions",
      "auth": "public"
    },
    {
      "routeKey": "open:embeddings:post",
      "method": "POST",
      "path": "/embeddings",
      "auth": "public"
    },
    {
      "routeKey": "open:models:get",
      "method": "GET",
      "path": "/models",
      "auth": "public"
    },
    {
      "routeKey": "open:quota:get",
      "method": "GET",
      "path": "/quota",
      "auth": "public"
    }
  ]
}
