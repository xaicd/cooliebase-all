{
  "$schema": "cooliebase-module-manifest/v1",
  "domain": "member",
  "id": "cooliebase.member",
  "apiVersion": 1,
  "displayName": "会员中心",
  "kind": "plugin",
  "stage": "A",
  "owner": "member",
  "contractVersion": "v1",
  "implementation": "local-ts",
  "minimumHostVersion": "1.0.0",
  "capabilities": [
    "api.routes.register",
    "facade.invoke",
    "rpc.serve",
    "cmd.dispatch",
    "pack.independent"
  ],
  "entrypoints": {
    "facade": [
      "packages/plugins/plugin-member/contract/member.facade.ts"
    ],
    "proto": "packages/plugins/plugin-member/contract/member.proto",
    "actions": "packages/plugins/plugin-member/contract/actions.ts"
  },
  "apiRoutes": {
    "publicPrefix": [
      "/api/v1/admin/member",
      "/api/v1/app/member"
    ],
    "adminPrefix": "/api/v1/admin/member"
  },
  "auth": {
    "audience": "admin",
    "tenantPolicy": "required"
  },
  "messaging": {
    "queueGroup": "cooliebase.member",
    "commandSubject": "cooliebase.cmd.member.>",
    "eventSubject": "cooliebase.evt.member.>"
  },
  "invoke": {
    "colocated": "sdk",
    "remote": "rpc",
    "protocol": "nats-rr",
    "serialization": "json"
  },
  "upstream": {
    "env": "COOLIEBASE_DOMAIN_MEMBER_UPSTREAM",
    "protocol": "http",
    "defaultPort": 3218
  },
  "resilience": {
    "timeoutMs": 5000,
    "retry": {
      "maxAttempts": 1,
      "safeMethodsOnly": true
    },
    "idempotencyRequired": false
  },
  "facadeMethods": [
    "ping",
    "listUsers",
    "updateUser",
    "listLevels",
    "createLevel",
    "listPoints",
    "adjustPoint"
  ],
  "rpc": [
    {
      "service": "MemberService",
      "method": "Ping"
    },
    {
      "service": "MemberService",
      "method": "ListUsers"
    },
    {
      "service": "MemberService",
      "method": "UpdateUser"
    },
    {
      "service": "MemberService",
      "method": "ListLevels"
    },
    {
      "service": "MemberService",
      "method": "CreateLevel"
    },
    {
      "service": "MemberService",
      "method": "ListPoints"
    },
    {
      "service": "MemberService",
      "method": "AdjustPoint"
    }
  ],
  "actions": [
    "member.ping",
    "member.listUsers",
    "member.updateUser",
    "member.listLevels",
    "member.createLevel",
    "member.listPoints",
    "member.adjustPoint"
  ],
  "permissions": [
    "member:address:create",
    "member:address:delete",
    "member:address:query",
    "member:address:update",
    "member:config:create",
    "member:config:delete",
    "member:config:query",
    "member:config:update",
    "member:experience-record:create",
    "member:experience-record:delete",
    "member:experience-record:query",
    "member:experience-record:update",
    "member:group:create",
    "member:group:delete",
    "member:group:query",
    "member:group:update",
    "member:level-record:create",
    "member:level-record:delete",
    "member:level-record:query",
    "member:level-record:update",
    "member:level:create",
    "member:level:delete",
    "member:level:update",
    "member:level:view",
    "member:point-record:create",
    "member:point-record:delete",
    "member:point-record:query",
    "member:point-record:update",
    "member:point:adjust",
    "member:point:view",
    "member:sign-in-config:create",
    "member:sign-in-config:delete",
    "member:sign-in-config:query",
    "member:sign-in-config:update",
    "member:sign-in-record:create",
    "member:sign-in-record:delete",
    "member:sign-in-record:query",
    "member:sign-in-record:update",
    "member:tag:create",
    "member:tag:delete",
    "member:tag:query",
    "member:tag:update",
    "member:user:create",
    "member:user:delete",
    "member:user:update",
    "member:user:view"
  ],
  "dependsOn": [
    "shared"
  ],
  "pack": {
    "enabled": true,
    "kind": "api-only",
    "independentDatabase": false
  }
}
