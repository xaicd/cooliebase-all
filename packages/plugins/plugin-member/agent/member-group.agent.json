{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "member",
  "entity": "MemberGroup",
  "kebab": "member-group",
  "businessName": "用户分组",
  "permissionPrefix": "member:member_group",
  "page": {
    "route": "/admin/member/member-group",
    "title": "用户分组管理",
    "titleSelector": "[data-testid=\"member-group-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.member/api",
    "bffMount": "/api/v1/admin/member",
    "resource": "member-group",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/member-group",
        "query": [
          "page",
          "pageSize"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/member-group/:id"
      },
      "create": {
        "http": "POST",
        "path": "/member-group"
      },
      "update": {
        "http": "PUT",
        "path": "/member-group/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/member-group/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"member-group-title\"]",
    "refresh": "[data-testid=\"member-group-refresh\"]",
    "createButton": "[data-testid=\"member-group-create\"]",
    "searchForm": "[data-testid=\"member-group-search\"]",
    "searchSubmit": "[data-testid=\"member-group-search-submit\"]",
    "searchReset": "[data-testid=\"member-group-search-reset\"]",
    "total": "[data-testid=\"member-group-total\"]",
    "table": "[data-testid=\"member-group-table\"]",
    "row": "[data-testid=\"member-group-row\"]",
    "editButton": "[data-testid=\"member-group-edit\"]",
    "deleteButton": "[data-testid=\"member-group-delete\"]",
    "form": "[data-testid=\"member-group-form\"]",
    "formError": "[data-testid=\"member-group-form-error\"]",
    "formSubmit": "[data-testid=\"member-group-form-submit\"]",
    "formCancel": "[data-testid=\"member-group-form-cancel\"]",
    "formClose": "[data-testid=\"member-group-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "用户分组列表",
    "dialogLabel": {
      "create": "新增用户分组",
      "edit": "编辑用户分组"
    },
    "searchFields": [],
    "fields": [
      {
        "name": "name",
        "label": "名称",
        "type": "string",
        "required": false,
        "testId": "field-name",
        "selector": "[data-testid=\"field-name\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      },
      {
        "name": "status",
        "label": "状态",
        "type": "number",
        "required": false,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "member-group",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"member-group\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"member-group-form-overlay\"]",
      "dialog": "[data-testid=\"member-group-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "member-group:search",
      "reset": "member-group:reset",
      "refresh": "member-group:refresh",
      "create": "member-group:create",
      "edit": "member-group:edit",
      "delete": "member-group:delete",
      "submit": "member-group:submit",
      "cancel": "member-group:cancel",
      "close": "member-group:close",
      "row": "member-group:row",
      "pagination": "member-group:pagination",
      "fields": {
        "name": "member-group:field:name",
        "remark": "member-group:field:remark",
        "status": "member-group:field:status"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "member.member-group",
      "examples": [
        "member.member-group__List__Refresh",
        "member.member-group__ListItem__Open",
        "member.member-group__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
