{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "member",
  "entity": "MemberAddress",
  "kebab": "member-address",
  "businessName": "用户收件地址",
  "permissionPrefix": "member:member_address",
  "page": {
    "route": "/admin/member/member-address",
    "title": "用户收件地址管理",
    "titleSelector": "[data-testid=\"member-address-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.member/api",
    "bffMount": "/api/v1/admin/member",
    "resource": "member-address",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/member-address",
        "query": [
          "page",
          "pageSize",
          "user_id",
          "name",
          "mobile",
          "area_id"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/member-address/:id"
      },
      "create": {
        "http": "POST",
        "path": "/member-address"
      },
      "update": {
        "http": "PUT",
        "path": "/member-address/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/member-address/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"member-address-title\"]",
    "refresh": "[data-testid=\"member-address-refresh\"]",
    "createButton": "[data-testid=\"member-address-create\"]",
    "searchForm": "[data-testid=\"member-address-search\"]",
    "searchSubmit": "[data-testid=\"member-address-search-submit\"]",
    "searchReset": "[data-testid=\"member-address-search-reset\"]",
    "total": "[data-testid=\"member-address-total\"]",
    "table": "[data-testid=\"member-address-table\"]",
    "row": "[data-testid=\"member-address-row\"]",
    "editButton": "[data-testid=\"member-address-edit\"]",
    "deleteButton": "[data-testid=\"member-address-delete\"]",
    "form": "[data-testid=\"member-address-form\"]",
    "formError": "[data-testid=\"member-address-form-error\"]",
    "formSubmit": "[data-testid=\"member-address-form-submit\"]",
    "formCancel": "[data-testid=\"member-address-form-cancel\"]",
    "formClose": "[data-testid=\"member-address-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "用户收件地址列表",
    "dialogLabel": {
      "create": "新增用户收件地址",
      "edit": "编辑用户收件地址"
    },
    "searchFields": [
      {
        "name": "user_id",
        "label": "用户编号",
        "testId": "search-user_id",
        "selector": "[data-testid=\"search-user_id\"]"
      },
      {
        "name": "name",
        "label": "收件人名称",
        "testId": "search-name",
        "selector": "[data-testid=\"search-name\"]"
      },
      {
        "name": "mobile",
        "label": "手机号",
        "testId": "search-mobile",
        "selector": "[data-testid=\"search-mobile\"]"
      },
      {
        "name": "area_id",
        "label": "地区编号",
        "testId": "search-area_id",
        "selector": "[data-testid=\"search-area_id\"]"
      }
    ],
    "fields": [
      {
        "name": "user_id",
        "label": "用户编号",
        "type": "string",
        "required": false,
        "testId": "field-user_id",
        "selector": "[data-testid=\"field-user_id\"]"
      },
      {
        "name": "name",
        "label": "收件人名称",
        "type": "string",
        "required": false,
        "testId": "field-name",
        "selector": "[data-testid=\"field-name\"]"
      },
      {
        "name": "mobile",
        "label": "手机号",
        "type": "string",
        "required": false,
        "testId": "field-mobile",
        "selector": "[data-testid=\"field-mobile\"]"
      },
      {
        "name": "area_id",
        "label": "地区编号",
        "type": "string",
        "required": false,
        "testId": "field-area_id",
        "selector": "[data-testid=\"field-area_id\"]"
      },
      {
        "name": "detail_address",
        "label": "收件详细地址",
        "type": "string",
        "required": false,
        "testId": "field-detail_address",
        "selector": "[data-testid=\"field-detail_address\"]"
      },
      {
        "name": "default_status",
        "label": "是否默认",
        "type": "boolean",
        "required": false,
        "testId": "field-default_status",
        "selector": "[data-testid=\"field-default_status\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "member-address",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"member-address\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"member-address-form-overlay\"]",
      "dialog": "[data-testid=\"member-address-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "member-address:search",
      "reset": "member-address:reset",
      "refresh": "member-address:refresh",
      "create": "member-address:create",
      "edit": "member-address:edit",
      "delete": "member-address:delete",
      "submit": "member-address:submit",
      "cancel": "member-address:cancel",
      "close": "member-address:close",
      "row": "member-address:row",
      "pagination": "member-address:pagination",
      "fields": {
        "user_id": "member-address:field:user_id",
        "name": "member-address:field:name",
        "mobile": "member-address:field:mobile",
        "area_id": "member-address:field:area_id",
        "detail_address": "member-address:field:detail_address",
        "default_status": "member-address:field:default_status"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "member.member-address",
      "examples": [
        "member.member-address__List__Refresh",
        "member.member-address__ListItem__Open",
        "member.member-address__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
