{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "member",
  "entity": "MemberSignInConfig",
  "kebab": "member-sign-in-config",
  "businessName": "签到规则",
  "permissionPrefix": "member:member_sign_in_config",
  "page": {
    "route": "/admin/member/member-sign-in-config",
    "title": "签到规则管理",
    "titleSelector": "[data-testid=\"member-sign-in-config-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.member/api",
    "bffMount": "/api/v1/admin/member",
    "resource": "member-sign-in-config",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/member-sign-in-config",
        "query": [
          "page",
          "pageSize",
          "status"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/member-sign-in-config/:id"
      },
      "create": {
        "http": "POST",
        "path": "/member-sign-in-config"
      },
      "update": {
        "http": "PUT",
        "path": "/member-sign-in-config/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/member-sign-in-config/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"member-sign-in-config-title\"]",
    "refresh": "[data-testid=\"member-sign-in-config-refresh\"]",
    "createButton": "[data-testid=\"member-sign-in-config-create\"]",
    "searchForm": "[data-testid=\"member-sign-in-config-search\"]",
    "searchSubmit": "[data-testid=\"member-sign-in-config-search-submit\"]",
    "searchReset": "[data-testid=\"member-sign-in-config-search-reset\"]",
    "total": "[data-testid=\"member-sign-in-config-total\"]",
    "table": "[data-testid=\"member-sign-in-config-table\"]",
    "row": "[data-testid=\"member-sign-in-config-row\"]",
    "editButton": "[data-testid=\"member-sign-in-config-edit\"]",
    "deleteButton": "[data-testid=\"member-sign-in-config-delete\"]",
    "form": "[data-testid=\"member-sign-in-config-form\"]",
    "formError": "[data-testid=\"member-sign-in-config-form-error\"]",
    "formSubmit": "[data-testid=\"member-sign-in-config-form-submit\"]",
    "formCancel": "[data-testid=\"member-sign-in-config-form-cancel\"]",
    "formClose": "[data-testid=\"member-sign-in-config-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "签到规则列表",
    "dialogLabel": {
      "create": "新增签到规则",
      "edit": "编辑签到规则"
    },
    "searchFields": [
      {
        "name": "status",
        "label": "状态",
        "testId": "search-status",
        "selector": "[data-testid=\"search-status\"]"
      }
    ],
    "fields": [
      {
        "name": "day",
        "label": "签到第 x 天",
        "type": "number",
        "required": false,
        "testId": "field-day",
        "selector": "[data-testid=\"field-day\"]"
      },
      {
        "name": "point",
        "label": "奖励积分",
        "type": "number",
        "required": false,
        "testId": "field-point",
        "selector": "[data-testid=\"field-point\"]"
      },
      {
        "name": "experience",
        "label": "奖励经验",
        "type": "number",
        "required": false,
        "testId": "field-experience",
        "selector": "[data-testid=\"field-experience\"]"
      },
      {
        "name": "status",
        "label": "状态",
        "type": "string",
        "required": false,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "member-sign-in-config",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"member-sign-in-config\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"member-sign-in-config-form-overlay\"]",
      "dialog": "[data-testid=\"member-sign-in-config-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "member-sign-in-config:search",
      "reset": "member-sign-in-config:reset",
      "refresh": "member-sign-in-config:refresh",
      "create": "member-sign-in-config:create",
      "edit": "member-sign-in-config:edit",
      "delete": "member-sign-in-config:delete",
      "submit": "member-sign-in-config:submit",
      "cancel": "member-sign-in-config:cancel",
      "close": "member-sign-in-config:close",
      "row": "member-sign-in-config:row",
      "pagination": "member-sign-in-config:pagination",
      "fields": {
        "day": "member-sign-in-config:field:day",
        "point": "member-sign-in-config:field:point",
        "experience": "member-sign-in-config:field:experience",
        "status": "member-sign-in-config:field:status"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "member.member-sign-in-config",
      "examples": [
        "member.member-sign-in-config__List__Refresh",
        "member.member-sign-in-config__ListItem__Open",
        "member.member-sign-in-config__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
