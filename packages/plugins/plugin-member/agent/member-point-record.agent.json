{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "member",
  "entity": "MemberPointRecord",
  "kebab": "member-point-record",
  "businessName": "用户积分记录",
  "permissionPrefix": "member:member_point_record",
  "page": {
    "route": "/admin/member/member-point-record",
    "title": "用户积分记录管理",
    "titleSelector": "[data-testid=\"member-point-record-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.member/api",
    "bffMount": "/api/v1/admin/member",
    "resource": "member-point-record",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/member-point-record",
        "query": [
          "page",
          "pageSize"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/member-point-record/:id"
      },
      "create": {
        "http": "POST",
        "path": "/member-point-record"
      },
      "update": {
        "http": "PUT",
        "path": "/member-point-record/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/member-point-record/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"member-point-record-title\"]",
    "refresh": "[data-testid=\"member-point-record-refresh\"]",
    "createButton": "[data-testid=\"member-point-record-create\"]",
    "searchForm": "[data-testid=\"member-point-record-search\"]",
    "searchSubmit": "[data-testid=\"member-point-record-search-submit\"]",
    "searchReset": "[data-testid=\"member-point-record-search-reset\"]",
    "total": "[data-testid=\"member-point-record-total\"]",
    "table": "[data-testid=\"member-point-record-table\"]",
    "row": "[data-testid=\"member-point-record-row\"]",
    "editButton": "[data-testid=\"member-point-record-edit\"]",
    "deleteButton": "[data-testid=\"member-point-record-delete\"]",
    "form": "[data-testid=\"member-point-record-form\"]",
    "formError": "[data-testid=\"member-point-record-form-error\"]",
    "formSubmit": "[data-testid=\"member-point-record-form-submit\"]",
    "formCancel": "[data-testid=\"member-point-record-form-cancel\"]",
    "formClose": "[data-testid=\"member-point-record-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "用户积分记录列表",
    "dialogLabel": {
      "create": "新增用户积分记录",
      "edit": "编辑用户积分记录"
    },
    "searchFields": [],
    "fields": [
      {
        "name": "user_id",
        "label": "用户编号",
        "type": "number",
        "required": false,
        "testId": "field-user_id",
        "selector": "[data-testid=\"field-user_id\"]"
      },
      {
        "name": "biz_id",
        "label": "业务编码",
        "type": "string",
        "required": false,
        "testId": "field-biz_id",
        "selector": "[data-testid=\"field-biz_id\"]"
      },
      {
        "name": "biz_type",
        "label": "业务类型",
        "type": "number",
        "required": false,
        "testId": "field-biz_type",
        "selector": "[data-testid=\"field-biz_type\"]"
      },
      {
        "name": "title",
        "label": "积分标题",
        "type": "string",
        "required": false,
        "testId": "field-title",
        "selector": "[data-testid=\"field-title\"]"
      },
      {
        "name": "description",
        "label": "积分描述",
        "type": "string",
        "required": false,
        "testId": "field-description",
        "selector": "[data-testid=\"field-description\"]"
      },
      {
        "name": "point",
        "label": "变动积分",
        "type": "number",
        "required": false,
        "testId": "field-point",
        "selector": "[data-testid=\"field-point\"]"
      },
      {
        "name": "total_point",
        "label": "变动后的积分",
        "type": "number",
        "required": false,
        "testId": "field-total_point",
        "selector": "[data-testid=\"field-total_point\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "member-point-record",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"member-point-record\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"member-point-record-form-overlay\"]",
      "dialog": "[data-testid=\"member-point-record-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "member-point-record:search",
      "reset": "member-point-record:reset",
      "refresh": "member-point-record:refresh",
      "create": "member-point-record:create",
      "edit": "member-point-record:edit",
      "delete": "member-point-record:delete",
      "submit": "member-point-record:submit",
      "cancel": "member-point-record:cancel",
      "close": "member-point-record:close",
      "row": "member-point-record:row",
      "pagination": "member-point-record:pagination",
      "fields": {
        "user_id": "member-point-record:field:user_id",
        "biz_id": "member-point-record:field:biz_id",
        "biz_type": "member-point-record:field:biz_type",
        "title": "member-point-record:field:title",
        "description": "member-point-record:field:description",
        "point": "member-point-record:field:point",
        "total_point": "member-point-record:field:total_point"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "member.member-point-record",
      "examples": [
        "member.member-point-record__List__Refresh",
        "member.member-point-record__ListItem__Open",
        "member.member-point-record__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
