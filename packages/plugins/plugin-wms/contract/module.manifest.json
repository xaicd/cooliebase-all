{
  "$schema": "cooliebase-module-manifest/v1",
  "domain": "wms",
  "id": "cooliebase.wms",
  "apiVersion": 1,
  "displayName": "仓储中心",
  "kind": "plugin",
  "stage": "B",
  "owner": "wms",
  "contractVersion": "v1",
  "implementation": "local-ts",
  "minimumHostVersion": "1.0.0",
  "capabilities": [
    "api.routes.register",
    "facade.invoke",
    "rpc.serve",
    "cmd.dispatch",
    "pack.independent"
  ],
  "entrypoints": {
    "facade": [
      "packages/plugins/plugin-wms/contract/wms.facade.ts"
    ],
    "proto": "packages/plugins/plugin-wms/contract/wms.proto",
    "actions": "packages/plugins/plugin-wms/contract/actions.ts"
  },
  "apiRoutes": {
    "publicPrefix": [
      "/api/v1/admin/wms"
    ],
    "adminPrefix": "/api/v1/admin/wms"
  },
  "auth": {
    "audience": "admin",
    "tenantPolicy": "required"
  },
  "messaging": {
    "queueGroup": "cooliebase.wms",
    "commandSubject": "cooliebase.cmd.wms.>",
    "eventSubject": "cooliebase.evt.wms.>"
  },
  "invoke": {
    "colocated": "sdk",
    "remote": "rpc",
    "protocol": "nats-rr",
    "serialization": "json"
  },
  "upstream": {
    "env": "COOLIEBASE_DOMAIN_WMS_UPSTREAM",
    "protocol": "http",
    "defaultPort": 3221
  },
  "resilience": {
    "timeoutMs": 8000,
    "retry": {
      "maxAttempts": 1,
      "safeMethodsOnly": true
    },
    "idempotencyRequired": true
  },
  "facadeMethods": [
    "ping",
    "listWarehouses",
    "checkin",
    "deductStock",
    "lockStock",
    "releaseStock",
    "replenishStock"
  ],
  "rpc": [
    {
      "service": "WmsService",
      "method": "Ping"
    },
    {
      "service": "WmsService",
      "method": "ListWarehouses"
    },
    {
      "service": "WmsService",
      "method": "Checkin"
    },
    {
      "service": "WmsService",
      "method": "DeductStock"
    },
    {
      "service": "WmsService",
      "method": "LockStock"
    },
    {
      "service": "WmsService",
      "method": "ReleaseStock"
    },
    {
      "service": "WmsService",
      "method": "ReplenishStock"
    }
  ],
  "actions": [
    "wms.ping",
    "wms.listWarehouses",
    "wms.checkin",
    "wms.deductStock",
    "wms.lockStock",
    "wms.releaseStock",
    "wms.replenishStock"
  ],
  "permissions": [
    "wms:operation:checkin",
    "wms:warehouse:view",
    "wms:wms-check-order:create",
    "wms:wms-check-order:delete",
    "wms:wms-check-order:query",
    "wms:wms-check-order:update",
    "wms:wms-inventory-history:create",
    "wms:wms-inventory-history:delete",
    "wms:wms-inventory-history:query",
    "wms:wms-inventory-history:update",
    "wms:wms-inventory:create",
    "wms:wms-inventory:delete",
    "wms:wms-inventory:query",
    "wms:wms-inventory:update",
    "wms:wms-item-brand:create",
    "wms:wms-item-brand:delete",
    "wms:wms-item-brand:query",
    "wms:wms-item-brand:update",
    "wms:wms-item-category:create",
    "wms:wms-item-category:delete",
    "wms:wms-item-category:query",
    "wms:wms-item-category:update",
    "wms:wms-item:create",
    "wms:wms-item:delete",
    "wms:wms-item:query",
    "wms:wms-item:update",
    "wms:wms-merchant:create",
    "wms:wms-merchant:delete",
    "wms:wms-merchant:query",
    "wms:wms-merchant:update",
    "wms:wms-movement-order:create",
    "wms:wms-movement-order:delete",
    "wms:wms-movement-order:query",
    "wms:wms-movement-order:update",
    "wms:wms-receipt-order:create",
    "wms:wms-receipt-order:delete",
    "wms:wms-receipt-order:query",
    "wms:wms-receipt-order:update",
    "wms:wms-shipment-order:create",
    "wms:wms-shipment-order:delete",
    "wms:wms-shipment-order:query",
    "wms:wms-shipment-order:update",
    "wms:wms-warehouse:create",
    "wms:wms-warehouse:delete",
    "wms:wms-warehouse:update"
  ],
  "dependsOn": [
    "shared"
  ],
  "pack": {
    "enabled": true,
    "kind": "api-only",
    "independentDatabase": false
  }
}
