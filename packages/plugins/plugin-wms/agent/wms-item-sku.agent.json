{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "wms",
  "entity": "WmsItemSku",
  "kebab": "wms-item-sku",
  "businessName": "物料SKU",
  "permissionPrefix": "wms:item",
  "page": {
    "route": "/admin/wms/wms-item-sku",
    "title": "物料SKU管理",
    "titleSelector": "[data-testid=\"wms-item-sku-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.wms/api",
    "bffMount": "/api/v1/admin/wms",
    "resource": "wms-item-sku",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/wms-item-sku",
        "query": [
          "page",
          "pageSize",
          "item_id",
          "sku_code",
          "sku_name"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/wms-item-sku/:id"
      },
      "create": {
        "http": "POST",
        "path": "/wms-item-sku"
      },
      "update": {
        "http": "PUT",
        "path": "/wms-item-sku/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/wms-item-sku/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"wms-item-sku-title\"]",
    "refresh": "[data-testid=\"wms-item-sku-refresh\"]",
    "createButton": "[data-testid=\"wms-item-sku-create\"]",
    "searchForm": "[data-testid=\"wms-item-sku-search\"]",
    "searchSubmit": "[data-testid=\"wms-item-sku-search-submit\"]",
    "searchReset": "[data-testid=\"wms-item-sku-search-reset\"]",
    "total": "[data-testid=\"wms-item-sku-total\"]",
    "table": "[data-testid=\"wms-item-sku-table\"]",
    "row": "[data-testid=\"wms-item-sku-row\"]",
    "editButton": "[data-testid=\"wms-item-sku-edit\"]",
    "deleteButton": "[data-testid=\"wms-item-sku-delete\"]",
    "form": "[data-testid=\"wms-item-sku-form\"]",
    "formError": "[data-testid=\"wms-item-sku-form-error\"]",
    "formSubmit": "[data-testid=\"wms-item-sku-form-submit\"]",
    "formCancel": "[data-testid=\"wms-item-sku-form-cancel\"]",
    "formClose": "[data-testid=\"wms-item-sku-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "物料SKU列表",
    "dialogLabel": {
      "create": "新增物料SKU",
      "edit": "编辑物料SKU"
    },
    "searchFields": [
      {
        "name": "item_id",
        "label": "物料ID",
        "testId": "search-item_id",
        "selector": "[data-testid=\"search-item_id\"]"
      },
      {
        "name": "sku_code",
        "label": "SKU编码",
        "testId": "search-sku_code",
        "selector": "[data-testid=\"search-sku_code\"]"
      },
      {
        "name": "sku_name",
        "label": "规格名称",
        "testId": "search-sku_name",
        "selector": "[data-testid=\"search-sku_name\"]"
      }
    ],
    "fields": [
      {
        "name": "item_id",
        "label": "物料ID",
        "type": "string",
        "required": true,
        "testId": "field-item_id",
        "selector": "[data-testid=\"field-item_id\"]"
      },
      {
        "name": "sku_code",
        "label": "SKU编码",
        "type": "string",
        "required": true,
        "testId": "field-sku_code",
        "selector": "[data-testid=\"field-sku_code\"]"
      },
      {
        "name": "sku_name",
        "label": "规格名称",
        "type": "string",
        "required": true,
        "testId": "field-sku_name",
        "selector": "[data-testid=\"field-sku_name\"]"
      },
      {
        "name": "barcode",
        "label": "条形码",
        "type": "string",
        "required": false,
        "testId": "field-barcode",
        "selector": "[data-testid=\"field-barcode\"]"
      },
      {
        "name": "price",
        "label": "参考单价",
        "type": "number",
        "required": false,
        "testId": "field-price",
        "selector": "[data-testid=\"field-price\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "wms-item-sku",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"wms-item-sku\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"wms-item-sku-form-overlay\"]",
      "dialog": "[data-testid=\"wms-item-sku-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "wms-item-sku:search",
      "reset": "wms-item-sku:reset",
      "refresh": "wms-item-sku:refresh",
      "create": "wms-item-sku:create",
      "edit": "wms-item-sku:edit",
      "delete": "wms-item-sku:delete",
      "submit": "wms-item-sku:submit",
      "cancel": "wms-item-sku:cancel",
      "close": "wms-item-sku:close",
      "row": "wms-item-sku:row",
      "pagination": "wms-item-sku:pagination",
      "fields": {
        "item_id": "wms-item-sku:field:item_id",
        "sku_code": "wms-item-sku:field:sku_code",
        "sku_name": "wms-item-sku:field:sku_name",
        "barcode": "wms-item-sku:field:barcode",
        "price": "wms-item-sku:field:price"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "wms.wms-item-sku",
      "examples": [
        "wms.wms-item-sku__List__Refresh",
        "wms.wms-item-sku__ListItem__Open",
        "wms.wms-item-sku__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
