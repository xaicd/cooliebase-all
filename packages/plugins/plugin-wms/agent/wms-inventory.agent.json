{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "wms",
  "entity": "WmsInventory",
  "kebab": "wms-inventory",
  "businessName": "实时库存",
  "permissionPrefix": "wms:inventory",
  "page": {
    "route": "/admin/wms/wms-inventory",
    "title": "实时库存管理",
    "titleSelector": "[data-testid=\"wms-inventory-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.wms/api",
    "bffMount": "/api/v1/admin/wms",
    "resource": "wms-inventory",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/wms-inventory",
        "query": [
          "page",
          "pageSize",
          "warehouse_id",
          "item_id"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/wms-inventory/:id"
      },
      "create": {
        "http": "POST",
        "path": "/wms-inventory"
      },
      "update": {
        "http": "PUT",
        "path": "/wms-inventory/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/wms-inventory/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"wms-inventory-title\"]",
    "refresh": "[data-testid=\"wms-inventory-refresh\"]",
    "createButton": "[data-testid=\"wms-inventory-create\"]",
    "searchForm": "[data-testid=\"wms-inventory-search\"]",
    "searchSubmit": "[data-testid=\"wms-inventory-search-submit\"]",
    "searchReset": "[data-testid=\"wms-inventory-search-reset\"]",
    "total": "[data-testid=\"wms-inventory-total\"]",
    "table": "[data-testid=\"wms-inventory-table\"]",
    "row": "[data-testid=\"wms-inventory-row\"]",
    "editButton": "[data-testid=\"wms-inventory-edit\"]",
    "deleteButton": "[data-testid=\"wms-inventory-delete\"]",
    "form": "[data-testid=\"wms-inventory-form\"]",
    "formError": "[data-testid=\"wms-inventory-form-error\"]",
    "formSubmit": "[data-testid=\"wms-inventory-form-submit\"]",
    "formCancel": "[data-testid=\"wms-inventory-form-cancel\"]",
    "formClose": "[data-testid=\"wms-inventory-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "实时库存列表",
    "dialogLabel": {
      "create": "新增实时库存",
      "edit": "编辑实时库存"
    },
    "searchFields": [
      {
        "name": "warehouse_id",
        "label": "仓库ID",
        "testId": "search-warehouse_id",
        "selector": "[data-testid=\"search-warehouse_id\"]"
      },
      {
        "name": "item_id",
        "label": "物料ID",
        "testId": "search-item_id",
        "selector": "[data-testid=\"search-item_id\"]"
      }
    ],
    "fields": [
      {
        "name": "warehouse_id",
        "label": "仓库ID",
        "type": "string",
        "required": true,
        "testId": "field-warehouse_id",
        "selector": "[data-testid=\"field-warehouse_id\"]"
      },
      {
        "name": "item_id",
        "label": "物料ID",
        "type": "string",
        "required": true,
        "testId": "field-item_id",
        "selector": "[data-testid=\"field-item_id\"]"
      },
      {
        "name": "merchant_id",
        "label": "货主ID",
        "type": "string",
        "required": false,
        "testId": "field-merchant_id",
        "selector": "[data-testid=\"field-merchant_id\"]"
      },
      {
        "name": "qty",
        "label": "现存数量",
        "type": "number",
        "required": true,
        "testId": "field-qty",
        "selector": "[data-testid=\"field-qty\"]"
      },
      {
        "name": "locked_qty",
        "label": "锁定数量",
        "type": "number",
        "required": true,
        "testId": "field-locked_qty",
        "selector": "[data-testid=\"field-locked_qty\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "wms-inventory",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"wms-inventory\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"wms-inventory-form-overlay\"]",
      "dialog": "[data-testid=\"wms-inventory-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "wms-inventory:search",
      "reset": "wms-inventory:reset",
      "refresh": "wms-inventory:refresh",
      "create": "wms-inventory:create",
      "edit": "wms-inventory:edit",
      "delete": "wms-inventory:delete",
      "submit": "wms-inventory:submit",
      "cancel": "wms-inventory:cancel",
      "close": "wms-inventory:close",
      "row": "wms-inventory:row",
      "pagination": "wms-inventory:pagination",
      "fields": {
        "warehouse_id": "wms-inventory:field:warehouse_id",
        "item_id": "wms-inventory:field:item_id",
        "merchant_id": "wms-inventory:field:merchant_id",
        "qty": "wms-inventory:field:qty",
        "locked_qty": "wms-inventory:field:locked_qty"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "wms.wms-inventory",
      "examples": [
        "wms.wms-inventory__List__Refresh",
        "wms.wms-inventory__ListItem__Open",
        "wms.wms-inventory__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
