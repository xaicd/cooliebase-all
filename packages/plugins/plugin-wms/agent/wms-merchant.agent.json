{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "wms",
  "entity": "WmsMerchant",
  "kebab": "wms-merchant",
  "businessName": "货主管理",
  "permissionPrefix": "wms:merchant",
  "page": {
    "route": "/admin/wms/wms-merchant",
    "title": "货主管理管理",
    "titleSelector": "[data-testid=\"wms-merchant-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.wms/api",
    "bffMount": "/api/v1/admin/wms",
    "resource": "wms-merchant",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/wms-merchant",
        "query": [
          "page",
          "pageSize",
          "code",
          "name"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/wms-merchant/:id"
      },
      "create": {
        "http": "POST",
        "path": "/wms-merchant"
      },
      "update": {
        "http": "PUT",
        "path": "/wms-merchant/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/wms-merchant/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"wms-merchant-title\"]",
    "refresh": "[data-testid=\"wms-merchant-refresh\"]",
    "createButton": "[data-testid=\"wms-merchant-create\"]",
    "searchForm": "[data-testid=\"wms-merchant-search\"]",
    "searchSubmit": "[data-testid=\"wms-merchant-search-submit\"]",
    "searchReset": "[data-testid=\"wms-merchant-search-reset\"]",
    "total": "[data-testid=\"wms-merchant-total\"]",
    "table": "[data-testid=\"wms-merchant-table\"]",
    "row": "[data-testid=\"wms-merchant-row\"]",
    "editButton": "[data-testid=\"wms-merchant-edit\"]",
    "deleteButton": "[data-testid=\"wms-merchant-delete\"]",
    "form": "[data-testid=\"wms-merchant-form\"]",
    "formError": "[data-testid=\"wms-merchant-form-error\"]",
    "formSubmit": "[data-testid=\"wms-merchant-form-submit\"]",
    "formCancel": "[data-testid=\"wms-merchant-form-cancel\"]",
    "formClose": "[data-testid=\"wms-merchant-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "货主管理列表",
    "dialogLabel": {
      "create": "新增货主管理",
      "edit": "编辑货主管理"
    },
    "searchFields": [
      {
        "name": "code",
        "label": "货主编码",
        "testId": "search-code",
        "selector": "[data-testid=\"search-code\"]"
      },
      {
        "name": "name",
        "label": "货主名称",
        "testId": "search-name",
        "selector": "[data-testid=\"search-name\"]"
      }
    ],
    "fields": [
      {
        "name": "code",
        "label": "货主编码",
        "type": "string",
        "required": true,
        "testId": "field-code",
        "selector": "[data-testid=\"field-code\"]"
      },
      {
        "name": "name",
        "label": "货主名称",
        "type": "string",
        "required": true,
        "testId": "field-name",
        "selector": "[data-testid=\"field-name\"]"
      },
      {
        "name": "contact_name",
        "label": "联系人",
        "type": "string",
        "required": false,
        "testId": "field-contact_name",
        "selector": "[data-testid=\"field-contact_name\"]"
      },
      {
        "name": "contact_phone",
        "label": "联系电话",
        "type": "string",
        "required": false,
        "testId": "field-contact_phone",
        "selector": "[data-testid=\"field-contact_phone\"]"
      },
      {
        "name": "status",
        "label": "状态",
        "type": "string",
        "required": true,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "wms-merchant",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"wms-merchant\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"wms-merchant-form-overlay\"]",
      "dialog": "[data-testid=\"wms-merchant-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "wms-merchant:search",
      "reset": "wms-merchant:reset",
      "refresh": "wms-merchant:refresh",
      "create": "wms-merchant:create",
      "edit": "wms-merchant:edit",
      "delete": "wms-merchant:delete",
      "submit": "wms-merchant:submit",
      "cancel": "wms-merchant:cancel",
      "close": "wms-merchant:close",
      "row": "wms-merchant:row",
      "pagination": "wms-merchant:pagination",
      "fields": {
        "code": "wms-merchant:field:code",
        "name": "wms-merchant:field:name",
        "contact_name": "wms-merchant:field:contact_name",
        "contact_phone": "wms-merchant:field:contact_phone",
        "status": "wms-merchant:field:status"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "wms.wms-merchant",
      "examples": [
        "wms.wms-merchant__List__Refresh",
        "wms.wms-merchant__ListItem__Open",
        "wms.wms-merchant__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
