{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "wms",
  "entity": "WmsWarehouse",
  "kebab": "wms-warehouse",
  "businessName": "智能仓库",
  "permissionPrefix": "wms:warehouse",
  "page": {
    "route": "/admin/wms/wms-warehouse",
    "title": "智能仓库管理",
    "titleSelector": "[data-testid=\"wms-warehouse-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.wms/api",
    "bffMount": "/api/v1/admin/wms",
    "resource": "wms-warehouse",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/wms-warehouse",
        "query": [
          "page",
          "pageSize",
          "code",
          "name"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/wms-warehouse/:id"
      },
      "create": {
        "http": "POST",
        "path": "/wms-warehouse"
      },
      "update": {
        "http": "PUT",
        "path": "/wms-warehouse/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/wms-warehouse/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"wms-warehouse-title\"]",
    "refresh": "[data-testid=\"wms-warehouse-refresh\"]",
    "createButton": "[data-testid=\"wms-warehouse-create\"]",
    "searchForm": "[data-testid=\"wms-warehouse-search\"]",
    "searchSubmit": "[data-testid=\"wms-warehouse-search-submit\"]",
    "searchReset": "[data-testid=\"wms-warehouse-search-reset\"]",
    "total": "[data-testid=\"wms-warehouse-total\"]",
    "table": "[data-testid=\"wms-warehouse-table\"]",
    "row": "[data-testid=\"wms-warehouse-row\"]",
    "editButton": "[data-testid=\"wms-warehouse-edit\"]",
    "deleteButton": "[data-testid=\"wms-warehouse-delete\"]",
    "form": "[data-testid=\"wms-warehouse-form\"]",
    "formError": "[data-testid=\"wms-warehouse-form-error\"]",
    "formSubmit": "[data-testid=\"wms-warehouse-form-submit\"]",
    "formCancel": "[data-testid=\"wms-warehouse-form-cancel\"]",
    "formClose": "[data-testid=\"wms-warehouse-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "智能仓库列表",
    "dialogLabel": {
      "create": "新增智能仓库",
      "edit": "编辑智能仓库"
    },
    "searchFields": [
      {
        "name": "code",
        "label": "仓库编码",
        "testId": "search-code",
        "selector": "[data-testid=\"search-code\"]"
      },
      {
        "name": "name",
        "label": "仓库名称",
        "testId": "search-name",
        "selector": "[data-testid=\"search-name\"]"
      }
    ],
    "fields": [
      {
        "name": "code",
        "label": "仓库编码",
        "type": "string",
        "required": true,
        "testId": "field-code",
        "selector": "[data-testid=\"field-code\"]"
      },
      {
        "name": "name",
        "label": "仓库名称",
        "type": "string",
        "required": true,
        "testId": "field-name",
        "selector": "[data-testid=\"field-name\"]"
      },
      {
        "name": "capacity",
        "label": "库容量(m³)",
        "type": "number",
        "required": false,
        "testId": "field-capacity",
        "selector": "[data-testid=\"field-capacity\"]"
      },
      {
        "name": "active",
        "label": "启用状态",
        "type": "boolean",
        "required": true,
        "testId": "field-active",
        "selector": "[data-testid=\"field-active\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "wms-warehouse",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"wms-warehouse\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"wms-warehouse-form-overlay\"]",
      "dialog": "[data-testid=\"wms-warehouse-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "wms-warehouse:search",
      "reset": "wms-warehouse:reset",
      "refresh": "wms-warehouse:refresh",
      "create": "wms-warehouse:create",
      "edit": "wms-warehouse:edit",
      "delete": "wms-warehouse:delete",
      "submit": "wms-warehouse:submit",
      "cancel": "wms-warehouse:cancel",
      "close": "wms-warehouse:close",
      "row": "wms-warehouse:row",
      "pagination": "wms-warehouse:pagination",
      "fields": {
        "code": "wms-warehouse:field:code",
        "name": "wms-warehouse:field:name",
        "capacity": "wms-warehouse:field:capacity",
        "active": "wms-warehouse:field:active"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "wms.wms-warehouse",
      "examples": [
        "wms.wms-warehouse__List__Refresh",
        "wms.wms-warehouse__ListItem__Open",
        "wms.wms-warehouse__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
