{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "wms",
  "entity": "WmsMovementOrderDetail",
  "kebab": "wms-movement-order-detail",
  "businessName": "移库明细",
  "permissionPrefix": "wms:movement",
  "page": {
    "route": "/admin/wms/wms-movement-order-detail",
    "title": "移库明细管理",
    "titleSelector": "[data-testid=\"wms-movement-order-detail-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.wms/api",
    "bffMount": "/api/v1/admin/wms",
    "resource": "wms-movement-order-detail",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/wms-movement-order-detail",
        "query": [
          "page",
          "pageSize",
          "movement_order_id",
          "item_id"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/wms-movement-order-detail/:id"
      },
      "create": {
        "http": "POST",
        "path": "/wms-movement-order-detail"
      },
      "update": {
        "http": "PUT",
        "path": "/wms-movement-order-detail/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/wms-movement-order-detail/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"wms-movement-order-detail-title\"]",
    "refresh": "[data-testid=\"wms-movement-order-detail-refresh\"]",
    "createButton": "[data-testid=\"wms-movement-order-detail-create\"]",
    "searchForm": "[data-testid=\"wms-movement-order-detail-search\"]",
    "searchSubmit": "[data-testid=\"wms-movement-order-detail-search-submit\"]",
    "searchReset": "[data-testid=\"wms-movement-order-detail-search-reset\"]",
    "total": "[data-testid=\"wms-movement-order-detail-total\"]",
    "table": "[data-testid=\"wms-movement-order-detail-table\"]",
    "row": "[data-testid=\"wms-movement-order-detail-row\"]",
    "editButton": "[data-testid=\"wms-movement-order-detail-edit\"]",
    "deleteButton": "[data-testid=\"wms-movement-order-detail-delete\"]",
    "form": "[data-testid=\"wms-movement-order-detail-form\"]",
    "formError": "[data-testid=\"wms-movement-order-detail-form-error\"]",
    "formSubmit": "[data-testid=\"wms-movement-order-detail-form-submit\"]",
    "formCancel": "[data-testid=\"wms-movement-order-detail-form-cancel\"]",
    "formClose": "[data-testid=\"wms-movement-order-detail-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "移库明细列表",
    "dialogLabel": {
      "create": "新增移库明细",
      "edit": "编辑移库明细"
    },
    "searchFields": [
      {
        "name": "movement_order_id",
        "label": "关联移库单ID",
        "testId": "search-movement_order_id",
        "selector": "[data-testid=\"search-movement_order_id\"]"
      },
      {
        "name": "item_id",
        "label": "物料ID",
        "testId": "search-item_id",
        "selector": "[data-testid=\"search-item_id\"]"
      }
    ],
    "fields": [
      {
        "name": "movement_order_id",
        "label": "关联移库单ID",
        "type": "string",
        "required": true,
        "testId": "field-movement_order_id",
        "selector": "[data-testid=\"field-movement_order_id\"]"
      },
      {
        "name": "item_id",
        "label": "物料ID",
        "type": "string",
        "required": true,
        "testId": "field-item_id",
        "selector": "[data-testid=\"field-item_id\"]"
      },
      {
        "name": "qty",
        "label": "移库数量",
        "type": "number",
        "required": true,
        "testId": "field-qty",
        "selector": "[data-testid=\"field-qty\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "wms-movement-order-detail",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"wms-movement-order-detail\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"wms-movement-order-detail-form-overlay\"]",
      "dialog": "[data-testid=\"wms-movement-order-detail-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "wms-movement-order-detail:search",
      "reset": "wms-movement-order-detail:reset",
      "refresh": "wms-movement-order-detail:refresh",
      "create": "wms-movement-order-detail:create",
      "edit": "wms-movement-order-detail:edit",
      "delete": "wms-movement-order-detail:delete",
      "submit": "wms-movement-order-detail:submit",
      "cancel": "wms-movement-order-detail:cancel",
      "close": "wms-movement-order-detail:close",
      "row": "wms-movement-order-detail:row",
      "pagination": "wms-movement-order-detail:pagination",
      "fields": {
        "movement_order_id": "wms-movement-order-detail:field:movement_order_id",
        "item_id": "wms-movement-order-detail:field:item_id",
        "qty": "wms-movement-order-detail:field:qty"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "wms.wms-movement-order-detail",
      "examples": [
        "wms.wms-movement-order-detail__List__Refresh",
        "wms.wms-movement-order-detail__ListItem__Open",
        "wms.wms-movement-order-detail__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
