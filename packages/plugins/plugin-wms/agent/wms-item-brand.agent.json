{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "wms",
  "entity": "WmsItemBrand",
  "kebab": "wms-item-brand",
  "businessName": "物料品牌",
  "permissionPrefix": "wms:brand",
  "page": {
    "route": "/admin/wms/wms-item-brand",
    "title": "物料品牌管理",
    "titleSelector": "[data-testid=\"wms-item-brand-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.wms/api",
    "bffMount": "/api/v1/admin/wms",
    "resource": "wms-item-brand",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/wms-item-brand",
        "query": [
          "page",
          "pageSize",
          "name",
          "code"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/wms-item-brand/:id"
      },
      "create": {
        "http": "POST",
        "path": "/wms-item-brand"
      },
      "update": {
        "http": "PUT",
        "path": "/wms-item-brand/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/wms-item-brand/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"wms-item-brand-title\"]",
    "refresh": "[data-testid=\"wms-item-brand-refresh\"]",
    "createButton": "[data-testid=\"wms-item-brand-create\"]",
    "searchForm": "[data-testid=\"wms-item-brand-search\"]",
    "searchSubmit": "[data-testid=\"wms-item-brand-search-submit\"]",
    "searchReset": "[data-testid=\"wms-item-brand-search-reset\"]",
    "total": "[data-testid=\"wms-item-brand-total\"]",
    "table": "[data-testid=\"wms-item-brand-table\"]",
    "row": "[data-testid=\"wms-item-brand-row\"]",
    "editButton": "[data-testid=\"wms-item-brand-edit\"]",
    "deleteButton": "[data-testid=\"wms-item-brand-delete\"]",
    "form": "[data-testid=\"wms-item-brand-form\"]",
    "formError": "[data-testid=\"wms-item-brand-form-error\"]",
    "formSubmit": "[data-testid=\"wms-item-brand-form-submit\"]",
    "formCancel": "[data-testid=\"wms-item-brand-form-cancel\"]",
    "formClose": "[data-testid=\"wms-item-brand-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "物料品牌列表",
    "dialogLabel": {
      "create": "新增物料品牌",
      "edit": "编辑物料品牌"
    },
    "searchFields": [
      {
        "name": "name",
        "label": "品牌名称",
        "testId": "search-name",
        "selector": "[data-testid=\"search-name\"]"
      },
      {
        "name": "code",
        "label": "品牌编码",
        "testId": "search-code",
        "selector": "[data-testid=\"search-code\"]"
      }
    ],
    "fields": [
      {
        "name": "name",
        "label": "品牌名称",
        "type": "string",
        "required": true,
        "testId": "field-name",
        "selector": "[data-testid=\"field-name\"]"
      },
      {
        "name": "code",
        "label": "品牌编码",
        "type": "string",
        "required": true,
        "testId": "field-code",
        "selector": "[data-testid=\"field-code\"]"
      },
      {
        "name": "logo",
        "label": "品牌LOGO",
        "type": "string",
        "required": false,
        "testId": "field-logo",
        "selector": "[data-testid=\"field-logo\"]"
      },
      {
        "name": "status",
        "label": "状态",
        "type": "string",
        "required": true,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "wms-item-brand",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"wms-item-brand\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"wms-item-brand-form-overlay\"]",
      "dialog": "[data-testid=\"wms-item-brand-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "wms-item-brand:search",
      "reset": "wms-item-brand:reset",
      "refresh": "wms-item-brand:refresh",
      "create": "wms-item-brand:create",
      "edit": "wms-item-brand:edit",
      "delete": "wms-item-brand:delete",
      "submit": "wms-item-brand:submit",
      "cancel": "wms-item-brand:cancel",
      "close": "wms-item-brand:close",
      "row": "wms-item-brand:row",
      "pagination": "wms-item-brand:pagination",
      "fields": {
        "name": "wms-item-brand:field:name",
        "code": "wms-item-brand:field:code",
        "logo": "wms-item-brand:field:logo",
        "status": "wms-item-brand:field:status"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "wms.wms-item-brand",
      "examples": [
        "wms.wms-item-brand__List__Refresh",
        "wms.wms-item-brand__ListItem__Open",
        "wms.wms-item-brand__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
