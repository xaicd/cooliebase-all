{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "wms",
  "entity": "WmsItem",
  "kebab": "wms-item",
  "businessName": "物料主数据",
  "permissionPrefix": "wms:item",
  "page": {
    "route": "/admin/wms/wms-item",
    "title": "物料主数据管理",
    "titleSelector": "[data-testid=\"wms-item-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.wms/api",
    "bffMount": "/api/v1/admin/wms",
    "resource": "wms-item",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/wms-item",
        "query": [
          "page",
          "pageSize",
          "item_code",
          "item_name"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/wms-item/:id"
      },
      "create": {
        "http": "POST",
        "path": "/wms-item"
      },
      "update": {
        "http": "PUT",
        "path": "/wms-item/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/wms-item/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"wms-item-title\"]",
    "refresh": "[data-testid=\"wms-item-refresh\"]",
    "createButton": "[data-testid=\"wms-item-create\"]",
    "searchForm": "[data-testid=\"wms-item-search\"]",
    "searchSubmit": "[data-testid=\"wms-item-search-submit\"]",
    "searchReset": "[data-testid=\"wms-item-search-reset\"]",
    "total": "[data-testid=\"wms-item-total\"]",
    "table": "[data-testid=\"wms-item-table\"]",
    "row": "[data-testid=\"wms-item-row\"]",
    "editButton": "[data-testid=\"wms-item-edit\"]",
    "deleteButton": "[data-testid=\"wms-item-delete\"]",
    "form": "[data-testid=\"wms-item-form\"]",
    "formError": "[data-testid=\"wms-item-form-error\"]",
    "formSubmit": "[data-testid=\"wms-item-form-submit\"]",
    "formCancel": "[data-testid=\"wms-item-form-cancel\"]",
    "formClose": "[data-testid=\"wms-item-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "物料主数据列表",
    "dialogLabel": {
      "create": "新增物料主数据",
      "edit": "编辑物料主数据"
    },
    "searchFields": [
      {
        "name": "item_code",
        "label": "物料编码",
        "testId": "search-item_code",
        "selector": "[data-testid=\"search-item_code\"]"
      },
      {
        "name": "item_name",
        "label": "物料名称",
        "testId": "search-item_name",
        "selector": "[data-testid=\"search-item_name\"]"
      }
    ],
    "fields": [
      {
        "name": "item_code",
        "label": "物料编码",
        "type": "string",
        "required": true,
        "testId": "field-item_code",
        "selector": "[data-testid=\"field-item_code\"]"
      },
      {
        "name": "item_name",
        "label": "物料名称",
        "type": "string",
        "required": true,
        "testId": "field-item_name",
        "selector": "[data-testid=\"field-item_name\"]"
      },
      {
        "name": "category_id",
        "label": "分类ID",
        "type": "string",
        "required": false,
        "testId": "field-category_id",
        "selector": "[data-testid=\"field-category_id\"]"
      },
      {
        "name": "brand_id",
        "label": "品牌ID",
        "type": "string",
        "required": false,
        "testId": "field-brand_id",
        "selector": "[data-testid=\"field-brand_id\"]"
      },
      {
        "name": "unit",
        "label": "基本单位",
        "type": "string",
        "required": false,
        "testId": "field-unit",
        "selector": "[data-testid=\"field-unit\"]"
      },
      {
        "name": "spec",
        "label": "规格型号",
        "type": "string",
        "required": false,
        "testId": "field-spec",
        "selector": "[data-testid=\"field-spec\"]"
      },
      {
        "name": "status",
        "label": "物料状态",
        "type": "string",
        "required": true,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "wms-item",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"wms-item\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"wms-item-form-overlay\"]",
      "dialog": "[data-testid=\"wms-item-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "wms-item:search",
      "reset": "wms-item:reset",
      "refresh": "wms-item:refresh",
      "create": "wms-item:create",
      "edit": "wms-item:edit",
      "delete": "wms-item:delete",
      "submit": "wms-item:submit",
      "cancel": "wms-item:cancel",
      "close": "wms-item:close",
      "row": "wms-item:row",
      "pagination": "wms-item:pagination",
      "fields": {
        "item_code": "wms-item:field:item_code",
        "item_name": "wms-item:field:item_name",
        "category_id": "wms-item:field:category_id",
        "brand_id": "wms-item:field:brand_id",
        "unit": "wms-item:field:unit",
        "spec": "wms-item:field:spec",
        "status": "wms-item:field:status"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "wms.wms-item",
      "examples": [
        "wms.wms-item__List__Refresh",
        "wms.wms-item__ListItem__Open",
        "wms.wms-item__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
