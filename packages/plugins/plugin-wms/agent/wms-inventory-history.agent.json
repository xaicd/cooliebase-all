{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "wms",
  "entity": "WmsInventoryHistory",
  "kebab": "wms-inventory-history",
  "businessName": "库存流水",
  "permissionPrefix": "wms:inventory-history",
  "page": {
    "route": "/admin/wms/wms-inventory-history",
    "title": "库存流水管理",
    "titleSelector": "[data-testid=\"wms-inventory-history-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.wms/api",
    "bffMount": "/api/v1/admin/wms",
    "resource": "wms-inventory-history",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/wms-inventory-history",
        "query": [
          "page",
          "pageSize",
          "ref_order_no"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/wms-inventory-history/:id"
      },
      "create": {
        "http": "POST",
        "path": "/wms-inventory-history"
      },
      "update": {
        "http": "PUT",
        "path": "/wms-inventory-history/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/wms-inventory-history/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"wms-inventory-history-title\"]",
    "refresh": "[data-testid=\"wms-inventory-history-refresh\"]",
    "createButton": "[data-testid=\"wms-inventory-history-create\"]",
    "searchForm": "[data-testid=\"wms-inventory-history-search\"]",
    "searchSubmit": "[data-testid=\"wms-inventory-history-search-submit\"]",
    "searchReset": "[data-testid=\"wms-inventory-history-search-reset\"]",
    "total": "[data-testid=\"wms-inventory-history-total\"]",
    "table": "[data-testid=\"wms-inventory-history-table\"]",
    "row": "[data-testid=\"wms-inventory-history-row\"]",
    "editButton": "[data-testid=\"wms-inventory-history-edit\"]",
    "deleteButton": "[data-testid=\"wms-inventory-history-delete\"]",
    "form": "[data-testid=\"wms-inventory-history-form\"]",
    "formError": "[data-testid=\"wms-inventory-history-form-error\"]",
    "formSubmit": "[data-testid=\"wms-inventory-history-form-submit\"]",
    "formCancel": "[data-testid=\"wms-inventory-history-form-cancel\"]",
    "formClose": "[data-testid=\"wms-inventory-history-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "库存流水列表",
    "dialogLabel": {
      "create": "新增库存流水",
      "edit": "编辑库存流水"
    },
    "searchFields": [
      {
        "name": "ref_order_no",
        "label": "关联单号",
        "testId": "search-ref_order_no",
        "selector": "[data-testid=\"search-ref_order_no\"]"
      }
    ],
    "fields": [
      {
        "name": "warehouse_id",
        "label": "仓库ID",
        "type": "string",
        "required": true,
        "testId": "field-warehouse_id",
        "selector": "[data-testid=\"field-warehouse_id\"]"
      },
      {
        "name": "item_id",
        "label": "物料ID",
        "type": "string",
        "required": true,
        "testId": "field-item_id",
        "selector": "[data-testid=\"field-item_id\"]"
      },
      {
        "name": "change_type",
        "label": "变动类型",
        "type": "string",
        "required": true,
        "testId": "field-change_type",
        "selector": "[data-testid=\"field-change_type\"]"
      },
      {
        "name": "qty_change",
        "label": "变动数量",
        "type": "number",
        "required": true,
        "testId": "field-qty_change",
        "selector": "[data-testid=\"field-qty_change\"]"
      },
      {
        "name": "before_qty",
        "label": "变动前数量",
        "type": "number",
        "required": true,
        "testId": "field-before_qty",
        "selector": "[data-testid=\"field-before_qty\"]"
      },
      {
        "name": "after_qty",
        "label": "变动后数量",
        "type": "number",
        "required": true,
        "testId": "field-after_qty",
        "selector": "[data-testid=\"field-after_qty\"]"
      },
      {
        "name": "ref_order_no",
        "label": "关联单号",
        "type": "string",
        "required": false,
        "testId": "field-ref_order_no",
        "selector": "[data-testid=\"field-ref_order_no\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "wms-inventory-history",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"wms-inventory-history\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"wms-inventory-history-form-overlay\"]",
      "dialog": "[data-testid=\"wms-inventory-history-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "wms-inventory-history:search",
      "reset": "wms-inventory-history:reset",
      "refresh": "wms-inventory-history:refresh",
      "create": "wms-inventory-history:create",
      "edit": "wms-inventory-history:edit",
      "delete": "wms-inventory-history:delete",
      "submit": "wms-inventory-history:submit",
      "cancel": "wms-inventory-history:cancel",
      "close": "wms-inventory-history:close",
      "row": "wms-inventory-history:row",
      "pagination": "wms-inventory-history:pagination",
      "fields": {
        "warehouse_id": "wms-inventory-history:field:warehouse_id",
        "item_id": "wms-inventory-history:field:item_id",
        "change_type": "wms-inventory-history:field:change_type",
        "qty_change": "wms-inventory-history:field:qty_change",
        "before_qty": "wms-inventory-history:field:before_qty",
        "after_qty": "wms-inventory-history:field:after_qty",
        "ref_order_no": "wms-inventory-history:field:ref_order_no"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "wms.wms-inventory-history",
      "examples": [
        "wms.wms-inventory-history__List__Refresh",
        "wms.wms-inventory-history__ListItem__Open",
        "wms.wms-inventory-history__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
