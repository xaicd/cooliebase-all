{
  "$schema": "cooliebase-module-manifest/v1",
  "domain": "mes",
  "id": "cooliebase.mes",
  "apiVersion": 1,
  "displayName": "制造中心",
  "kind": "plugin",
  "stage": "B",
  "owner": "mes",
  "contractVersion": "v1",
  "implementation": "local-ts",
  "minimumHostVersion": "1.0.0",
  "capabilities": [
    "api.routes.register",
    "facade.invoke",
    "rpc.serve",
    "cmd.dispatch",
    "pack.independent"
  ],
  "entrypoints": {
    "facade": [
      "packages/plugins/plugin-mes/contract/mes.facade.ts"
    ],
    "proto": "packages/plugins/plugin-mes/contract/mes.proto",
    "actions": "packages/plugins/plugin-mes/contract/actions.ts"
  },
  "apiRoutes": {
    "publicPrefix": [
      "/api/v1/admin/mes"
    ],
    "adminPrefix": "/api/v1/admin/mes"
  },
  "auth": {
    "audience": "admin",
    "tenantPolicy": "required"
  },
  "messaging": {
    "queueGroup": "cooliebase.mes",
    "commandSubject": "cooliebase.cmd.mes.>",
    "eventSubject": "cooliebase.evt.mes.>"
  },
  "invoke": {
    "colocated": "sdk",
    "remote": "rpc",
    "protocol": "nats-rr",
    "serialization": "json"
  },
  "upstream": {
    "env": "COOLIEBASE_DOMAIN_MES_UPSTREAM",
    "protocol": "http",
    "defaultPort": 3222
  },
  "resilience": {
    "timeoutMs": 8000,
    "retry": {
      "maxAttempts": 1,
      "safeMethodsOnly": true
    },
    "idempotencyRequired": true
  },
  "facadeMethods": [
    "ping",
    "listWorkOrders",
    "reportWork"
  ],
  "rpc": [
    {
      "service": "MesService",
      "method": "Ping"
    },
    {
      "service": "MesService",
      "method": "ListWorkOrders"
    },
    {
      "service": "MesService",
      "method": "ReportWork"
    }
  ],
  "actions": [
    "mes.ping",
    "mes.listWorkOrders",
    "mes.reportWork"
  ],
