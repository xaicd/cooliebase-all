{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mes",
  "entity": "MesMdItem",
  "kebab": "mes-md-item",
  "businessName": "MES 物料产品",
  "permissionPrefix": "mes:mes_md_item",
  "page": {
    "route": "/admin/mes/mes-md-item",
    "title": "MES 物料产品管理",
    "titleSelector": "[data-testid=\"mes-md-item-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mes/api",
    "bffMount": "/api/v1/admin/mes",
    "resource": "mes-md-item",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/mes-md-item",
        "query": [
          "page",
          "pageSize"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/mes-md-item/:id"
      },
      "create": {
        "http": "POST",
        "path": "/mes-md-item"
      },
      "update": {
        "http": "PUT",
        "path": "/mes-md-item/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/mes-md-item/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"mes-md-item-title\"]",
    "refresh": "[data-testid=\"mes-md-item-refresh\"]",
    "createButton": "[data-testid=\"mes-md-item-create\"]",
    "searchForm": "[data-testid=\"mes-md-item-search\"]",
    "searchSubmit": "[data-testid=\"mes-md-item-search-submit\"]",
    "searchReset": "[data-testid=\"mes-md-item-search-reset\"]",
    "total": "[data-testid=\"mes-md-item-total\"]",
    "table": "[data-testid=\"mes-md-item-table\"]",
    "row": "[data-testid=\"mes-md-item-row\"]",
    "editButton": "[data-testid=\"mes-md-item-edit\"]",
    "deleteButton": "[data-testid=\"mes-md-item-delete\"]",
    "form": "[data-testid=\"mes-md-item-form\"]",
    "formError": "[data-testid=\"mes-md-item-form-error\"]",
    "formSubmit": "[data-testid=\"mes-md-item-form-submit\"]",
    "formCancel": "[data-testid=\"mes-md-item-form-cancel\"]",
    "formClose": "[data-testid=\"mes-md-item-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "MES 物料产品列表",
    "dialogLabel": {
      "create": "新增MES 物料产品",
      "edit": "编辑MES 物料产品"
    },
    "searchFields": [],
    "fields": [
      {
        "name": "code",
        "label": "物料编码",
        "type": "string",
        "required": false,
        "testId": "field-code",
        "selector": "[data-testid=\"field-code\"]"
      },
      {
        "name": "name",
        "label": "物料名称",
        "type": "string",
        "required": false,
        "testId": "field-name",
        "selector": "[data-testid=\"field-name\"]"
      },
      {
        "name": "specification",
        "label": "规格型号",
        "type": "string",
        "required": false,
        "testId": "field-specification",
        "selector": "[data-testid=\"field-specification\"]"
      },
      {
        "name": "unit_measure_id",
        "label": "计量单位编号",
        "type": "number",
        "required": false,
        "testId": "field-unit_measure_id",
        "selector": "[data-testid=\"field-unit_measure_id\"]"
      },
      {
        "name": "item_type_id",
        "label": "物料分类编号",
        "type": "number",
        "required": false,
        "testId": "field-item_type_id",
        "selector": "[data-testid=\"field-item_type_id\"]"
      },
      {
        "name": "status",
        "label": "状态",
        "type": "number",
        "required": false,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      },
      {
        "name": "safe_stock_flag",
        "label": "是否启用安全库存",
        "type": "boolean",
        "required": false,
        "testId": "field-safe_stock_flag",
        "selector": "[data-testid=\"field-safe_stock_flag\"]"
      },
      {
        "name": "min_stock",
        "label": "最低库存量",
        "type": "number",
        "required": false,
        "testId": "field-min_stock",
        "selector": "[data-testid=\"field-min_stock\"]"
      },
      {
        "name": "max_stock",
        "label": "最高库存量",
        "type": "number",
        "required": false,
        "testId": "field-max_stock",
        "selector": "[data-testid=\"field-max_stock\"]"
      },
      {
        "name": "high_value",
        "label": "是否高值物料",
        "type": "boolean",
        "required": false,
        "testId": "field-high_value",
        "selector": "[data-testid=\"field-high_value\"]"
      },
      {
        "name": "batch_flag",
        "label": "是否启用批次管理",
        "type": "boolean",
        "required": false,
        "testId": "field-batch_flag",
        "selector": "[data-testid=\"field-batch_flag\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "mes-md-item",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"mes-md-item\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"mes-md-item-form-overlay\"]",
      "dialog": "[data-testid=\"mes-md-item-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "mes-md-item:search",
      "reset": "mes-md-item:reset",
      "refresh": "mes-md-item:refresh",
      "create": "mes-md-item:create",
      "edit": "mes-md-item:edit",
      "delete": "mes-md-item:delete",
      "submit": "mes-md-item:submit",
      "cancel": "mes-md-item:cancel",
      "close": "mes-md-item:close",
      "row": "mes-md-item:row",
      "pagination": "mes-md-item:pagination",
      "fields": {
        "code": "mes-md-item:field:code",
        "name": "mes-md-item:field:name",
        "specification": "mes-md-item:field:specification",
        "unit_measure_id": "mes-md-item:field:unit_measure_id",
        "item_type_id": "mes-md-item:field:item_type_id",
        "status": "mes-md-item:field:status",
        "safe_stock_flag": "mes-md-item:field:safe_stock_flag",
        "min_stock": "mes-md-item:field:min_stock",
        "max_stock": "mes-md-item:field:max_stock",
        "high_value": "mes-md-item:field:high_value",
        "batch_flag": "mes-md-item:field:batch_flag",
        "remark": "mes-md-item:field:remark"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mes.mes-md-item",
      "examples": [
        "mes.mes-md-item__List__Refresh",
        "mes.mes-md-item__ListItem__Open",
        "mes.mes-md-item__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
