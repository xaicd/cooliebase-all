{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mes",
  "entity": "MesMdClient",
  "kebab": "mes-md-client",
  "businessName": "MES 客户",
  "permissionPrefix": "mes:mes_md_client",
  "page": {
    "route": "/admin/mes/mes-md-client",
    "title": "MES 客户管理",
    "titleSelector": "[data-testid=\"mes-md-client-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mes/api",
    "bffMount": "/api/v1/admin/mes",
    "resource": "mes-md-client",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/mes-md-client",
        "query": [
          "page",
          "pageSize",
          "code",
          "name",
          "type",
          "email",
          "status"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/mes-md-client/:id"
      },
      "create": {
        "http": "POST",
        "path": "/mes-md-client"
      },
      "update": {
        "http": "PUT",
        "path": "/mes-md-client/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/mes-md-client/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"mes-md-client-title\"]",
    "refresh": "[data-testid=\"mes-md-client-refresh\"]",
    "createButton": "[data-testid=\"mes-md-client-create\"]",
    "searchForm": "[data-testid=\"mes-md-client-search\"]",
    "searchSubmit": "[data-testid=\"mes-md-client-search-submit\"]",
    "searchReset": "[data-testid=\"mes-md-client-search-reset\"]",
    "total": "[data-testid=\"mes-md-client-total\"]",
    "table": "[data-testid=\"mes-md-client-table\"]",
    "row": "[data-testid=\"mes-md-client-row\"]",
    "editButton": "[data-testid=\"mes-md-client-edit\"]",
    "deleteButton": "[data-testid=\"mes-md-client-delete\"]",
    "form": "[data-testid=\"mes-md-client-form\"]",
    "formError": "[data-testid=\"mes-md-client-form-error\"]",
    "formSubmit": "[data-testid=\"mes-md-client-form-submit\"]",
    "formCancel": "[data-testid=\"mes-md-client-form-cancel\"]",
    "formClose": "[data-testid=\"mes-md-client-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "MES 客户列表",
    "dialogLabel": {
      "create": "新增MES 客户",
      "edit": "编辑MES 客户"
    },
    "searchFields": [
      {
        "name": "code",
        "label": "客户编码",
        "testId": "search-code",
        "selector": "[data-testid=\"search-code\"]"
      },
      {
        "name": "name",
        "label": "客户名称",
        "testId": "search-name",
        "selector": "[data-testid=\"search-name\"]"
      },
      {
        "name": "type",
        "label": "客户类型",
        "testId": "search-type",
        "selector": "[data-testid=\"search-type\"]"
      },
      {
        "name": "email",
        "label": "客户邮箱地址",
        "testId": "search-email",
        "selector": "[data-testid=\"search-email\"]"
      },
      {
        "name": "status",
        "label": "状态",
        "testId": "search-status",
        "selector": "[data-testid=\"search-status\"]"
      }
    ],
    "fields": [
      {
        "name": "code",
        "label": "客户编码",
        "type": "string",
        "required": false,
        "testId": "field-code",
        "selector": "[data-testid=\"field-code\"]"
      },
      {
        "name": "name",
        "label": "客户名称",
        "type": "string",
        "required": false,
        "testId": "field-name",
        "selector": "[data-testid=\"field-name\"]"
      },
      {
        "name": "nickname",
        "label": "客户简称",
        "type": "string",
        "required": false,
        "testId": "field-nickname",
        "selector": "[data-testid=\"field-nickname\"]"
      },
      {
        "name": "english_name",
        "label": "客户英文名称",
        "type": "string",
        "required": false,
        "testId": "field-english_name",
        "selector": "[data-testid=\"field-english_name\"]"
      },
      {
        "name": "description",
        "label": "客户简介",
        "type": "string",
        "required": false,
        "testId": "field-description",
        "selector": "[data-testid=\"field-description\"]"
      },
      {
        "name": "logo",
        "label": "客户LOGO地址",
        "type": "string",
        "required": false,
        "testId": "field-logo",
        "selector": "[data-testid=\"field-logo\"]"
      },
      {
        "name": "type",
        "label": "客户类型",
        "type": "number",
        "required": false,
        "testId": "field-type",
        "selector": "[data-testid=\"field-type\"]"
      },
      {
        "name": "address",
        "label": "客户地址",
        "type": "string",
        "required": false,
        "testId": "field-address",
        "selector": "[data-testid=\"field-address\"]"
      },
      {
        "name": "website",
        "label": "客户官网地址",
        "type": "string",
        "required": false,
        "testId": "field-website",
        "selector": "[data-testid=\"field-website\"]"
      },
      {
        "name": "email",
        "label": "客户邮箱地址",
        "type": "string",
        "required": false,
        "testId": "field-email",
        "selector": "[data-testid=\"field-email\"]"
      },
      {
        "name": "telephone",
        "label": "客户电话",
        "type": "string",
        "required": false,
        "testId": "field-telephone",
        "selector": "[data-testid=\"field-telephone\"]"
      },
      {
        "name": "contact1_name",
        "label": "联系人1",
        "type": "string",
        "required": false,
        "testId": "field-contact1_name",
        "selector": "[data-testid=\"field-contact1_name\"]"
      },
      {
        "name": "contact1_telephone",
        "label": "联系人1-电话",
        "type": "string",
        "required": false,
        "testId": "field-contact1_telephone",
        "selector": "[data-testid=\"field-contact1_telephone\"]"
      },
      {
        "name": "contact1_email",
        "label": "联系人1-邮箱",
        "type": "string",
        "required": false,
        "testId": "field-contact1_email",
        "selector": "[data-testid=\"field-contact1_email\"]"
      },
      {
        "name": "contact2_name",
        "label": "联系人2",
        "type": "string",
        "required": false,
        "testId": "field-contact2_name",
        "selector": "[data-testid=\"field-contact2_name\"]"
      },
      {
        "name": "contact2_telephone",
        "label": "联系人2-电话",
        "type": "string",
        "required": false,
        "testId": "field-contact2_telephone",
        "selector": "[data-testid=\"field-contact2_telephone\"]"
      },
      {
        "name": "contact2_email",
        "label": "联系人2-邮箱",
        "type": "string",
        "required": false,
        "testId": "field-contact2_email",
        "selector": "[data-testid=\"field-contact2_email\"]"
      },
      {
        "name": "credit_code",
        "label": "统一社会信用代码",
        "type": "string",
        "required": false,
        "testId": "field-credit_code",
        "selector": "[data-testid=\"field-credit_code\"]"
      },
      {
        "name": "status",
        "label": "状态",
        "type": "number",
        "required": false,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "mes-md-client",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"mes-md-client\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"mes-md-client-form-overlay\"]",
      "dialog": "[data-testid=\"mes-md-client-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "mes-md-client:search",
      "reset": "mes-md-client:reset",
      "refresh": "mes-md-client:refresh",
      "create": "mes-md-client:create",
      "edit": "mes-md-client:edit",
      "delete": "mes-md-client:delete",
      "submit": "mes-md-client:submit",
      "cancel": "mes-md-client:cancel",
      "close": "mes-md-client:close",
      "row": "mes-md-client:row",
      "pagination": "mes-md-client:pagination",
      "fields": {
        "code": "mes-md-client:field:code",
        "name": "mes-md-client:field:name",
        "nickname": "mes-md-client:field:nickname",
        "english_name": "mes-md-client:field:english_name",
        "description": "mes-md-client:field:description",
        "logo": "mes-md-client:field:logo",
        "type": "mes-md-client:field:type",
        "address": "mes-md-client:field:address",
        "website": "mes-md-client:field:website",
        "email": "mes-md-client:field:email",
        "telephone": "mes-md-client:field:telephone",
        "contact1_name": "mes-md-client:field:contact1_name",
        "contact1_telephone": "mes-md-client:field:contact1_telephone",
        "contact1_email": "mes-md-client:field:contact1_email",
        "contact2_name": "mes-md-client:field:contact2_name",
        "contact2_telephone": "mes-md-client:field:contact2_telephone",
        "contact2_email": "mes-md-client:field:contact2_email",
        "credit_code": "mes-md-client:field:credit_code",
        "status": "mes-md-client:field:status",
        "remark": "mes-md-client:field:remark"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mes.mes-md-client",
      "examples": [
        "mes.mes-md-client__List__Refresh",
        "mes.mes-md-client__ListItem__Open",
        "mes.mes-md-client__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
