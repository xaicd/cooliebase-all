{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mes",
  "entity": "MesCalPlan",
  "kebab": "mes-cal-plan",
  "businessName": "MES 排班计划",
  "permissionPrefix": "mes:mes_cal_plan",
  "page": {
    "route": "/admin/mes/mes-cal-plan",
    "title": "MES 排班计划管理",
    "titleSelector": "[data-testid=\"mes-cal-plan-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mes/api",
    "bffMount": "/api/v1/admin/mes",
    "resource": "mes-cal-plan",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/mes-cal-plan",
        "query": [
          "page",
          "pageSize"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/mes-cal-plan/:id"
      },
      "create": {
        "http": "POST",
        "path": "/mes-cal-plan"
      },
      "update": {
        "http": "PUT",
        "path": "/mes-cal-plan/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/mes-cal-plan/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"mes-cal-plan-title\"]",
    "refresh": "[data-testid=\"mes-cal-plan-refresh\"]",
    "createButton": "[data-testid=\"mes-cal-plan-create\"]",
    "searchForm": "[data-testid=\"mes-cal-plan-search\"]",
    "searchSubmit": "[data-testid=\"mes-cal-plan-search-submit\"]",
    "searchReset": "[data-testid=\"mes-cal-plan-search-reset\"]",
    "total": "[data-testid=\"mes-cal-plan-total\"]",
    "table": "[data-testid=\"mes-cal-plan-table\"]",
    "row": "[data-testid=\"mes-cal-plan-row\"]",
    "editButton": "[data-testid=\"mes-cal-plan-edit\"]",
    "deleteButton": "[data-testid=\"mes-cal-plan-delete\"]",
    "form": "[data-testid=\"mes-cal-plan-form\"]",
    "formError": "[data-testid=\"mes-cal-plan-form-error\"]",
    "formSubmit": "[data-testid=\"mes-cal-plan-form-submit\"]",
    "formCancel": "[data-testid=\"mes-cal-plan-form-cancel\"]",
    "formClose": "[data-testid=\"mes-cal-plan-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "MES 排班计划列表",
    "dialogLabel": {
      "create": "新增MES 排班计划",
      "edit": "编辑MES 排班计划"
    },
    "searchFields": [],
    "fields": [
      {
        "name": "code",
        "label": "计划编码",
        "type": "string",
        "required": false,
        "testId": "field-code",
        "selector": "[data-testid=\"field-code\"]"
      },
      {
        "name": "name",
        "label": "计划名称",
        "type": "string",
        "required": false,
        "testId": "field-name",
        "selector": "[data-testid=\"field-name\"]"
      },
      {
        "name": "calendar_type",
        "label": "班组类型",
        "type": "number",
        "required": false,
        "testId": "field-calendar_type",
        "selector": "[data-testid=\"field-calendar_type\"]"
      },
      {
        "name": "start_date",
        "label": "开始日期",
        "type": "string",
        "required": false,
        "testId": "field-start_date",
        "selector": "[data-testid=\"field-start_date\"]"
      },
      {
        "name": "end_date",
        "label": "结束日期",
        "type": "string",
        "required": false,
        "testId": "field-end_date",
        "selector": "[data-testid=\"field-end_date\"]"
      },
      {
        "name": "shift_type",
        "label": "轮班方式",
        "type": "number",
        "required": false,
        "testId": "field-shift_type",
        "selector": "[data-testid=\"field-shift_type\"]"
      },
      {
        "name": "shift_method",
        "label": "倒班方式",
        "type": "number",
        "required": false,
        "testId": "field-shift_method",
        "selector": "[data-testid=\"field-shift_method\"]"
      },
      {
        "name": "shift_count",
        "label": "倒班天数",
        "type": "number",
        "required": false,
        "testId": "field-shift_count",
        "selector": "[data-testid=\"field-shift_count\"]"
      },
      {
        "name": "status",
        "label": "状态",
        "type": "number",
        "required": false,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "mes-cal-plan",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"mes-cal-plan\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"mes-cal-plan-form-overlay\"]",
      "dialog": "[data-testid=\"mes-cal-plan-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "mes-cal-plan:search",
      "reset": "mes-cal-plan:reset",
      "refresh": "mes-cal-plan:refresh",
      "create": "mes-cal-plan:create",
      "edit": "mes-cal-plan:edit",
      "delete": "mes-cal-plan:delete",
      "submit": "mes-cal-plan:submit",
      "cancel": "mes-cal-plan:cancel",
      "close": "mes-cal-plan:close",
      "row": "mes-cal-plan:row",
      "pagination": "mes-cal-plan:pagination",
      "fields": {
        "code": "mes-cal-plan:field:code",
        "name": "mes-cal-plan:field:name",
        "calendar_type": "mes-cal-plan:field:calendar_type",
        "start_date": "mes-cal-plan:field:start_date",
        "end_date": "mes-cal-plan:field:end_date",
        "shift_type": "mes-cal-plan:field:shift_type",
        "shift_method": "mes-cal-plan:field:shift_method",
        "shift_count": "mes-cal-plan:field:shift_count",
        "status": "mes-cal-plan:field:status",
        "remark": "mes-cal-plan:field:remark"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mes.mes-cal-plan",
      "examples": [
        "mes.mes-cal-plan__List__Refresh",
        "mes.mes-cal-plan__ListItem__Open",
        "mes.mes-cal-plan__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
