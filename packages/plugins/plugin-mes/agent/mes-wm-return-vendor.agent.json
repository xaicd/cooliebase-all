{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mes",
  "entity": "MesWmReturnVendor",
  "kebab": "mes-wm-return-vendor",
  "businessName": "MES 供应商退货单",
  "permissionPrefix": "mes:mes_wm_return_vendor",
  "page": {
    "route": "/admin/mes/mes-wm-return-vendor",
    "title": "MES 供应商退货单管理",
    "titleSelector": "[data-testid=\"mes-wm-return-vendor-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mes/api",
    "bffMount": "/api/v1/admin/mes",
    "resource": "mes-wm-return-vendor",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/mes-wm-return-vendor",
        "query": [
          "page",
          "pageSize"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/mes-wm-return-vendor/:id"
      },
      "create": {
        "http": "POST",
        "path": "/mes-wm-return-vendor"
      },
      "update": {
        "http": "PUT",
        "path": "/mes-wm-return-vendor/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/mes-wm-return-vendor/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"mes-wm-return-vendor-title\"]",
    "refresh": "[data-testid=\"mes-wm-return-vendor-refresh\"]",
    "createButton": "[data-testid=\"mes-wm-return-vendor-create\"]",
    "searchForm": "[data-testid=\"mes-wm-return-vendor-search\"]",
    "searchSubmit": "[data-testid=\"mes-wm-return-vendor-search-submit\"]",
    "searchReset": "[data-testid=\"mes-wm-return-vendor-search-reset\"]",
    "total": "[data-testid=\"mes-wm-return-vendor-total\"]",
    "table": "[data-testid=\"mes-wm-return-vendor-table\"]",
    "row": "[data-testid=\"mes-wm-return-vendor-row\"]",
    "editButton": "[data-testid=\"mes-wm-return-vendor-edit\"]",
    "deleteButton": "[data-testid=\"mes-wm-return-vendor-delete\"]",
    "form": "[data-testid=\"mes-wm-return-vendor-form\"]",
    "formError": "[data-testid=\"mes-wm-return-vendor-form-error\"]",
    "formSubmit": "[data-testid=\"mes-wm-return-vendor-form-submit\"]",
    "formCancel": "[data-testid=\"mes-wm-return-vendor-form-cancel\"]",
    "formClose": "[data-testid=\"mes-wm-return-vendor-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "MES 供应商退货单列表",
    "dialogLabel": {
      "create": "新增MES 供应商退货单",
      "edit": "编辑MES 供应商退货单"
    },
    "searchFields": [],
    "fields": [
      {
        "name": "code",
        "label": "退货单编号",
        "type": "string",
        "required": false,
        "testId": "field-code",
        "selector": "[data-testid=\"field-code\"]"
      },
      {
        "name": "name",
        "label": "退货单名称",
        "type": "string",
        "required": false,
        "testId": "field-name",
        "selector": "[data-testid=\"field-name\"]"
      },
      {
        "name": "purchase_order_code",
        "label": "采购订单编号",
        "type": "string",
        "required": false,
        "testId": "field-purchase_order_code",
        "selector": "[data-testid=\"field-purchase_order_code\"]"
      },
      {
        "name": "vendor_id",
        "label": "供应商 ID",
        "type": "number",
        "required": false,
        "testId": "field-vendor_id",
        "selector": "[data-testid=\"field-vendor_id\"]"
      },
      {
        "name": "return_date",
        "label": "退货日期",
        "type": "string",
        "required": false,
        "testId": "field-return_date",
        "selector": "[data-testid=\"field-return_date\"]"
      },
      {
        "name": "return_reason",
        "label": "退货原因",
        "type": "string",
        "required": false,
        "testId": "field-return_reason",
        "selector": "[data-testid=\"field-return_reason\"]"
      },
      {
        "name": "transport_code",
        "label": "物流单号",
        "type": "string",
        "required": false,
        "testId": "field-transport_code",
        "selector": "[data-testid=\"field-transport_code\"]"
      },
      {
        "name": "transport_telephone",
        "label": "物流联系电话",
        "type": "string",
        "required": false,
        "testId": "field-transport_telephone",
        "selector": "[data-testid=\"field-transport_telephone\"]"
      },
      {
        "name": "status",
        "label": "状态",
        "type": "number",
        "required": false,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "mes-wm-return-vendor",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"mes-wm-return-vendor\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"mes-wm-return-vendor-form-overlay\"]",
      "dialog": "[data-testid=\"mes-wm-return-vendor-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "mes-wm-return-vendor:search",
      "reset": "mes-wm-return-vendor:reset",
      "refresh": "mes-wm-return-vendor:refresh",
      "create": "mes-wm-return-vendor:create",
      "edit": "mes-wm-return-vendor:edit",
      "delete": "mes-wm-return-vendor:delete",
      "submit": "mes-wm-return-vendor:submit",
      "cancel": "mes-wm-return-vendor:cancel",
      "close": "mes-wm-return-vendor:close",
      "row": "mes-wm-return-vendor:row",
      "pagination": "mes-wm-return-vendor:pagination",
      "fields": {
        "code": "mes-wm-return-vendor:field:code",
        "name": "mes-wm-return-vendor:field:name",
        "purchase_order_code": "mes-wm-return-vendor:field:purchase_order_code",
        "vendor_id": "mes-wm-return-vendor:field:vendor_id",
        "return_date": "mes-wm-return-vendor:field:return_date",
        "return_reason": "mes-wm-return-vendor:field:return_reason",
        "transport_code": "mes-wm-return-vendor:field:transport_code",
        "transport_telephone": "mes-wm-return-vendor:field:transport_telephone",
        "status": "mes-wm-return-vendor:field:status",
        "remark": "mes-wm-return-vendor:field:remark"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mes.mes-wm-return-vendor",
      "examples": [
        "mes.mes-wm-return-vendor__List__Refresh",
        "mes.mes-wm-return-vendor__ListItem__Open",
        "mes.mes-wm-return-vendor__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
