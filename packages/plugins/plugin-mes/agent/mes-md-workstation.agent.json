{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mes",
  "entity": "MesMdWorkstation",
  "kebab": "mes-md-workstation",
  "businessName": "MES 工作站",
  "permissionPrefix": "mes:mes_md_workstation",
  "page": {
    "route": "/admin/mes/mes-md-workstation",
    "title": "MES 工作站管理",
    "titleSelector": "[data-testid=\"mes-md-workstation-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mes/api",
    "bffMount": "/api/v1/admin/mes",
    "resource": "mes-md-workstation",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/mes-md-workstation",
        "query": [
          "page",
          "pageSize",
          "code",
          "name",
          "workshop_id",
          "process_id",
          "warehouse_id"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/mes-md-workstation/:id"
      },
      "create": {
        "http": "POST",
        "path": "/mes-md-workstation"
      },
      "update": {
        "http": "PUT",
        "path": "/mes-md-workstation/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/mes-md-workstation/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"mes-md-workstation-title\"]",
    "refresh": "[data-testid=\"mes-md-workstation-refresh\"]",
    "createButton": "[data-testid=\"mes-md-workstation-create\"]",
    "searchForm": "[data-testid=\"mes-md-workstation-search\"]",
    "searchSubmit": "[data-testid=\"mes-md-workstation-search-submit\"]",
    "searchReset": "[data-testid=\"mes-md-workstation-search-reset\"]",
    "total": "[data-testid=\"mes-md-workstation-total\"]",
    "table": "[data-testid=\"mes-md-workstation-table\"]",
    "row": "[data-testid=\"mes-md-workstation-row\"]",
    "editButton": "[data-testid=\"mes-md-workstation-edit\"]",
    "deleteButton": "[data-testid=\"mes-md-workstation-delete\"]",
    "form": "[data-testid=\"mes-md-workstation-form\"]",
    "formError": "[data-testid=\"mes-md-workstation-form-error\"]",
    "formSubmit": "[data-testid=\"mes-md-workstation-form-submit\"]",
    "formCancel": "[data-testid=\"mes-md-workstation-form-cancel\"]",
    "formClose": "[data-testid=\"mes-md-workstation-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "MES 工作站列表",
    "dialogLabel": {
      "create": "新增MES 工作站",
      "edit": "编辑MES 工作站"
    },
    "searchFields": [
      {
        "name": "code",
        "label": "工作站编码",
        "testId": "search-code",
        "selector": "[data-testid=\"search-code\"]"
      },
      {
        "name": "name",
        "label": "工作站名称",
        "testId": "search-name",
        "selector": "[data-testid=\"search-name\"]"
      },
      {
        "name": "workshop_id",
        "label": "所在车间编号",
        "testId": "search-workshop_id",
        "selector": "[data-testid=\"search-workshop_id\"]"
      },
      {
        "name": "process_id",
        "label": "工序编号",
        "testId": "search-process_id",
        "selector": "[data-testid=\"search-process_id\"]"
      },
      {
        "name": "warehouse_id",
        "label": "线边库编号",
        "testId": "search-warehouse_id",
        "selector": "[data-testid=\"search-warehouse_id\"]"
      }
    ],
    "fields": [
      {
        "name": "code",
        "label": "工作站编码",
        "type": "string",
        "required": false,
        "testId": "field-code",
        "selector": "[data-testid=\"field-code\"]"
      },
      {
        "name": "name",
        "label": "工作站名称",
        "type": "string",
        "required": false,
        "testId": "field-name",
        "selector": "[data-testid=\"field-name\"]"
      },
      {
        "name": "address",
        "label": "工作站地点",
        "type": "string",
        "required": false,
        "testId": "field-address",
        "selector": "[data-testid=\"field-address\"]"
      },
      {
        "name": "workshop_id",
        "label": "所在车间编号",
        "type": "string",
        "required": false,
        "testId": "field-workshop_id",
        "selector": "[data-testid=\"field-workshop_id\"]"
      },
      {
        "name": "process_id",
        "label": "工序编号",
        "type": "string",
        "required": false,
        "testId": "field-process_id",
        "selector": "[data-testid=\"field-process_id\"]"
      },
      {
        "name": "warehouse_id",
        "label": "线边库编号",
        "type": "string",
        "required": false,
        "testId": "field-warehouse_id",
        "selector": "[data-testid=\"field-warehouse_id\"]"
      },
      {
        "name": "location_id",
        "label": "库区编号",
        "type": "string",
        "required": false,
        "testId": "field-location_id",
        "selector": "[data-testid=\"field-location_id\"]"
      },
      {
        "name": "area_id",
        "label": "库位编号",
        "type": "string",
        "required": false,
        "testId": "field-area_id",
        "selector": "[data-testid=\"field-area_id\"]"
      },
      {
        "name": "status",
        "label": "状态",
        "type": "number",
        "required": false,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "mes-md-workstation",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"mes-md-workstation\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"mes-md-workstation-form-overlay\"]",
      "dialog": "[data-testid=\"mes-md-workstation-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "mes-md-workstation:search",
      "reset": "mes-md-workstation:reset",
      "refresh": "mes-md-workstation:refresh",
      "create": "mes-md-workstation:create",
      "edit": "mes-md-workstation:edit",
      "delete": "mes-md-workstation:delete",
      "submit": "mes-md-workstation:submit",
      "cancel": "mes-md-workstation:cancel",
      "close": "mes-md-workstation:close",
      "row": "mes-md-workstation:row",
      "pagination": "mes-md-workstation:pagination",
      "fields": {
        "code": "mes-md-workstation:field:code",
        "name": "mes-md-workstation:field:name",
        "address": "mes-md-workstation:field:address",
        "workshop_id": "mes-md-workstation:field:workshop_id",
        "process_id": "mes-md-workstation:field:process_id",
        "warehouse_id": "mes-md-workstation:field:warehouse_id",
        "location_id": "mes-md-workstation:field:location_id",
        "area_id": "mes-md-workstation:field:area_id",
        "status": "mes-md-workstation:field:status",
        "remark": "mes-md-workstation:field:remark"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mes.mes-md-workstation",
      "examples": [
        "mes.mes-md-workstation__List__Refresh",
        "mes.mes-md-workstation__ListItem__Open",
        "mes.mes-md-workstation__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
