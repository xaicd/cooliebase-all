{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mes",
  "entity": "MesQcTemplateIndicator",
  "kebab": "mes-qc-template-indicator",
  "businessName": "MES 质检方案-检测指标项",
  "permissionPrefix": "mes:mes_qc_template_indicator",
  "page": {
    "route": "/admin/mes/mes-qc-template-indicator",
    "title": "MES 质检方案-检测指标项管理",
    "titleSelector": "[data-testid=\"mes-qc-template-indicator-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mes/api",
    "bffMount": "/api/v1/admin/mes",
    "resource": "mes-qc-template-indicator",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/mes-qc-template-indicator",
        "query": [
          "page",
          "pageSize",
          "template_id",
          "indicator_id",
          "unit_measure_id"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/mes-qc-template-indicator/:id"
      },
      "create": {
        "http": "POST",
        "path": "/mes-qc-template-indicator"
      },
      "update": {
        "http": "PUT",
        "path": "/mes-qc-template-indicator/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/mes-qc-template-indicator/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"mes-qc-template-indicator-title\"]",
    "refresh": "[data-testid=\"mes-qc-template-indicator-refresh\"]",
    "createButton": "[data-testid=\"mes-qc-template-indicator-create\"]",
    "searchForm": "[data-testid=\"mes-qc-template-indicator-search\"]",
    "searchSubmit": "[data-testid=\"mes-qc-template-indicator-search-submit\"]",
    "searchReset": "[data-testid=\"mes-qc-template-indicator-search-reset\"]",
    "total": "[data-testid=\"mes-qc-template-indicator-total\"]",
    "table": "[data-testid=\"mes-qc-template-indicator-table\"]",
    "row": "[data-testid=\"mes-qc-template-indicator-row\"]",
    "editButton": "[data-testid=\"mes-qc-template-indicator-edit\"]",
    "deleteButton": "[data-testid=\"mes-qc-template-indicator-delete\"]",
    "form": "[data-testid=\"mes-qc-template-indicator-form\"]",
    "formError": "[data-testid=\"mes-qc-template-indicator-form-error\"]",
    "formSubmit": "[data-testid=\"mes-qc-template-indicator-form-submit\"]",
    "formCancel": "[data-testid=\"mes-qc-template-indicator-form-cancel\"]",
    "formClose": "[data-testid=\"mes-qc-template-indicator-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "MES 质检方案-检测指标项列表",
    "dialogLabel": {
      "create": "新增MES 质检方案-检测指标项",
      "edit": "编辑MES 质检方案-检测指标项"
    },
    "searchFields": [
      {
        "name": "template_id",
        "label": "质检方案编号",
        "testId": "search-template_id",
        "selector": "[data-testid=\"search-template_id\"]"
      },
      {
        "name": "indicator_id",
        "label": "质检指标编号",
        "testId": "search-indicator_id",
        "selector": "[data-testid=\"search-indicator_id\"]"
      },
      {
        "name": "unit_measure_id",
        "label": "计量单位编号",
        "testId": "search-unit_measure_id",
        "selector": "[data-testid=\"search-unit_measure_id\"]"
      }
    ],
    "fields": [
      {
        "name": "template_id",
        "label": "质检方案编号",
        "type": "string",
        "required": false,
        "testId": "field-template_id",
        "selector": "[data-testid=\"field-template_id\"]"
      },
      {
        "name": "indicator_id",
        "label": "质检指标编号",
        "type": "string",
        "required": false,
        "testId": "field-indicator_id",
        "selector": "[data-testid=\"field-indicator_id\"]"
      },
      {
        "name": "check_method",
        "label": "检测方法",
        "type": "string",
        "required": false,
        "testId": "field-check_method",
        "selector": "[data-testid=\"field-check_method\"]"
      },
      {
        "name": "standard_value",
        "label": "标准值",
        "type": "number",
        "required": false,
        "testId": "field-standard_value",
        "selector": "[data-testid=\"field-standard_value\"]"
      },
      {
        "name": "unit_measure_id",
        "label": "计量单位编号",
        "type": "string",
        "required": false,
        "testId": "field-unit_measure_id",
        "selector": "[data-testid=\"field-unit_measure_id\"]"
      },
      {
        "name": "threshold_max",
        "label": "误差上限",
        "type": "number",
        "required": false,
        "testId": "field-threshold_max",
        "selector": "[data-testid=\"field-threshold_max\"]"
      },
      {
        "name": "threshold_min",
        "label": "误差下限",
        "type": "number",
        "required": false,
        "testId": "field-threshold_min",
        "selector": "[data-testid=\"field-threshold_min\"]"
      },
      {
        "name": "doc_url",
        "label": "说明图 URL",
        "type": "string",
        "required": false,
        "testId": "field-doc_url",
        "selector": "[data-testid=\"field-doc_url\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "mes-qc-template-indicator",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"mes-qc-template-indicator\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"mes-qc-template-indicator-form-overlay\"]",
      "dialog": "[data-testid=\"mes-qc-template-indicator-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "mes-qc-template-indicator:search",
      "reset": "mes-qc-template-indicator:reset",
      "refresh": "mes-qc-template-indicator:refresh",
      "create": "mes-qc-template-indicator:create",
      "edit": "mes-qc-template-indicator:edit",
      "delete": "mes-qc-template-indicator:delete",
      "submit": "mes-qc-template-indicator:submit",
      "cancel": "mes-qc-template-indicator:cancel",
      "close": "mes-qc-template-indicator:close",
      "row": "mes-qc-template-indicator:row",
      "pagination": "mes-qc-template-indicator:pagination",
      "fields": {
        "template_id": "mes-qc-template-indicator:field:template_id",
        "indicator_id": "mes-qc-template-indicator:field:indicator_id",
        "check_method": "mes-qc-template-indicator:field:check_method",
        "standard_value": "mes-qc-template-indicator:field:standard_value",
        "unit_measure_id": "mes-qc-template-indicator:field:unit_measure_id",
        "threshold_max": "mes-qc-template-indicator:field:threshold_max",
        "threshold_min": "mes-qc-template-indicator:field:threshold_min",
        "doc_url": "mes-qc-template-indicator:field:doc_url",
        "remark": "mes-qc-template-indicator:field:remark"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mes.mes-qc-template-indicator",
      "examples": [
        "mes.mes-qc-template-indicator__List__Refresh",
        "mes.mes-qc-template-indicator__ListItem__Open",
        "mes.mes-qc-template-indicator__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
