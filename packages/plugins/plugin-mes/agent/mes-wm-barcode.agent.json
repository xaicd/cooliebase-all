{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mes",
  "entity": "MesWmBarcode",
  "kebab": "mes-wm-barcode",
  "businessName": "MES 条码清单",
  "permissionPrefix": "mes:mes_wm_barcode",
  "page": {
    "route": "/admin/mes/mes-wm-barcode",
    "title": "MES 条码清单管理",
    "titleSelector": "[data-testid=\"mes-wm-barcode-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mes/api",
    "bffMount": "/api/v1/admin/mes",
    "resource": "mes-wm-barcode",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/mes-wm-barcode",
        "query": [
          "page",
          "pageSize",
          "config_id",
          "biz_type",
          "biz_id",
          "status"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/mes-wm-barcode/:id"
      },
      "create": {
        "http": "POST",
        "path": "/mes-wm-barcode"
      },
      "update": {
        "http": "PUT",
        "path": "/mes-wm-barcode/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/mes-wm-barcode/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"mes-wm-barcode-title\"]",
    "refresh": "[data-testid=\"mes-wm-barcode-refresh\"]",
    "createButton": "[data-testid=\"mes-wm-barcode-create\"]",
    "searchForm": "[data-testid=\"mes-wm-barcode-search\"]",
    "searchSubmit": "[data-testid=\"mes-wm-barcode-search-submit\"]",
    "searchReset": "[data-testid=\"mes-wm-barcode-search-reset\"]",
    "total": "[data-testid=\"mes-wm-barcode-total\"]",
    "table": "[data-testid=\"mes-wm-barcode-table\"]",
    "row": "[data-testid=\"mes-wm-barcode-row\"]",
    "editButton": "[data-testid=\"mes-wm-barcode-edit\"]",
    "deleteButton": "[data-testid=\"mes-wm-barcode-delete\"]",
    "form": "[data-testid=\"mes-wm-barcode-form\"]",
    "formError": "[data-testid=\"mes-wm-barcode-form-error\"]",
    "formSubmit": "[data-testid=\"mes-wm-barcode-form-submit\"]",
    "formCancel": "[data-testid=\"mes-wm-barcode-form-cancel\"]",
    "formClose": "[data-testid=\"mes-wm-barcode-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "MES 条码清单列表",
    "dialogLabel": {
      "create": "新增MES 条码清单",
      "edit": "编辑MES 条码清单"
    },
    "searchFields": [
      {
        "name": "config_id",
        "label": "条码配置编号",
        "testId": "search-config_id",
        "selector": "[data-testid=\"search-config_id\"]"
      },
      {
        "name": "biz_type",
        "label": "业务类型",
        "testId": "search-biz_type",
        "selector": "[data-testid=\"search-biz_type\"]"
      },
      {
        "name": "biz_id",
        "label": "业务编号",
        "testId": "search-biz_id",
        "selector": "[data-testid=\"search-biz_id\"]"
      },
      {
        "name": "status",
        "label": "状态",
        "testId": "search-status",
        "selector": "[data-testid=\"search-status\"]"
      }
    ],
    "fields": [
      {
        "name": "config_id",
        "label": "条码配置编号",
        "type": "string",
        "required": false,
        "testId": "field-config_id",
        "selector": "[data-testid=\"field-config_id\"]"
      },
      {
        "name": "format",
        "label": "条码格式",
        "type": "number",
        "required": false,
        "testId": "field-format",
        "selector": "[data-testid=\"field-format\"]"
      },
      {
        "name": "biz_type",
        "label": "业务类型",
        "type": "number",
        "required": false,
        "testId": "field-biz_type",
        "selector": "[data-testid=\"field-biz_type\"]"
      },
      {
        "name": "content",
        "label": "条码内容（核心字段，前端根据此内容生成条码图片）",
        "type": "string",
        "required": false,
        "testId": "field-content",
        "selector": "[data-testid=\"field-content\"]"
      },
      {
        "name": "biz_id",
        "label": "业务编号",
        "type": "string",
        "required": false,
        "testId": "field-biz_id",
        "selector": "[data-testid=\"field-biz_id\"]"
      },
      {
        "name": "biz_code",
        "label": "业务编码",
        "type": "string",
        "required": false,
        "testId": "field-biz_code",
        "selector": "[data-testid=\"field-biz_code\"]"
      },
      {
        "name": "biz_name",
        "label": "业务名称",
        "type": "string",
        "required": false,
        "testId": "field-biz_name",
        "selector": "[data-testid=\"field-biz_name\"]"
      },
      {
        "name": "status",
        "label": "状态",
        "type": "number",
        "required": false,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "mes-wm-barcode",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"mes-wm-barcode\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"mes-wm-barcode-form-overlay\"]",
      "dialog": "[data-testid=\"mes-wm-barcode-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "mes-wm-barcode:search",
      "reset": "mes-wm-barcode:reset",
      "refresh": "mes-wm-barcode:refresh",
      "create": "mes-wm-barcode:create",
      "edit": "mes-wm-barcode:edit",
      "delete": "mes-wm-barcode:delete",
      "submit": "mes-wm-barcode:submit",
      "cancel": "mes-wm-barcode:cancel",
      "close": "mes-wm-barcode:close",
      "row": "mes-wm-barcode:row",
      "pagination": "mes-wm-barcode:pagination",
      "fields": {
        "config_id": "mes-wm-barcode:field:config_id",
        "format": "mes-wm-barcode:field:format",
        "biz_type": "mes-wm-barcode:field:biz_type",
        "content": "mes-wm-barcode:field:content",
        "biz_id": "mes-wm-barcode:field:biz_id",
        "biz_code": "mes-wm-barcode:field:biz_code",
        "biz_name": "mes-wm-barcode:field:biz_name",
        "status": "mes-wm-barcode:field:status",
        "remark": "mes-wm-barcode:field:remark"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mes.mes-wm-barcode",
      "examples": [
        "mes.mes-wm-barcode__List__Refresh",
        "mes.mes-wm-barcode__ListItem__Open",
        "mes.mes-wm-barcode__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
