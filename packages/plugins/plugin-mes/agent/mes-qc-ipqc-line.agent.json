{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mes",
  "entity": "MesQcIpqcLine",
  "kebab": "mes-qc-ipqc-line",
  "businessName": "MES 过程检验单行",
  "permissionPrefix": "mes:mes_qc_ipqc_line",
  "page": {
    "route": "/admin/mes/mes-qc-ipqc-line",
    "title": "MES 过程检验单行管理",
    "titleSelector": "[data-testid=\"mes-qc-ipqc-line-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mes/api",
    "bffMount": "/api/v1/admin/mes",
    "resource": "mes-qc-ipqc-line",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/mes-qc-ipqc-line",
        "query": [
          "page",
          "pageSize"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/mes-qc-ipqc-line/:id"
      },
      "create": {
        "http": "POST",
        "path": "/mes-qc-ipqc-line"
      },
      "update": {
        "http": "PUT",
        "path": "/mes-qc-ipqc-line/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/mes-qc-ipqc-line/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"mes-qc-ipqc-line-title\"]",
    "refresh": "[data-testid=\"mes-qc-ipqc-line-refresh\"]",
    "createButton": "[data-testid=\"mes-qc-ipqc-line-create\"]",
    "searchForm": "[data-testid=\"mes-qc-ipqc-line-search\"]",
    "searchSubmit": "[data-testid=\"mes-qc-ipqc-line-search-submit\"]",
    "searchReset": "[data-testid=\"mes-qc-ipqc-line-search-reset\"]",
    "total": "[data-testid=\"mes-qc-ipqc-line-total\"]",
    "table": "[data-testid=\"mes-qc-ipqc-line-table\"]",
    "row": "[data-testid=\"mes-qc-ipqc-line-row\"]",
    "editButton": "[data-testid=\"mes-qc-ipqc-line-edit\"]",
    "deleteButton": "[data-testid=\"mes-qc-ipqc-line-delete\"]",
    "form": "[data-testid=\"mes-qc-ipqc-line-form\"]",
    "formError": "[data-testid=\"mes-qc-ipqc-line-form-error\"]",
    "formSubmit": "[data-testid=\"mes-qc-ipqc-line-form-submit\"]",
    "formCancel": "[data-testid=\"mes-qc-ipqc-line-form-cancel\"]",
    "formClose": "[data-testid=\"mes-qc-ipqc-line-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "MES 过程检验单行列表",
    "dialogLabel": {
      "create": "新增MES 过程检验单行",
      "edit": "编辑MES 过程检验单行"
    },
    "searchFields": [],
    "fields": [
      {
        "name": "ipqc_id",
        "label": "过程检验单 ID",
        "type": "number",
        "required": false,
        "testId": "field-ipqc_id",
        "selector": "[data-testid=\"field-ipqc_id\"]"
      },
      {
        "name": "indicator_id",
        "label": "检测指标 ID",
        "type": "number",
        "required": false,
        "testId": "field-indicator_id",
        "selector": "[data-testid=\"field-indicator_id\"]"
      },
      {
        "name": "tool",
        "label": "检测工具",
        "type": "string",
        "required": false,
        "testId": "field-tool",
        "selector": "[data-testid=\"field-tool\"]"
      },
      {
        "name": "check_method",
        "label": "检测方法",
        "type": "string",
        "required": false,
        "testId": "field-check_method",
        "selector": "[data-testid=\"field-check_method\"]"
      },
      {
        "name": "standard_value",
        "label": "标准值",
        "type": "number",
        "required": false,
        "testId": "field-standard_value",
        "selector": "[data-testid=\"field-standard_value\"]"
      },
      {
        "name": "unit_measure_id",
        "label": "计量单位 ID",
        "type": "number",
        "required": false,
        "testId": "field-unit_measure_id",
        "selector": "[data-testid=\"field-unit_measure_id\"]"
      },
      {
        "name": "max_threshold",
        "label": "误差上限",
        "type": "number",
        "required": false,
        "testId": "field-max_threshold",
        "selector": "[data-testid=\"field-max_threshold\"]"
      },
      {
        "name": "min_threshold",
        "label": "误差下限",
        "type": "number",
        "required": false,
        "testId": "field-min_threshold",
        "selector": "[data-testid=\"field-min_threshold\"]"
      },
      {
        "name": "critical_quantity",
        "label": "致命缺陷数量",
        "type": "number",
        "required": false,
        "testId": "field-critical_quantity",
        "selector": "[data-testid=\"field-critical_quantity\"]"
      },
      {
        "name": "major_quantity",
        "label": "严重缺陷数量",
        "type": "number",
        "required": false,
        "testId": "field-major_quantity",
        "selector": "[data-testid=\"field-major_quantity\"]"
      },
      {
        "name": "minor_quantity",
        "label": "轻微缺陷数量",
        "type": "number",
        "required": false,
        "testId": "field-minor_quantity",
        "selector": "[data-testid=\"field-minor_quantity\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "mes-qc-ipqc-line",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"mes-qc-ipqc-line\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"mes-qc-ipqc-line-form-overlay\"]",
      "dialog": "[data-testid=\"mes-qc-ipqc-line-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "mes-qc-ipqc-line:search",
      "reset": "mes-qc-ipqc-line:reset",
      "refresh": "mes-qc-ipqc-line:refresh",
      "create": "mes-qc-ipqc-line:create",
      "edit": "mes-qc-ipqc-line:edit",
      "delete": "mes-qc-ipqc-line:delete",
      "submit": "mes-qc-ipqc-line:submit",
      "cancel": "mes-qc-ipqc-line:cancel",
      "close": "mes-qc-ipqc-line:close",
      "row": "mes-qc-ipqc-line:row",
      "pagination": "mes-qc-ipqc-line:pagination",
      "fields": {
        "ipqc_id": "mes-qc-ipqc-line:field:ipqc_id",
        "indicator_id": "mes-qc-ipqc-line:field:indicator_id",
        "tool": "mes-qc-ipqc-line:field:tool",
        "check_method": "mes-qc-ipqc-line:field:check_method",
        "standard_value": "mes-qc-ipqc-line:field:standard_value",
        "unit_measure_id": "mes-qc-ipqc-line:field:unit_measure_id",
        "max_threshold": "mes-qc-ipqc-line:field:max_threshold",
        "min_threshold": "mes-qc-ipqc-line:field:min_threshold",
        "critical_quantity": "mes-qc-ipqc-line:field:critical_quantity",
        "major_quantity": "mes-qc-ipqc-line:field:major_quantity",
        "minor_quantity": "mes-qc-ipqc-line:field:minor_quantity",
        "remark": "mes-qc-ipqc-line:field:remark"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mes.mes-qc-ipqc-line",
      "examples": [
        "mes.mes-qc-ipqc-line__List__Refresh",
        "mes.mes-qc-ipqc-line__ListItem__Open",
        "mes.mes-qc-ipqc-line__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
