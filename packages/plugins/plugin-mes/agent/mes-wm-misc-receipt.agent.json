{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mes",
  "entity": "MesWmMiscReceipt",
  "kebab": "mes-wm-misc-receipt",
  "businessName": "MES 杂项入库单",
  "permissionPrefix": "mes:mes_wm_misc_receipt",
  "page": {
    "route": "/admin/mes/mes-wm-misc-receipt",
    "title": "MES 杂项入库单管理",
    "titleSelector": "[data-testid=\"mes-wm-misc-receipt-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mes/api",
    "bffMount": "/api/v1/admin/mes",
    "resource": "mes-wm-misc-receipt",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/mes-wm-misc-receipt",
        "query": [
          "page",
          "pageSize",
          "code",
          "name",
          "type",
          "source_doc_id",
          "status"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/mes-wm-misc-receipt/:id"
      },
      "create": {
        "http": "POST",
        "path": "/mes-wm-misc-receipt"
      },
      "update": {
        "http": "PUT",
        "path": "/mes-wm-misc-receipt/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/mes-wm-misc-receipt/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"mes-wm-misc-receipt-title\"]",
    "refresh": "[data-testid=\"mes-wm-misc-receipt-refresh\"]",
    "createButton": "[data-testid=\"mes-wm-misc-receipt-create\"]",
    "searchForm": "[data-testid=\"mes-wm-misc-receipt-search\"]",
    "searchSubmit": "[data-testid=\"mes-wm-misc-receipt-search-submit\"]",
    "searchReset": "[data-testid=\"mes-wm-misc-receipt-search-reset\"]",
    "total": "[data-testid=\"mes-wm-misc-receipt-total\"]",
    "table": "[data-testid=\"mes-wm-misc-receipt-table\"]",
    "row": "[data-testid=\"mes-wm-misc-receipt-row\"]",
    "editButton": "[data-testid=\"mes-wm-misc-receipt-edit\"]",
    "deleteButton": "[data-testid=\"mes-wm-misc-receipt-delete\"]",
    "form": "[data-testid=\"mes-wm-misc-receipt-form\"]",
    "formError": "[data-testid=\"mes-wm-misc-receipt-form-error\"]",
    "formSubmit": "[data-testid=\"mes-wm-misc-receipt-form-submit\"]",
    "formCancel": "[data-testid=\"mes-wm-misc-receipt-form-cancel\"]",
    "formClose": "[data-testid=\"mes-wm-misc-receipt-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "MES 杂项入库单列表",
    "dialogLabel": {
      "create": "新增MES 杂项入库单",
      "edit": "编辑MES 杂项入库单"
    },
    "searchFields": [
      {
        "name": "code",
        "label": "入库单编码",
        "testId": "search-code",
        "selector": "[data-testid=\"search-code\"]"
      },
      {
        "name": "name",
        "label": "入库单名称",
        "testId": "search-name",
        "selector": "[data-testid=\"search-name\"]"
      },
      {
        "name": "type",
        "label": "杂项类型",
        "testId": "search-type",
        "selector": "[data-testid=\"search-type\"]"
      },
      {
        "name": "source_doc_id",
        "label": "来源单据 ID",
        "testId": "search-source_doc_id",
        "selector": "[data-testid=\"search-source_doc_id\"]"
      },
      {
        "name": "status",
        "label": "状态",
        "testId": "search-status",
        "selector": "[data-testid=\"search-status\"]"
      }
    ],
    "fields": [
      {
        "name": "code",
        "label": "入库单编码",
        "type": "string",
        "required": false,
        "testId": "field-code",
        "selector": "[data-testid=\"field-code\"]"
      },
      {
        "name": "name",
        "label": "入库单名称",
        "type": "string",
        "required": false,
        "testId": "field-name",
        "selector": "[data-testid=\"field-name\"]"
      },
      {
        "name": "type",
        "label": "杂项类型",
        "type": "number",
        "required": false,
        "testId": "field-type",
        "selector": "[data-testid=\"field-type\"]"
      },
      {
        "name": "source_doc_type",
        "label": "来源单据类型",
        "type": "string",
        "required": false,
        "testId": "field-source_doc_type",
        "selector": "[data-testid=\"field-source_doc_type\"]"
      },
      {
        "name": "source_doc_id",
        "label": "来源单据 ID",
        "type": "string",
        "required": false,
        "testId": "field-source_doc_id",
        "selector": "[data-testid=\"field-source_doc_id\"]"
      },
      {
        "name": "source_doc_code",
        "label": "来源单据编码",
        "type": "string",
        "required": false,
        "testId": "field-source_doc_code",
        "selector": "[data-testid=\"field-source_doc_code\"]"
      },
      {
        "name": "receipt_date",
        "label": "入库日期",
        "type": "string",
        "required": false,
        "testId": "field-receipt_date",
        "selector": "[data-testid=\"field-receipt_date\"]"
      },
      {
        "name": "status",
        "label": "状态",
        "type": "number",
        "required": false,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "mes-wm-misc-receipt",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"mes-wm-misc-receipt\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"mes-wm-misc-receipt-form-overlay\"]",
      "dialog": "[data-testid=\"mes-wm-misc-receipt-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "mes-wm-misc-receipt:search",
      "reset": "mes-wm-misc-receipt:reset",
      "refresh": "mes-wm-misc-receipt:refresh",
      "create": "mes-wm-misc-receipt:create",
      "edit": "mes-wm-misc-receipt:edit",
      "delete": "mes-wm-misc-receipt:delete",
      "submit": "mes-wm-misc-receipt:submit",
      "cancel": "mes-wm-misc-receipt:cancel",
      "close": "mes-wm-misc-receipt:close",
      "row": "mes-wm-misc-receipt:row",
      "pagination": "mes-wm-misc-receipt:pagination",
      "fields": {
        "code": "mes-wm-misc-receipt:field:code",
        "name": "mes-wm-misc-receipt:field:name",
        "type": "mes-wm-misc-receipt:field:type",
        "source_doc_type": "mes-wm-misc-receipt:field:source_doc_type",
        "source_doc_id": "mes-wm-misc-receipt:field:source_doc_id",
        "source_doc_code": "mes-wm-misc-receipt:field:source_doc_code",
        "receipt_date": "mes-wm-misc-receipt:field:receipt_date",
        "status": "mes-wm-misc-receipt:field:status",
        "remark": "mes-wm-misc-receipt:field:remark"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mes.mes-wm-misc-receipt",
      "examples": [
        "mes.mes-wm-misc-receipt__List__Refresh",
        "mes.mes-wm-misc-receipt__ListItem__Open",
        "mes.mes-wm-misc-receipt__Form__Submit"
      ]
    }
  },
  "enums": {
    "status": {
      "type": "enum",
      "values": [
        "0",
        "3",
        "4",
        "5"
      ],
      "labels": {
        "0": "草稿",
        "3": "待执行入库",
        "4": "已完成",
        "5": "已取消"
      },
      "description": "状态"
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
