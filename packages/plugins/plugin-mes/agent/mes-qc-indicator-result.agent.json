{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mes",
  "entity": "MesQcIndicatorResult",
  "kebab": "mes-qc-indicator-result",
  "businessName": "MES 检验结果记录",
  "permissionPrefix": "mes:mes_qc_indicator_result",
  "page": {
    "route": "/admin/mes/mes-qc-indicator-result",
    "title": "MES 检验结果记录管理",
    "titleSelector": "[data-testid=\"mes-qc-indicator-result-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mes/api",
    "bffMount": "/api/v1/admin/mes",
    "resource": "mes-qc-indicator-result",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/mes-qc-indicator-result",
        "query": [
          "page",
          "pageSize"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/mes-qc-indicator-result/:id"
      },
      "create": {
        "http": "POST",
        "path": "/mes-qc-indicator-result"
      },
      "update": {
        "http": "PUT",
        "path": "/mes-qc-indicator-result/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/mes-qc-indicator-result/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"mes-qc-indicator-result-title\"]",
    "refresh": "[data-testid=\"mes-qc-indicator-result-refresh\"]",
    "createButton": "[data-testid=\"mes-qc-indicator-result-create\"]",
    "searchForm": "[data-testid=\"mes-qc-indicator-result-search\"]",
    "searchSubmit": "[data-testid=\"mes-qc-indicator-result-search-submit\"]",
    "searchReset": "[data-testid=\"mes-qc-indicator-result-search-reset\"]",
    "total": "[data-testid=\"mes-qc-indicator-result-total\"]",
    "table": "[data-testid=\"mes-qc-indicator-result-table\"]",
    "row": "[data-testid=\"mes-qc-indicator-result-row\"]",
    "editButton": "[data-testid=\"mes-qc-indicator-result-edit\"]",
    "deleteButton": "[data-testid=\"mes-qc-indicator-result-delete\"]",
    "form": "[data-testid=\"mes-qc-indicator-result-form\"]",
    "formError": "[data-testid=\"mes-qc-indicator-result-form-error\"]",
    "formSubmit": "[data-testid=\"mes-qc-indicator-result-form-submit\"]",
    "formCancel": "[data-testid=\"mes-qc-indicator-result-form-cancel\"]",
    "formClose": "[data-testid=\"mes-qc-indicator-result-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "MES 检验结果记录列表",
    "dialogLabel": {
      "create": "新增MES 检验结果记录",
      "edit": "编辑MES 检验结果记录"
    },
    "searchFields": [],
    "fields": [
      {
        "name": "code",
        "label": "样品编号",
        "type": "string",
        "required": false,
        "testId": "field-code",
        "selector": "[data-testid=\"field-code\"]"
      },
      {
        "name": "qc_id",
        "label": "关联质检单 ID（IQC/IPQC/OQC/RQC 的 id）",
        "type": "number",
        "required": false,
        "testId": "field-qc_id",
        "selector": "[data-testid=\"field-qc_id\"]"
      },
      {
        "name": "qc_type",
        "label": "质检类型",
        "type": "number",
        "required": false,
        "testId": "field-qc_type",
        "selector": "[data-testid=\"field-qc_type\"]"
      },
      {
        "name": "item_id",
        "label": "产品物料 ID",
        "type": "number",
        "required": false,
        "testId": "field-item_id",
        "selector": "[data-testid=\"field-item_id\"]"
      },
      {
        "name": "sn",
        "label": "物资 SN",
        "type": "string",
        "required": false,
        "testId": "field-sn",
        "selector": "[data-testid=\"field-sn\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "mes-qc-indicator-result",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"mes-qc-indicator-result\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"mes-qc-indicator-result-form-overlay\"]",
      "dialog": "[data-testid=\"mes-qc-indicator-result-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "mes-qc-indicator-result:search",
      "reset": "mes-qc-indicator-result:reset",
      "refresh": "mes-qc-indicator-result:refresh",
      "create": "mes-qc-indicator-result:create",
      "edit": "mes-qc-indicator-result:edit",
      "delete": "mes-qc-indicator-result:delete",
      "submit": "mes-qc-indicator-result:submit",
      "cancel": "mes-qc-indicator-result:cancel",
      "close": "mes-qc-indicator-result:close",
      "row": "mes-qc-indicator-result:row",
      "pagination": "mes-qc-indicator-result:pagination",
      "fields": {
        "code": "mes-qc-indicator-result:field:code",
        "qc_id": "mes-qc-indicator-result:field:qc_id",
        "qc_type": "mes-qc-indicator-result:field:qc_type",
        "item_id": "mes-qc-indicator-result:field:item_id",
        "sn": "mes-qc-indicator-result:field:sn",
        "remark": "mes-qc-indicator-result:field:remark"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mes.mes-qc-indicator-result",
      "examples": [
        "mes.mes-qc-indicator-result__List__Refresh",
        "mes.mes-qc-indicator-result__ListItem__Open",
        "mes.mes-qc-indicator-result__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
