{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mes",
  "entity": "MesWmWarehouseLocation",
  "kebab": "mes-wm-warehouse-location",
  "businessName": "MES 库区",
  "permissionPrefix": "mes:mes_wm_warehouse_location",
  "page": {
    "route": "/admin/mes/mes-wm-warehouse-location",
    "title": "MES 库区管理",
    "titleSelector": "[data-testid=\"mes-wm-warehouse-location-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mes/api",
    "bffMount": "/api/v1/admin/mes",
    "resource": "mes-wm-warehouse-location",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/mes-wm-warehouse-location",
        "query": [
          "page",
          "pageSize"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/mes-wm-warehouse-location/:id"
      },
      "create": {
        "http": "POST",
        "path": "/mes-wm-warehouse-location"
      },
      "update": {
        "http": "PUT",
        "path": "/mes-wm-warehouse-location/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/mes-wm-warehouse-location/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"mes-wm-warehouse-location-title\"]",
    "refresh": "[data-testid=\"mes-wm-warehouse-location-refresh\"]",
    "createButton": "[data-testid=\"mes-wm-warehouse-location-create\"]",
    "searchForm": "[data-testid=\"mes-wm-warehouse-location-search\"]",
    "searchSubmit": "[data-testid=\"mes-wm-warehouse-location-search-submit\"]",
    "searchReset": "[data-testid=\"mes-wm-warehouse-location-search-reset\"]",
    "total": "[data-testid=\"mes-wm-warehouse-location-total\"]",
    "table": "[data-testid=\"mes-wm-warehouse-location-table\"]",
    "row": "[data-testid=\"mes-wm-warehouse-location-row\"]",
    "editButton": "[data-testid=\"mes-wm-warehouse-location-edit\"]",
    "deleteButton": "[data-testid=\"mes-wm-warehouse-location-delete\"]",
    "form": "[data-testid=\"mes-wm-warehouse-location-form\"]",
    "formError": "[data-testid=\"mes-wm-warehouse-location-form-error\"]",
    "formSubmit": "[data-testid=\"mes-wm-warehouse-location-form-submit\"]",
    "formCancel": "[data-testid=\"mes-wm-warehouse-location-form-cancel\"]",
    "formClose": "[data-testid=\"mes-wm-warehouse-location-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "MES 库区列表",
    "dialogLabel": {
      "create": "新增MES 库区",
      "edit": "编辑MES 库区"
    },
    "searchFields": [],
    "fields": [
      {
        "name": "code",
        "label": "库区编码",
        "type": "string",
        "required": false,
        "testId": "field-code",
        "selector": "[data-testid=\"field-code\"]"
      },
      {
        "name": "name",
        "label": "库区名称",
        "type": "string",
        "required": false,
        "testId": "field-name",
        "selector": "[data-testid=\"field-name\"]"
      },
      {
        "name": "warehouse_id",
        "label": "仓库编号",
        "type": "number",
        "required": false,
        "testId": "field-warehouse_id",
        "selector": "[data-testid=\"field-warehouse_id\"]"
      },
      {
        "name": "area",
        "label": "面积",
        "type": "number",
        "required": false,
        "testId": "field-area",
        "selector": "[data-testid=\"field-area\"]"
      },
      {
        "name": "frozen",
        "label": "是否冻结",
        "type": "boolean",
        "required": false,
        "testId": "field-frozen",
        "selector": "[data-testid=\"field-frozen\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "mes-wm-warehouse-location",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"mes-wm-warehouse-location\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"mes-wm-warehouse-location-form-overlay\"]",
      "dialog": "[data-testid=\"mes-wm-warehouse-location-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "mes-wm-warehouse-location:search",
      "reset": "mes-wm-warehouse-location:reset",
      "refresh": "mes-wm-warehouse-location:refresh",
      "create": "mes-wm-warehouse-location:create",
      "edit": "mes-wm-warehouse-location:edit",
      "delete": "mes-wm-warehouse-location:delete",
      "submit": "mes-wm-warehouse-location:submit",
      "cancel": "mes-wm-warehouse-location:cancel",
      "close": "mes-wm-warehouse-location:close",
      "row": "mes-wm-warehouse-location:row",
      "pagination": "mes-wm-warehouse-location:pagination",
      "fields": {
        "code": "mes-wm-warehouse-location:field:code",
        "name": "mes-wm-warehouse-location:field:name",
        "warehouse_id": "mes-wm-warehouse-location:field:warehouse_id",
        "area": "mes-wm-warehouse-location:field:area",
        "frozen": "mes-wm-warehouse-location:field:frozen",
        "remark": "mes-wm-warehouse-location:field:remark"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mes.mes-wm-warehouse-location",
      "examples": [
        "mes.mes-wm-warehouse-location__List__Refresh",
        "mes.mes-wm-warehouse-location__ListItem__Open",
        "mes.mes-wm-warehouse-location__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
