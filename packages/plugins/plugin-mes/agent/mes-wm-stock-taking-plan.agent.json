{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mes",
  "entity": "MesWmStockTakingPlan",
  "kebab": "mes-wm-stock-taking-plan",
  "businessName": "MES 盘点方案",
  "permissionPrefix": "mes:mes_wm_stock_taking_plan",
  "page": {
    "route": "/admin/mes/mes-wm-stock-taking-plan",
    "title": "MES 盘点方案管理",
    "titleSelector": "[data-testid=\"mes-wm-stock-taking-plan-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mes/api",
    "bffMount": "/api/v1/admin/mes",
    "resource": "mes-wm-stock-taking-plan",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/mes-wm-stock-taking-plan",
        "query": [
          "page",
          "pageSize",
          "code",
          "name",
          "type",
          "status"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/mes-wm-stock-taking-plan/:id"
      },
      "create": {
        "http": "POST",
        "path": "/mes-wm-stock-taking-plan"
      },
      "update": {
        "http": "PUT",
        "path": "/mes-wm-stock-taking-plan/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/mes-wm-stock-taking-plan/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"mes-wm-stock-taking-plan-title\"]",
    "refresh": "[data-testid=\"mes-wm-stock-taking-plan-refresh\"]",
    "createButton": "[data-testid=\"mes-wm-stock-taking-plan-create\"]",
    "searchForm": "[data-testid=\"mes-wm-stock-taking-plan-search\"]",
    "searchSubmit": "[data-testid=\"mes-wm-stock-taking-plan-search-submit\"]",
    "searchReset": "[data-testid=\"mes-wm-stock-taking-plan-search-reset\"]",
    "total": "[data-testid=\"mes-wm-stock-taking-plan-total\"]",
    "table": "[data-testid=\"mes-wm-stock-taking-plan-table\"]",
    "row": "[data-testid=\"mes-wm-stock-taking-plan-row\"]",
    "editButton": "[data-testid=\"mes-wm-stock-taking-plan-edit\"]",
    "deleteButton": "[data-testid=\"mes-wm-stock-taking-plan-delete\"]",
    "form": "[data-testid=\"mes-wm-stock-taking-plan-form\"]",
    "formError": "[data-testid=\"mes-wm-stock-taking-plan-form-error\"]",
    "formSubmit": "[data-testid=\"mes-wm-stock-taking-plan-form-submit\"]",
    "formCancel": "[data-testid=\"mes-wm-stock-taking-plan-form-cancel\"]",
    "formClose": "[data-testid=\"mes-wm-stock-taking-plan-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "MES 盘点方案列表",
    "dialogLabel": {
      "create": "新增MES 盘点方案",
      "edit": "编辑MES 盘点方案"
    },
    "searchFields": [
      {
        "name": "code",
        "label": "方案编码",
        "testId": "search-code",
        "selector": "[data-testid=\"search-code\"]"
      },
      {
        "name": "name",
        "label": "方案名称",
        "testId": "search-name",
        "selector": "[data-testid=\"search-name\"]"
      },
      {
        "name": "type",
        "label": "盘点类型",
        "testId": "search-type",
        "selector": "[data-testid=\"search-type\"]"
      },
      {
        "name": "status",
        "label": "状态",
        "testId": "search-status",
        "selector": "[data-testid=\"search-status\"]"
      }
    ],
    "fields": [
      {
        "name": "code",
        "label": "方案编码",
        "type": "string",
        "required": false,
        "testId": "field-code",
        "selector": "[data-testid=\"field-code\"]"
      },
      {
        "name": "name",
        "label": "方案名称",
        "type": "string",
        "required": false,
        "testId": "field-name",
        "selector": "[data-testid=\"field-name\"]"
      },
      {
        "name": "type",
        "label": "盘点类型",
        "type": "number",
        "required": false,
        "testId": "field-type",
        "selector": "[data-testid=\"field-type\"]"
      },
      {
        "name": "start_time",
        "label": "计划开始时间",
        "type": "string",
        "required": false,
        "testId": "field-start_time",
        "selector": "[data-testid=\"field-start_time\"]"
      },
      {
        "name": "end_time",
        "label": "计划结束时间",
        "type": "string",
        "required": false,
        "testId": "field-end_time",
        "selector": "[data-testid=\"field-end_time\"]"
      },
      {
        "name": "blind_flag",
        "label": "是否盲盘",
        "type": "boolean",
        "required": false,
        "testId": "field-blind_flag",
        "selector": "[data-testid=\"field-blind_flag\"]"
      },
      {
        "name": "frozen",
        "label": "是否冻结库存",
        "type": "boolean",
        "required": false,
        "testId": "field-frozen",
        "selector": "[data-testid=\"field-frozen\"]"
      },
      {
        "name": "status",
        "label": "状态",
        "type": "number",
        "required": false,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "mes-wm-stock-taking-plan",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"mes-wm-stock-taking-plan\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"mes-wm-stock-taking-plan-form-overlay\"]",
      "dialog": "[data-testid=\"mes-wm-stock-taking-plan-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "mes-wm-stock-taking-plan:search",
      "reset": "mes-wm-stock-taking-plan:reset",
      "refresh": "mes-wm-stock-taking-plan:refresh",
      "create": "mes-wm-stock-taking-plan:create",
      "edit": "mes-wm-stock-taking-plan:edit",
      "delete": "mes-wm-stock-taking-plan:delete",
      "submit": "mes-wm-stock-taking-plan:submit",
      "cancel": "mes-wm-stock-taking-plan:cancel",
      "close": "mes-wm-stock-taking-plan:close",
      "row": "mes-wm-stock-taking-plan:row",
      "pagination": "mes-wm-stock-taking-plan:pagination",
      "fields": {
        "code": "mes-wm-stock-taking-plan:field:code",
        "name": "mes-wm-stock-taking-plan:field:name",
        "type": "mes-wm-stock-taking-plan:field:type",
        "start_time": "mes-wm-stock-taking-plan:field:start_time",
        "end_time": "mes-wm-stock-taking-plan:field:end_time",
        "blind_flag": "mes-wm-stock-taking-plan:field:blind_flag",
        "frozen": "mes-wm-stock-taking-plan:field:frozen",
        "status": "mes-wm-stock-taking-plan:field:status",
        "remark": "mes-wm-stock-taking-plan:field:remark"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mes.mes-wm-stock-taking-plan",
      "examples": [
        "mes.mes-wm-stock-taking-plan__List__Refresh",
        "mes.mes-wm-stock-taking-plan__ListItem__Open",
        "mes.mes-wm-stock-taking-plan__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
