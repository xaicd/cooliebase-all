{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mes",
  "entity": "MesDvMaintenRecordLine",
  "kebab": "mes-dv-mainten-record-line",
  "businessName": "MES 设备保养记录明细",
  "permissionPrefix": "mes:mes_dv_mainten_record_line",
  "page": {
    "route": "/admin/mes/mes-dv-mainten-record-line",
    "title": "MES 设备保养记录明细管理",
    "titleSelector": "[data-testid=\"mes-dv-mainten-record-line-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mes/api",
    "bffMount": "/api/v1/admin/mes",
    "resource": "mes-dv-mainten-record-line",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/mes-dv-mainten-record-line",
        "query": [
          "page",
          "pageSize"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/mes-dv-mainten-record-line/:id"
      },
      "create": {
        "http": "POST",
        "path": "/mes-dv-mainten-record-line"
      },
      "update": {
        "http": "PUT",
        "path": "/mes-dv-mainten-record-line/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/mes-dv-mainten-record-line/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"mes-dv-mainten-record-line-title\"]",
    "refresh": "[data-testid=\"mes-dv-mainten-record-line-refresh\"]",
    "createButton": "[data-testid=\"mes-dv-mainten-record-line-create\"]",
    "searchForm": "[data-testid=\"mes-dv-mainten-record-line-search\"]",
    "searchSubmit": "[data-testid=\"mes-dv-mainten-record-line-search-submit\"]",
    "searchReset": "[data-testid=\"mes-dv-mainten-record-line-search-reset\"]",
    "total": "[data-testid=\"mes-dv-mainten-record-line-total\"]",
    "table": "[data-testid=\"mes-dv-mainten-record-line-table\"]",
    "row": "[data-testid=\"mes-dv-mainten-record-line-row\"]",
    "editButton": "[data-testid=\"mes-dv-mainten-record-line-edit\"]",
    "deleteButton": "[data-testid=\"mes-dv-mainten-record-line-delete\"]",
    "form": "[data-testid=\"mes-dv-mainten-record-line-form\"]",
    "formError": "[data-testid=\"mes-dv-mainten-record-line-form-error\"]",
    "formSubmit": "[data-testid=\"mes-dv-mainten-record-line-form-submit\"]",
    "formCancel": "[data-testid=\"mes-dv-mainten-record-line-form-cancel\"]",
    "formClose": "[data-testid=\"mes-dv-mainten-record-line-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "MES 设备保养记录明细列表",
    "dialogLabel": {
      "create": "新增MES 设备保养记录明细",
      "edit": "编辑MES 设备保养记录明细"
    },
    "searchFields": [],
    "fields": [
      {
        "name": "record_id",
        "label": "保养记录编号",
        "type": "number",
        "required": false,
        "testId": "field-record_id",
        "selector": "[data-testid=\"field-record_id\"]"
      },
      {
        "name": "subject_id",
        "label": "项目编号",
        "type": "number",
        "required": false,
        "testId": "field-subject_id",
        "selector": "[data-testid=\"field-subject_id\"]"
      },
      {
        "name": "status",
        "label": "保养结果",
        "type": "number",
        "required": false,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      },
      {
        "name": "result",
        "label": "异常描述",
        "type": "string",
        "required": false,
        "testId": "field-result",
        "selector": "[data-testid=\"field-result\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "mes-dv-mainten-record-line",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"mes-dv-mainten-record-line\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"mes-dv-mainten-record-line-form-overlay\"]",
      "dialog": "[data-testid=\"mes-dv-mainten-record-line-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "mes-dv-mainten-record-line:search",
      "reset": "mes-dv-mainten-record-line:reset",
      "refresh": "mes-dv-mainten-record-line:refresh",
      "create": "mes-dv-mainten-record-line:create",
      "edit": "mes-dv-mainten-record-line:edit",
      "delete": "mes-dv-mainten-record-line:delete",
      "submit": "mes-dv-mainten-record-line:submit",
      "cancel": "mes-dv-mainten-record-line:cancel",
      "close": "mes-dv-mainten-record-line:close",
      "row": "mes-dv-mainten-record-line:row",
      "pagination": "mes-dv-mainten-record-line:pagination",
      "fields": {
        "record_id": "mes-dv-mainten-record-line:field:record_id",
        "subject_id": "mes-dv-mainten-record-line:field:subject_id",
        "status": "mes-dv-mainten-record-line:field:status",
        "result": "mes-dv-mainten-record-line:field:result",
        "remark": "mes-dv-mainten-record-line:field:remark"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mes.mes-dv-mainten-record-line",
      "examples": [
        "mes.mes-dv-mainten-record-line__List__Refresh",
        "mes.mes-dv-mainten-record-line__ListItem__Open",
        "mes.mes-dv-mainten-record-line__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
