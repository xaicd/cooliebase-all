{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mes",
  "entity": "MesWmBarcodeConfig",
  "kebab": "mes-wm-barcode-config",
  "businessName": "MES 条码配置",
  "permissionPrefix": "mes:mes_wm_barcode_config",
  "page": {
    "route": "/admin/mes/mes-wm-barcode-config",
    "title": "MES 条码配置管理",
    "titleSelector": "[data-testid=\"mes-wm-barcode-config-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mes/api",
    "bffMount": "/api/v1/admin/mes",
    "resource": "mes-wm-barcode-config",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/mes-wm-barcode-config",
        "query": [
          "page",
          "pageSize",
          "biz_type",
          "status"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/mes-wm-barcode-config/:id"
      },
      "create": {
        "http": "POST",
        "path": "/mes-wm-barcode-config"
      },
      "update": {
        "http": "PUT",
        "path": "/mes-wm-barcode-config/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/mes-wm-barcode-config/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"mes-wm-barcode-config-title\"]",
    "refresh": "[data-testid=\"mes-wm-barcode-config-refresh\"]",
    "createButton": "[data-testid=\"mes-wm-barcode-config-create\"]",
    "searchForm": "[data-testid=\"mes-wm-barcode-config-search\"]",
    "searchSubmit": "[data-testid=\"mes-wm-barcode-config-search-submit\"]",
    "searchReset": "[data-testid=\"mes-wm-barcode-config-search-reset\"]",
    "total": "[data-testid=\"mes-wm-barcode-config-total\"]",
    "table": "[data-testid=\"mes-wm-barcode-config-table\"]",
    "row": "[data-testid=\"mes-wm-barcode-config-row\"]",
    "editButton": "[data-testid=\"mes-wm-barcode-config-edit\"]",
    "deleteButton": "[data-testid=\"mes-wm-barcode-config-delete\"]",
    "form": "[data-testid=\"mes-wm-barcode-config-form\"]",
    "formError": "[data-testid=\"mes-wm-barcode-config-form-error\"]",
    "formSubmit": "[data-testid=\"mes-wm-barcode-config-form-submit\"]",
    "formCancel": "[data-testid=\"mes-wm-barcode-config-form-cancel\"]",
    "formClose": "[data-testid=\"mes-wm-barcode-config-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "MES 条码配置列表",
    "dialogLabel": {
      "create": "新增MES 条码配置",
      "edit": "编辑MES 条码配置"
    },
    "searchFields": [
      {
        "name": "biz_type",
        "label": "业务类型",
        "testId": "search-biz_type",
        "selector": "[data-testid=\"search-biz_type\"]"
      },
      {
        "name": "status",
        "label": "状态",
        "testId": "search-status",
        "selector": "[data-testid=\"search-status\"]"
      }
    ],
    "fields": [
      {
        "name": "format",
        "label": "条码格式",
        "type": "number",
        "required": false,
        "testId": "field-format",
        "selector": "[data-testid=\"field-format\"]"
      },
      {
        "name": "biz_type",
        "label": "业务类型",
        "type": "number",
        "required": false,
        "testId": "field-biz_type",
        "selector": "[data-testid=\"field-biz_type\"]"
      },
      {
        "name": "content_format",
        "label": "内容格式模板（支持 BUSINESSCODE 占位符）",
        "type": "string",
        "required": false,
        "testId": "field-content_format",
        "selector": "[data-testid=\"field-content_format\"]"
      },
      {
        "name": "content_example",
        "label": "内容样例",
        "type": "string",
        "required": false,
        "testId": "field-content_example",
        "selector": "[data-testid=\"field-content_example\"]"
      },
      {
        "name": "auto_generate_flag",
        "label": "是否自动生成",
        "type": "boolean",
        "required": false,
        "testId": "field-auto_generate_flag",
        "selector": "[data-testid=\"field-auto_generate_flag\"]"
      },
      {
        "name": "default_template",
        "label": "默认打印模板",
        "type": "string",
        "required": false,
        "testId": "field-default_template",
        "selector": "[data-testid=\"field-default_template\"]"
      },
      {
        "name": "status",
        "label": "状态",
        "type": "number",
        "required": false,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "mes-wm-barcode-config",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"mes-wm-barcode-config\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"mes-wm-barcode-config-form-overlay\"]",
      "dialog": "[data-testid=\"mes-wm-barcode-config-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "mes-wm-barcode-config:search",
      "reset": "mes-wm-barcode-config:reset",
      "refresh": "mes-wm-barcode-config:refresh",
      "create": "mes-wm-barcode-config:create",
      "edit": "mes-wm-barcode-config:edit",
      "delete": "mes-wm-barcode-config:delete",
      "submit": "mes-wm-barcode-config:submit",
      "cancel": "mes-wm-barcode-config:cancel",
      "close": "mes-wm-barcode-config:close",
      "row": "mes-wm-barcode-config:row",
      "pagination": "mes-wm-barcode-config:pagination",
      "fields": {
        "format": "mes-wm-barcode-config:field:format",
        "biz_type": "mes-wm-barcode-config:field:biz_type",
        "content_format": "mes-wm-barcode-config:field:content_format",
        "content_example": "mes-wm-barcode-config:field:content_example",
        "auto_generate_flag": "mes-wm-barcode-config:field:auto_generate_flag",
        "default_template": "mes-wm-barcode-config:field:default_template",
        "status": "mes-wm-barcode-config:field:status",
        "remark": "mes-wm-barcode-config:field:remark"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mes.mes-wm-barcode-config",
      "examples": [
        "mes.mes-wm-barcode-config__List__Refresh",
        "mes.mes-wm-barcode-config__ListItem__Open",
        "mes.mes-wm-barcode-config__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
