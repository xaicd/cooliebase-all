{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mes",
  "entity": "MesProAndonRecord",
  "kebab": "mes-pro-andon-record",
  "businessName": "MES 安灯呼叫记录",
  "permissionPrefix": "mes:mes_pro_andon_record",
  "page": {
    "route": "/admin/mes/mes-pro-andon-record",
    "title": "MES 安灯呼叫记录管理",
    "titleSelector": "[data-testid=\"mes-pro-andon-record-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mes/api",
    "bffMount": "/api/v1/admin/mes",
    "resource": "mes-pro-andon-record",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/mes-pro-andon-record",
        "query": [
          "page",
          "pageSize",
          "config_id",
          "workstation_id",
          "user_id",
          "work_order_id",
          "process_id"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/mes-pro-andon-record/:id"
      },
      "create": {
        "http": "POST",
        "path": "/mes-pro-andon-record"
      },
      "update": {
        "http": "PUT",
        "path": "/mes-pro-andon-record/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/mes-pro-andon-record/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"mes-pro-andon-record-title\"]",
    "refresh": "[data-testid=\"mes-pro-andon-record-refresh\"]",
    "createButton": "[data-testid=\"mes-pro-andon-record-create\"]",
    "searchForm": "[data-testid=\"mes-pro-andon-record-search\"]",
    "searchSubmit": "[data-testid=\"mes-pro-andon-record-search-submit\"]",
    "searchReset": "[data-testid=\"mes-pro-andon-record-search-reset\"]",
    "total": "[data-testid=\"mes-pro-andon-record-total\"]",
    "table": "[data-testid=\"mes-pro-andon-record-table\"]",
    "row": "[data-testid=\"mes-pro-andon-record-row\"]",
    "editButton": "[data-testid=\"mes-pro-andon-record-edit\"]",
    "deleteButton": "[data-testid=\"mes-pro-andon-record-delete\"]",
    "form": "[data-testid=\"mes-pro-andon-record-form\"]",
    "formError": "[data-testid=\"mes-pro-andon-record-form-error\"]",
    "formSubmit": "[data-testid=\"mes-pro-andon-record-form-submit\"]",
    "formCancel": "[data-testid=\"mes-pro-andon-record-form-cancel\"]",
    "formClose": "[data-testid=\"mes-pro-andon-record-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "MES 安灯呼叫记录列表",
    "dialogLabel": {
      "create": "新增MES 安灯呼叫记录",
      "edit": "编辑MES 安灯呼叫记录"
    },
    "searchFields": [
      {
        "name": "config_id",
        "label": "安灯配置编号",
        "testId": "search-config_id",
        "selector": "[data-testid=\"search-config_id\"]"
      },
      {
        "name": "workstation_id",
        "label": "工作站编号",
        "testId": "search-workstation_id",
        "selector": "[data-testid=\"search-workstation_id\"]"
      },
      {
        "name": "user_id",
        "label": "发起用户编号",
        "testId": "search-user_id",
        "selector": "[data-testid=\"search-user_id\"]"
      },
      {
        "name": "work_order_id",
        "label": "生产工单编号",
        "testId": "search-work_order_id",
        "selector": "[data-testid=\"search-work_order_id\"]"
      },
      {
        "name": "process_id",
        "label": "工序编号",
        "testId": "search-process_id",
        "selector": "[data-testid=\"search-process_id\"]"
      }
    ],
    "fields": [
      {
        "name": "config_id",
        "label": "安灯配置编号",
        "type": "string",
        "required": false,
        "testId": "field-config_id",
        "selector": "[data-testid=\"field-config_id\"]"
      },
      {
        "name": "workstation_id",
        "label": "工作站编号",
        "type": "string",
        "required": false,
        "testId": "field-workstation_id",
        "selector": "[data-testid=\"field-workstation_id\"]"
      },
      {
        "name": "user_id",
        "label": "发起用户编号",
        "type": "string",
        "required": false,
        "testId": "field-user_id",
        "selector": "[data-testid=\"field-user_id\"]"
      },
      {
        "name": "work_order_id",
        "label": "生产工单编号",
        "type": "string",
        "required": false,
        "testId": "field-work_order_id",
        "selector": "[data-testid=\"field-work_order_id\"]"
      },
      {
        "name": "process_id",
        "label": "工序编号",
        "type": "string",
        "required": false,
        "testId": "field-process_id",
        "selector": "[data-testid=\"field-process_id\"]"
      },
      {
        "name": "reason",
        "label": "呼叫原因（快照值，不随配置变更）",
        "type": "string",
        "required": false,
        "testId": "field-reason",
        "selector": "[data-testid=\"field-reason\"]"
      },
      {
        "name": "level",
        "label": "级别（快照值）",
        "type": "number",
        "required": false,
        "testId": "field-level",
        "selector": "[data-testid=\"field-level\"]"
      },
      {
        "name": "status",
        "label": "处置状态",
        "type": "number",
        "required": false,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      },
      {
        "name": "handle_time",
        "label": "处置时间",
        "type": "string",
        "required": false,
        "testId": "field-handle_time",
        "selector": "[data-testid=\"field-handle_time\"]"
      },
      {
        "name": "handler_user_id",
        "label": "处置人编号",
        "type": "string",
        "required": false,
        "testId": "field-handler_user_id",
        "selector": "[data-testid=\"field-handler_user_id\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "mes-pro-andon-record",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"mes-pro-andon-record\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"mes-pro-andon-record-form-overlay\"]",
      "dialog": "[data-testid=\"mes-pro-andon-record-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "mes-pro-andon-record:search",
      "reset": "mes-pro-andon-record:reset",
      "refresh": "mes-pro-andon-record:refresh",
      "create": "mes-pro-andon-record:create",
      "edit": "mes-pro-andon-record:edit",
      "delete": "mes-pro-andon-record:delete",
      "submit": "mes-pro-andon-record:submit",
      "cancel": "mes-pro-andon-record:cancel",
      "close": "mes-pro-andon-record:close",
      "row": "mes-pro-andon-record:row",
      "pagination": "mes-pro-andon-record:pagination",
      "fields": {
        "config_id": "mes-pro-andon-record:field:config_id",
        "workstation_id": "mes-pro-andon-record:field:workstation_id",
        "user_id": "mes-pro-andon-record:field:user_id",
        "work_order_id": "mes-pro-andon-record:field:work_order_id",
        "process_id": "mes-pro-andon-record:field:process_id",
        "reason": "mes-pro-andon-record:field:reason",
        "level": "mes-pro-andon-record:field:level",
        "status": "mes-pro-andon-record:field:status",
        "handle_time": "mes-pro-andon-record:field:handle_time",
        "handler_user_id": "mes-pro-andon-record:field:handler_user_id",
        "remark": "mes-pro-andon-record:field:remark"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mes.mes-pro-andon-record",
      "examples": [
        "mes.mes-pro-andon-record__List__Refresh",
        "mes.mes-pro-andon-record__ListItem__Open",
        "mes.mes-pro-andon-record__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
