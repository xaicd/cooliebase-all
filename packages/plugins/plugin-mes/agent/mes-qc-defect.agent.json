{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mes",
  "entity": "MesQcDefect",
  "kebab": "mes-qc-defect",
  "businessName": "MES 缺陷类型",
  "permissionPrefix": "mes:mes_qc_defect",
  "page": {
    "route": "/admin/mes/mes-qc-defect",
    "title": "MES 缺陷类型管理",
    "titleSelector": "[data-testid=\"mes-qc-defect-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mes/api",
    "bffMount": "/api/v1/admin/mes",
    "resource": "mes-qc-defect",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/mes-qc-defect",
        "query": [
          "page",
          "pageSize",
          "code",
          "name",
          "type",
          "level"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/mes-qc-defect/:id"
      },
      "create": {
        "http": "POST",
        "path": "/mes-qc-defect"
      },
      "update": {
        "http": "PUT",
        "path": "/mes-qc-defect/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/mes-qc-defect/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"mes-qc-defect-title\"]",
    "refresh": "[data-testid=\"mes-qc-defect-refresh\"]",
    "createButton": "[data-testid=\"mes-qc-defect-create\"]",
    "searchForm": "[data-testid=\"mes-qc-defect-search\"]",
    "searchSubmit": "[data-testid=\"mes-qc-defect-search-submit\"]",
    "searchReset": "[data-testid=\"mes-qc-defect-search-reset\"]",
    "total": "[data-testid=\"mes-qc-defect-total\"]",
    "table": "[data-testid=\"mes-qc-defect-table\"]",
    "row": "[data-testid=\"mes-qc-defect-row\"]",
    "editButton": "[data-testid=\"mes-qc-defect-edit\"]",
    "deleteButton": "[data-testid=\"mes-qc-defect-delete\"]",
    "form": "[data-testid=\"mes-qc-defect-form\"]",
    "formError": "[data-testid=\"mes-qc-defect-form-error\"]",
    "formSubmit": "[data-testid=\"mes-qc-defect-form-submit\"]",
    "formCancel": "[data-testid=\"mes-qc-defect-form-cancel\"]",
    "formClose": "[data-testid=\"mes-qc-defect-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "MES 缺陷类型列表",
    "dialogLabel": {
      "create": "新增MES 缺陷类型",
      "edit": "编辑MES 缺陷类型"
    },
    "searchFields": [
      {
        "name": "code",
        "label": "缺陷编码",
        "testId": "search-code",
        "selector": "[data-testid=\"search-code\"]"
      },
      {
        "name": "name",
        "label": "缺陷描述",
        "testId": "search-name",
        "selector": "[data-testid=\"search-name\"]"
      },
      {
        "name": "type",
        "label": "检测项类型",
        "testId": "search-type",
        "selector": "[data-testid=\"search-type\"]"
      },
      {
        "name": "level",
        "label": "缺陷等级",
        "testId": "search-level",
        "selector": "[data-testid=\"search-level\"]"
      }
    ],
    "fields": [
      {
        "name": "code",
        "label": "缺陷编码",
        "type": "string",
        "required": false,
        "testId": "field-code",
        "selector": "[data-testid=\"field-code\"]"
      },
      {
        "name": "name",
        "label": "缺陷描述",
        "type": "string",
        "required": false,
        "testId": "field-name",
        "selector": "[data-testid=\"field-name\"]"
      },
      {
        "name": "type",
        "label": "检测项类型",
        "type": "number",
        "required": false,
        "testId": "field-type",
        "selector": "[data-testid=\"field-type\"]"
      },
      {
        "name": "level",
        "label": "缺陷等级",
        "type": "number",
        "required": false,
        "testId": "field-level",
        "selector": "[data-testid=\"field-level\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "mes-qc-defect",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"mes-qc-defect\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"mes-qc-defect-form-overlay\"]",
      "dialog": "[data-testid=\"mes-qc-defect-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "mes-qc-defect:search",
      "reset": "mes-qc-defect:reset",
      "refresh": "mes-qc-defect:refresh",
      "create": "mes-qc-defect:create",
      "edit": "mes-qc-defect:edit",
      "delete": "mes-qc-defect:delete",
      "submit": "mes-qc-defect:submit",
      "cancel": "mes-qc-defect:cancel",
      "close": "mes-qc-defect:close",
      "row": "mes-qc-defect:row",
      "pagination": "mes-qc-defect:pagination",
      "fields": {
        "code": "mes-qc-defect:field:code",
        "name": "mes-qc-defect:field:name",
        "type": "mes-qc-defect:field:type",
        "level": "mes-qc-defect:field:level",
        "remark": "mes-qc-defect:field:remark"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mes.mes-qc-defect",
      "examples": [
        "mes.mes-qc-defect__List__Refresh",
        "mes.mes-qc-defect__ListItem__Open",
        "mes.mes-qc-defect__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
