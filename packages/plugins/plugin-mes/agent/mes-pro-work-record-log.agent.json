{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mes",
  "entity": "MesProWorkRecordLog",
  "kebab": "mes-pro-work-record-log",
  "businessName": "MES 上下工记录流水",
  "permissionPrefix": "mes:mes_pro_work_record_log",
  "page": {
    "route": "/admin/mes/mes-pro-work-record-log",
    "title": "MES 上下工记录流水管理",
    "titleSelector": "[data-testid=\"mes-pro-work-record-log-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mes/api",
    "bffMount": "/api/v1/admin/mes",
    "resource": "mes-pro-work-record-log",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/mes-pro-work-record-log",
        "query": [
          "page",
          "pageSize"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/mes-pro-work-record-log/:id"
      },
      "create": {
        "http": "POST",
        "path": "/mes-pro-work-record-log"
      },
      "update": {
        "http": "PUT",
        "path": "/mes-pro-work-record-log/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/mes-pro-work-record-log/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"mes-pro-work-record-log-title\"]",
    "refresh": "[data-testid=\"mes-pro-work-record-log-refresh\"]",
    "createButton": "[data-testid=\"mes-pro-work-record-log-create\"]",
    "searchForm": "[data-testid=\"mes-pro-work-record-log-search\"]",
    "searchSubmit": "[data-testid=\"mes-pro-work-record-log-search-submit\"]",
    "searchReset": "[data-testid=\"mes-pro-work-record-log-search-reset\"]",
    "total": "[data-testid=\"mes-pro-work-record-log-total\"]",
    "table": "[data-testid=\"mes-pro-work-record-log-table\"]",
    "row": "[data-testid=\"mes-pro-work-record-log-row\"]",
    "editButton": "[data-testid=\"mes-pro-work-record-log-edit\"]",
    "deleteButton": "[data-testid=\"mes-pro-work-record-log-delete\"]",
    "form": "[data-testid=\"mes-pro-work-record-log-form\"]",
    "formError": "[data-testid=\"mes-pro-work-record-log-form-error\"]",
    "formSubmit": "[data-testid=\"mes-pro-work-record-log-form-submit\"]",
    "formCancel": "[data-testid=\"mes-pro-work-record-log-form-cancel\"]",
    "formClose": "[data-testid=\"mes-pro-work-record-log-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "MES 上下工记录流水列表",
    "dialogLabel": {
      "create": "新增MES 上下工记录流水",
      "edit": "编辑MES 上下工记录流水"
    },
    "searchFields": [],
    "fields": [
      {
        "name": "user_id",
        "label": "用户编号",
        "type": "number",
        "required": false,
        "testId": "field-user_id",
        "selector": "[data-testid=\"field-user_id\"]"
      },
      {
        "name": "workstation_id",
        "label": "工作站编号",
        "type": "number",
        "required": false,
        "testId": "field-workstation_id",
        "selector": "[data-testid=\"field-workstation_id\"]"
      },
      {
        "name": "type",
        "label": "操作类型",
        "type": "number",
        "required": false,
        "testId": "field-type",
        "selector": "[data-testid=\"field-type\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "mes-pro-work-record-log",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"mes-pro-work-record-log\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"mes-pro-work-record-log-form-overlay\"]",
      "dialog": "[data-testid=\"mes-pro-work-record-log-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "mes-pro-work-record-log:search",
      "reset": "mes-pro-work-record-log:reset",
      "refresh": "mes-pro-work-record-log:refresh",
      "create": "mes-pro-work-record-log:create",
      "edit": "mes-pro-work-record-log:edit",
      "delete": "mes-pro-work-record-log:delete",
      "submit": "mes-pro-work-record-log:submit",
      "cancel": "mes-pro-work-record-log:cancel",
      "close": "mes-pro-work-record-log:close",
      "row": "mes-pro-work-record-log:row",
      "pagination": "mes-pro-work-record-log:pagination",
      "fields": {
        "user_id": "mes-pro-work-record-log:field:user_id",
        "workstation_id": "mes-pro-work-record-log:field:workstation_id",
        "type": "mes-pro-work-record-log:field:type",
        "remark": "mes-pro-work-record-log:field:remark"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mes.mes-pro-work-record-log",
      "examples": [
        "mes.mes-pro-work-record-log__List__Refresh",
        "mes.mes-pro-work-record-log__ListItem__Open",
        "mes.mes-pro-work-record-log__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
