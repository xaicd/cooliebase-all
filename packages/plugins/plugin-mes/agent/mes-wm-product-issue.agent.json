{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mes",
  "entity": "MesWmProductIssue",
  "kebab": "mes-wm-product-issue",
  "businessName": "MES 领料出库单",
  "permissionPrefix": "mes:mes_wm_product_issue",
  "page": {
    "route": "/admin/mes/mes-wm-product-issue",
    "title": "MES 领料出库单管理",
    "titleSelector": "[data-testid=\"mes-wm-product-issue-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mes/api",
    "bffMount": "/api/v1/admin/mes",
    "resource": "mes-wm-product-issue",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/mes-wm-product-issue",
        "query": [
          "page",
          "pageSize",
          "code",
          "name",
          "workstation_id",
          "work_order_id",
          "task_id"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/mes-wm-product-issue/:id"
      },
      "create": {
        "http": "POST",
        "path": "/mes-wm-product-issue"
      },
      "update": {
        "http": "PUT",
        "path": "/mes-wm-product-issue/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/mes-wm-product-issue/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"mes-wm-product-issue-title\"]",
    "refresh": "[data-testid=\"mes-wm-product-issue-refresh\"]",
    "createButton": "[data-testid=\"mes-wm-product-issue-create\"]",
    "searchForm": "[data-testid=\"mes-wm-product-issue-search\"]",
    "searchSubmit": "[data-testid=\"mes-wm-product-issue-search-submit\"]",
    "searchReset": "[data-testid=\"mes-wm-product-issue-search-reset\"]",
    "total": "[data-testid=\"mes-wm-product-issue-total\"]",
    "table": "[data-testid=\"mes-wm-product-issue-table\"]",
    "row": "[data-testid=\"mes-wm-product-issue-row\"]",
    "editButton": "[data-testid=\"mes-wm-product-issue-edit\"]",
    "deleteButton": "[data-testid=\"mes-wm-product-issue-delete\"]",
    "form": "[data-testid=\"mes-wm-product-issue-form\"]",
    "formError": "[data-testid=\"mes-wm-product-issue-form-error\"]",
    "formSubmit": "[data-testid=\"mes-wm-product-issue-form-submit\"]",
    "formCancel": "[data-testid=\"mes-wm-product-issue-form-cancel\"]",
    "formClose": "[data-testid=\"mes-wm-product-issue-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "MES 领料出库单列表",
    "dialogLabel": {
      "create": "新增MES 领料出库单",
      "edit": "编辑MES 领料出库单"
    },
    "searchFields": [
      {
        "name": "code",
        "label": "领料单编号",
        "testId": "search-code",
        "selector": "[data-testid=\"search-code\"]"
      },
      {
        "name": "name",
        "label": "领料单名称",
        "testId": "search-name",
        "selector": "[data-testid=\"search-name\"]"
      },
      {
        "name": "workstation_id",
        "label": "工作站 ID",
        "testId": "search-workstation_id",
        "selector": "[data-testid=\"search-workstation_id\"]"
      },
      {
        "name": "work_order_id",
        "label": "生产工单 ID",
        "testId": "search-work_order_id",
        "selector": "[data-testid=\"search-work_order_id\"]"
      },
      {
        "name": "task_id",
        "label": "生产任务 ID",
        "testId": "search-task_id",
        "selector": "[data-testid=\"search-task_id\"]"
      }
    ],
    "fields": [
      {
        "name": "code",
        "label": "领料单编号",
        "type": "string",
        "required": false,
        "testId": "field-code",
        "selector": "[data-testid=\"field-code\"]"
      },
      {
        "name": "name",
        "label": "领料单名称",
        "type": "string",
        "required": false,
        "testId": "field-name",
        "selector": "[data-testid=\"field-name\"]"
      },
      {
        "name": "workstation_id",
        "label": "工作站 ID",
        "type": "string",
        "required": false,
        "testId": "field-workstation_id",
        "selector": "[data-testid=\"field-workstation_id\"]"
      },
      {
        "name": "work_order_id",
        "label": "生产工单 ID",
        "type": "string",
        "required": false,
        "testId": "field-work_order_id",
        "selector": "[data-testid=\"field-work_order_id\"]"
      },
      {
        "name": "task_id",
        "label": "生产任务 ID",
        "type": "string",
        "required": false,
        "testId": "field-task_id",
        "selector": "[data-testid=\"field-task_id\"]"
      },
      {
        "name": "issue_date",
        "label": "领料日期",
        "type": "string",
        "required": false,
        "testId": "field-issue_date",
        "selector": "[data-testid=\"field-issue_date\"]"
      },
      {
        "name": "required_time",
        "label": "需求时间",
        "type": "string",
        "required": false,
        "testId": "field-required_time",
        "selector": "[data-testid=\"field-required_time\"]"
      },
      {
        "name": "status",
        "label": "状态",
        "type": "number",
        "required": false,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "mes-wm-product-issue",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"mes-wm-product-issue\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"mes-wm-product-issue-form-overlay\"]",
      "dialog": "[data-testid=\"mes-wm-product-issue-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "mes-wm-product-issue:search",
      "reset": "mes-wm-product-issue:reset",
      "refresh": "mes-wm-product-issue:refresh",
      "create": "mes-wm-product-issue:create",
      "edit": "mes-wm-product-issue:edit",
      "delete": "mes-wm-product-issue:delete",
      "submit": "mes-wm-product-issue:submit",
      "cancel": "mes-wm-product-issue:cancel",
      "close": "mes-wm-product-issue:close",
      "row": "mes-wm-product-issue:row",
      "pagination": "mes-wm-product-issue:pagination",
      "fields": {
        "code": "mes-wm-product-issue:field:code",
        "name": "mes-wm-product-issue:field:name",
        "workstation_id": "mes-wm-product-issue:field:workstation_id",
        "work_order_id": "mes-wm-product-issue:field:work_order_id",
        "task_id": "mes-wm-product-issue:field:task_id",
        "issue_date": "mes-wm-product-issue:field:issue_date",
        "required_time": "mes-wm-product-issue:field:required_time",
        "status": "mes-wm-product-issue:field:status",
        "remark": "mes-wm-product-issue:field:remark"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mes.mes-wm-product-issue",
      "examples": [
        "mes.mes-wm-product-issue__List__Refresh",
        "mes.mes-wm-product-issue__ListItem__Open",
        "mes.mes-wm-product-issue__Form__Submit"
      ]
    }
  },
  "enums": {
    "status": {
      "type": "enum",
      "values": [
        "0",
        "2",
        "3",
        "4",
        "5"
      ],
      "labels": {
        "0": "草稿",
        "2": "待拣货",
        "3": "待执行领出",
        "4": "已完成",
        "5": "已取消"
      },
      "description": "状态"
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
