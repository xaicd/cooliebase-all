{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mes",
  "entity": "MesMdItemBatchConfig",
  "kebab": "mes-md-item-batch-config",
  "businessName": "MES 物料批次属性配置",
  "permissionPrefix": "mes:mes_md_item_batch_config",
  "page": {
    "route": "/admin/mes/mes-md-item-batch-config",
    "title": "MES 物料批次属性配置管理",
    "titleSelector": "[data-testid=\"mes-md-item-batch-config-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mes/api",
    "bffMount": "/api/v1/admin/mes",
    "resource": "mes-md-item-batch-config",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/mes-md-item-batch-config",
        "query": [
          "page",
          "pageSize",
          "item_id"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/mes-md-item-batch-config/:id"
      },
      "create": {
        "http": "POST",
        "path": "/mes-md-item-batch-config"
      },
      "update": {
        "http": "PUT",
        "path": "/mes-md-item-batch-config/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/mes-md-item-batch-config/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"mes-md-item-batch-config-title\"]",
    "refresh": "[data-testid=\"mes-md-item-batch-config-refresh\"]",
    "createButton": "[data-testid=\"mes-md-item-batch-config-create\"]",
    "searchForm": "[data-testid=\"mes-md-item-batch-config-search\"]",
    "searchSubmit": "[data-testid=\"mes-md-item-batch-config-search-submit\"]",
    "searchReset": "[data-testid=\"mes-md-item-batch-config-search-reset\"]",
    "total": "[data-testid=\"mes-md-item-batch-config-total\"]",
    "table": "[data-testid=\"mes-md-item-batch-config-table\"]",
    "row": "[data-testid=\"mes-md-item-batch-config-row\"]",
    "editButton": "[data-testid=\"mes-md-item-batch-config-edit\"]",
    "deleteButton": "[data-testid=\"mes-md-item-batch-config-delete\"]",
    "form": "[data-testid=\"mes-md-item-batch-config-form\"]",
    "formError": "[data-testid=\"mes-md-item-batch-config-form-error\"]",
    "formSubmit": "[data-testid=\"mes-md-item-batch-config-form-submit\"]",
    "formCancel": "[data-testid=\"mes-md-item-batch-config-form-cancel\"]",
    "formClose": "[data-testid=\"mes-md-item-batch-config-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "MES 物料批次属性配置列表",
    "dialogLabel": {
      "create": "新增MES 物料批次属性配置",
      "edit": "编辑MES 物料批次属性配置"
    },
    "searchFields": [
      {
        "name": "item_id",
        "label": "物料编号",
        "testId": "search-item_id",
        "selector": "[data-testid=\"search-item_id\"]"
      }
    ],
    "fields": [
      {
        "name": "item_id",
        "label": "物料编号",
        "type": "string",
        "required": false,
        "testId": "field-item_id",
        "selector": "[data-testid=\"field-item_id\"]"
      },
      {
        "name": "produce_date_flag",
        "label": "批次属性-生产日期",
        "type": "boolean",
        "required": false,
        "testId": "field-produce_date_flag",
        "selector": "[data-testid=\"field-produce_date_flag\"]"
      },
      {
        "name": "expire_date_flag",
        "label": "批次属性-有效期",
        "type": "boolean",
        "required": false,
        "testId": "field-expire_date_flag",
        "selector": "[data-testid=\"field-expire_date_flag\"]"
      },
      {
        "name": "receipt_date_flag",
        "label": "批次属性-入库日期",
        "type": "boolean",
        "required": false,
        "testId": "field-receipt_date_flag",
        "selector": "[data-testid=\"field-receipt_date_flag\"]"
      },
      {
        "name": "vendor_flag",
        "label": "批次属性-供应商",
        "type": "boolean",
        "required": false,
        "testId": "field-vendor_flag",
        "selector": "[data-testid=\"field-vendor_flag\"]"
      },
      {
        "name": "client_flag",
        "label": "批次属性-客户",
        "type": "boolean",
        "required": false,
        "testId": "field-client_flag",
        "selector": "[data-testid=\"field-client_flag\"]"
      },
      {
        "name": "sales_order_code_flag",
        "label": "批次属性-销售订单编号",
        "type": "boolean",
        "required": false,
        "testId": "field-sales_order_code_flag",
        "selector": "[data-testid=\"field-sales_order_code_flag\"]"
      },
      {
        "name": "purchase_order_code_flag",
        "label": "批次属性-采购订单编号",
        "type": "boolean",
        "required": false,
        "testId": "field-purchase_order_code_flag",
        "selector": "[data-testid=\"field-purchase_order_code_flag\"]"
      },
      {
        "name": "work_order_flag",
        "label": "批次属性-生产工单",
        "type": "boolean",
        "required": false,
        "testId": "field-work_order_flag",
        "selector": "[data-testid=\"field-work_order_flag\"]"
      },
      {
        "name": "task_flag",
        "label": "批次属性-生产任务",
        "type": "boolean",
        "required": false,
        "testId": "field-task_flag",
        "selector": "[data-testid=\"field-task_flag\"]"
      },
      {
        "name": "workstation_flag",
        "label": "批次属性-工作站",
        "type": "boolean",
        "required": false,
        "testId": "field-workstation_flag",
        "selector": "[data-testid=\"field-workstation_flag\"]"
      },
      {
        "name": "tool_flag",
        "label": "批次属性-工具",
        "type": "boolean",
        "required": false,
        "testId": "field-tool_flag",
        "selector": "[data-testid=\"field-tool_flag\"]"
      },
      {
        "name": "mold_flag",
        "label": "批次属性-模具",
        "type": "boolean",
        "required": false,
        "testId": "field-mold_flag",
        "selector": "[data-testid=\"field-mold_flag\"]"
      },
      {
        "name": "lot_number_flag",
        "label": "批次属性-生产批号",
        "type": "boolean",
        "required": false,
        "testId": "field-lot_number_flag",
        "selector": "[data-testid=\"field-lot_number_flag\"]"
      },
      {
        "name": "quality_status_flag",
        "label": "批次属性-质量状态",
        "type": "boolean",
        "required": false,
        "testId": "field-quality_status_flag",
        "selector": "[data-testid=\"field-quality_status_flag\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "mes-md-item-batch-config",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"mes-md-item-batch-config\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"mes-md-item-batch-config-form-overlay\"]",
      "dialog": "[data-testid=\"mes-md-item-batch-config-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "mes-md-item-batch-config:search",
      "reset": "mes-md-item-batch-config:reset",
      "refresh": "mes-md-item-batch-config:refresh",
      "create": "mes-md-item-batch-config:create",
      "edit": "mes-md-item-batch-config:edit",
      "delete": "mes-md-item-batch-config:delete",
      "submit": "mes-md-item-batch-config:submit",
      "cancel": "mes-md-item-batch-config:cancel",
      "close": "mes-md-item-batch-config:close",
      "row": "mes-md-item-batch-config:row",
      "pagination": "mes-md-item-batch-config:pagination",
      "fields": {
        "item_id": "mes-md-item-batch-config:field:item_id",
        "produce_date_flag": "mes-md-item-batch-config:field:produce_date_flag",
        "expire_date_flag": "mes-md-item-batch-config:field:expire_date_flag",
        "receipt_date_flag": "mes-md-item-batch-config:field:receipt_date_flag",
        "vendor_flag": "mes-md-item-batch-config:field:vendor_flag",
        "client_flag": "mes-md-item-batch-config:field:client_flag",
        "sales_order_code_flag": "mes-md-item-batch-config:field:sales_order_code_flag",
        "purchase_order_code_flag": "mes-md-item-batch-config:field:purchase_order_code_flag",
        "work_order_flag": "mes-md-item-batch-config:field:work_order_flag",
        "task_flag": "mes-md-item-batch-config:field:task_flag",
        "workstation_flag": "mes-md-item-batch-config:field:workstation_flag",
        "tool_flag": "mes-md-item-batch-config:field:tool_flag",
        "mold_flag": "mes-md-item-batch-config:field:mold_flag",
        "lot_number_flag": "mes-md-item-batch-config:field:lot_number_flag",
        "quality_status_flag": "mes-md-item-batch-config:field:quality_status_flag"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mes.mes-md-item-batch-config",
      "examples": [
        "mes.mes-md-item-batch-config__List__Refresh",
        "mes.mes-md-item-batch-config__ListItem__Open",
        "mes.mes-md-item-batch-config__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
