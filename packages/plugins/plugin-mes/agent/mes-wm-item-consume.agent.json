{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mes",
  "entity": "MesWmItemConsume",
  "kebab": "mes-wm-item-consume",
  "businessName": "MES 物料消耗记录",
  "permissionPrefix": "mes:mes_wm_item_consume",
  "page": {
    "route": "/admin/mes/mes-wm-item-consume",
    "title": "MES 物料消耗记录管理",
    "titleSelector": "[data-testid=\"mes-wm-item-consume-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mes/api",
    "bffMount": "/api/v1/admin/mes",
    "resource": "mes-wm-item-consume",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/mes-wm-item-consume",
        "query": [
          "page",
          "pageSize",
          "work_order_id",
          "task_id",
          "workstation_id",
          "process_id",
          "feedback_id"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/mes-wm-item-consume/:id"
      },
      "create": {
        "http": "POST",
        "path": "/mes-wm-item-consume"
      },
      "update": {
        "http": "PUT",
        "path": "/mes-wm-item-consume/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/mes-wm-item-consume/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"mes-wm-item-consume-title\"]",
    "refresh": "[data-testid=\"mes-wm-item-consume-refresh\"]",
    "createButton": "[data-testid=\"mes-wm-item-consume-create\"]",
    "searchForm": "[data-testid=\"mes-wm-item-consume-search\"]",
    "searchSubmit": "[data-testid=\"mes-wm-item-consume-search-submit\"]",
    "searchReset": "[data-testid=\"mes-wm-item-consume-search-reset\"]",
    "total": "[data-testid=\"mes-wm-item-consume-total\"]",
    "table": "[data-testid=\"mes-wm-item-consume-table\"]",
    "row": "[data-testid=\"mes-wm-item-consume-row\"]",
    "editButton": "[data-testid=\"mes-wm-item-consume-edit\"]",
    "deleteButton": "[data-testid=\"mes-wm-item-consume-delete\"]",
    "form": "[data-testid=\"mes-wm-item-consume-form\"]",
    "formError": "[data-testid=\"mes-wm-item-consume-form-error\"]",
    "formSubmit": "[data-testid=\"mes-wm-item-consume-form-submit\"]",
    "formCancel": "[data-testid=\"mes-wm-item-consume-form-cancel\"]",
    "formClose": "[data-testid=\"mes-wm-item-consume-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "MES 物料消耗记录列表",
    "dialogLabel": {
      "create": "新增MES 物料消耗记录",
      "edit": "编辑MES 物料消耗记录"
    },
    "searchFields": [
      {
        "name": "work_order_id",
        "label": "生产工单编号",
        "testId": "search-work_order_id",
        "selector": "[data-testid=\"search-work_order_id\"]"
      },
      {
        "name": "task_id",
        "label": "生产任务编号",
        "testId": "search-task_id",
        "selector": "[data-testid=\"search-task_id\"]"
      },
      {
        "name": "workstation_id",
        "label": "工作站编号",
        "testId": "search-workstation_id",
        "selector": "[data-testid=\"search-workstation_id\"]"
      },
      {
        "name": "process_id",
        "label": "工序编号",
        "testId": "search-process_id",
        "selector": "[data-testid=\"search-process_id\"]"
      },
      {
        "name": "feedback_id",
        "label": "报工记录编号",
        "testId": "search-feedback_id",
        "selector": "[data-testid=\"search-feedback_id\"]"
      }
    ],
    "fields": [
      {
        "name": "work_order_id",
        "label": "生产工单编号",
        "type": "string",
        "required": false,
        "testId": "field-work_order_id",
        "selector": "[data-testid=\"field-work_order_id\"]"
      },
      {
        "name": "task_id",
        "label": "生产任务编号",
        "type": "string",
        "required": false,
        "testId": "field-task_id",
        "selector": "[data-testid=\"field-task_id\"]"
      },
      {
        "name": "workstation_id",
        "label": "工作站编号",
        "type": "string",
        "required": false,
        "testId": "field-workstation_id",
        "selector": "[data-testid=\"field-workstation_id\"]"
      },
      {
        "name": "process_id",
        "label": "工序编号",
        "type": "string",
        "required": false,
        "testId": "field-process_id",
        "selector": "[data-testid=\"field-process_id\"]"
      },
      {
        "name": "feedback_id",
        "label": "报工记录编号",
        "type": "string",
        "required": false,
        "testId": "field-feedback_id",
        "selector": "[data-testid=\"field-feedback_id\"]"
      },
      {
        "name": "consume_date",
        "label": "消耗日期",
        "type": "string",
        "required": false,
        "testId": "field-consume_date",
        "selector": "[data-testid=\"field-consume_date\"]"
      },
      {
        "name": "status",
        "label": "状态",
        "type": "number",
        "required": false,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "mes-wm-item-consume",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"mes-wm-item-consume\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"mes-wm-item-consume-form-overlay\"]",
      "dialog": "[data-testid=\"mes-wm-item-consume-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "mes-wm-item-consume:search",
      "reset": "mes-wm-item-consume:reset",
      "refresh": "mes-wm-item-consume:refresh",
      "create": "mes-wm-item-consume:create",
      "edit": "mes-wm-item-consume:edit",
      "delete": "mes-wm-item-consume:delete",
      "submit": "mes-wm-item-consume:submit",
      "cancel": "mes-wm-item-consume:cancel",
      "close": "mes-wm-item-consume:close",
      "row": "mes-wm-item-consume:row",
      "pagination": "mes-wm-item-consume:pagination",
      "fields": {
        "work_order_id": "mes-wm-item-consume:field:work_order_id",
        "task_id": "mes-wm-item-consume:field:task_id",
        "workstation_id": "mes-wm-item-consume:field:workstation_id",
        "process_id": "mes-wm-item-consume:field:process_id",
        "feedback_id": "mes-wm-item-consume:field:feedback_id",
        "consume_date": "mes-wm-item-consume:field:consume_date",
        "status": "mes-wm-item-consume:field:status",
        "remark": "mes-wm-item-consume:field:remark"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mes.mes-wm-item-consume",
      "examples": [
        "mes.mes-wm-item-consume__List__Refresh",
        "mes.mes-wm-item-consume__ListItem__Open",
        "mes.mes-wm-item-consume__Form__Submit"
      ]
    }
  },
  "enums": {
    "status": {
      "type": "enum",
      "values": [
        "0",
        "4"
      ],
      "labels": {
        "0": "草稿",
        "4": "已完成"
      },
      "description": "状态"
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
