{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mes",
  "entity": "MesQcRqc",
  "kebab": "mes-qc-rqc",
  "businessName": "MES 退货检验单（RQC, Return Quality Control）",
  "permissionPrefix": "mes:mes_qc_rqc",
  "page": {
    "route": "/admin/mes/mes-qc-rqc",
    "title": "MES 退货检验单（RQC, Return Quality Control）管理",
    "titleSelector": "[data-testid=\"mes-qc-rqc-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mes/api",
    "bffMount": "/api/v1/admin/mes",
    "resource": "mes-qc-rqc",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/mes-qc-rqc",
        "query": [
          "page",
          "pageSize"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/mes-qc-rqc/:id"
      },
      "create": {
        "http": "POST",
        "path": "/mes-qc-rqc"
      },
      "update": {
        "http": "PUT",
        "path": "/mes-qc-rqc/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/mes-qc-rqc/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"mes-qc-rqc-title\"]",
    "refresh": "[data-testid=\"mes-qc-rqc-refresh\"]",
    "createButton": "[data-testid=\"mes-qc-rqc-create\"]",
    "searchForm": "[data-testid=\"mes-qc-rqc-search\"]",
    "searchSubmit": "[data-testid=\"mes-qc-rqc-search-submit\"]",
    "searchReset": "[data-testid=\"mes-qc-rqc-search-reset\"]",
    "total": "[data-testid=\"mes-qc-rqc-total\"]",
    "table": "[data-testid=\"mes-qc-rqc-table\"]",
    "row": "[data-testid=\"mes-qc-rqc-row\"]",
    "editButton": "[data-testid=\"mes-qc-rqc-edit\"]",
    "deleteButton": "[data-testid=\"mes-qc-rqc-delete\"]",
    "form": "[data-testid=\"mes-qc-rqc-form\"]",
    "formError": "[data-testid=\"mes-qc-rqc-form-error\"]",
    "formSubmit": "[data-testid=\"mes-qc-rqc-form-submit\"]",
    "formCancel": "[data-testid=\"mes-qc-rqc-form-cancel\"]",
    "formClose": "[data-testid=\"mes-qc-rqc-form-close\"]"
  },
