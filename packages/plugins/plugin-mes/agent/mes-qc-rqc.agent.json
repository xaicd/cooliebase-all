  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "mes-qc-rqc",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"mes-qc-rqc\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"mes-qc-rqc-form-overlay\"]",
      "dialog": "[data-testid=\"mes-qc-rqc-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "mes-qc-rqc:search",
      "reset": "mes-qc-rqc:reset",
      "refresh": "mes-qc-rqc:refresh",
      "create": "mes-qc-rqc:create",
      "edit": "mes-qc-rqc:edit",
      "delete": "mes-qc-rqc:delete",
      "submit": "mes-qc-rqc:submit",
      "cancel": "mes-qc-rqc:cancel",
      "close": "mes-qc-rqc:close",
      "row": "mes-qc-rqc:row",
