        "source_line_id": "mes-qc-rqc:field:source_line_id",
        "source_doc_code": "mes-qc-rqc:field:source_doc_code",
        "type": "mes-qc-rqc:field:type",
        "item_id": "mes-qc-rqc:field:item_id",
        "batch_code": "mes-qc-rqc:field:batch_code",
        "check_quantity": "mes-qc-rqc:field:check_quantity",
        "qualified_quantity": "mes-qc-rqc:field:qualified_quantity",
        "unqualified_quantity": "mes-qc-rqc:field:unqualified_quantity",
        "critical_rate": "mes-qc-rqc:field:critical_rate",
        "major_rate": "mes-qc-rqc:field:major_rate",
        "minor_rate": "mes-qc-rqc:field:minor_rate",
