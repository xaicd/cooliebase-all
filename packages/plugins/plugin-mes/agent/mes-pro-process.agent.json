{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mes",
  "entity": "MesProProcess",
  "kebab": "mes-pro-process",
  "businessName": "MES 生产工序",
  "permissionPrefix": "mes:mes_pro_process",
  "page": {
    "route": "/admin/mes/mes-pro-process",
    "title": "MES 生产工序管理",
    "titleSelector": "[data-testid=\"mes-pro-process-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mes/api",
    "bffMount": "/api/v1/admin/mes",
    "resource": "mes-pro-process",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/mes-pro-process",
        "query": [
          "page",
          "pageSize",
          "code",
          "name",
          "status"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/mes-pro-process/:id"
      },
      "create": {
        "http": "POST",
        "path": "/mes-pro-process"
      },
      "update": {
        "http": "PUT",
        "path": "/mes-pro-process/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/mes-pro-process/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"mes-pro-process-title\"]",
    "refresh": "[data-testid=\"mes-pro-process-refresh\"]",
    "createButton": "[data-testid=\"mes-pro-process-create\"]",
    "searchForm": "[data-testid=\"mes-pro-process-search\"]",
    "searchSubmit": "[data-testid=\"mes-pro-process-search-submit\"]",
    "searchReset": "[data-testid=\"mes-pro-process-search-reset\"]",
    "total": "[data-testid=\"mes-pro-process-total\"]",
    "table": "[data-testid=\"mes-pro-process-table\"]",
    "row": "[data-testid=\"mes-pro-process-row\"]",
    "editButton": "[data-testid=\"mes-pro-process-edit\"]",
    "deleteButton": "[data-testid=\"mes-pro-process-delete\"]",
    "form": "[data-testid=\"mes-pro-process-form\"]",
    "formError": "[data-testid=\"mes-pro-process-form-error\"]",
    "formSubmit": "[data-testid=\"mes-pro-process-form-submit\"]",
    "formCancel": "[data-testid=\"mes-pro-process-form-cancel\"]",
    "formClose": "[data-testid=\"mes-pro-process-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "MES 生产工序列表",
    "dialogLabel": {
      "create": "新增MES 生产工序",
      "edit": "编辑MES 生产工序"
    },
    "searchFields": [
      {
        "name": "code",
        "label": "工序编码",
        "testId": "search-code",
        "selector": "[data-testid=\"search-code\"]"
      },
      {
        "name": "name",
        "label": "工序名称",
        "testId": "search-name",
        "selector": "[data-testid=\"search-name\"]"
      },
      {
        "name": "status",
        "label": "状态",
        "testId": "search-status",
        "selector": "[data-testid=\"search-status\"]"
      }
    ],
    "fields": [
      {
        "name": "code",
        "label": "工序编码",
        "type": "string",
        "required": false,
        "testId": "field-code",
        "selector": "[data-testid=\"field-code\"]"
      },
      {
        "name": "name",
        "label": "工序名称",
        "type": "string",
        "required": false,
        "testId": "field-name",
        "selector": "[data-testid=\"field-name\"]"
      },
      {
        "name": "attention",
        "label": "工艺要求",
        "type": "string",
        "required": false,
        "testId": "field-attention",
        "selector": "[data-testid=\"field-attention\"]"
      },
      {
        "name": "status",
        "label": "状态",
        "type": "number",
        "required": false,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "mes-pro-process",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"mes-pro-process\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"mes-pro-process-form-overlay\"]",
      "dialog": "[data-testid=\"mes-pro-process-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "mes-pro-process:search",
      "reset": "mes-pro-process:reset",
      "refresh": "mes-pro-process:refresh",
      "create": "mes-pro-process:create",
      "edit": "mes-pro-process:edit",
      "delete": "mes-pro-process:delete",
      "submit": "mes-pro-process:submit",
      "cancel": "mes-pro-process:cancel",
      "close": "mes-pro-process:close",
      "row": "mes-pro-process:row",
      "pagination": "mes-pro-process:pagination",
      "fields": {
        "code": "mes-pro-process:field:code",
        "name": "mes-pro-process:field:name",
        "attention": "mes-pro-process:field:attention",
        "status": "mes-pro-process:field:status",
        "remark": "mes-pro-process:field:remark"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mes.mes-pro-process",
      "examples": [
        "mes.mes-pro-process__List__Refresh",
        "mes.mes-pro-process__ListItem__Open",
        "mes.mes-pro-process__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
