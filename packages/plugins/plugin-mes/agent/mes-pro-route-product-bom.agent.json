{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mes",
  "entity": "MesProRouteProductBom",
  "kebab": "mes-pro-route-product-bom",
  "businessName": "MES 工艺路线产品 BOM",
  "permissionPrefix": "mes:mes_pro_route_product_bom",
  "page": {
    "route": "/admin/mes/mes-pro-route-product-bom",
    "title": "MES 工艺路线产品 BOM管理",
    "titleSelector": "[data-testid=\"mes-pro-route-product-bom-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mes/api",
    "bffMount": "/api/v1/admin/mes",
    "resource": "mes-pro-route-product-bom",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/mes-pro-route-product-bom",
        "query": [
          "page",
          "pageSize"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/mes-pro-route-product-bom/:id"
      },
      "create": {
        "http": "POST",
        "path": "/mes-pro-route-product-bom"
      },
      "update": {
        "http": "PUT",
        "path": "/mes-pro-route-product-bom/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/mes-pro-route-product-bom/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"mes-pro-route-product-bom-title\"]",
    "refresh": "[data-testid=\"mes-pro-route-product-bom-refresh\"]",
    "createButton": "[data-testid=\"mes-pro-route-product-bom-create\"]",
    "searchForm": "[data-testid=\"mes-pro-route-product-bom-search\"]",
    "searchSubmit": "[data-testid=\"mes-pro-route-product-bom-search-submit\"]",
    "searchReset": "[data-testid=\"mes-pro-route-product-bom-search-reset\"]",
    "total": "[data-testid=\"mes-pro-route-product-bom-total\"]",
    "table": "[data-testid=\"mes-pro-route-product-bom-table\"]",
    "row": "[data-testid=\"mes-pro-route-product-bom-row\"]",
    "editButton": "[data-testid=\"mes-pro-route-product-bom-edit\"]",
    "deleteButton": "[data-testid=\"mes-pro-route-product-bom-delete\"]",
    "form": "[data-testid=\"mes-pro-route-product-bom-form\"]",
    "formError": "[data-testid=\"mes-pro-route-product-bom-form-error\"]",
    "formSubmit": "[data-testid=\"mes-pro-route-product-bom-form-submit\"]",
    "formCancel": "[data-testid=\"mes-pro-route-product-bom-form-cancel\"]",
    "formClose": "[data-testid=\"mes-pro-route-product-bom-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "MES 工艺路线产品 BOM列表",
    "dialogLabel": {
      "create": "新增MES 工艺路线产品 BOM",
      "edit": "编辑MES 工艺路线产品 BOM"
    },
    "searchFields": [],
    "fields": [
      {
        "name": "route_id",
        "label": "工艺路线编号",
        "type": "number",
        "required": false,
        "testId": "field-route_id",
        "selector": "[data-testid=\"field-route_id\"]"
      },
      {
        "name": "process_id",
        "label": "工序编号",
        "type": "number",
        "required": false,
        "testId": "field-process_id",
        "selector": "[data-testid=\"field-process_id\"]"
      },
      {
        "name": "product_id",
        "label": "产品物料编号",
        "type": "number",
        "required": false,
        "testId": "field-product_id",
        "selector": "[data-testid=\"field-product_id\"]"
      },
      {
        "name": "item_id",
        "label": "BOM 物料编号",
        "type": "number",
        "required": false,
        "testId": "field-item_id",
        "selector": "[data-testid=\"field-item_id\"]"
      },
      {
        "name": "quantity",
        "label": "用料比例",
        "type": "number",
        "required": false,
        "testId": "field-quantity",
        "selector": "[data-testid=\"field-quantity\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "mes-pro-route-product-bom",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"mes-pro-route-product-bom\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"mes-pro-route-product-bom-form-overlay\"]",
      "dialog": "[data-testid=\"mes-pro-route-product-bom-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "mes-pro-route-product-bom:search",
      "reset": "mes-pro-route-product-bom:reset",
      "refresh": "mes-pro-route-product-bom:refresh",
      "create": "mes-pro-route-product-bom:create",
      "edit": "mes-pro-route-product-bom:edit",
      "delete": "mes-pro-route-product-bom:delete",
      "submit": "mes-pro-route-product-bom:submit",
      "cancel": "mes-pro-route-product-bom:cancel",
      "close": "mes-pro-route-product-bom:close",
      "row": "mes-pro-route-product-bom:row",
      "pagination": "mes-pro-route-product-bom:pagination",
      "fields": {
        "route_id": "mes-pro-route-product-bom:field:route_id",
        "process_id": "mes-pro-route-product-bom:field:process_id",
        "product_id": "mes-pro-route-product-bom:field:product_id",
        "item_id": "mes-pro-route-product-bom:field:item_id",
        "quantity": "mes-pro-route-product-bom:field:quantity",
        "remark": "mes-pro-route-product-bom:field:remark"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mes.mes-pro-route-product-bom",
      "examples": [
        "mes.mes-pro-route-product-bom__List__Refresh",
        "mes.mes-pro-route-product-bom__ListItem__Open",
        "mes.mes-pro-route-product-bom__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
