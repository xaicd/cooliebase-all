{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mes",
  "entity": "MesMdAutoCodeRecord",
  "kebab": "mes-md-auto-code-record",
  "businessName": "MES 编码生成记录",
  "permissionPrefix": "mes:mes_md_auto_code_record",
  "page": {
    "route": "/admin/mes/mes-md-auto-code-record",
    "title": "MES 编码生成记录管理",
    "titleSelector": "[data-testid=\"mes-md-auto-code-record-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mes/api",
    "bffMount": "/api/v1/admin/mes",
    "resource": "mes-md-auto-code-record",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/mes-md-auto-code-record",
        "query": [
          "page",
          "pageSize",
          "rule_id"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/mes-md-auto-code-record/:id"
      },
      "create": {
        "http": "POST",
        "path": "/mes-md-auto-code-record"
      },
      "update": {
        "http": "PUT",
        "path": "/mes-md-auto-code-record/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/mes-md-auto-code-record/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"mes-md-auto-code-record-title\"]",
    "refresh": "[data-testid=\"mes-md-auto-code-record-refresh\"]",
    "createButton": "[data-testid=\"mes-md-auto-code-record-create\"]",
    "searchForm": "[data-testid=\"mes-md-auto-code-record-search\"]",
    "searchSubmit": "[data-testid=\"mes-md-auto-code-record-search-submit\"]",
    "searchReset": "[data-testid=\"mes-md-auto-code-record-search-reset\"]",
    "total": "[data-testid=\"mes-md-auto-code-record-total\"]",
    "table": "[data-testid=\"mes-md-auto-code-record-table\"]",
    "row": "[data-testid=\"mes-md-auto-code-record-row\"]",
    "editButton": "[data-testid=\"mes-md-auto-code-record-edit\"]",
    "deleteButton": "[data-testid=\"mes-md-auto-code-record-delete\"]",
    "form": "[data-testid=\"mes-md-auto-code-record-form\"]",
    "formError": "[data-testid=\"mes-md-auto-code-record-form-error\"]",
    "formSubmit": "[data-testid=\"mes-md-auto-code-record-form-submit\"]",
    "formCancel": "[data-testid=\"mes-md-auto-code-record-form-cancel\"]",
    "formClose": "[data-testid=\"mes-md-auto-code-record-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "MES 编码生成记录列表",
    "dialogLabel": {
      "create": "新增MES 编码生成记录",
      "edit": "编辑MES 编码生成记录"
    },
    "searchFields": [
      {
        "name": "rule_id",
        "label": "规则 ID",
        "testId": "search-rule_id",
        "selector": "[data-testid=\"search-rule_id\"]"
      }
    ],
    "fields": [
      {
        "name": "rule_id",
        "label": "规则 ID",
        "type": "string",
        "required": false,
        "testId": "field-rule_id",
        "selector": "[data-testid=\"field-rule_id\"]"
      },
      {
        "name": "result",
        "label": "生成的编码",
        "type": "string",
        "required": false,
        "testId": "field-result",
        "selector": "[data-testid=\"field-result\"]"
      },
      {
        "name": "serial_no",
        "label": "生成的流水号",
        "type": "number",
        "required": false,
        "testId": "field-serial_no",
        "selector": "[data-testid=\"field-serial_no\"]"
      },
      {
        "name": "input_char",
        "label": "传入的参数",
        "type": "string",
        "required": false,
        "testId": "field-input_char",
        "selector": "[data-testid=\"field-input_char\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "mes-md-auto-code-record",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"mes-md-auto-code-record\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"mes-md-auto-code-record-form-overlay\"]",
      "dialog": "[data-testid=\"mes-md-auto-code-record-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "mes-md-auto-code-record:search",
      "reset": "mes-md-auto-code-record:reset",
      "refresh": "mes-md-auto-code-record:refresh",
      "create": "mes-md-auto-code-record:create",
      "edit": "mes-md-auto-code-record:edit",
      "delete": "mes-md-auto-code-record:delete",
      "submit": "mes-md-auto-code-record:submit",
      "cancel": "mes-md-auto-code-record:cancel",
      "close": "mes-md-auto-code-record:close",
      "row": "mes-md-auto-code-record:row",
      "pagination": "mes-md-auto-code-record:pagination",
      "fields": {
        "rule_id": "mes-md-auto-code-record:field:rule_id",
        "result": "mes-md-auto-code-record:field:result",
        "serial_no": "mes-md-auto-code-record:field:serial_no",
        "input_char": "mes-md-auto-code-record:field:input_char"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mes.mes-md-auto-code-record",
      "examples": [
        "mes.mes-md-auto-code-record__List__Refresh",
        "mes.mes-md-auto-code-record__ListItem__Open",
        "mes.mes-md-auto-code-record__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
