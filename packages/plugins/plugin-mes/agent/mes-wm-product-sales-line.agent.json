{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mes",
  "entity": "MesWmProductSalesLine",
  "kebab": "mes-wm-product-sales-line",
  "businessName": "MES 销售出库单行",
  "permissionPrefix": "mes:mes_wm_product_sales_line",
  "page": {
    "route": "/admin/mes/mes-wm-product-sales-line",
    "title": "MES 销售出库单行管理",
    "titleSelector": "[data-testid=\"mes-wm-product-sales-line-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mes/api",
    "bffMount": "/api/v1/admin/mes",
    "resource": "mes-wm-product-sales-line",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/mes-wm-product-sales-line",
        "query": [
          "page",
          "pageSize"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/mes-wm-product-sales-line/:id"
      },
      "create": {
        "http": "POST",
        "path": "/mes-wm-product-sales-line"
      },
      "update": {
        "http": "PUT",
        "path": "/mes-wm-product-sales-line/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/mes-wm-product-sales-line/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"mes-wm-product-sales-line-title\"]",
    "refresh": "[data-testid=\"mes-wm-product-sales-line-refresh\"]",
    "createButton": "[data-testid=\"mes-wm-product-sales-line-create\"]",
    "searchForm": "[data-testid=\"mes-wm-product-sales-line-search\"]",
    "searchSubmit": "[data-testid=\"mes-wm-product-sales-line-search-submit\"]",
    "searchReset": "[data-testid=\"mes-wm-product-sales-line-search-reset\"]",
    "total": "[data-testid=\"mes-wm-product-sales-line-total\"]",
    "table": "[data-testid=\"mes-wm-product-sales-line-table\"]",
    "row": "[data-testid=\"mes-wm-product-sales-line-row\"]",
    "editButton": "[data-testid=\"mes-wm-product-sales-line-edit\"]",
    "deleteButton": "[data-testid=\"mes-wm-product-sales-line-delete\"]",
    "form": "[data-testid=\"mes-wm-product-sales-line-form\"]",
    "formError": "[data-testid=\"mes-wm-product-sales-line-form-error\"]",
    "formSubmit": "[data-testid=\"mes-wm-product-sales-line-form-submit\"]",
    "formCancel": "[data-testid=\"mes-wm-product-sales-line-form-cancel\"]",
    "formClose": "[data-testid=\"mes-wm-product-sales-line-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "MES 销售出库单行列表",
    "dialogLabel": {
      "create": "新增MES 销售出库单行",
      "edit": "编辑MES 销售出库单行"
    },
    "searchFields": [],
    "fields": [
      {
        "name": "sales_id",
        "label": "出库单ID",
        "type": "number",
        "required": false,
        "testId": "field-sales_id",
        "selector": "[data-testid=\"field-sales_id\"]"
      },
      {
        "name": "notice_line_id",
        "label": "发货通知单行ID",
        "type": "number",
        "required": false,
        "testId": "field-notice_line_id",
        "selector": "[data-testid=\"field-notice_line_id\"]"
      },
      {
        "name": "item_id",
        "label": "物料ID",
        "type": "number",
        "required": false,
        "testId": "field-item_id",
        "selector": "[data-testid=\"field-item_id\"]"
      },
      {
        "name": "quantity",
        "label": "出库数量",
        "type": "number",
        "required": false,
        "testId": "field-quantity",
        "selector": "[data-testid=\"field-quantity\"]"
      },
      {
        "name": "batch_id",
        "label": "批次 ID",
        "type": "number",
        "required": false,
        "testId": "field-batch_id",
        "selector": "[data-testid=\"field-batch_id\"]"
      },
      {
        "name": "batch_code",
        "label": "批次号",
        "type": "string",
        "required": false,
        "testId": "field-batch_code",
        "selector": "[data-testid=\"field-batch_code\"]"
      },
      {
        "name": "material_stock_id",
        "label": "库存记录ID",
        "type": "number",
        "required": false,
        "testId": "field-material_stock_id",
        "selector": "[data-testid=\"field-material_stock_id\"]"
      },
      {
        "name": "oqc_check_flag",
        "label": "是否出厂检验",
        "type": "boolean",
        "required": false,
        "testId": "field-oqc_check_flag",
        "selector": "[data-testid=\"field-oqc_check_flag\"]"
      },
      {
        "name": "oqc_id",
        "label": "出厂检验单 ID",
        "type": "number",
        "required": false,
        "testId": "field-oqc_id",
        "selector": "[data-testid=\"field-oqc_id\"]"
      },
      {
        "name": "quality_status",
        "label": "质量状态",
        "type": "number",
        "required": false,
        "testId": "field-quality_status",
        "selector": "[data-testid=\"field-quality_status\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "mes-wm-product-sales-line",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"mes-wm-product-sales-line\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"mes-wm-product-sales-line-form-overlay\"]",
      "dialog": "[data-testid=\"mes-wm-product-sales-line-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "mes-wm-product-sales-line:search",
      "reset": "mes-wm-product-sales-line:reset",
      "refresh": "mes-wm-product-sales-line:refresh",
      "create": "mes-wm-product-sales-line:create",
      "edit": "mes-wm-product-sales-line:edit",
      "delete": "mes-wm-product-sales-line:delete",
      "submit": "mes-wm-product-sales-line:submit",
      "cancel": "mes-wm-product-sales-line:cancel",
      "close": "mes-wm-product-sales-line:close",
      "row": "mes-wm-product-sales-line:row",
      "pagination": "mes-wm-product-sales-line:pagination",
      "fields": {
        "sales_id": "mes-wm-product-sales-line:field:sales_id",
        "notice_line_id": "mes-wm-product-sales-line:field:notice_line_id",
        "item_id": "mes-wm-product-sales-line:field:item_id",
        "quantity": "mes-wm-product-sales-line:field:quantity",
        "batch_id": "mes-wm-product-sales-line:field:batch_id",
        "batch_code": "mes-wm-product-sales-line:field:batch_code",
        "material_stock_id": "mes-wm-product-sales-line:field:material_stock_id",
        "oqc_check_flag": "mes-wm-product-sales-line:field:oqc_check_flag",
        "oqc_id": "mes-wm-product-sales-line:field:oqc_id",
        "quality_status": "mes-wm-product-sales-line:field:quality_status",
        "remark": "mes-wm-product-sales-line:field:remark"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mes.mes-wm-product-sales-line",
      "examples": [
        "mes.mes-wm-product-sales-line__List__Refresh",
        "mes.mes-wm-product-sales-line__ListItem__Open",
        "mes.mes-wm-product-sales-line__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
