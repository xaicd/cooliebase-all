{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mes",
  "entity": "MesWmTransferLine",
  "kebab": "mes-wm-transfer-line",
  "businessName": "MES 转移单行",
  "permissionPrefix": "mes:mes_wm_transfer_line",
  "page": {
    "route": "/admin/mes/mes-wm-transfer-line",
    "title": "MES 转移单行管理",
    "titleSelector": "[data-testid=\"mes-wm-transfer-line-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mes/api",
    "bffMount": "/api/v1/admin/mes",
    "resource": "mes-wm-transfer-line",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/mes-wm-transfer-line",
        "query": [
          "page",
          "pageSize",
          "transfer_id",
          "material_stock_id",
          "item_id",
          "batch_id",
          "from_warehouse_id"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/mes-wm-transfer-line/:id"
      },
      "create": {
        "http": "POST",
        "path": "/mes-wm-transfer-line"
      },
      "update": {
        "http": "PUT",
        "path": "/mes-wm-transfer-line/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/mes-wm-transfer-line/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"mes-wm-transfer-line-title\"]",
    "refresh": "[data-testid=\"mes-wm-transfer-line-refresh\"]",
    "createButton": "[data-testid=\"mes-wm-transfer-line-create\"]",
    "searchForm": "[data-testid=\"mes-wm-transfer-line-search\"]",
    "searchSubmit": "[data-testid=\"mes-wm-transfer-line-search-submit\"]",
    "searchReset": "[data-testid=\"mes-wm-transfer-line-search-reset\"]",
    "total": "[data-testid=\"mes-wm-transfer-line-total\"]",
    "table": "[data-testid=\"mes-wm-transfer-line-table\"]",
    "row": "[data-testid=\"mes-wm-transfer-line-row\"]",
    "editButton": "[data-testid=\"mes-wm-transfer-line-edit\"]",
    "deleteButton": "[data-testid=\"mes-wm-transfer-line-delete\"]",
    "form": "[data-testid=\"mes-wm-transfer-line-form\"]",
    "formError": "[data-testid=\"mes-wm-transfer-line-form-error\"]",
    "formSubmit": "[data-testid=\"mes-wm-transfer-line-form-submit\"]",
    "formCancel": "[data-testid=\"mes-wm-transfer-line-form-cancel\"]",
    "formClose": "[data-testid=\"mes-wm-transfer-line-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "MES 转移单行列表",
    "dialogLabel": {
      "create": "新增MES 转移单行",
      "edit": "编辑MES 转移单行"
    },
    "searchFields": [
      {
        "name": "transfer_id",
        "label": "转移单编号",
        "testId": "search-transfer_id",
        "selector": "[data-testid=\"search-transfer_id\"]"
      },
      {
        "name": "material_stock_id",
        "label": "库存记录编号",
        "testId": "search-material_stock_id",
        "selector": "[data-testid=\"search-material_stock_id\"]"
      },
      {
        "name": "item_id",
        "label": "物料编号",
        "testId": "search-item_id",
        "selector": "[data-testid=\"search-item_id\"]"
      },
      {
        "name": "batch_id",
        "label": "批次编号",
        "testId": "search-batch_id",
        "selector": "[data-testid=\"search-batch_id\"]"
      },
      {
        "name": "from_warehouse_id",
        "label": "移出仓库编号",
        "testId": "search-from_warehouse_id",
        "selector": "[data-testid=\"search-from_warehouse_id\"]"
      }
    ],
    "fields": [
      {
        "name": "transfer_id",
        "label": "转移单编号",
        "type": "string",
        "required": false,
        "testId": "field-transfer_id",
        "selector": "[data-testid=\"field-transfer_id\"]"
      },
      {
        "name": "material_stock_id",
        "label": "库存记录编号",
        "type": "string",
        "required": false,
        "testId": "field-material_stock_id",
        "selector": "[data-testid=\"field-material_stock_id\"]"
      },
      {
        "name": "item_id",
        "label": "物料编号",
        "type": "string",
        "required": false,
        "testId": "field-item_id",
        "selector": "[data-testid=\"field-item_id\"]"
      },
      {
        "name": "quantity",
        "label": "转移数量",
        "type": "number",
        "required": false,
        "testId": "field-quantity",
        "selector": "[data-testid=\"field-quantity\"]"
      },
      {
        "name": "batch_id",
        "label": "批次编号",
        "type": "string",
        "required": false,
        "testId": "field-batch_id",
        "selector": "[data-testid=\"field-batch_id\"]"
      },
      {
        "name": "from_warehouse_id",
        "label": "移出仓库编号",
        "type": "string",
        "required": false,
        "testId": "field-from_warehouse_id",
        "selector": "[data-testid=\"field-from_warehouse_id\"]"
      },
      {
        "name": "from_location_id",
        "label": "移出库区编号",
        "type": "string",
        "required": false,
        "testId": "field-from_location_id",
        "selector": "[data-testid=\"field-from_location_id\"]"
      },
      {
        "name": "from_area_id",
        "label": "移出库位编号",
        "type": "string",
        "required": false,
        "testId": "field-from_area_id",
        "selector": "[data-testid=\"field-from_area_id\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "mes-wm-transfer-line",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"mes-wm-transfer-line\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"mes-wm-transfer-line-form-overlay\"]",
      "dialog": "[data-testid=\"mes-wm-transfer-line-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "mes-wm-transfer-line:search",
      "reset": "mes-wm-transfer-line:reset",
      "refresh": "mes-wm-transfer-line:refresh",
      "create": "mes-wm-transfer-line:create",
      "edit": "mes-wm-transfer-line:edit",
      "delete": "mes-wm-transfer-line:delete",
      "submit": "mes-wm-transfer-line:submit",
      "cancel": "mes-wm-transfer-line:cancel",
      "close": "mes-wm-transfer-line:close",
      "row": "mes-wm-transfer-line:row",
      "pagination": "mes-wm-transfer-line:pagination",
      "fields": {
        "transfer_id": "mes-wm-transfer-line:field:transfer_id",
        "material_stock_id": "mes-wm-transfer-line:field:material_stock_id",
        "item_id": "mes-wm-transfer-line:field:item_id",
        "quantity": "mes-wm-transfer-line:field:quantity",
        "batch_id": "mes-wm-transfer-line:field:batch_id",
        "from_warehouse_id": "mes-wm-transfer-line:field:from_warehouse_id",
        "from_location_id": "mes-wm-transfer-line:field:from_location_id",
        "from_area_id": "mes-wm-transfer-line:field:from_area_id",
        "remark": "mes-wm-transfer-line:field:remark"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mes.mes-wm-transfer-line",
      "examples": [
        "mes.mes-wm-transfer-line__List__Refresh",
        "mes.mes-wm-transfer-line__ListItem__Open",
        "mes.mes-wm-transfer-line__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
