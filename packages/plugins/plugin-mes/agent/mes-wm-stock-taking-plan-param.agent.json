    "resource": "mes-wm-stock-taking-plan-param",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/mes-wm-stock-taking-plan-param",
        "query": [
          "page",
          "pageSize",
          "plan_id",
          "type",
          "value_id"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/mes-wm-stock-taking-plan-param/:id"
      },
      "create": {
        "http": "POST",
        "path": "/mes-wm-stock-taking-plan-param"
      },
      "update": {
        "http": "PUT",
        "path": "/mes-wm-stock-taking-plan-param/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/mes-wm-stock-taking-plan-param/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
