        "label": "参数值名称，例如仓库名称、库区名称、库位名称、物料名称、批次名称",
        "type": "string",
        "required": false,
        "testId": "field-value_name",
        "selector": "[data-testid=\"field-value_name\"]"
      },
      {
        "name": "remark",
