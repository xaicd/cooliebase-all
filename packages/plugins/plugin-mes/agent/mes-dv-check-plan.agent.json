{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mes",
  "entity": "MesDvCheckPlan",
  "kebab": "mes-dv-check-plan",
  "businessName": "MES 点检保养方案",
  "permissionPrefix": "mes:mes_dv_check_plan",
  "page": {
    "route": "/admin/mes/mes-dv-check-plan",
    "title": "MES 点检保养方案管理",
    "titleSelector": "[data-testid=\"mes-dv-check-plan-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mes/api",
    "bffMount": "/api/v1/admin/mes",
    "resource": "mes-dv-check-plan",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/mes-dv-check-plan",
        "query": [
          "page",
          "pageSize",
          "code",
          "name",
          "type",
          "status"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/mes-dv-check-plan/:id"
      },
      "create": {
        "http": "POST",
        "path": "/mes-dv-check-plan"
      },
      "update": {
        "http": "PUT",
        "path": "/mes-dv-check-plan/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/mes-dv-check-plan/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"mes-dv-check-plan-title\"]",
    "refresh": "[data-testid=\"mes-dv-check-plan-refresh\"]",
    "createButton": "[data-testid=\"mes-dv-check-plan-create\"]",
    "searchForm": "[data-testid=\"mes-dv-check-plan-search\"]",
    "searchSubmit": "[data-testid=\"mes-dv-check-plan-search-submit\"]",
    "searchReset": "[data-testid=\"mes-dv-check-plan-search-reset\"]",
    "total": "[data-testid=\"mes-dv-check-plan-total\"]",
    "table": "[data-testid=\"mes-dv-check-plan-table\"]",
    "row": "[data-testid=\"mes-dv-check-plan-row\"]",
    "editButton": "[data-testid=\"mes-dv-check-plan-edit\"]",
    "deleteButton": "[data-testid=\"mes-dv-check-plan-delete\"]",
    "form": "[data-testid=\"mes-dv-check-plan-form\"]",
    "formError": "[data-testid=\"mes-dv-check-plan-form-error\"]",
    "formSubmit": "[data-testid=\"mes-dv-check-plan-form-submit\"]",
    "formCancel": "[data-testid=\"mes-dv-check-plan-form-cancel\"]",
    "formClose": "[data-testid=\"mes-dv-check-plan-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "MES 点检保养方案列表",
    "dialogLabel": {
      "create": "新增MES 点检保养方案",
      "edit": "编辑MES 点检保养方案"
    },
    "searchFields": [
      {
        "name": "code",
        "label": "方案编码",
        "testId": "search-code",
        "selector": "[data-testid=\"search-code\"]"
      },
      {
        "name": "name",
        "label": "方案名称",
        "testId": "search-name",
        "selector": "[data-testid=\"search-name\"]"
      },
      {
        "name": "type",
        "label": "方案类型",
        "testId": "search-type",
        "selector": "[data-testid=\"search-type\"]"
      },
      {
        "name": "status",
        "label": "状态",
        "testId": "search-status",
        "selector": "[data-testid=\"search-status\"]"
      }
    ],
    "fields": [
      {
        "name": "code",
        "label": "方案编码",
        "type": "string",
        "required": false,
        "testId": "field-code",
        "selector": "[data-testid=\"field-code\"]"
      },
      {
        "name": "name",
        "label": "方案名称",
        "type": "string",
        "required": false,
        "testId": "field-name",
        "selector": "[data-testid=\"field-name\"]"
      },
      {
        "name": "type",
        "label": "方案类型",
        "type": "number",
        "required": false,
        "testId": "field-type",
        "selector": "[data-testid=\"field-type\"]"
      },
      {
        "name": "start_date",
        "label": "开始日期",
        "type": "string",
        "required": false,
        "testId": "field-start_date",
        "selector": "[data-testid=\"field-start_date\"]"
      },
      {
        "name": "end_date",
        "label": "结束日期",
        "type": "string",
        "required": false,
        "testId": "field-end_date",
        "selector": "[data-testid=\"field-end_date\"]"
      },
      {
        "name": "cycle_type",
        "label": "周期类型",
        "type": "number",
        "required": false,
        "testId": "field-cycle_type",
        "selector": "[data-testid=\"field-cycle_type\"]"
      },
      {
        "name": "cycle_count",
        "label": "周期数量",
        "type": "number",
        "required": false,
        "testId": "field-cycle_count",
        "selector": "[data-testid=\"field-cycle_count\"]"
      },
      {
        "name": "status",
        "label": "状态",
        "type": "number",
        "required": false,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "mes-dv-check-plan",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"mes-dv-check-plan\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"mes-dv-check-plan-form-overlay\"]",
      "dialog": "[data-testid=\"mes-dv-check-plan-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "mes-dv-check-plan:search",
      "reset": "mes-dv-check-plan:reset",
      "refresh": "mes-dv-check-plan:refresh",
      "create": "mes-dv-check-plan:create",
      "edit": "mes-dv-check-plan:edit",
      "delete": "mes-dv-check-plan:delete",
      "submit": "mes-dv-check-plan:submit",
      "cancel": "mes-dv-check-plan:cancel",
      "close": "mes-dv-check-plan:close",
      "row": "mes-dv-check-plan:row",
      "pagination": "mes-dv-check-plan:pagination",
      "fields": {
        "code": "mes-dv-check-plan:field:code",
        "name": "mes-dv-check-plan:field:name",
        "type": "mes-dv-check-plan:field:type",
        "start_date": "mes-dv-check-plan:field:start_date",
        "end_date": "mes-dv-check-plan:field:end_date",
        "cycle_type": "mes-dv-check-plan:field:cycle_type",
        "cycle_count": "mes-dv-check-plan:field:cycle_count",
        "status": "mes-dv-check-plan:field:status",
        "remark": "mes-dv-check-plan:field:remark"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mes.mes-dv-check-plan",
      "examples": [
        "mes.mes-dv-check-plan__List__Refresh",
        "mes.mes-dv-check-plan__ListItem__Open",
        "mes.mes-dv-check-plan__Form__Submit"
      ]
    }
  },
  "enums": {
    "status": {
      "type": "enum",
      "values": [
        "0",
        "1"
      ],
      "labels": {
        "0": "草稿",
        "1": "已启用"
      },
      "description": "状态"
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
