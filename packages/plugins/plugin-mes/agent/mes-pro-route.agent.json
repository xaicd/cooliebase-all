{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mes",
  "entity": "MesProRoute",
  "kebab": "mes-pro-route",
  "businessName": "MES 工艺路线",
  "permissionPrefix": "mes:mes_pro_route",
  "page": {
    "route": "/admin/mes/mes-pro-route",
    "title": "MES 工艺路线管理",
    "titleSelector": "[data-testid=\"mes-pro-route-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mes/api",
    "bffMount": "/api/v1/admin/mes",
    "resource": "mes-pro-route",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/mes-pro-route",
        "query": [
          "page",
          "pageSize"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/mes-pro-route/:id"
      },
      "create": {
        "http": "POST",
        "path": "/mes-pro-route"
      },
      "update": {
        "http": "PUT",
        "path": "/mes-pro-route/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/mes-pro-route/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"mes-pro-route-title\"]",
    "refresh": "[data-testid=\"mes-pro-route-refresh\"]",
    "createButton": "[data-testid=\"mes-pro-route-create\"]",
    "searchForm": "[data-testid=\"mes-pro-route-search\"]",
    "searchSubmit": "[data-testid=\"mes-pro-route-search-submit\"]",
    "searchReset": "[data-testid=\"mes-pro-route-search-reset\"]",
    "total": "[data-testid=\"mes-pro-route-total\"]",
    "table": "[data-testid=\"mes-pro-route-table\"]",
    "row": "[data-testid=\"mes-pro-route-row\"]",
    "editButton": "[data-testid=\"mes-pro-route-edit\"]",
    "deleteButton": "[data-testid=\"mes-pro-route-delete\"]",
    "form": "[data-testid=\"mes-pro-route-form\"]",
    "formError": "[data-testid=\"mes-pro-route-form-error\"]",
    "formSubmit": "[data-testid=\"mes-pro-route-form-submit\"]",
    "formCancel": "[data-testid=\"mes-pro-route-form-cancel\"]",
    "formClose": "[data-testid=\"mes-pro-route-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "MES 工艺路线列表",
    "dialogLabel": {
      "create": "新增MES 工艺路线",
      "edit": "编辑MES 工艺路线"
    },
    "searchFields": [],
    "fields": [
      {
        "name": "code",
        "label": "工艺路线编码",
        "type": "string",
        "required": false,
        "testId": "field-code",
        "selector": "[data-testid=\"field-code\"]"
      },
      {
        "name": "name",
        "label": "工艺路线名称",
        "type": "string",
        "required": false,
        "testId": "field-name",
        "selector": "[data-testid=\"field-name\"]"
      },
      {
        "name": "description",
        "label": "工艺路线说明",
        "type": "string",
        "required": false,
        "testId": "field-description",
        "selector": "[data-testid=\"field-description\"]"
      },
      {
        "name": "status",
        "label": "状态",
        "type": "number",
        "required": false,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "mes-pro-route",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"mes-pro-route\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"mes-pro-route-form-overlay\"]",
      "dialog": "[data-testid=\"mes-pro-route-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "mes-pro-route:search",
      "reset": "mes-pro-route:reset",
      "refresh": "mes-pro-route:refresh",
      "create": "mes-pro-route:create",
      "edit": "mes-pro-route:edit",
      "delete": "mes-pro-route:delete",
      "submit": "mes-pro-route:submit",
      "cancel": "mes-pro-route:cancel",
      "close": "mes-pro-route:close",
      "row": "mes-pro-route:row",
      "pagination": "mes-pro-route:pagination",
      "fields": {
        "code": "mes-pro-route:field:code",
        "name": "mes-pro-route:field:name",
        "description": "mes-pro-route:field:description",
        "status": "mes-pro-route:field:status",
        "remark": "mes-pro-route:field:remark"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mes.mes-pro-route",
      "examples": [
        "mes.mes-pro-route__List__Refresh",
        "mes.mes-pro-route__ListItem__Open",
        "mes.mes-pro-route__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
