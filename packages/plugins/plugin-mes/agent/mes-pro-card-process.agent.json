{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mes",
  "entity": "MesProCardProcess",
  "kebab": "mes-pro-card-process",
  "businessName": "MES 流转卡工序记录",
  "permissionPrefix": "mes:mes_pro_card_process",
  "page": {
    "route": "/admin/mes/mes-pro-card-process",
    "title": "MES 流转卡工序记录管理",
    "titleSelector": "[data-testid=\"mes-pro-card-process-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mes/api",
    "bffMount": "/api/v1/admin/mes",
    "resource": "mes-pro-card-process",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/mes-pro-card-process",
        "query": [
          "page",
          "pageSize"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/mes-pro-card-process/:id"
      },
      "create": {
        "http": "POST",
        "path": "/mes-pro-card-process"
      },
      "update": {
        "http": "PUT",
        "path": "/mes-pro-card-process/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/mes-pro-card-process/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"mes-pro-card-process-title\"]",
    "refresh": "[data-testid=\"mes-pro-card-process-refresh\"]",
    "createButton": "[data-testid=\"mes-pro-card-process-create\"]",
    "searchForm": "[data-testid=\"mes-pro-card-process-search\"]",
    "searchSubmit": "[data-testid=\"mes-pro-card-process-search-submit\"]",
    "searchReset": "[data-testid=\"mes-pro-card-process-search-reset\"]",
    "total": "[data-testid=\"mes-pro-card-process-total\"]",
    "table": "[data-testid=\"mes-pro-card-process-table\"]",
    "row": "[data-testid=\"mes-pro-card-process-row\"]",
    "editButton": "[data-testid=\"mes-pro-card-process-edit\"]",
    "deleteButton": "[data-testid=\"mes-pro-card-process-delete\"]",
    "form": "[data-testid=\"mes-pro-card-process-form\"]",
    "formError": "[data-testid=\"mes-pro-card-process-form-error\"]",
    "formSubmit": "[data-testid=\"mes-pro-card-process-form-submit\"]",
    "formCancel": "[data-testid=\"mes-pro-card-process-form-cancel\"]",
    "formClose": "[data-testid=\"mes-pro-card-process-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "MES 流转卡工序记录列表",
    "dialogLabel": {
      "create": "新增MES 流转卡工序记录",
      "edit": "编辑MES 流转卡工序记录"
    },
    "searchFields": [],
    "fields": [
      {
        "name": "card_id",
        "label": "流转卡编号",
        "type": "number",
        "required": false,
        "testId": "field-card_id",
        "selector": "[data-testid=\"field-card_id\"]"
      },
      {
        "name": "sort",
        "label": "序号",
        "type": "number",
        "required": false,
        "testId": "field-sort",
        "selector": "[data-testid=\"field-sort\"]"
      },
      {
        "name": "process_id",
        "label": "工序编号",
        "type": "number",
        "required": false,
        "testId": "field-process_id",
        "selector": "[data-testid=\"field-process_id\"]"
      },
      {
        "name": "input_time",
        "label": "进入工序时间",
        "type": "string",
        "required": false,
        "testId": "field-input_time",
        "selector": "[data-testid=\"field-input_time\"]"
      },
      {
        "name": "output_time",
        "label": "出工序时间",
        "type": "string",
        "required": false,
        "testId": "field-output_time",
        "selector": "[data-testid=\"field-output_time\"]"
      },
      {
        "name": "input_quantity",
        "label": "投入数量",
        "type": "number",
        "required": false,
        "testId": "field-input_quantity",
        "selector": "[data-testid=\"field-input_quantity\"]"
      },
      {
        "name": "output_quantity",
        "label": "产出数量",
        "type": "number",
        "required": false,
        "testId": "field-output_quantity",
        "selector": "[data-testid=\"field-output_quantity\"]"
      },
      {
        "name": "unqualified_quantity",
        "label": "不合格品数量",
        "type": "number",
        "required": false,
        "testId": "field-unqualified_quantity",
        "selector": "[data-testid=\"field-unqualified_quantity\"]"
      },
      {
        "name": "workstation_id",
        "label": "工位编号",
        "type": "number",
        "required": false,
        "testId": "field-workstation_id",
        "selector": "[data-testid=\"field-workstation_id\"]"
      },
      {
        "name": "user_id",
        "label": "操作人编号",
        "type": "number",
        "required": false,
        "testId": "field-user_id",
        "selector": "[data-testid=\"field-user_id\"]"
      },
      {
        "name": "ipqc_id",
        "label": "过程检验单编号",
        "type": "number",
        "required": false,
        "testId": "field-ipqc_id",
        "selector": "[data-testid=\"field-ipqc_id\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "mes-pro-card-process",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"mes-pro-card-process\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"mes-pro-card-process-form-overlay\"]",
      "dialog": "[data-testid=\"mes-pro-card-process-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "mes-pro-card-process:search",
      "reset": "mes-pro-card-process:reset",
      "refresh": "mes-pro-card-process:refresh",
      "create": "mes-pro-card-process:create",
      "edit": "mes-pro-card-process:edit",
      "delete": "mes-pro-card-process:delete",
      "submit": "mes-pro-card-process:submit",
      "cancel": "mes-pro-card-process:cancel",
      "close": "mes-pro-card-process:close",
      "row": "mes-pro-card-process:row",
      "pagination": "mes-pro-card-process:pagination",
      "fields": {
        "card_id": "mes-pro-card-process:field:card_id",
        "sort": "mes-pro-card-process:field:sort",
        "process_id": "mes-pro-card-process:field:process_id",
        "input_time": "mes-pro-card-process:field:input_time",
        "output_time": "mes-pro-card-process:field:output_time",
        "input_quantity": "mes-pro-card-process:field:input_quantity",
        "output_quantity": "mes-pro-card-process:field:output_quantity",
        "unqualified_quantity": "mes-pro-card-process:field:unqualified_quantity",
        "workstation_id": "mes-pro-card-process:field:workstation_id",
        "user_id": "mes-pro-card-process:field:user_id",
        "ipqc_id": "mes-pro-card-process:field:ipqc_id",
        "remark": "mes-pro-card-process:field:remark"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mes.mes-pro-card-process",
      "examples": [
        "mes.mes-pro-card-process__List__Refresh",
        "mes.mes-pro-card-process__ListItem__Open",
        "mes.mes-pro-card-process__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
