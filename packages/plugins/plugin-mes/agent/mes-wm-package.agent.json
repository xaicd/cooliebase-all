{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mes",
  "entity": "MesWmPackage",
  "kebab": "mes-wm-package",
  "businessName": "MES 装箱单",
  "permissionPrefix": "mes:mes_wm_package",
  "page": {
    "route": "/admin/mes/mes-wm-package",
    "title": "MES 装箱单管理",
    "titleSelector": "[data-testid=\"mes-wm-package-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mes/api",
    "bffMount": "/api/v1/admin/mes",
    "resource": "mes-wm-package",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/mes-wm-package",
        "query": [
          "page",
          "pageSize",
          "code",
          "parent_id",
          "client_id",
          "size_unit_id",
          "weight_unit_id"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/mes-wm-package/:id"
      },
      "create": {
        "http": "POST",
        "path": "/mes-wm-package"
      },
      "update": {
        "http": "PUT",
        "path": "/mes-wm-package/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/mes-wm-package/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"mes-wm-package-title\"]",
    "refresh": "[data-testid=\"mes-wm-package-refresh\"]",
    "createButton": "[data-testid=\"mes-wm-package-create\"]",
    "searchForm": "[data-testid=\"mes-wm-package-search\"]",
    "searchSubmit": "[data-testid=\"mes-wm-package-search-submit\"]",
    "searchReset": "[data-testid=\"mes-wm-package-search-reset\"]",
    "total": "[data-testid=\"mes-wm-package-total\"]",
    "table": "[data-testid=\"mes-wm-package-table\"]",
    "row": "[data-testid=\"mes-wm-package-row\"]",
    "editButton": "[data-testid=\"mes-wm-package-edit\"]",
    "deleteButton": "[data-testid=\"mes-wm-package-delete\"]",
    "form": "[data-testid=\"mes-wm-package-form\"]",
    "formError": "[data-testid=\"mes-wm-package-form-error\"]",
    "formSubmit": "[data-testid=\"mes-wm-package-form-submit\"]",
    "formCancel": "[data-testid=\"mes-wm-package-form-cancel\"]",
    "formClose": "[data-testid=\"mes-wm-package-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "MES 装箱单列表",
    "dialogLabel": {
      "create": "新增MES 装箱单",
      "edit": "编辑MES 装箱单"
    },
    "searchFields": [
      {
        "name": "code",
        "label": "装箱单编号",
        "testId": "search-code",
        "selector": "[data-testid=\"search-code\"]"
      },
      {
        "name": "parent_id",
        "label": "父箱 ID",
        "testId": "search-parent_id",
        "selector": "[data-testid=\"search-parent_id\"]"
      },
      {
        "name": "client_id",
        "label": "客户 ID",
        "testId": "search-client_id",
        "selector": "[data-testid=\"search-client_id\"]"
      },
      {
        "name": "size_unit_id",
        "label": "尺寸单位 ID",
        "testId": "search-size_unit_id",
        "selector": "[data-testid=\"search-size_unit_id\"]"
      },
      {
        "name": "weight_unit_id",
        "label": "重量单位 ID",
        "testId": "search-weight_unit_id",
        "selector": "[data-testid=\"search-weight_unit_id\"]"
      }
    ],
    "fields": [
      {
        "name": "code",
        "label": "装箱单编号",
        "type": "string",
        "required": false,
        "testId": "field-code",
        "selector": "[data-testid=\"field-code\"]"
      },
      {
        "name": "parent_id",
        "label": "父箱 ID",
        "type": "string",
        "required": false,
        "testId": "field-parent_id",
        "selector": "[data-testid=\"field-parent_id\"]"
      },
      {
        "name": "package_date",
        "label": "装箱日期",
        "type": "string",
        "required": false,
        "testId": "field-package_date",
        "selector": "[data-testid=\"field-package_date\"]"
      },
      {
        "name": "sales_order_code",
        "label": "销售订单编号",
        "type": "string",
        "required": false,
        "testId": "field-sales_order_code",
        "selector": "[data-testid=\"field-sales_order_code\"]"
      },
      {
        "name": "invoice_code",
        "label": "发票编号",
        "type": "string",
        "required": false,
        "testId": "field-invoice_code",
        "selector": "[data-testid=\"field-invoice_code\"]"
      },
      {
        "name": "client_id",
        "label": "客户 ID",
        "type": "string",
        "required": false,
        "testId": "field-client_id",
        "selector": "[data-testid=\"field-client_id\"]"
      },
      {
        "name": "length",
        "label": "箱长度",
        "type": "number",
        "required": false,
        "testId": "field-length",
        "selector": "[data-testid=\"field-length\"]"
      },
      {
        "name": "width",
        "label": "箱宽度",
        "type": "number",
        "required": false,
        "testId": "field-width",
        "selector": "[data-testid=\"field-width\"]"
      },
      {
        "name": "height",
        "label": "箱高度",
        "type": "number",
        "required": false,
        "testId": "field-height",
        "selector": "[data-testid=\"field-height\"]"
      },
      {
        "name": "size_unit_id",
        "label": "尺寸单位 ID",
        "type": "string",
        "required": false,
        "testId": "field-size_unit_id",
        "selector": "[data-testid=\"field-size_unit_id\"]"
      },
      {
        "name": "net_weight",
        "label": "净重",
        "type": "number",
        "required": false,
        "testId": "field-net_weight",
        "selector": "[data-testid=\"field-net_weight\"]"
      },
      {
        "name": "gross_weight",
        "label": "毛重",
        "type": "number",
        "required": false,
        "testId": "field-gross_weight",
        "selector": "[data-testid=\"field-gross_weight\"]"
      },
      {
        "name": "weight_unit_id",
        "label": "重量单位 ID",
        "type": "string",
        "required": false,
        "testId": "field-weight_unit_id",
        "selector": "[data-testid=\"field-weight_unit_id\"]"
      },
      {
        "name": "inspector_user_id",
        "label": "检查员用户 ID",
        "type": "string",
        "required": false,
        "testId": "field-inspector_user_id",
        "selector": "[data-testid=\"field-inspector_user_id\"]"
      },
      {
        "name": "status",
        "label": "状态",
        "type": "number",
        "required": false,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "mes-wm-package",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"mes-wm-package\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"mes-wm-package-form-overlay\"]",
      "dialog": "[data-testid=\"mes-wm-package-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "mes-wm-package:search",
      "reset": "mes-wm-package:reset",
      "refresh": "mes-wm-package:refresh",
      "create": "mes-wm-package:create",
      "edit": "mes-wm-package:edit",
      "delete": "mes-wm-package:delete",
      "submit": "mes-wm-package:submit",
      "cancel": "mes-wm-package:cancel",
      "close": "mes-wm-package:close",
      "row": "mes-wm-package:row",
      "pagination": "mes-wm-package:pagination",
      "fields": {
        "code": "mes-wm-package:field:code",
        "parent_id": "mes-wm-package:field:parent_id",
        "package_date": "mes-wm-package:field:package_date",
        "sales_order_code": "mes-wm-package:field:sales_order_code",
        "invoice_code": "mes-wm-package:field:invoice_code",
        "client_id": "mes-wm-package:field:client_id",
        "length": "mes-wm-package:field:length",
        "width": "mes-wm-package:field:width",
        "height": "mes-wm-package:field:height",
        "size_unit_id": "mes-wm-package:field:size_unit_id",
        "net_weight": "mes-wm-package:field:net_weight",
        "gross_weight": "mes-wm-package:field:gross_weight",
        "weight_unit_id": "mes-wm-package:field:weight_unit_id",
        "inspector_user_id": "mes-wm-package:field:inspector_user_id",
        "status": "mes-wm-package:field:status",
        "remark": "mes-wm-package:field:remark"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mes.mes-wm-package",
      "examples": [
        "mes.mes-wm-package__List__Refresh",
        "mes.mes-wm-package__ListItem__Open",
        "mes.mes-wm-package__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
