{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mes",
  "entity": "MesDvRepair",
  "kebab": "mes-dv-repair",
  "businessName": "MES 维修工单",
  "permissionPrefix": "mes:mes_dv_repair",
  "page": {
    "route": "/admin/mes/mes-dv-repair",
    "title": "MES 维修工单管理",
    "titleSelector": "[data-testid=\"mes-dv-repair-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mes/api",
    "bffMount": "/api/v1/admin/mes",
    "resource": "mes-dv-repair",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/mes-dv-repair",
        "query": [
          "page",
          "pageSize",
          "code",
          "name",
          "machinery_id",
          "accepted_user_id",
          "confirm_user_id"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/mes-dv-repair/:id"
      },
      "create": {
        "http": "POST",
        "path": "/mes-dv-repair"
      },
      "update": {
        "http": "PUT",
        "path": "/mes-dv-repair/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/mes-dv-repair/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"mes-dv-repair-title\"]",
    "refresh": "[data-testid=\"mes-dv-repair-refresh\"]",
    "createButton": "[data-testid=\"mes-dv-repair-create\"]",
    "searchForm": "[data-testid=\"mes-dv-repair-search\"]",
    "searchSubmit": "[data-testid=\"mes-dv-repair-search-submit\"]",
    "searchReset": "[data-testid=\"mes-dv-repair-search-reset\"]",
    "total": "[data-testid=\"mes-dv-repair-total\"]",
    "table": "[data-testid=\"mes-dv-repair-table\"]",
    "row": "[data-testid=\"mes-dv-repair-row\"]",
    "editButton": "[data-testid=\"mes-dv-repair-edit\"]",
    "deleteButton": "[data-testid=\"mes-dv-repair-delete\"]",
    "form": "[data-testid=\"mes-dv-repair-form\"]",
    "formError": "[data-testid=\"mes-dv-repair-form-error\"]",
    "formSubmit": "[data-testid=\"mes-dv-repair-form-submit\"]",
    "formCancel": "[data-testid=\"mes-dv-repair-form-cancel\"]",
    "formClose": "[data-testid=\"mes-dv-repair-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "MES 维修工单列表",
    "dialogLabel": {
      "create": "新增MES 维修工单",
      "edit": "编辑MES 维修工单"
    },
    "searchFields": [
      {
        "name": "code",
        "label": "维修工单编码",
        "testId": "search-code",
        "selector": "[data-testid=\"search-code\"]"
      },
      {
        "name": "name",
        "label": "维修工单名称",
        "testId": "search-name",
        "selector": "[data-testid=\"search-name\"]"
      },
      {
        "name": "machinery_id",
        "label": "设备编号",
        "testId": "search-machinery_id",
        "selector": "[data-testid=\"search-machinery_id\"]"
      },
      {
        "name": "accepted_user_id",
        "label": "维修人用户编号",
        "testId": "search-accepted_user_id",
        "selector": "[data-testid=\"search-accepted_user_id\"]"
      },
      {
        "name": "confirm_user_id",
        "label": "验收人用户编号",
        "testId": "search-confirm_user_id",
        "selector": "[data-testid=\"search-confirm_user_id\"]"
      }
    ],
    "fields": [
      {
        "name": "code",
        "label": "维修工单编码",
        "type": "string",
        "required": false,
        "testId": "field-code",
        "selector": "[data-testid=\"field-code\"]"
      },
      {
        "name": "name",
        "label": "维修工单名称",
        "type": "string",
        "required": false,
        "testId": "field-name",
        "selector": "[data-testid=\"field-name\"]"
      },
      {
        "name": "machinery_id",
        "label": "设备编号",
        "type": "string",
        "required": false,
        "testId": "field-machinery_id",
        "selector": "[data-testid=\"field-machinery_id\"]"
      },
      {
        "name": "require_date",
        "label": "报修日期",
        "type": "string",
        "required": false,
        "testId": "field-require_date",
        "selector": "[data-testid=\"field-require_date\"]"
      },
      {
        "name": "finish_date",
        "label": "维修完成日期",
        "type": "string",
        "required": false,
        "testId": "field-finish_date",
        "selector": "[data-testid=\"field-finish_date\"]"
      },
      {
        "name": "confirm_date",
        "label": "验收日期",
        "type": "string",
        "required": false,
        "testId": "field-confirm_date",
        "selector": "[data-testid=\"field-confirm_date\"]"
      },
      {
        "name": "result",
        "label": "维修结果",
        "type": "number",
        "required": false,
        "testId": "field-result",
        "selector": "[data-testid=\"field-result\"]"
      },
      {
        "name": "accepted_user_id",
        "label": "维修人用户编号",
        "type": "string",
        "required": false,
        "testId": "field-accepted_user_id",
        "selector": "[data-testid=\"field-accepted_user_id\"]"
      },
      {
        "name": "confirm_user_id",
        "label": "验收人用户编号",
        "type": "string",
        "required": false,
        "testId": "field-confirm_user_id",
        "selector": "[data-testid=\"field-confirm_user_id\"]"
      },
      {
        "name": "source_doc_type",
        "label": "来源单据类型",
        "type": "number",
        "required": false,
        "testId": "field-source_doc_type",
        "selector": "[data-testid=\"field-source_doc_type\"]"
      },
      {
        "name": "source_doc_id",
        "label": "来源单据编号",
        "type": "string",
        "required": false,
        "testId": "field-source_doc_id",
        "selector": "[data-testid=\"field-source_doc_id\"]"
      },
      {
        "name": "source_doc_code",
        "label": "来源单据编码",
        "type": "string",
        "required": false,
        "testId": "field-source_doc_code",
        "selector": "[data-testid=\"field-source_doc_code\"]"
      },
      {
        "name": "status",
        "label": "状态",
        "type": "number",
        "required": false,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "mes-dv-repair",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"mes-dv-repair\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"mes-dv-repair-form-overlay\"]",
      "dialog": "[data-testid=\"mes-dv-repair-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "mes-dv-repair:search",
      "reset": "mes-dv-repair:reset",
      "refresh": "mes-dv-repair:refresh",
      "create": "mes-dv-repair:create",
      "edit": "mes-dv-repair:edit",
      "delete": "mes-dv-repair:delete",
      "submit": "mes-dv-repair:submit",
      "cancel": "mes-dv-repair:cancel",
      "close": "mes-dv-repair:close",
      "row": "mes-dv-repair:row",
      "pagination": "mes-dv-repair:pagination",
      "fields": {
        "code": "mes-dv-repair:field:code",
        "name": "mes-dv-repair:field:name",
        "machinery_id": "mes-dv-repair:field:machinery_id",
        "require_date": "mes-dv-repair:field:require_date",
        "finish_date": "mes-dv-repair:field:finish_date",
        "confirm_date": "mes-dv-repair:field:confirm_date",
        "result": "mes-dv-repair:field:result",
        "accepted_user_id": "mes-dv-repair:field:accepted_user_id",
        "confirm_user_id": "mes-dv-repair:field:confirm_user_id",
        "source_doc_type": "mes-dv-repair:field:source_doc_type",
        "source_doc_id": "mes-dv-repair:field:source_doc_id",
        "source_doc_code": "mes-dv-repair:field:source_doc_code",
        "status": "mes-dv-repair:field:status",
        "remark": "mes-dv-repair:field:remark"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mes.mes-dv-repair",
      "examples": [
        "mes.mes-dv-repair__List__Refresh",
        "mes.mes-dv-repair__ListItem__Open",
        "mes.mes-dv-repair__Form__Submit"
      ]
    }
  },
  "enums": {
    "status": {
      "type": "enum",
      "values": [
        "0",
        "1",
        "2",
        "4"
      ],
      "labels": {
        "0": "草稿",
        "1": "维修中",
        "2": "待验收",
        "4": "已确认"
      },
      "description": "状态"
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
