{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mes",
  "entity": "MesWmReturnSalesDetail",
  "kebab": "mes-wm-return-sales-detail",
  "businessName": "MES 销售退货明细",
  "permissionPrefix": "mes:mes_wm_return_sales_detail",
  "page": {
    "route": "/admin/mes/mes-wm-return-sales-detail",
    "title": "MES 销售退货明细管理",
    "titleSelector": "[data-testid=\"mes-wm-return-sales-detail-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mes/api",
    "bffMount": "/api/v1/admin/mes",
    "resource": "mes-wm-return-sales-detail",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/mes-wm-return-sales-detail",
        "query": [
          "page",
          "pageSize",
          "return_id",
          "line_id",
          "item_id",
          "batch_id",
          "warehouse_id"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/mes-wm-return-sales-detail/:id"
      },
      "create": {
        "http": "POST",
        "path": "/mes-wm-return-sales-detail"
      },
      "update": {
        "http": "PUT",
        "path": "/mes-wm-return-sales-detail/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/mes-wm-return-sales-detail/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"mes-wm-return-sales-detail-title\"]",
    "refresh": "[data-testid=\"mes-wm-return-sales-detail-refresh\"]",
    "createButton": "[data-testid=\"mes-wm-return-sales-detail-create\"]",
    "searchForm": "[data-testid=\"mes-wm-return-sales-detail-search\"]",
    "searchSubmit": "[data-testid=\"mes-wm-return-sales-detail-search-submit\"]",
    "searchReset": "[data-testid=\"mes-wm-return-sales-detail-search-reset\"]",
    "total": "[data-testid=\"mes-wm-return-sales-detail-total\"]",
    "table": "[data-testid=\"mes-wm-return-sales-detail-table\"]",
    "row": "[data-testid=\"mes-wm-return-sales-detail-row\"]",
    "editButton": "[data-testid=\"mes-wm-return-sales-detail-edit\"]",
    "deleteButton": "[data-testid=\"mes-wm-return-sales-detail-delete\"]",
    "form": "[data-testid=\"mes-wm-return-sales-detail-form\"]",
    "formError": "[data-testid=\"mes-wm-return-sales-detail-form-error\"]",
    "formSubmit": "[data-testid=\"mes-wm-return-sales-detail-form-submit\"]",
    "formCancel": "[data-testid=\"mes-wm-return-sales-detail-form-cancel\"]",
    "formClose": "[data-testid=\"mes-wm-return-sales-detail-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "MES 销售退货明细列表",
    "dialogLabel": {
      "create": "新增MES 销售退货明细",
      "edit": "编辑MES 销售退货明细"
    },
    "searchFields": [
      {
        "name": "return_id",
        "label": "退货单 ID",
        "testId": "search-return_id",
        "selector": "[data-testid=\"search-return_id\"]"
      },
      {
        "name": "line_id",
        "label": "行 ID",
        "testId": "search-line_id",
        "selector": "[data-testid=\"search-line_id\"]"
      },
      {
        "name": "item_id",
        "label": "物料 ID",
        "testId": "search-item_id",
        "selector": "[data-testid=\"search-item_id\"]"
      },
      {
        "name": "batch_id",
        "label": "批次 ID",
        "testId": "search-batch_id",
        "selector": "[data-testid=\"search-batch_id\"]"
      },
      {
        "name": "warehouse_id",
        "label": "仓库 ID",
        "testId": "search-warehouse_id",
        "selector": "[data-testid=\"search-warehouse_id\"]"
      }
    ],
    "fields": [
      {
        "name": "return_id",
        "label": "退货单 ID",
        "type": "string",
        "required": false,
        "testId": "field-return_id",
        "selector": "[data-testid=\"field-return_id\"]"
      },
      {
        "name": "line_id",
        "label": "行 ID",
        "type": "string",
        "required": false,
        "testId": "field-line_id",
        "selector": "[data-testid=\"field-line_id\"]"
      },
      {
        "name": "item_id",
        "label": "物料 ID",
        "type": "string",
        "required": false,
        "testId": "field-item_id",
        "selector": "[data-testid=\"field-item_id\"]"
      },
      {
        "name": "quantity",
        "label": "数量",
        "type": "number",
        "required": false,
        "testId": "field-quantity",
        "selector": "[data-testid=\"field-quantity\"]"
      },
      {
        "name": "batch_id",
        "label": "批次 ID",
        "type": "string",
        "required": false,
        "testId": "field-batch_id",
        "selector": "[data-testid=\"field-batch_id\"]"
      },
      {
        "name": "batch_code",
        "label": "批次号",
        "type": "string",
        "required": false,
        "testId": "field-batch_code",
        "selector": "[data-testid=\"field-batch_code\"]"
      },
      {
        "name": "warehouse_id",
        "label": "仓库 ID",
        "type": "string",
        "required": false,
        "testId": "field-warehouse_id",
        "selector": "[data-testid=\"field-warehouse_id\"]"
      },
      {
        "name": "location_id",
        "label": "库区 ID",
        "type": "string",
        "required": false,
        "testId": "field-location_id",
        "selector": "[data-testid=\"field-location_id\"]"
      },
      {
        "name": "area_id",
        "label": "库位 ID",
        "type": "string",
        "required": false,
        "testId": "field-area_id",
        "selector": "[data-testid=\"field-area_id\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "mes-wm-return-sales-detail",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"mes-wm-return-sales-detail\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"mes-wm-return-sales-detail-form-overlay\"]",
      "dialog": "[data-testid=\"mes-wm-return-sales-detail-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "mes-wm-return-sales-detail:search",
      "reset": "mes-wm-return-sales-detail:reset",
      "refresh": "mes-wm-return-sales-detail:refresh",
      "create": "mes-wm-return-sales-detail:create",
      "edit": "mes-wm-return-sales-detail:edit",
      "delete": "mes-wm-return-sales-detail:delete",
      "submit": "mes-wm-return-sales-detail:submit",
      "cancel": "mes-wm-return-sales-detail:cancel",
      "close": "mes-wm-return-sales-detail:close",
      "row": "mes-wm-return-sales-detail:row",
      "pagination": "mes-wm-return-sales-detail:pagination",
      "fields": {
        "return_id": "mes-wm-return-sales-detail:field:return_id",
        "line_id": "mes-wm-return-sales-detail:field:line_id",
        "item_id": "mes-wm-return-sales-detail:field:item_id",
        "quantity": "mes-wm-return-sales-detail:field:quantity",
        "batch_id": "mes-wm-return-sales-detail:field:batch_id",
        "batch_code": "mes-wm-return-sales-detail:field:batch_code",
        "warehouse_id": "mes-wm-return-sales-detail:field:warehouse_id",
        "location_id": "mes-wm-return-sales-detail:field:location_id",
        "area_id": "mes-wm-return-sales-detail:field:area_id",
        "remark": "mes-wm-return-sales-detail:field:remark"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mes.mes-wm-return-sales-detail",
      "examples": [
        "mes.mes-wm-return-sales-detail__List__Refresh",
        "mes.mes-wm-return-sales-detail__ListItem__Open",
        "mes.mes-wm-return-sales-detail__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
