{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mes",
  "entity": "MesCalTeam",
  "kebab": "mes-cal-team",
  "businessName": "MES 班组",
  "permissionPrefix": "mes:mes_cal_team",
  "page": {
    "route": "/admin/mes/mes-cal-team",
    "title": "MES 班组管理",
    "titleSelector": "[data-testid=\"mes-cal-team-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mes/api",
    "bffMount": "/api/v1/admin/mes",
    "resource": "mes-cal-team",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/mes-cal-team",
        "query": [
          "page",
          "pageSize"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/mes-cal-team/:id"
      },
      "create": {
        "http": "POST",
        "path": "/mes-cal-team"
      },
      "update": {
        "http": "PUT",
        "path": "/mes-cal-team/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/mes-cal-team/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"mes-cal-team-title\"]",
    "refresh": "[data-testid=\"mes-cal-team-refresh\"]",
    "createButton": "[data-testid=\"mes-cal-team-create\"]",
    "searchForm": "[data-testid=\"mes-cal-team-search\"]",
    "searchSubmit": "[data-testid=\"mes-cal-team-search-submit\"]",
    "searchReset": "[data-testid=\"mes-cal-team-search-reset\"]",
    "total": "[data-testid=\"mes-cal-team-total\"]",
    "table": "[data-testid=\"mes-cal-team-table\"]",
    "row": "[data-testid=\"mes-cal-team-row\"]",
    "editButton": "[data-testid=\"mes-cal-team-edit\"]",
    "deleteButton": "[data-testid=\"mes-cal-team-delete\"]",
    "form": "[data-testid=\"mes-cal-team-form\"]",
    "formError": "[data-testid=\"mes-cal-team-form-error\"]",
    "formSubmit": "[data-testid=\"mes-cal-team-form-submit\"]",
    "formCancel": "[data-testid=\"mes-cal-team-form-cancel\"]",
    "formClose": "[data-testid=\"mes-cal-team-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "MES 班组列表",
    "dialogLabel": {
      "create": "新增MES 班组",
      "edit": "编辑MES 班组"
    },
    "searchFields": [],
    "fields": [
      {
        "name": "code",
        "label": "班组编码",
        "type": "string",
        "required": false,
        "testId": "field-code",
        "selector": "[data-testid=\"field-code\"]"
      },
      {
        "name": "name",
        "label": "班组名称",
        "type": "string",
        "required": false,
        "testId": "field-name",
        "selector": "[data-testid=\"field-name\"]"
      },
      {
        "name": "calendar_type",
        "label": "班组类型",
        "type": "number",
        "required": false,
        "testId": "field-calendar_type",
        "selector": "[data-testid=\"field-calendar_type\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "mes-cal-team",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"mes-cal-team\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"mes-cal-team-form-overlay\"]",
      "dialog": "[data-testid=\"mes-cal-team-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "mes-cal-team:search",
      "reset": "mes-cal-team:reset",
      "refresh": "mes-cal-team:refresh",
      "create": "mes-cal-team:create",
      "edit": "mes-cal-team:edit",
      "delete": "mes-cal-team:delete",
      "submit": "mes-cal-team:submit",
      "cancel": "mes-cal-team:cancel",
      "close": "mes-cal-team:close",
      "row": "mes-cal-team:row",
      "pagination": "mes-cal-team:pagination",
      "fields": {
        "code": "mes-cal-team:field:code",
        "name": "mes-cal-team:field:name",
        "calendar_type": "mes-cal-team:field:calendar_type",
        "remark": "mes-cal-team:field:remark"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mes.mes-cal-team",
      "examples": [
        "mes.mes-cal-team__List__Refresh",
        "mes.mes-cal-team__ListItem__Open",
        "mes.mes-cal-team__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
