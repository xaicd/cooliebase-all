{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mes",
  "entity": "MesWmWarehouse",
  "kebab": "mes-wm-warehouse",
  "businessName": "MES 仓库",
  "permissionPrefix": "mes:mes_wm_warehouse",
  "page": {
    "route": "/admin/mes/mes-wm-warehouse",
    "title": "MES 仓库管理",
    "titleSelector": "[data-testid=\"mes-wm-warehouse-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mes/api",
    "bffMount": "/api/v1/admin/mes",
    "resource": "mes-wm-warehouse",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/mes-wm-warehouse",
        "query": [
          "page",
          "pageSize"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/mes-wm-warehouse/:id"
      },
      "create": {
        "http": "POST",
        "path": "/mes-wm-warehouse"
      },
      "update": {
        "http": "PUT",
        "path": "/mes-wm-warehouse/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/mes-wm-warehouse/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"mes-wm-warehouse-title\"]",
    "refresh": "[data-testid=\"mes-wm-warehouse-refresh\"]",
    "createButton": "[data-testid=\"mes-wm-warehouse-create\"]",
    "searchForm": "[data-testid=\"mes-wm-warehouse-search\"]",
    "searchSubmit": "[data-testid=\"mes-wm-warehouse-search-submit\"]",
    "searchReset": "[data-testid=\"mes-wm-warehouse-search-reset\"]",
    "total": "[data-testid=\"mes-wm-warehouse-total\"]",
    "table": "[data-testid=\"mes-wm-warehouse-table\"]",
    "row": "[data-testid=\"mes-wm-warehouse-row\"]",
    "editButton": "[data-testid=\"mes-wm-warehouse-edit\"]",
    "deleteButton": "[data-testid=\"mes-wm-warehouse-delete\"]",
    "form": "[data-testid=\"mes-wm-warehouse-form\"]",
    "formError": "[data-testid=\"mes-wm-warehouse-form-error\"]",
    "formSubmit": "[data-testid=\"mes-wm-warehouse-form-submit\"]",
    "formCancel": "[data-testid=\"mes-wm-warehouse-form-cancel\"]",
    "formClose": "[data-testid=\"mes-wm-warehouse-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "MES 仓库列表",
    "dialogLabel": {
      "create": "新增MES 仓库",
      "edit": "编辑MES 仓库"
    },
    "searchFields": [],
    "fields": [
      {
        "name": "code",
        "label": "仓库编码",
        "type": "string",
        "required": false,
        "testId": "field-code",
        "selector": "[data-testid=\"field-code\"]"
      },
      {
        "name": "name",
        "label": "仓库名称",
        "type": "string",
        "required": false,
        "testId": "field-name",
        "selector": "[data-testid=\"field-name\"]"
      },
      {
        "name": "address",
        "label": "仓库地址",
        "type": "string",
        "required": false,
        "testId": "field-address",
        "selector": "[data-testid=\"field-address\"]"
      },
      {
        "name": "area",
        "label": "面积",
        "type": "number",
        "required": false,
        "testId": "field-area",
        "selector": "[data-testid=\"field-area\"]"
      },
      {
        "name": "charge_user_id",
        "label": "负责人用户编号",
        "type": "number",
        "required": false,
        "testId": "field-charge_user_id",
        "selector": "[data-testid=\"field-charge_user_id\"]"
      },
      {
        "name": "frozen",
        "label": "是否冻结",
        "type": "boolean",
        "required": false,
        "testId": "field-frozen",
        "selector": "[data-testid=\"field-frozen\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "mes-wm-warehouse",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"mes-wm-warehouse\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"mes-wm-warehouse-form-overlay\"]",
      "dialog": "[data-testid=\"mes-wm-warehouse-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "mes-wm-warehouse:search",
      "reset": "mes-wm-warehouse:reset",
      "refresh": "mes-wm-warehouse:refresh",
      "create": "mes-wm-warehouse:create",
      "edit": "mes-wm-warehouse:edit",
      "delete": "mes-wm-warehouse:delete",
      "submit": "mes-wm-warehouse:submit",
      "cancel": "mes-wm-warehouse:cancel",
      "close": "mes-wm-warehouse:close",
      "row": "mes-wm-warehouse:row",
      "pagination": "mes-wm-warehouse:pagination",
      "fields": {
        "code": "mes-wm-warehouse:field:code",
        "name": "mes-wm-warehouse:field:name",
        "address": "mes-wm-warehouse:field:address",
        "area": "mes-wm-warehouse:field:area",
        "charge_user_id": "mes-wm-warehouse:field:charge_user_id",
        "frozen": "mes-wm-warehouse:field:frozen",
        "remark": "mes-wm-warehouse:field:remark"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mes.mes-wm-warehouse",
      "examples": [
        "mes.mes-wm-warehouse__List__Refresh",
        "mes.mes-wm-warehouse__ListItem__Open",
        "mes.mes-wm-warehouse__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
