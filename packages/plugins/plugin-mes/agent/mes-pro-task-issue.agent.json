{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mes",
  "entity": "MesProTaskIssue",
  "kebab": "mes-pro-task-issue",
  "businessName": "MES 生产任务投料",
  "permissionPrefix": "mes:mes_pro_task_issue",
  "page": {
    "route": "/admin/mes/mes-pro-task-issue",
    "title": "MES 生产任务投料管理",
    "titleSelector": "[data-testid=\"mes-pro-task-issue-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mes/api",
    "bffMount": "/api/v1/admin/mes",
    "resource": "mes-pro-task-issue",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/mes-pro-task-issue",
        "query": [
          "page",
          "pageSize"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/mes-pro-task-issue/:id"
      },
      "create": {
        "http": "POST",
        "path": "/mes-pro-task-issue"
      },
      "update": {
        "http": "PUT",
        "path": "/mes-pro-task-issue/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/mes-pro-task-issue/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"mes-pro-task-issue-title\"]",
    "refresh": "[data-testid=\"mes-pro-task-issue-refresh\"]",
    "createButton": "[data-testid=\"mes-pro-task-issue-create\"]",
    "searchForm": "[data-testid=\"mes-pro-task-issue-search\"]",
    "searchSubmit": "[data-testid=\"mes-pro-task-issue-search-submit\"]",
    "searchReset": "[data-testid=\"mes-pro-task-issue-search-reset\"]",
    "total": "[data-testid=\"mes-pro-task-issue-total\"]",
    "table": "[data-testid=\"mes-pro-task-issue-table\"]",
    "row": "[data-testid=\"mes-pro-task-issue-row\"]",
    "editButton": "[data-testid=\"mes-pro-task-issue-edit\"]",
    "deleteButton": "[data-testid=\"mes-pro-task-issue-delete\"]",
    "form": "[data-testid=\"mes-pro-task-issue-form\"]",
    "formError": "[data-testid=\"mes-pro-task-issue-form-error\"]",
    "formSubmit": "[data-testid=\"mes-pro-task-issue-form-submit\"]",
    "formCancel": "[data-testid=\"mes-pro-task-issue-form-cancel\"]",
    "formClose": "[data-testid=\"mes-pro-task-issue-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "MES 生产任务投料列表",
    "dialogLabel": {
      "create": "新增MES 生产任务投料",
      "edit": "编辑MES 生产任务投料"
    },
    "searchFields": [],
    "fields": [
      {
        "name": "task_id",
        "label": "生产任务编号",
        "type": "number",
        "required": false,
        "testId": "field-task_id",
        "selector": "[data-testid=\"field-task_id\"]"
      },
      {
        "name": "work_order_id",
        "label": "生产工单编号",
        "type": "number",
        "required": false,
        "testId": "field-work_order_id",
        "selector": "[data-testid=\"field-work_order_id\"]"
      },
      {
        "name": "workstation_id",
        "label": "工作站编号",
        "type": "number",
        "required": false,
        "testId": "field-workstation_id",
        "selector": "[data-testid=\"field-workstation_id\"]"
      },
      {
        "name": "source_doc_type",
        "label": "来源单据类型",
        "type": "string",
        "required": false,
        "testId": "field-source_doc_type",
        "selector": "[data-testid=\"field-source_doc_type\"]"
      },
      {
        "name": "source_doc_id",
        "label": "来源单据编号",
        "type": "number",
        "required": false,
        "testId": "field-source_doc_id",
        "selector": "[data-testid=\"field-source_doc_id\"]"
      },
      {
        "name": "source_line_id",
        "label": "来源单据行编号",
        "type": "number",
        "required": false,
        "testId": "field-source_line_id",
        "selector": "[data-testid=\"field-source_line_id\"]"
      },
      {
        "name": "source_doc_code",
        "label": "来源单据编码",
        "type": "string",
        "required": false,
        "testId": "field-source_doc_code",
        "selector": "[data-testid=\"field-source_doc_code\"]"
      },
      {
        "name": "batch_code",
        "label": "投料批次",
        "type": "string",
        "required": false,
        "testId": "field-batch_code",
        "selector": "[data-testid=\"field-batch_code\"]"
      },
      {
        "name": "item_id",
        "label": "产品物料编号",
        "type": "number",
        "required": false,
        "testId": "field-item_id",
        "selector": "[data-testid=\"field-item_id\"]"
      },
      {
        "name": "unit_measure_id",
        "label": "单位编号",
        "type": "number",
        "required": false,
        "testId": "field-unit_measure_id",
        "selector": "[data-testid=\"field-unit_measure_id\"]"
      },
      {
        "name": "issued_quantity",
        "label": "总投料数量",
        "type": "number",
        "required": false,
        "testId": "field-issued_quantity",
        "selector": "[data-testid=\"field-issued_quantity\"]"
      },
      {
        "name": "available_quantity",
        "label": "当前可用数量",
        "type": "number",
        "required": false,
        "testId": "field-available_quantity",
        "selector": "[data-testid=\"field-available_quantity\"]"
      },
      {
        "name": "used_quantity",
        "label": "当前使用数量",
        "type": "number",
        "required": false,
        "testId": "field-used_quantity",
        "selector": "[data-testid=\"field-used_quantity\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "mes-pro-task-issue",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"mes-pro-task-issue\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"mes-pro-task-issue-form-overlay\"]",
      "dialog": "[data-testid=\"mes-pro-task-issue-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "mes-pro-task-issue:search",
      "reset": "mes-pro-task-issue:reset",
      "refresh": "mes-pro-task-issue:refresh",
      "create": "mes-pro-task-issue:create",
      "edit": "mes-pro-task-issue:edit",
      "delete": "mes-pro-task-issue:delete",
      "submit": "mes-pro-task-issue:submit",
      "cancel": "mes-pro-task-issue:cancel",
      "close": "mes-pro-task-issue:close",
      "row": "mes-pro-task-issue:row",
      "pagination": "mes-pro-task-issue:pagination",
      "fields": {
        "task_id": "mes-pro-task-issue:field:task_id",
        "work_order_id": "mes-pro-task-issue:field:work_order_id",
        "workstation_id": "mes-pro-task-issue:field:workstation_id",
        "source_doc_type": "mes-pro-task-issue:field:source_doc_type",
        "source_doc_id": "mes-pro-task-issue:field:source_doc_id",
        "source_line_id": "mes-pro-task-issue:field:source_line_id",
        "source_doc_code": "mes-pro-task-issue:field:source_doc_code",
        "batch_code": "mes-pro-task-issue:field:batch_code",
        "item_id": "mes-pro-task-issue:field:item_id",
        "unit_measure_id": "mes-pro-task-issue:field:unit_measure_id",
        "issued_quantity": "mes-pro-task-issue:field:issued_quantity",
        "available_quantity": "mes-pro-task-issue:field:available_quantity",
        "used_quantity": "mes-pro-task-issue:field:used_quantity",
        "remark": "mes-pro-task-issue:field:remark"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mes.mes-pro-task-issue",
      "examples": [
        "mes.mes-pro-task-issue__List__Refresh",
        "mes.mes-pro-task-issue__ListItem__Open",
        "mes.mes-pro-task-issue__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
