{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mes",
  "entity": "MesProWorkOrder",
  "kebab": "mes-pro-work-order",
  "businessName": "MES 生产工单",
  "permissionPrefix": "mes:mes_pro_work_order",
  "page": {
    "route": "/admin/mes/mes-pro-work-order",
    "title": "MES 生产工单管理",
    "titleSelector": "[data-testid=\"mes-pro-work-order-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mes/api",
    "bffMount": "/api/v1/admin/mes",
    "resource": "mes-pro-work-order",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/mes-pro-work-order",
        "query": [
          "page",
          "pageSize"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/mes-pro-work-order/:id"
      },
      "create": {
        "http": "POST",
        "path": "/mes-pro-work-order"
      },
      "update": {
        "http": "PUT",
        "path": "/mes-pro-work-order/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/mes-pro-work-order/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"mes-pro-work-order-title\"]",
    "refresh": "[data-testid=\"mes-pro-work-order-refresh\"]",
    "createButton": "[data-testid=\"mes-pro-work-order-create\"]",
    "searchForm": "[data-testid=\"mes-pro-work-order-search\"]",
    "searchSubmit": "[data-testid=\"mes-pro-work-order-search-submit\"]",
    "searchReset": "[data-testid=\"mes-pro-work-order-search-reset\"]",
    "total": "[data-testid=\"mes-pro-work-order-total\"]",
    "table": "[data-testid=\"mes-pro-work-order-table\"]",
    "row": "[data-testid=\"mes-pro-work-order-row\"]",
    "editButton": "[data-testid=\"mes-pro-work-order-edit\"]",
    "deleteButton": "[data-testid=\"mes-pro-work-order-delete\"]",
    "form": "[data-testid=\"mes-pro-work-order-form\"]",
    "formError": "[data-testid=\"mes-pro-work-order-form-error\"]",
    "formSubmit": "[data-testid=\"mes-pro-work-order-form-submit\"]",
    "formCancel": "[data-testid=\"mes-pro-work-order-form-cancel\"]",
    "formClose": "[data-testid=\"mes-pro-work-order-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "MES 生产工单列表",
    "dialogLabel": {
      "create": "新增MES 生产工单",
      "edit": "编辑MES 生产工单"
    },
    "searchFields": [],
    "fields": [
      {
        "name": "code",
        "label": "工单编码",
        "type": "string",
        "required": false,
        "testId": "field-code",
        "selector": "[data-testid=\"field-code\"]"
      },
      {
        "name": "name",
        "label": "工单名称",
        "type": "string",
        "required": false,
        "testId": "field-name",
        "selector": "[data-testid=\"field-name\"]"
      },
      {
        "name": "type",
        "label": "工单类型",
        "type": "number",
        "required": false,
        "testId": "field-type",
        "selector": "[data-testid=\"field-type\"]"
      },
      {
        "name": "order_source_type",
        "label": "来源类型",
        "type": "number",
        "required": false,
        "testId": "field-order_source_type",
        "selector": "[data-testid=\"field-order_source_type\"]"
      },
      {
        "name": "order_source_code",
        "label": "来源单据编号",
        "type": "string",
        "required": false,
        "testId": "field-order_source_code",
        "selector": "[data-testid=\"field-order_source_code\"]"
      },
      {
        "name": "product_id",
        "label": "产品编号",
        "type": "number",
        "required": false,
        "testId": "field-product_id",
        "selector": "[data-testid=\"field-product_id\"]"
      },
      {
        "name": "quantity",
        "label": "生产数量",
        "type": "number",
        "required": false,
        "testId": "field-quantity",
        "selector": "[data-testid=\"field-quantity\"]"
      },
      {
        "name": "quantity_produced",
        "label": "已生产数量",
        "type": "number",
        "required": false,
        "testId": "field-quantity_produced",
        "selector": "[data-testid=\"field-quantity_produced\"]"
      },
      {
        "name": "quantity_changed",
        "label": "调整数量",
        "type": "number",
        "required": false,
        "testId": "field-quantity_changed",
        "selector": "[data-testid=\"field-quantity_changed\"]"
      },
      {
        "name": "quantity_scheduled",
        "label": "已排产数量",
        "type": "number",
        "required": false,
        "testId": "field-quantity_scheduled",
        "selector": "[data-testid=\"field-quantity_scheduled\"]"
      },
      {
        "name": "client_id",
        "label": "客户编号",
        "type": "number",
        "required": false,
        "testId": "field-client_id",
        "selector": "[data-testid=\"field-client_id\"]"
      },
      {
        "name": "vendor_id",
        "label": "供应商编号",
        "type": "number",
        "required": false,
        "testId": "field-vendor_id",
        "selector": "[data-testid=\"field-vendor_id\"]"
      },
      {
        "name": "batch_code",
        "label": "批次号",
        "type": "string",
        "required": false,
        "testId": "field-batch_code",
        "selector": "[data-testid=\"field-batch_code\"]"
      },
      {
        "name": "request_date",
        "label": "需求日期",
        "type": "string",
        "required": false,
        "testId": "field-request_date",
        "selector": "[data-testid=\"field-request_date\"]"
      },
      {
        "name": "parent_id",
        "label": "父工单编号",
        "type": "number",
        "required": false,
        "testId": "field-parent_id",
        "selector": "[data-testid=\"field-parent_id\"]"
      },
      {
        "name": "finish_date",
        "label": "完成时间",
        "type": "string",
        "required": false,
        "testId": "field-finish_date",
        "selector": "[data-testid=\"field-finish_date\"]"
      },
      {
        "name": "cancel_date",
        "label": "取消时间",
        "type": "string",
        "required": false,
        "testId": "field-cancel_date",
        "selector": "[data-testid=\"field-cancel_date\"]"
      },
      {
        "name": "status",
        "label": "工单状态",
        "type": "number",
        "required": false,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "mes-pro-work-order",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"mes-pro-work-order\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"mes-pro-work-order-form-overlay\"]",
      "dialog": "[data-testid=\"mes-pro-work-order-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "mes-pro-work-order:search",
      "reset": "mes-pro-work-order:reset",
      "refresh": "mes-pro-work-order:refresh",
      "create": "mes-pro-work-order:create",
      "edit": "mes-pro-work-order:edit",
      "delete": "mes-pro-work-order:delete",
      "submit": "mes-pro-work-order:submit",
      "cancel": "mes-pro-work-order:cancel",
      "close": "mes-pro-work-order:close",
      "row": "mes-pro-work-order:row",
      "pagination": "mes-pro-work-order:pagination",
      "fields": {
        "code": "mes-pro-work-order:field:code",
        "name": "mes-pro-work-order:field:name",
        "type": "mes-pro-work-order:field:type",
        "order_source_type": "mes-pro-work-order:field:order_source_type",
        "order_source_code": "mes-pro-work-order:field:order_source_code",
        "product_id": "mes-pro-work-order:field:product_id",
        "quantity": "mes-pro-work-order:field:quantity",
        "quantity_produced": "mes-pro-work-order:field:quantity_produced",
        "quantity_changed": "mes-pro-work-order:field:quantity_changed",
        "quantity_scheduled": "mes-pro-work-order:field:quantity_scheduled",
        "client_id": "mes-pro-work-order:field:client_id",
        "vendor_id": "mes-pro-work-order:field:vendor_id",
        "batch_code": "mes-pro-work-order:field:batch_code",
        "request_date": "mes-pro-work-order:field:request_date",
        "parent_id": "mes-pro-work-order:field:parent_id",
        "finish_date": "mes-pro-work-order:field:finish_date",
        "cancel_date": "mes-pro-work-order:field:cancel_date",
        "status": "mes-pro-work-order:field:status",
        "remark": "mes-pro-work-order:field:remark"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mes.mes-pro-work-order",
      "examples": [
        "mes.mes-pro-work-order__List__Refresh",
        "mes.mes-pro-work-order__ListItem__Open",
        "mes.mes-pro-work-order__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
