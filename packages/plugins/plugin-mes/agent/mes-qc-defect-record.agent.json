{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mes",
  "entity": "MesQcDefectRecord",
  "kebab": "mes-qc-defect-record",
  "businessName": "MES 质检缺陷记录 DO通用缺陷记录表，通过 区分检验类型（IQC、IPQC、",
  "permissionPrefix": "mes:mes_qc_defect_record",
  "page": {
    "route": "/admin/mes/mes-qc-defect-record",
    "title": "MES 质检缺陷记录 DO通用缺陷记录表，通过 区分检验类型（IQC、IPQC、管理",
    "titleSelector": "[data-testid=\"mes-qc-defect-record-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mes/api",
    "bffMount": "/api/v1/admin/mes",
    "resource": "mes-qc-defect-record",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/mes-qc-defect-record",
        "query": [
          "page",
          "pageSize",
          "qc_id",
          "line_id",
          "name",
          "level"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/mes-qc-defect-record/:id"
      },
      "create": {
        "http": "POST",
        "path": "/mes-qc-defect-record"
      },
      "update": {
        "http": "PUT",
        "path": "/mes-qc-defect-record/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/mes-qc-defect-record/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"mes-qc-defect-record-title\"]",
    "refresh": "[data-testid=\"mes-qc-defect-record-refresh\"]",
    "createButton": "[data-testid=\"mes-qc-defect-record-create\"]",
    "searchForm": "[data-testid=\"mes-qc-defect-record-search\"]",
    "searchSubmit": "[data-testid=\"mes-qc-defect-record-search-submit\"]",
    "searchReset": "[data-testid=\"mes-qc-defect-record-search-reset\"]",
    "total": "[data-testid=\"mes-qc-defect-record-total\"]",
    "table": "[data-testid=\"mes-qc-defect-record-table\"]",
    "row": "[data-testid=\"mes-qc-defect-record-row\"]",
    "editButton": "[data-testid=\"mes-qc-defect-record-edit\"]",
    "deleteButton": "[data-testid=\"mes-qc-defect-record-delete\"]",
    "form": "[data-testid=\"mes-qc-defect-record-form\"]",
    "formError": "[data-testid=\"mes-qc-defect-record-form-error\"]",
    "formSubmit": "[data-testid=\"mes-qc-defect-record-form-submit\"]",
    "formCancel": "[data-testid=\"mes-qc-defect-record-form-cancel\"]",
    "formClose": "[data-testid=\"mes-qc-defect-record-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "MES 质检缺陷记录 DO通用缺陷记录表，通过 区分检验类型（IQC、IPQC、列表",
    "dialogLabel": {
      "create": "新增MES 质检缺陷记录 DO通用缺陷记录表，通过 区分检验类型（IQC、IPQC、",
      "edit": "编辑MES 质检缺陷记录 DO通用缺陷记录表，通过 区分检验类型（IQC、IPQC、"
    },
    "searchFields": [
      {
        "name": "qc_id",
        "label": "检验单 ID",
        "testId": "search-qc_id",
        "selector": "[data-testid=\"search-qc_id\"]"
      },
      {
        "name": "line_id",
        "label": "检验行 ID",
        "testId": "search-line_id",
        "selector": "[data-testid=\"search-line_id\"]"
      },
      {
        "name": "name",
        "label": "缺陷描述",
        "testId": "search-name",
        "selector": "[data-testid=\"search-name\"]"
      },
      {
        "name": "level",
        "label": "缺陷等级",
        "testId": "search-level",
        "selector": "[data-testid=\"search-level\"]"
      }
    ],
    "fields": [
      {
        "name": "qc_type",
        "label": "检验类型",
        "type": "number",
        "required": false,
        "testId": "field-qc_type",
        "selector": "[data-testid=\"field-qc_type\"]"
      },
      {
        "name": "qc_id",
        "label": "检验单 ID",
        "type": "string",
        "required": false,
        "testId": "field-qc_id",
        "selector": "[data-testid=\"field-qc_id\"]"
      },
      {
        "name": "line_id",
        "label": "检验行 ID",
        "type": "string",
        "required": false,
        "testId": "field-line_id",
        "selector": "[data-testid=\"field-line_id\"]"
      },
      {
        "name": "name",
        "label": "缺陷描述",
        "type": "string",
        "required": false,
        "testId": "field-name",
        "selector": "[data-testid=\"field-name\"]"
      },
      {
        "name": "level",
        "label": "缺陷等级",
        "type": "number",
        "required": false,
        "testId": "field-level",
        "selector": "[data-testid=\"field-level\"]"
      },
      {
        "name": "quantity",
        "label": "缺陷数量",
        "type": "number",
        "required": false,
        "testId": "field-quantity",
        "selector": "[data-testid=\"field-quantity\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "mes-qc-defect-record",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"mes-qc-defect-record\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"mes-qc-defect-record-form-overlay\"]",
      "dialog": "[data-testid=\"mes-qc-defect-record-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "mes-qc-defect-record:search",
      "reset": "mes-qc-defect-record:reset",
      "refresh": "mes-qc-defect-record:refresh",
      "create": "mes-qc-defect-record:create",
      "edit": "mes-qc-defect-record:edit",
      "delete": "mes-qc-defect-record:delete",
      "submit": "mes-qc-defect-record:submit",
      "cancel": "mes-qc-defect-record:cancel",
      "close": "mes-qc-defect-record:close",
      "row": "mes-qc-defect-record:row",
      "pagination": "mes-qc-defect-record:pagination",
      "fields": {
        "qc_type": "mes-qc-defect-record:field:qc_type",
        "qc_id": "mes-qc-defect-record:field:qc_id",
        "line_id": "mes-qc-defect-record:field:line_id",
        "name": "mes-qc-defect-record:field:name",
        "level": "mes-qc-defect-record:field:level",
        "quantity": "mes-qc-defect-record:field:quantity",
        "remark": "mes-qc-defect-record:field:remark"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mes.mes-qc-defect-record",
      "examples": [
        "mes.mes-qc-defect-record__List__Refresh",
        "mes.mes-qc-defect-record__ListItem__Open",
        "mes.mes-qc-defect-record__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
