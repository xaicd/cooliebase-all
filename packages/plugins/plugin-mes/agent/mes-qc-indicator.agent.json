{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mes",
  "entity": "MesQcIndicator",
  "kebab": "mes-qc-indicator",
  "businessName": "MES 质检指标",
  "permissionPrefix": "mes:mes_qc_indicator",
  "page": {
    "route": "/admin/mes/mes-qc-indicator",
    "title": "MES 质检指标管理",
    "titleSelector": "[data-testid=\"mes-qc-indicator-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mes/api",
    "bffMount": "/api/v1/admin/mes",
    "resource": "mes-qc-indicator",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/mes-qc-indicator",
        "query": [
          "page",
          "pageSize"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/mes-qc-indicator/:id"
      },
      "create": {
        "http": "POST",
        "path": "/mes-qc-indicator"
      },
      "update": {
        "http": "PUT",
        "path": "/mes-qc-indicator/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/mes-qc-indicator/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"mes-qc-indicator-title\"]",
    "refresh": "[data-testid=\"mes-qc-indicator-refresh\"]",
    "createButton": "[data-testid=\"mes-qc-indicator-create\"]",
    "searchForm": "[data-testid=\"mes-qc-indicator-search\"]",
    "searchSubmit": "[data-testid=\"mes-qc-indicator-search-submit\"]",
    "searchReset": "[data-testid=\"mes-qc-indicator-search-reset\"]",
    "total": "[data-testid=\"mes-qc-indicator-total\"]",
    "table": "[data-testid=\"mes-qc-indicator-table\"]",
    "row": "[data-testid=\"mes-qc-indicator-row\"]",
    "editButton": "[data-testid=\"mes-qc-indicator-edit\"]",
    "deleteButton": "[data-testid=\"mes-qc-indicator-delete\"]",
    "form": "[data-testid=\"mes-qc-indicator-form\"]",
    "formError": "[data-testid=\"mes-qc-indicator-form-error\"]",
    "formSubmit": "[data-testid=\"mes-qc-indicator-form-submit\"]",
    "formCancel": "[data-testid=\"mes-qc-indicator-form-cancel\"]",
    "formClose": "[data-testid=\"mes-qc-indicator-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "MES 质检指标列表",
    "dialogLabel": {
      "create": "新增MES 质检指标",
      "edit": "编辑MES 质检指标"
    },
    "searchFields": [],
    "fields": [
      {
        "name": "code",
        "label": "检测项编码",
        "type": "string",
        "required": false,
        "testId": "field-code",
        "selector": "[data-testid=\"field-code\"]"
      },
      {
        "name": "name",
        "label": "检测项名称",
        "type": "string",
        "required": false,
        "testId": "field-name",
        "selector": "[data-testid=\"field-name\"]"
      },
      {
        "name": "type",
        "label": "检测项类型",
        "type": "number",
        "required": false,
        "testId": "field-type",
        "selector": "[data-testid=\"field-type\"]"
      },
      {
        "name": "tool",
        "label": "检测工具",
        "type": "string",
        "required": false,
        "testId": "field-tool",
        "selector": "[data-testid=\"field-tool\"]"
      },
      {
        "name": "result_type",
        "label": "结果值类型",
        "type": "number",
        "required": false,
        "testId": "field-result_type",
        "selector": "[data-testid=\"field-result_type\"]"
      },
      {
        "name": "result_specification",
        "label": "结果值属性",
        "type": "string",
        "required": false,
        "testId": "field-result_specification",
        "selector": "[data-testid=\"field-result_specification\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "mes-qc-indicator",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"mes-qc-indicator\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"mes-qc-indicator-form-overlay\"]",
      "dialog": "[data-testid=\"mes-qc-indicator-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "mes-qc-indicator:search",
      "reset": "mes-qc-indicator:reset",
      "refresh": "mes-qc-indicator:refresh",
      "create": "mes-qc-indicator:create",
      "edit": "mes-qc-indicator:edit",
      "delete": "mes-qc-indicator:delete",
      "submit": "mes-qc-indicator:submit",
      "cancel": "mes-qc-indicator:cancel",
      "close": "mes-qc-indicator:close",
      "row": "mes-qc-indicator:row",
      "pagination": "mes-qc-indicator:pagination",
      "fields": {
        "code": "mes-qc-indicator:field:code",
        "name": "mes-qc-indicator:field:name",
        "type": "mes-qc-indicator:field:type",
        "tool": "mes-qc-indicator:field:tool",
        "result_type": "mes-qc-indicator:field:result_type",
        "result_specification": "mes-qc-indicator:field:result_specification",
        "remark": "mes-qc-indicator:field:remark"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mes.mes-qc-indicator",
      "examples": [
        "mes.mes-qc-indicator__List__Refresh",
        "mes.mes-qc-indicator__ListItem__Open",
        "mes.mes-qc-indicator__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
