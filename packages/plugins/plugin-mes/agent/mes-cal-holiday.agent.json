{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mes",
  "entity": "MesCalHoliday",
  "kebab": "mes-cal-holiday",
  "businessName": "MES 假期设置",
  "permissionPrefix": "mes:mes_cal_holiday",
  "page": {
    "route": "/admin/mes/mes-cal-holiday",
    "title": "MES 假期设置管理",
    "titleSelector": "[data-testid=\"mes-cal-holiday-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mes/api",
    "bffMount": "/api/v1/admin/mes",
    "resource": "mes-cal-holiday",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/mes-cal-holiday",
        "query": [
          "page",
          "pageSize"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/mes-cal-holiday/:id"
      },
      "create": {
        "http": "POST",
        "path": "/mes-cal-holiday"
      },
      "update": {
        "http": "PUT",
        "path": "/mes-cal-holiday/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/mes-cal-holiday/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"mes-cal-holiday-title\"]",
    "refresh": "[data-testid=\"mes-cal-holiday-refresh\"]",
    "createButton": "[data-testid=\"mes-cal-holiday-create\"]",
    "searchForm": "[data-testid=\"mes-cal-holiday-search\"]",
    "searchSubmit": "[data-testid=\"mes-cal-holiday-search-submit\"]",
    "searchReset": "[data-testid=\"mes-cal-holiday-search-reset\"]",
    "total": "[data-testid=\"mes-cal-holiday-total\"]",
    "table": "[data-testid=\"mes-cal-holiday-table\"]",
    "row": "[data-testid=\"mes-cal-holiday-row\"]",
    "editButton": "[data-testid=\"mes-cal-holiday-edit\"]",
    "deleteButton": "[data-testid=\"mes-cal-holiday-delete\"]",
    "form": "[data-testid=\"mes-cal-holiday-form\"]",
    "formError": "[data-testid=\"mes-cal-holiday-form-error\"]",
    "formSubmit": "[data-testid=\"mes-cal-holiday-form-submit\"]",
    "formCancel": "[data-testid=\"mes-cal-holiday-form-cancel\"]",
    "formClose": "[data-testid=\"mes-cal-holiday-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "MES 假期设置列表",
    "dialogLabel": {
      "create": "新增MES 假期设置",
      "edit": "编辑MES 假期设置"
    },
    "searchFields": [],
    "fields": [
      {
        "name": "day",
        "label": "日期",
        "type": "string",
        "required": false,
        "testId": "field-day",
        "selector": "[data-testid=\"field-day\"]"
      },
      {
        "name": "type",
        "label": "日期类型",
        "type": "number",
        "required": false,
        "testId": "field-type",
        "selector": "[data-testid=\"field-type\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "mes-cal-holiday",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"mes-cal-holiday\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"mes-cal-holiday-form-overlay\"]",
      "dialog": "[data-testid=\"mes-cal-holiday-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "mes-cal-holiday:search",
      "reset": "mes-cal-holiday:reset",
      "refresh": "mes-cal-holiday:refresh",
      "create": "mes-cal-holiday:create",
      "edit": "mes-cal-holiday:edit",
      "delete": "mes-cal-holiday:delete",
      "submit": "mes-cal-holiday:submit",
      "cancel": "mes-cal-holiday:cancel",
      "close": "mes-cal-holiday:close",
      "row": "mes-cal-holiday:row",
      "pagination": "mes-cal-holiday:pagination",
      "fields": {
        "day": "mes-cal-holiday:field:day",
        "type": "mes-cal-holiday:field:type",
        "remark": "mes-cal-holiday:field:remark"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mes.mes-cal-holiday",
      "examples": [
        "mes.mes-cal-holiday__List__Refresh",
        "mes.mes-cal-holiday__ListItem__Open",
        "mes.mes-cal-holiday__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
