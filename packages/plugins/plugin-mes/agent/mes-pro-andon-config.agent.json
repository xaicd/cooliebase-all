{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mes",
  "entity": "MesProAndonConfig",
  "kebab": "mes-pro-andon-config",
  "businessName": "MES 安灯呼叫配置",
  "permissionPrefix": "mes:mes_pro_andon_config",
  "page": {
    "route": "/admin/mes/mes-pro-andon-config",
    "title": "MES 安灯呼叫配置管理",
    "titleSelector": "[data-testid=\"mes-pro-andon-config-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mes/api",
    "bffMount": "/api/v1/admin/mes",
    "resource": "mes-pro-andon-config",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/mes-pro-andon-config",
        "query": [
          "page",
          "pageSize",
          "level",
          "handler_role_id",
          "handler_user_id"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/mes-pro-andon-config/:id"
      },
      "create": {
        "http": "POST",
        "path": "/mes-pro-andon-config"
      },
      "update": {
        "http": "PUT",
        "path": "/mes-pro-andon-config/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/mes-pro-andon-config/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"mes-pro-andon-config-title\"]",
    "refresh": "[data-testid=\"mes-pro-andon-config-refresh\"]",
    "createButton": "[data-testid=\"mes-pro-andon-config-create\"]",
    "searchForm": "[data-testid=\"mes-pro-andon-config-search\"]",
    "searchSubmit": "[data-testid=\"mes-pro-andon-config-search-submit\"]",
    "searchReset": "[data-testid=\"mes-pro-andon-config-search-reset\"]",
    "total": "[data-testid=\"mes-pro-andon-config-total\"]",
    "table": "[data-testid=\"mes-pro-andon-config-table\"]",
    "row": "[data-testid=\"mes-pro-andon-config-row\"]",
    "editButton": "[data-testid=\"mes-pro-andon-config-edit\"]",
    "deleteButton": "[data-testid=\"mes-pro-andon-config-delete\"]",
    "form": "[data-testid=\"mes-pro-andon-config-form\"]",
    "formError": "[data-testid=\"mes-pro-andon-config-form-error\"]",
    "formSubmit": "[data-testid=\"mes-pro-andon-config-form-submit\"]",
    "formCancel": "[data-testid=\"mes-pro-andon-config-form-cancel\"]",
    "formClose": "[data-testid=\"mes-pro-andon-config-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "MES 安灯呼叫配置列表",
    "dialogLabel": {
      "create": "新增MES 安灯呼叫配置",
      "edit": "编辑MES 安灯呼叫配置"
    },
    "searchFields": [
      {
        "name": "level",
        "label": "级别",
        "testId": "search-level",
        "selector": "[data-testid=\"search-level\"]"
      },
      {
        "name": "handler_role_id",
        "label": "处置人角色编号",
        "testId": "search-handler_role_id",
        "selector": "[data-testid=\"search-handler_role_id\"]"
      },
      {
        "name": "handler_user_id",
        "label": "处置人编号",
        "testId": "search-handler_user_id",
        "selector": "[data-testid=\"search-handler_user_id\"]"
      }
    ],
    "fields": [
      {
        "name": "reason",
        "label": "呼叫原因",
        "type": "string",
        "required": false,
        "testId": "field-reason",
        "selector": "[data-testid=\"field-reason\"]"
      },
      {
        "name": "level",
        "label": "级别",
        "type": "number",
        "required": false,
        "testId": "field-level",
        "selector": "[data-testid=\"field-level\"]"
      },
      {
        "name": "handler_role_id",
        "label": "处置人角色编号",
        "type": "string",
        "required": false,
        "testId": "field-handler_role_id",
        "selector": "[data-testid=\"field-handler_role_id\"]"
      },
      {
        "name": "handler_user_id",
        "label": "处置人编号",
        "type": "string",
        "required": false,
        "testId": "field-handler_user_id",
        "selector": "[data-testid=\"field-handler_user_id\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "mes-pro-andon-config",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"mes-pro-andon-config\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"mes-pro-andon-config-form-overlay\"]",
      "dialog": "[data-testid=\"mes-pro-andon-config-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "mes-pro-andon-config:search",
      "reset": "mes-pro-andon-config:reset",
      "refresh": "mes-pro-andon-config:refresh",
      "create": "mes-pro-andon-config:create",
      "edit": "mes-pro-andon-config:edit",
      "delete": "mes-pro-andon-config:delete",
      "submit": "mes-pro-andon-config:submit",
      "cancel": "mes-pro-andon-config:cancel",
      "close": "mes-pro-andon-config:close",
      "row": "mes-pro-andon-config:row",
      "pagination": "mes-pro-andon-config:pagination",
      "fields": {
        "reason": "mes-pro-andon-config:field:reason",
        "level": "mes-pro-andon-config:field:level",
        "handler_role_id": "mes-pro-andon-config:field:handler_role_id",
        "handler_user_id": "mes-pro-andon-config:field:handler_user_id",
        "remark": "mes-pro-andon-config:field:remark"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mes.mes-pro-andon-config",
      "examples": [
        "mes.mes-pro-andon-config__List__Refresh",
        "mes.mes-pro-andon-config__ListItem__Open",
        "mes.mes-pro-andon-config__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
