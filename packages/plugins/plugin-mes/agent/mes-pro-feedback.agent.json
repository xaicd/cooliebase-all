{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mes",
  "entity": "MesProFeedback",
  "kebab": "mes-pro-feedback",
  "businessName": "MES 生产报工",
  "permissionPrefix": "mes:mes_pro_feedback",
  "page": {
    "route": "/admin/mes/mes-pro-feedback",
    "title": "MES 生产报工管理",
    "titleSelector": "[data-testid=\"mes-pro-feedback-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mes/api",
    "bffMount": "/api/v1/admin/mes",
    "resource": "mes-pro-feedback",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/mes-pro-feedback",
        "query": [
          "page",
          "pageSize",
          "code",
          "type",
          "workstation_id",
          "route_id",
          "process_id"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/mes-pro-feedback/:id"
      },
      "create": {
        "http": "POST",
        "path": "/mes-pro-feedback"
      },
      "update": {
        "http": "PUT",
        "path": "/mes-pro-feedback/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/mes-pro-feedback/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"mes-pro-feedback-title\"]",
    "refresh": "[data-testid=\"mes-pro-feedback-refresh\"]",
    "createButton": "[data-testid=\"mes-pro-feedback-create\"]",
    "searchForm": "[data-testid=\"mes-pro-feedback-search\"]",
    "searchSubmit": "[data-testid=\"mes-pro-feedback-search-submit\"]",
    "searchReset": "[data-testid=\"mes-pro-feedback-search-reset\"]",
    "total": "[data-testid=\"mes-pro-feedback-total\"]",
    "table": "[data-testid=\"mes-pro-feedback-table\"]",
    "row": "[data-testid=\"mes-pro-feedback-row\"]",
    "editButton": "[data-testid=\"mes-pro-feedback-edit\"]",
    "deleteButton": "[data-testid=\"mes-pro-feedback-delete\"]",
    "form": "[data-testid=\"mes-pro-feedback-form\"]",
    "formError": "[data-testid=\"mes-pro-feedback-form-error\"]",
    "formSubmit": "[data-testid=\"mes-pro-feedback-form-submit\"]",
    "formCancel": "[data-testid=\"mes-pro-feedback-form-cancel\"]",
    "formClose": "[data-testid=\"mes-pro-feedback-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "MES 生产报工列表",
    "dialogLabel": {
      "create": "新增MES 生产报工",
      "edit": "编辑MES 生产报工"
    },
    "searchFields": [
      {
        "name": "code",
        "label": "报工单编号",
        "testId": "search-code",
        "selector": "[data-testid=\"search-code\"]"
      },
      {
        "name": "type",
        "label": "报工类型",
        "testId": "search-type",
        "selector": "[data-testid=\"search-type\"]"
      },
      {
        "name": "workstation_id",
        "label": "工作站编号",
        "testId": "search-workstation_id",
        "selector": "[data-testid=\"search-workstation_id\"]"
      },
      {
        "name": "route_id",
        "label": "工艺路线编号",
        "testId": "search-route_id",
        "selector": "[data-testid=\"search-route_id\"]"
      },
      {
        "name": "process_id",
        "label": "工序编号",
        "testId": "search-process_id",
        "selector": "[data-testid=\"search-process_id\"]"
      }
    ],
    "fields": [
      {
        "name": "code",
        "label": "报工单编号",
        "type": "string",
        "required": false,
        "testId": "field-code",
        "selector": "[data-testid=\"field-code\"]"
      },
      {
        "name": "type",
        "label": "报工类型",
        "type": "number",
        "required": false,
        "testId": "field-type",
        "selector": "[data-testid=\"field-type\"]"
      },
      {
        "name": "channel",
        "label": "报工途径",
        "type": "string",
        "required": false,
        "testId": "field-channel",
        "selector": "[data-testid=\"field-channel\"]"
      },
      {
        "name": "feedback_time",
        "label": "报工时间",
        "type": "string",
        "required": false,
        "testId": "field-feedback_time",
        "selector": "[data-testid=\"field-feedback_time\"]"
      },
      {
        "name": "workstation_id",
        "label": "工作站编号",
        "type": "string",
        "required": false,
        "testId": "field-workstation_id",
        "selector": "[data-testid=\"field-workstation_id\"]"
      },
      {
        "name": "route_id",
        "label": "工艺路线编号",
        "type": "string",
        "required": false,
        "testId": "field-route_id",
        "selector": "[data-testid=\"field-route_id\"]"
      },
      {
        "name": "process_id",
        "label": "工序编号",
        "type": "string",
        "required": false,
        "testId": "field-process_id",
        "selector": "[data-testid=\"field-process_id\"]"
      },
      {
        "name": "work_order_id",
        "label": "生产工单编号",
        "type": "string",
        "required": false,
        "testId": "field-work_order_id",
        "selector": "[data-testid=\"field-work_order_id\"]"
      },
      {
        "name": "task_id",
        "label": "生产任务编号",
        "type": "string",
        "required": false,
        "testId": "field-task_id",
        "selector": "[data-testid=\"field-task_id\"]"
      },
      {
        "name": "item_id",
        "label": "产品物料编号（冗余自任务）",
        "type": "string",
        "required": false,
        "testId": "field-item_id",
        "selector": "[data-testid=\"field-item_id\"]"
      },
      {
        "name": "expire_date",
        "label": "过期日期",
        "type": "string",
        "required": false,
        "testId": "field-expire_date",
        "selector": "[data-testid=\"field-expire_date\"]"
      },
      {
        "name": "lot_number",
        "label": "生产批号",
        "type": "string",
        "required": false,
        "testId": "field-lot_number",
        "selector": "[data-testid=\"field-lot_number\"]"
      },
      {
        "name": "scheduled_quantity",
        "label": "排产数量",
        "type": "number",
        "required": false,
        "testId": "field-scheduled_quantity",
        "selector": "[data-testid=\"field-scheduled_quantity\"]"
      },
      {
        "name": "feedback_quantity",
        "label": "本次报工数量",
        "type": "number",
        "required": false,
        "testId": "field-feedback_quantity",
        "selector": "[data-testid=\"field-feedback_quantity\"]"
      },
      {
        "name": "qualified_quantity",
        "label": "合格品数量",
        "type": "number",
        "required": false,
        "testId": "field-qualified_quantity",
        "selector": "[data-testid=\"field-qualified_quantity\"]"
      },
      {
        "name": "unqualified_quantity",
        "label": "不良品数量",
        "type": "number",
        "required": false,
        "testId": "field-unqualified_quantity",
        "selector": "[data-testid=\"field-unqualified_quantity\"]"
      },
      {
        "name": "uncheck_quantity",
        "label": "待检测数量",
        "type": "number",
        "required": false,
        "testId": "field-uncheck_quantity",
        "selector": "[data-testid=\"field-uncheck_quantity\"]"
      },
      {
        "name": "labor_scrap_quantity",
        "label": "工废数量",
        "type": "number",
        "required": false,
        "testId": "field-labor_scrap_quantity",
        "selector": "[data-testid=\"field-labor_scrap_quantity\"]"
      },
      {
        "name": "material_scrap_quantity",
        "label": "料废数量",
        "type": "number",
        "required": false,
        "testId": "field-material_scrap_quantity",
        "selector": "[data-testid=\"field-material_scrap_quantity\"]"
      },
      {
        "name": "other_scrap_quantity",
        "label": "其他废品数量",
        "type": "number",
        "required": false,
        "testId": "field-other_scrap_quantity",
        "selector": "[data-testid=\"field-other_scrap_quantity\"]"
      },
      {
        "name": "feedback_user_id",
        "label": "报工用户编号",
        "type": "string",
        "required": false,
        "testId": "field-feedback_user_id",
        "selector": "[data-testid=\"field-feedback_user_id\"]"
      },
      {
        "name": "approve_user_id",
        "label": "审核用户编号",
        "type": "string",
        "required": false,
        "testId": "field-approve_user_id",
        "selector": "[data-testid=\"field-approve_user_id\"]"
      },
      {
        "name": "status",
        "label": "状态",
        "type": "number",
        "required": false,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "mes-pro-feedback",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"mes-pro-feedback\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"mes-pro-feedback-form-overlay\"]",
      "dialog": "[data-testid=\"mes-pro-feedback-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "mes-pro-feedback:search",
      "reset": "mes-pro-feedback:reset",
      "refresh": "mes-pro-feedback:refresh",
      "create": "mes-pro-feedback:create",
      "edit": "mes-pro-feedback:edit",
      "delete": "mes-pro-feedback:delete",
      "submit": "mes-pro-feedback:submit",
      "cancel": "mes-pro-feedback:cancel",
      "close": "mes-pro-feedback:close",
      "row": "mes-pro-feedback:row",
      "pagination": "mes-pro-feedback:pagination",
      "fields": {
        "code": "mes-pro-feedback:field:code",
        "type": "mes-pro-feedback:field:type",
        "channel": "mes-pro-feedback:field:channel",
        "feedback_time": "mes-pro-feedback:field:feedback_time",
        "workstation_id": "mes-pro-feedback:field:workstation_id",
        "route_id": "mes-pro-feedback:field:route_id",
        "process_id": "mes-pro-feedback:field:process_id",
        "work_order_id": "mes-pro-feedback:field:work_order_id",
        "task_id": "mes-pro-feedback:field:task_id",
        "item_id": "mes-pro-feedback:field:item_id",
        "expire_date": "mes-pro-feedback:field:expire_date",
        "lot_number": "mes-pro-feedback:field:lot_number",
        "scheduled_quantity": "mes-pro-feedback:field:scheduled_quantity",
        "feedback_quantity": "mes-pro-feedback:field:feedback_quantity",
        "qualified_quantity": "mes-pro-feedback:field:qualified_quantity",
        "unqualified_quantity": "mes-pro-feedback:field:unqualified_quantity",
        "uncheck_quantity": "mes-pro-feedback:field:uncheck_quantity",
        "labor_scrap_quantity": "mes-pro-feedback:field:labor_scrap_quantity",
        "material_scrap_quantity": "mes-pro-feedback:field:material_scrap_quantity",
        "other_scrap_quantity": "mes-pro-feedback:field:other_scrap_quantity",
        "feedback_user_id": "mes-pro-feedback:field:feedback_user_id",
        "approve_user_id": "mes-pro-feedback:field:approve_user_id",
        "status": "mes-pro-feedback:field:status",
        "remark": "mes-pro-feedback:field:remark"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mes.mes-pro-feedback",
      "examples": [
        "mes.mes-pro-feedback__List__Refresh",
        "mes.mes-pro-feedback__ListItem__Open",
        "mes.mes-pro-feedback__Form__Submit"
      ]
    }
  },
  "enums": {
    "status": {
      "type": "enum",
      "values": [
        "0",
        "2",
        "3",
        "4"
      ],
      "labels": {
        "0": "草稿",
        "2": "审批中",
        "3": "待检验",
        "4": "已完成"
      },
      "description": "状态"
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
