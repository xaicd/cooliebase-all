{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mes",
  "entity": "MesMdWorkstationWorker",
  "kebab": "mes-md-workstation-worker",
  "businessName": "MES 人力资源",
  "permissionPrefix": "mes:mes_md_workstation_worker",
  "page": {
    "route": "/admin/mes/mes-md-workstation-worker",
    "title": "MES 人力资源管理",
    "titleSelector": "[data-testid=\"mes-md-workstation-worker-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mes/api",
    "bffMount": "/api/v1/admin/mes",
    "resource": "mes-md-workstation-worker",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/mes-md-workstation-worker",
        "query": [
          "page",
          "pageSize",
          "workstation_id",
          "post_id"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/mes-md-workstation-worker/:id"
      },
      "create": {
        "http": "POST",
        "path": "/mes-md-workstation-worker"
      },
      "update": {
        "http": "PUT",
        "path": "/mes-md-workstation-worker/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/mes-md-workstation-worker/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"mes-md-workstation-worker-title\"]",
    "refresh": "[data-testid=\"mes-md-workstation-worker-refresh\"]",
    "createButton": "[data-testid=\"mes-md-workstation-worker-create\"]",
    "searchForm": "[data-testid=\"mes-md-workstation-worker-search\"]",
    "searchSubmit": "[data-testid=\"mes-md-workstation-worker-search-submit\"]",
    "searchReset": "[data-testid=\"mes-md-workstation-worker-search-reset\"]",
    "total": "[data-testid=\"mes-md-workstation-worker-total\"]",
    "table": "[data-testid=\"mes-md-workstation-worker-table\"]",
    "row": "[data-testid=\"mes-md-workstation-worker-row\"]",
    "editButton": "[data-testid=\"mes-md-workstation-worker-edit\"]",
    "deleteButton": "[data-testid=\"mes-md-workstation-worker-delete\"]",
    "form": "[data-testid=\"mes-md-workstation-worker-form\"]",
    "formError": "[data-testid=\"mes-md-workstation-worker-form-error\"]",
    "formSubmit": "[data-testid=\"mes-md-workstation-worker-form-submit\"]",
    "formCancel": "[data-testid=\"mes-md-workstation-worker-form-cancel\"]",
    "formClose": "[data-testid=\"mes-md-workstation-worker-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "MES 人力资源列表",
    "dialogLabel": {
      "create": "新增MES 人力资源",
      "edit": "编辑MES 人力资源"
    },
    "searchFields": [
      {
        "name": "workstation_id",
        "label": "工作站编号",
        "testId": "search-workstation_id",
        "selector": "[data-testid=\"search-workstation_id\"]"
      },
      {
        "name": "post_id",
        "label": "岗位编号",
        "testId": "search-post_id",
        "selector": "[data-testid=\"search-post_id\"]"
      }
    ],
    "fields": [
      {
        "name": "workstation_id",
        "label": "工作站编号",
        "type": "string",
        "required": false,
        "testId": "field-workstation_id",
        "selector": "[data-testid=\"field-workstation_id\"]"
      },
      {
        "name": "post_id",
        "label": "岗位编号",
        "type": "string",
        "required": false,
        "testId": "field-post_id",
        "selector": "[data-testid=\"field-post_id\"]"
      },
      {
        "name": "quantity",
        "label": "数量",
        "type": "number",
        "required": false,
        "testId": "field-quantity",
        "selector": "[data-testid=\"field-quantity\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "mes-md-workstation-worker",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"mes-md-workstation-worker\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"mes-md-workstation-worker-form-overlay\"]",
      "dialog": "[data-testid=\"mes-md-workstation-worker-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "mes-md-workstation-worker:search",
      "reset": "mes-md-workstation-worker:reset",
      "refresh": "mes-md-workstation-worker:refresh",
      "create": "mes-md-workstation-worker:create",
      "edit": "mes-md-workstation-worker:edit",
      "delete": "mes-md-workstation-worker:delete",
      "submit": "mes-md-workstation-worker:submit",
      "cancel": "mes-md-workstation-worker:cancel",
      "close": "mes-md-workstation-worker:close",
      "row": "mes-md-workstation-worker:row",
      "pagination": "mes-md-workstation-worker:pagination",
      "fields": {
        "workstation_id": "mes-md-workstation-worker:field:workstation_id",
        "post_id": "mes-md-workstation-worker:field:post_id",
        "quantity": "mes-md-workstation-worker:field:quantity",
        "remark": "mes-md-workstation-worker:field:remark"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mes.mes-md-workstation-worker",
      "examples": [
        "mes.mes-md-workstation-worker__List__Refresh",
        "mes.mes-md-workstation-worker__ListItem__Open",
        "mes.mes-md-workstation-worker__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
