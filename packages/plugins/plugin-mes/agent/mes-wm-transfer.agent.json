{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mes",
  "entity": "MesWmTransfer",
  "kebab": "mes-wm-transfer",
  "businessName": "MES 转移单",
  "permissionPrefix": "mes:mes_wm_transfer",
  "page": {
    "route": "/admin/mes/mes-wm-transfer",
    "title": "MES 转移单管理",
    "titleSelector": "[data-testid=\"mes-wm-transfer-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mes/api",
    "bffMount": "/api/v1/admin/mes",
    "resource": "mes-wm-transfer",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/mes-wm-transfer",
        "query": [
          "page",
          "pageSize",
          "code",
          "name",
          "type",
          "status"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/mes-wm-transfer/:id"
      },
      "create": {
        "http": "POST",
        "path": "/mes-wm-transfer"
      },
      "update": {
        "http": "PUT",
        "path": "/mes-wm-transfer/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/mes-wm-transfer/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"mes-wm-transfer-title\"]",
    "refresh": "[data-testid=\"mes-wm-transfer-refresh\"]",
    "createButton": "[data-testid=\"mes-wm-transfer-create\"]",
    "searchForm": "[data-testid=\"mes-wm-transfer-search\"]",
    "searchSubmit": "[data-testid=\"mes-wm-transfer-search-submit\"]",
    "searchReset": "[data-testid=\"mes-wm-transfer-search-reset\"]",
    "total": "[data-testid=\"mes-wm-transfer-total\"]",
    "table": "[data-testid=\"mes-wm-transfer-table\"]",
    "row": "[data-testid=\"mes-wm-transfer-row\"]",
    "editButton": "[data-testid=\"mes-wm-transfer-edit\"]",
    "deleteButton": "[data-testid=\"mes-wm-transfer-delete\"]",
    "form": "[data-testid=\"mes-wm-transfer-form\"]",
    "formError": "[data-testid=\"mes-wm-transfer-form-error\"]",
    "formSubmit": "[data-testid=\"mes-wm-transfer-form-submit\"]",
    "formCancel": "[data-testid=\"mes-wm-transfer-form-cancel\"]",
    "formClose": "[data-testid=\"mes-wm-transfer-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "MES 转移单列表",
    "dialogLabel": {
      "create": "新增MES 转移单",
      "edit": "编辑MES 转移单"
    },
    "searchFields": [
      {
        "name": "code",
        "label": "转移单编号",
        "testId": "search-code",
        "selector": "[data-testid=\"search-code\"]"
      },
      {
        "name": "name",
        "label": "转移单名称",
        "testId": "search-name",
        "selector": "[data-testid=\"search-name\"]"
      },
      {
        "name": "type",
        "label": "转移单类型",
        "testId": "search-type",
        "selector": "[data-testid=\"search-type\"]"
      },
      {
        "name": "status",
        "label": "状态",
        "testId": "search-status",
        "selector": "[data-testid=\"search-status\"]"
      }
    ],
    "fields": [
      {
        "name": "code",
        "label": "转移单编号",
        "type": "string",
        "required": false,
        "testId": "field-code",
        "selector": "[data-testid=\"field-code\"]"
      },
      {
        "name": "name",
        "label": "转移单名称",
        "type": "string",
        "required": false,
        "testId": "field-name",
        "selector": "[data-testid=\"field-name\"]"
      },
      {
        "name": "type",
        "label": "转移单类型",
        "type": "number",
        "required": false,
        "testId": "field-type",
        "selector": "[data-testid=\"field-type\"]"
      },
      {
        "name": "delivery_flag",
        "label": "是否配送",
        "type": "boolean",
        "required": false,
        "testId": "field-delivery_flag",
        "selector": "[data-testid=\"field-delivery_flag\"]"
      },
      {
        "name": "recipient_name",
        "label": "收货人",
        "type": "string",
        "required": false,
        "testId": "field-recipient_name",
        "selector": "[data-testid=\"field-recipient_name\"]"
      },
      {
        "name": "recipient_telephone",
        "label": "联系方式",
        "type": "string",
        "required": false,
        "testId": "field-recipient_telephone",
        "selector": "[data-testid=\"field-recipient_telephone\"]"
      },
      {
        "name": "destination_address",
        "label": "目的地",
        "type": "string",
        "required": false,
        "testId": "field-destination_address",
        "selector": "[data-testid=\"field-destination_address\"]"
      },
      {
        "name": "carrier",
        "label": "承运商",
        "type": "string",
        "required": false,
        "testId": "field-carrier",
        "selector": "[data-testid=\"field-carrier\"]"
      },
      {
        "name": "shipping_number",
        "label": "运输单号",
        "type": "string",
        "required": false,
        "testId": "field-shipping_number",
        "selector": "[data-testid=\"field-shipping_number\"]"
      },
      {
        "name": "confirm_flag",
        "label": "是否已确认",
        "type": "boolean",
        "required": false,
        "testId": "field-confirm_flag",
        "selector": "[data-testid=\"field-confirm_flag\"]"
      },
      {
        "name": "transfer_date",
        "label": "转移日期",
        "type": "string",
        "required": false,
        "testId": "field-transfer_date",
        "selector": "[data-testid=\"field-transfer_date\"]"
      },
      {
        "name": "status",
        "label": "状态",
        "type": "number",
        "required": false,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "mes-wm-transfer",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"mes-wm-transfer\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"mes-wm-transfer-form-overlay\"]",
      "dialog": "[data-testid=\"mes-wm-transfer-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "mes-wm-transfer:search",
      "reset": "mes-wm-transfer:reset",
      "refresh": "mes-wm-transfer:refresh",
      "create": "mes-wm-transfer:create",
      "edit": "mes-wm-transfer:edit",
      "delete": "mes-wm-transfer:delete",
      "submit": "mes-wm-transfer:submit",
      "cancel": "mes-wm-transfer:cancel",
      "close": "mes-wm-transfer:close",
      "row": "mes-wm-transfer:row",
      "pagination": "mes-wm-transfer:pagination",
      "fields": {
        "code": "mes-wm-transfer:field:code",
        "name": "mes-wm-transfer:field:name",
        "type": "mes-wm-transfer:field:type",
        "delivery_flag": "mes-wm-transfer:field:delivery_flag",
        "recipient_name": "mes-wm-transfer:field:recipient_name",
        "recipient_telephone": "mes-wm-transfer:field:recipient_telephone",
        "destination_address": "mes-wm-transfer:field:destination_address",
        "carrier": "mes-wm-transfer:field:carrier",
        "shipping_number": "mes-wm-transfer:field:shipping_number",
        "confirm_flag": "mes-wm-transfer:field:confirm_flag",
        "transfer_date": "mes-wm-transfer:field:transfer_date",
        "status": "mes-wm-transfer:field:status",
        "remark": "mes-wm-transfer:field:remark"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mes.mes-wm-transfer",
      "examples": [
        "mes.mes-wm-transfer__List__Refresh",
        "mes.mes-wm-transfer__ListItem__Open",
        "mes.mes-wm-transfer__Form__Submit"
      ]
    }
  },
  "enums": {
    "status": {
      "type": "enum",
      "values": [
        "0",
        "1",
        "2",
        "3",
        "4",
        "5"
      ],
      "labels": {
        "0": "草稿",
        "1": "待确认",
        "2": "待上架",
        "3": "待执行",
        "4": "已完成",
        "5": "已取消"
      },
      "description": "状态"
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
