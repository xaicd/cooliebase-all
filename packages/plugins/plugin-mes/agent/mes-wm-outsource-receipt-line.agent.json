{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mes",
  "entity": "MesWmOutsourceReceiptLine",
  "kebab": "mes-wm-outsource-receipt-line",
  "businessName": "MES 外协入库单行",
  "permissionPrefix": "mes:mes_wm_outsource_receipt_line",
  "page": {
    "route": "/admin/mes/mes-wm-outsource-receipt-line",
    "title": "MES 外协入库单行管理",
    "titleSelector": "[data-testid=\"mes-wm-outsource-receipt-line-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mes/api",
    "bffMount": "/api/v1/admin/mes",
    "resource": "mes-wm-outsource-receipt-line",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/mes-wm-outsource-receipt-line",
        "query": [
          "page",
          "pageSize"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/mes-wm-outsource-receipt-line/:id"
      },
      "create": {
        "http": "POST",
        "path": "/mes-wm-outsource-receipt-line"
      },
      "update": {
        "http": "PUT",
        "path": "/mes-wm-outsource-receipt-line/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/mes-wm-outsource-receipt-line/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"mes-wm-outsource-receipt-line-title\"]",
    "refresh": "[data-testid=\"mes-wm-outsource-receipt-line-refresh\"]",
    "createButton": "[data-testid=\"mes-wm-outsource-receipt-line-create\"]",
    "searchForm": "[data-testid=\"mes-wm-outsource-receipt-line-search\"]",
    "searchSubmit": "[data-testid=\"mes-wm-outsource-receipt-line-search-submit\"]",
    "searchReset": "[data-testid=\"mes-wm-outsource-receipt-line-search-reset\"]",
    "total": "[data-testid=\"mes-wm-outsource-receipt-line-total\"]",
    "table": "[data-testid=\"mes-wm-outsource-receipt-line-table\"]",
    "row": "[data-testid=\"mes-wm-outsource-receipt-line-row\"]",
    "editButton": "[data-testid=\"mes-wm-outsource-receipt-line-edit\"]",
    "deleteButton": "[data-testid=\"mes-wm-outsource-receipt-line-delete\"]",
    "form": "[data-testid=\"mes-wm-outsource-receipt-line-form\"]",
    "formError": "[data-testid=\"mes-wm-outsource-receipt-line-form-error\"]",
    "formSubmit": "[data-testid=\"mes-wm-outsource-receipt-line-form-submit\"]",
    "formCancel": "[data-testid=\"mes-wm-outsource-receipt-line-form-cancel\"]",
    "formClose": "[data-testid=\"mes-wm-outsource-receipt-line-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "MES 外协入库单行列表",
    "dialogLabel": {
      "create": "新增MES 外协入库单行",
      "edit": "编辑MES 外协入库单行"
    },
    "searchFields": [],
    "fields": [
      {
        "name": "receipt_id",
        "label": "入库单编号",
        "type": "number",
        "required": false,
        "testId": "field-receipt_id",
        "selector": "[data-testid=\"field-receipt_id\"]"
      },
      {
        "name": "item_id",
        "label": "物料编号",
        "type": "number",
        "required": false,
        "testId": "field-item_id",
        "selector": "[data-testid=\"field-item_id\"]"
      },
      {
        "name": "quantity",
        "label": "入库数量",
        "type": "number",
        "required": false,
        "testId": "field-quantity",
        "selector": "[data-testid=\"field-quantity\"]"
      },
      {
        "name": "batch_id",
        "label": "批次编号",
        "type": "number",
        "required": false,
        "testId": "field-batch_id",
        "selector": "[data-testid=\"field-batch_id\"]"
      },
      {
        "name": "batch_code",
        "label": "批次号",
        "type": "string",
        "required": false,
        "testId": "field-batch_code",
        "selector": "[data-testid=\"field-batch_code\"]"
      },
      {
        "name": "production_date",
        "label": "生产日期",
        "type": "string",
        "required": false,
        "testId": "field-production_date",
        "selector": "[data-testid=\"field-production_date\"]"
      },
      {
        "name": "expire_date",
        "label": "有效期",
        "type": "string",
        "required": false,
        "testId": "field-expire_date",
        "selector": "[data-testid=\"field-expire_date\"]"
      },
      {
        "name": "lot_number",
        "label": "生产批号",
        "type": "string",
        "required": false,
        "testId": "field-lot_number",
        "selector": "[data-testid=\"field-lot_number\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      },
      {
        "name": "iqc_id",
        "label": "来料检验单编号",
        "type": "number",
        "required": false,
        "testId": "field-iqc_id",
        "selector": "[data-testid=\"field-iqc_id\"]"
      },
      {
        "name": "iqc_check_flag",
        "label": "是否需要质检",
        "type": "boolean",
        "required": false,
        "testId": "field-iqc_check_flag",
        "selector": "[data-testid=\"field-iqc_check_flag\"]"
      },
      {
        "name": "quality_status",
        "label": "质量状态",
        "type": "number",
        "required": false,
        "testId": "field-quality_status",
        "selector": "[data-testid=\"field-quality_status\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "mes-wm-outsource-receipt-line",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"mes-wm-outsource-receipt-line\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"mes-wm-outsource-receipt-line-form-overlay\"]",
      "dialog": "[data-testid=\"mes-wm-outsource-receipt-line-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "mes-wm-outsource-receipt-line:search",
      "reset": "mes-wm-outsource-receipt-line:reset",
      "refresh": "mes-wm-outsource-receipt-line:refresh",
      "create": "mes-wm-outsource-receipt-line:create",
      "edit": "mes-wm-outsource-receipt-line:edit",
      "delete": "mes-wm-outsource-receipt-line:delete",
      "submit": "mes-wm-outsource-receipt-line:submit",
      "cancel": "mes-wm-outsource-receipt-line:cancel",
      "close": "mes-wm-outsource-receipt-line:close",
      "row": "mes-wm-outsource-receipt-line:row",
      "pagination": "mes-wm-outsource-receipt-line:pagination",
      "fields": {
        "receipt_id": "mes-wm-outsource-receipt-line:field:receipt_id",
        "item_id": "mes-wm-outsource-receipt-line:field:item_id",
        "quantity": "mes-wm-outsource-receipt-line:field:quantity",
        "batch_id": "mes-wm-outsource-receipt-line:field:batch_id",
        "batch_code": "mes-wm-outsource-receipt-line:field:batch_code",
        "production_date": "mes-wm-outsource-receipt-line:field:production_date",
        "expire_date": "mes-wm-outsource-receipt-line:field:expire_date",
        "lot_number": "mes-wm-outsource-receipt-line:field:lot_number",
        "remark": "mes-wm-outsource-receipt-line:field:remark",
        "iqc_id": "mes-wm-outsource-receipt-line:field:iqc_id",
        "iqc_check_flag": "mes-wm-outsource-receipt-line:field:iqc_check_flag",
        "quality_status": "mes-wm-outsource-receipt-line:field:quality_status"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mes.mes-wm-outsource-receipt-line",
      "examples": [
        "mes.mes-wm-outsource-receipt-line__List__Refresh",
        "mes.mes-wm-outsource-receipt-line__ListItem__Open",
        "mes.mes-wm-outsource-receipt-line__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
