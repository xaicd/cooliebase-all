{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mes",
  "entity": "MesProCard",
  "kebab": "mes-pro-card",
  "businessName": "MES 生产流转卡",
  "permissionPrefix": "mes:mes_pro_card",
  "page": {
    "route": "/admin/mes/mes-pro-card",
    "title": "MES 生产流转卡管理",
    "titleSelector": "[data-testid=\"mes-pro-card-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mes/api",
    "bffMount": "/api/v1/admin/mes",
    "resource": "mes-pro-card",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/mes-pro-card",
        "query": [
          "page",
          "pageSize"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/mes-pro-card/:id"
      },
      "create": {
        "http": "POST",
        "path": "/mes-pro-card"
      },
      "update": {
        "http": "PUT",
        "path": "/mes-pro-card/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/mes-pro-card/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"mes-pro-card-title\"]",
    "refresh": "[data-testid=\"mes-pro-card-refresh\"]",
    "createButton": "[data-testid=\"mes-pro-card-create\"]",
    "searchForm": "[data-testid=\"mes-pro-card-search\"]",
    "searchSubmit": "[data-testid=\"mes-pro-card-search-submit\"]",
    "searchReset": "[data-testid=\"mes-pro-card-search-reset\"]",
    "total": "[data-testid=\"mes-pro-card-total\"]",
    "table": "[data-testid=\"mes-pro-card-table\"]",
    "row": "[data-testid=\"mes-pro-card-row\"]",
    "editButton": "[data-testid=\"mes-pro-card-edit\"]",
    "deleteButton": "[data-testid=\"mes-pro-card-delete\"]",
    "form": "[data-testid=\"mes-pro-card-form\"]",
    "formError": "[data-testid=\"mes-pro-card-form-error\"]",
    "formSubmit": "[data-testid=\"mes-pro-card-form-submit\"]",
    "formCancel": "[data-testid=\"mes-pro-card-form-cancel\"]",
    "formClose": "[data-testid=\"mes-pro-card-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "MES 生产流转卡列表",
    "dialogLabel": {
      "create": "新增MES 生产流转卡",
      "edit": "编辑MES 生产流转卡"
    },
    "searchFields": [],
    "fields": [
      {
        "name": "code",
        "label": "流转卡编码",
        "type": "string",
        "required": false,
        "testId": "field-code",
        "selector": "[data-testid=\"field-code\"]"
      },
      {
        "name": "work_order_id",
        "label": "生产工单编号",
        "type": "number",
        "required": false,
        "testId": "field-work_order_id",
        "selector": "[data-testid=\"field-work_order_id\"]"
      },
      {
        "name": "item_id",
        "label": "产品物料编号",
        "type": "number",
        "required": false,
        "testId": "field-item_id",
        "selector": "[data-testid=\"field-item_id\"]"
      },
      {
        "name": "batch_code",
        "label": "批次号",
        "type": "string",
        "required": false,
        "testId": "field-batch_code",
        "selector": "[data-testid=\"field-batch_code\"]"
      },
      {
        "name": "transfered_quantity",
        "label": "流转数量",
        "type": "number",
        "required": false,
        "testId": "field-transfered_quantity",
        "selector": "[data-testid=\"field-transfered_quantity\"]"
      },
      {
        "name": "status",
        "label": "状态",
        "type": "number",
        "required": false,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "mes-pro-card",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"mes-pro-card\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"mes-pro-card-form-overlay\"]",
      "dialog": "[data-testid=\"mes-pro-card-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "mes-pro-card:search",
      "reset": "mes-pro-card:reset",
      "refresh": "mes-pro-card:refresh",
      "create": "mes-pro-card:create",
      "edit": "mes-pro-card:edit",
      "delete": "mes-pro-card:delete",
      "submit": "mes-pro-card:submit",
      "cancel": "mes-pro-card:cancel",
      "close": "mes-pro-card:close",
      "row": "mes-pro-card:row",
      "pagination": "mes-pro-card:pagination",
      "fields": {
        "code": "mes-pro-card:field:code",
        "work_order_id": "mes-pro-card:field:work_order_id",
        "item_id": "mes-pro-card:field:item_id",
        "batch_code": "mes-pro-card:field:batch_code",
        "transfered_quantity": "mes-pro-card:field:transfered_quantity",
        "status": "mes-pro-card:field:status",
        "remark": "mes-pro-card:field:remark"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mes.mes-pro-card",
      "examples": [
        "mes.mes-pro-card__List__Refresh",
        "mes.mes-pro-card__ListItem__Open",
        "mes.mes-pro-card__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
