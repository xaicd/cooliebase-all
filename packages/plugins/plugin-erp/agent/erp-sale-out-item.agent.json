{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "erp",
  "entity": "ErpSaleOutItem",
  "kebab": "erp-sale-out-item",
  "businessName": "ERP 销售出库项",
  "permissionPrefix": "erp:erp_sale_out_item",
  "page": {
    "route": "/admin/erp/erp-sale-out-item",
    "title": "ERP 销售出库项管理",
    "titleSelector": "[data-testid=\"erp-sale-out-item-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.erp/api",
    "bffMount": "/api/v1/admin/erp",
    "resource": "erp-sale-out-item",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/erp-sale-out-item",
        "query": [
          "page",
          "pageSize"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/erp-sale-out-item/:id"
      },
      "create": {
        "http": "POST",
        "path": "/erp-sale-out-item"
      },
      "update": {
        "http": "PUT",
        "path": "/erp-sale-out-item/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/erp-sale-out-item/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"erp-sale-out-item-title\"]",
    "refresh": "[data-testid=\"erp-sale-out-item-refresh\"]",
    "createButton": "[data-testid=\"erp-sale-out-item-create\"]",
    "searchForm": "[data-testid=\"erp-sale-out-item-search\"]",
    "searchSubmit": "[data-testid=\"erp-sale-out-item-search-submit\"]",
    "searchReset": "[data-testid=\"erp-sale-out-item-search-reset\"]",
    "total": "[data-testid=\"erp-sale-out-item-total\"]",
    "table": "[data-testid=\"erp-sale-out-item-table\"]",
    "row": "[data-testid=\"erp-sale-out-item-row\"]",
    "editButton": "[data-testid=\"erp-sale-out-item-edit\"]",
    "deleteButton": "[data-testid=\"erp-sale-out-item-delete\"]",
    "form": "[data-testid=\"erp-sale-out-item-form\"]",
    "formError": "[data-testid=\"erp-sale-out-item-form-error\"]",
    "formSubmit": "[data-testid=\"erp-sale-out-item-form-submit\"]",
    "formCancel": "[data-testid=\"erp-sale-out-item-form-cancel\"]",
    "formClose": "[data-testid=\"erp-sale-out-item-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "ERP 销售出库项列表",
    "dialogLabel": {
      "create": "新增ERP 销售出库项",
      "edit": "编辑ERP 销售出库项"
    },
    "searchFields": [],
    "fields": [
      {
        "name": "out_id",
        "label": "销售出库编号",
        "type": "number",
        "required": false,
        "testId": "field-out_id",
        "selector": "[data-testid=\"field-out_id\"]"
      },
      {
        "name": "order_item_id",
        "label": "销售订单项编号",
        "type": "number",
        "required": false,
        "testId": "field-order_item_id",
        "selector": "[data-testid=\"field-order_item_id\"]"
      },
      {
        "name": "warehouse_id",
        "label": "仓库编号",
        "type": "number",
        "required": false,
        "testId": "field-warehouse_id",
        "selector": "[data-testid=\"field-warehouse_id\"]"
      },
      {
        "name": "product_id",
        "label": "产品编号",
        "type": "number",
        "required": false,
        "testId": "field-product_id",
        "selector": "[data-testid=\"field-product_id\"]"
      },
      {
        "name": "product_unit_id",
        "label": "产品单位单位",
        "type": "number",
        "required": false,
        "testId": "field-product_unit_id",
        "selector": "[data-testid=\"field-product_unit_id\"]"
      },
      {
        "name": "product_price",
        "label": "产品单位单价，单位：元",
        "type": "number",
        "required": false,
        "testId": "field-product_price",
        "selector": "[data-testid=\"field-product_price\"]"
      },
      {
        "name": "count",
        "label": "数量",
        "type": "number",
        "required": false,
        "testId": "field-count",
        "selector": "[data-testid=\"field-count\"]"
      },
      {
        "name": "total_price",
        "label": "总价，单位：元",
        "type": "number",
        "required": false,
        "testId": "field-total_price",
        "selector": "[data-testid=\"field-total_price\"]"
      },
      {
        "name": "tax_percent",
        "label": "税率，百分比",
        "type": "number",
        "required": false,
        "testId": "field-tax_percent",
        "selector": "[data-testid=\"field-tax_percent\"]"
      },
      {
        "name": "tax_price",
        "label": "税额，单位：元",
        "type": "number",
        "required": false,
        "testId": "field-tax_price",
        "selector": "[data-testid=\"field-tax_price\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "erp-sale-out-item",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"erp-sale-out-item\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"erp-sale-out-item-form-overlay\"]",
      "dialog": "[data-testid=\"erp-sale-out-item-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "erp-sale-out-item:search",
      "reset": "erp-sale-out-item:reset",
      "refresh": "erp-sale-out-item:refresh",
      "create": "erp-sale-out-item:create",
      "edit": "erp-sale-out-item:edit",
      "delete": "erp-sale-out-item:delete",
      "submit": "erp-sale-out-item:submit",
      "cancel": "erp-sale-out-item:cancel",
      "close": "erp-sale-out-item:close",
      "row": "erp-sale-out-item:row",
      "pagination": "erp-sale-out-item:pagination",
      "fields": {
        "out_id": "erp-sale-out-item:field:out_id",
        "order_item_id": "erp-sale-out-item:field:order_item_id",
        "warehouse_id": "erp-sale-out-item:field:warehouse_id",
        "product_id": "erp-sale-out-item:field:product_id",
        "product_unit_id": "erp-sale-out-item:field:product_unit_id",
        "product_price": "erp-sale-out-item:field:product_price",
        "count": "erp-sale-out-item:field:count",
        "total_price": "erp-sale-out-item:field:total_price",
        "tax_percent": "erp-sale-out-item:field:tax_percent",
        "tax_price": "erp-sale-out-item:field:tax_price",
        "remark": "erp-sale-out-item:field:remark"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "erp.erp-sale-out-item",
      "examples": [
        "erp.erp-sale-out-item__List__Refresh",
        "erp.erp-sale-out-item__ListItem__Open",
        "erp.erp-sale-out-item__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
