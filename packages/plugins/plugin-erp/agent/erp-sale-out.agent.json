{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "erp",
  "entity": "ErpSaleOut",
  "kebab": "erp-sale-out",
  "businessName": "ERP 销售出库",
  "permissionPrefix": "erp:erp_sale_out",
  "page": {
    "route": "/admin/erp/erp-sale-out",
    "title": "ERP 销售出库管理",
    "titleSelector": "[data-testid=\"erp-sale-out-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.erp/api",
    "bffMount": "/api/v1/admin/erp",
    "resource": "erp-sale-out",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/erp-sale-out",
        "query": [
          "page",
          "pageSize"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/erp-sale-out/:id"
      },
      "create": {
        "http": "POST",
        "path": "/erp-sale-out"
      },
      "update": {
        "http": "PUT",
        "path": "/erp-sale-out/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/erp-sale-out/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"erp-sale-out-title\"]",
    "refresh": "[data-testid=\"erp-sale-out-refresh\"]",
    "createButton": "[data-testid=\"erp-sale-out-create\"]",
    "searchForm": "[data-testid=\"erp-sale-out-search\"]",
    "searchSubmit": "[data-testid=\"erp-sale-out-search-submit\"]",
    "searchReset": "[data-testid=\"erp-sale-out-search-reset\"]",
    "total": "[data-testid=\"erp-sale-out-total\"]",
    "table": "[data-testid=\"erp-sale-out-table\"]",
    "row": "[data-testid=\"erp-sale-out-row\"]",
    "editButton": "[data-testid=\"erp-sale-out-edit\"]",
    "deleteButton": "[data-testid=\"erp-sale-out-delete\"]",
    "form": "[data-testid=\"erp-sale-out-form\"]",
    "formError": "[data-testid=\"erp-sale-out-form-error\"]",
    "formSubmit": "[data-testid=\"erp-sale-out-form-submit\"]",
    "formCancel": "[data-testid=\"erp-sale-out-form-cancel\"]",
    "formClose": "[data-testid=\"erp-sale-out-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "ERP 销售出库列表",
    "dialogLabel": {
      "create": "新增ERP 销售出库",
      "edit": "编辑ERP 销售出库"
    },
    "searchFields": [],
    "fields": [
      {
        "name": "no",
        "label": "销售出库单号",
        "type": "string",
        "required": false,
        "testId": "field-no",
        "selector": "[data-testid=\"field-no\"]"
      },
      {
        "name": "status",
        "label": "出库状态",
        "type": "number",
        "required": false,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      },
      {
        "name": "customer_id",
        "label": "客户编号",
        "type": "number",
        "required": false,
        "testId": "field-customer_id",
        "selector": "[data-testid=\"field-customer_id\"]"
      },
      {
        "name": "account_id",
        "label": "结算账户编号",
        "type": "number",
        "required": false,
        "testId": "field-account_id",
        "selector": "[data-testid=\"field-account_id\"]"
      },
      {
        "name": "sale_user_id",
        "label": "销售员编号",
        "type": "number",
        "required": false,
        "testId": "field-sale_user_id",
        "selector": "[data-testid=\"field-sale_user_id\"]"
      },
      {
        "name": "out_time",
        "label": "出库时间",
        "type": "string",
        "required": false,
        "testId": "field-out_time",
        "selector": "[data-testid=\"field-out_time\"]"
      },
      {
        "name": "order_id",
        "label": "销售订单编号",
        "type": "number",
        "required": false,
        "testId": "field-order_id",
        "selector": "[data-testid=\"field-order_id\"]"
      },
      {
        "name": "order_no",
        "label": "销售订单号",
        "type": "string",
        "required": false,
        "testId": "field-order_no",
        "selector": "[data-testid=\"field-order_no\"]"
      },
      {
        "name": "total_count",
        "label": "合计数量",
        "type": "number",
        "required": false,
        "testId": "field-total_count",
        "selector": "[data-testid=\"field-total_count\"]"
      },
      {
        "name": "total_price",
        "label": "最终合计价格，单位：元",
        "type": "number",
        "required": false,
        "testId": "field-total_price",
        "selector": "[data-testid=\"field-total_price\"]"
      },
      {
        "name": "receipt_price",
        "label": "已收款金额，单位：元",
        "type": "number",
        "required": false,
        "testId": "field-receipt_price",
        "selector": "[data-testid=\"field-receipt_price\"]"
      },
      {
        "name": "total_product_price",
        "label": "合计产品价格，单位：元",
        "type": "number",
        "required": false,
        "testId": "field-total_product_price",
        "selector": "[data-testid=\"field-total_product_price\"]"
      },
      {
        "name": "total_tax_price",
        "label": "合计税额，单位：元",
        "type": "number",
        "required": false,
        "testId": "field-total_tax_price",
        "selector": "[data-testid=\"field-total_tax_price\"]"
      },
      {
        "name": "discount_percent",
        "label": "优惠率，百分比",
        "type": "number",
        "required": false,
        "testId": "field-discount_percent",
        "selector": "[data-testid=\"field-discount_percent\"]"
      },
      {
        "name": "discount_price",
        "label": "优惠金额，单位：元",
        "type": "number",
        "required": false,
        "testId": "field-discount_price",
        "selector": "[data-testid=\"field-discount_price\"]"
      },
      {
        "name": "other_price",
        "label": "其它金额，单位：元",
        "type": "number",
        "required": false,
        "testId": "field-other_price",
        "selector": "[data-testid=\"field-other_price\"]"
      },
      {
        "name": "file_url",
        "label": "附件地址",
        "type": "string",
        "required": false,
        "testId": "field-file_url",
        "selector": "[data-testid=\"field-file_url\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "erp-sale-out",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"erp-sale-out\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"erp-sale-out-form-overlay\"]",
      "dialog": "[data-testid=\"erp-sale-out-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "erp-sale-out:search",
      "reset": "erp-sale-out:reset",
      "refresh": "erp-sale-out:refresh",
      "create": "erp-sale-out:create",
      "edit": "erp-sale-out:edit",
      "delete": "erp-sale-out:delete",
      "submit": "erp-sale-out:submit",
      "cancel": "erp-sale-out:cancel",
      "close": "erp-sale-out:close",
      "row": "erp-sale-out:row",
      "pagination": "erp-sale-out:pagination",
      "fields": {
        "no": "erp-sale-out:field:no",
        "status": "erp-sale-out:field:status",
        "customer_id": "erp-sale-out:field:customer_id",
        "account_id": "erp-sale-out:field:account_id",
        "sale_user_id": "erp-sale-out:field:sale_user_id",
        "out_time": "erp-sale-out:field:out_time",
        "order_id": "erp-sale-out:field:order_id",
        "order_no": "erp-sale-out:field:order_no",
        "total_count": "erp-sale-out:field:total_count",
        "total_price": "erp-sale-out:field:total_price",
        "receipt_price": "erp-sale-out:field:receipt_price",
        "total_product_price": "erp-sale-out:field:total_product_price",
        "total_tax_price": "erp-sale-out:field:total_tax_price",
        "discount_percent": "erp-sale-out:field:discount_percent",
        "discount_price": "erp-sale-out:field:discount_price",
        "other_price": "erp-sale-out:field:other_price",
        "file_url": "erp-sale-out:field:file_url",
        "remark": "erp-sale-out:field:remark"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "erp.erp-sale-out",
      "examples": [
        "erp.erp-sale-out__List__Refresh",
        "erp.erp-sale-out__ListItem__Open",
        "erp.erp-sale-out__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
