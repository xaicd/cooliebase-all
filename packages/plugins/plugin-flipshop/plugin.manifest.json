{
  "$schema": "cooliebase-plugin-manifest/v1",
  "id": "cooliebase.flipshop",
  "apiVersion": 1,
  "version": "0.1.0",
  "displayName": "flipshop",
  "description": "flipshop 域（翻牌小店 · 商品最小闭环，由 scaffold-domain-plugin.cjs 派生）",
  "author": "CoolieBase All",
  "categories": [
    "automation"
  ],
  "capabilities": [
    "api.routes.register"
  ],
  "entrypoints": {
    "merged": "./plugin-entry.ts"
  },
  "domain": {
    "kind": "business",
    "stage": "B",
    "contractVersion": "v1",
    "publicPrefixes": [
      "/api/v1/admin/flipshop"
    ],
    "upstreamEnv": "COOLIEBASE_DOMAIN_FLIPSHOP_UPSTREAM",
    "defaultPort": 3227,
    "packable": true,
    "independentDatabase": false,
    "dependsOnModules": [
      "shared"
    ],
    "auth": {
      "audience": "admin",
      "tenantPolicy": "required"
    },
    "resilience": {
      "timeoutMs": 8000,
      "retryMaxAttempts": 1,
      "safeMethodsOnly": true,
      "idempotencyRequired": true
    }
  },
  "apiRoutes": [
    {
      "routeKey": "admin:products/[id]:get",
      "method": "GET",
      "path": "/products/[id]",
      "auth": "operator"
    },
    {
      "routeKey": "admin:products:get",
      "method": "GET",
      "path": "/products",
      "auth": "operator"
    },
    {
      "routeKey": "admin:products:post",
      "method": "POST",
      "path": "/products",
      "auth": "operator"
    }
  ]
}
