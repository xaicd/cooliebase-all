{
  "$schema": "cooliebase-module-manifest/v1",
  "domain": "flipshop",
  "id": "cooliebase.flipshop",
  "apiVersion": 1,
  "displayName": "翻牌小店",
  "kind": "business",
  "stage": "B",
  "owner": "flipshop",
  "contractVersion": "v1",
  "implementation": "local-ts",
  "minimumHostVersion": "1.0.0",
  "capabilities": [
    "api.routes.register"
  ],
  "entrypoints": {
    "facade": [],
    "proto": null,
    "actions": "packages/plugins/plugin-flipshop/contract/product.actions.ts"
  },
  "apiRoutes": {
    "publicPrefix": [
      "/api/v1/admin/flipshop"
    ],
    "adminPrefix": "/api/v1/admin/flipshop"
  },
  "auth": {
    "audience": "admin",
    "tenantPolicy": "required"
  },
  "messages": [
    "翻牌小店商品最小闭环：仅 list / detail / create 三接口，声明面与实现面一一对应。"
  ],
  "actions": [
    "flipshop.pageProduct",
    "flipshop.getProduct",
    "flipshop.createProduct"
  ],
  "permissions": [
    "flipshop:product:create",
    "flipshop:product:query"
  ],
  "dependsOn": [
    "shared"
  ],
  "pack": {
    "enabled": true,
    "kind": "api-only",
    "independentDatabase": false
  }
}
