{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mall",
  "entity": "KeFuConversation",
  "kebab": "ke-fu-conversation",
  "businessName": "客服会话",
  "permissionPrefix": "mall:ke_fu_conversation",
  "page": {
    "route": "/admin/mall/ke-fu-conversation",
    "title": "客服会话管理",
    "titleSelector": "[data-testid=\"ke-fu-conversation-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mall/api",
    "bffMount": "/api/v1/admin/mall",
    "resource": "ke-fu-conversation",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/ke-fu-conversation",
        "query": [
          "page",
          "pageSize"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/ke-fu-conversation/:id"
      },
      "create": {
        "http": "POST",
        "path": "/ke-fu-conversation"
      },
      "update": {
        "http": "PUT",
        "path": "/ke-fu-conversation/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/ke-fu-conversation/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"ke-fu-conversation-title\"]",
    "refresh": "[data-testid=\"ke-fu-conversation-refresh\"]",
    "createButton": "[data-testid=\"ke-fu-conversation-create\"]",
    "searchForm": "[data-testid=\"ke-fu-conversation-search\"]",
    "searchSubmit": "[data-testid=\"ke-fu-conversation-search-submit\"]",
    "searchReset": "[data-testid=\"ke-fu-conversation-search-reset\"]",
    "total": "[data-testid=\"ke-fu-conversation-total\"]",
    "table": "[data-testid=\"ke-fu-conversation-table\"]",
    "row": "[data-testid=\"ke-fu-conversation-row\"]",
    "editButton": "[data-testid=\"ke-fu-conversation-edit\"]",
    "deleteButton": "[data-testid=\"ke-fu-conversation-delete\"]",
    "form": "[data-testid=\"ke-fu-conversation-form\"]",
    "formError": "[data-testid=\"ke-fu-conversation-form-error\"]",
    "formSubmit": "[data-testid=\"ke-fu-conversation-form-submit\"]",
    "formCancel": "[data-testid=\"ke-fu-conversation-form-cancel\"]",
    "formClose": "[data-testid=\"ke-fu-conversation-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "客服会话列表",
    "dialogLabel": {
      "create": "新增客服会话",
      "edit": "编辑客服会话"
    },
    "searchFields": [],
    "fields": [
      {
        "name": "user_id",
        "label": "会话所属用户",
        "type": "number",
        "required": false,
        "testId": "field-user_id",
        "selector": "[data-testid=\"field-user_id\"]"
      },
      {
        "name": "last_message_time",
        "label": "最后聊天时间",
        "type": "string",
        "required": false,
        "testId": "field-last_message_time",
        "selector": "[data-testid=\"field-last_message_time\"]"
      },
      {
        "name": "last_message_content",
        "label": "最后聊天内容",
        "type": "string",
        "required": false,
        "testId": "field-last_message_content",
        "selector": "[data-testid=\"field-last_message_content\"]"
      },
      {
        "name": "last_message_content_type",
        "label": "最后发送的消息类型",
        "type": "number",
        "required": false,
        "testId": "field-last_message_content_type",
        "selector": "[data-testid=\"field-last_message_content_type\"]"
      },
      {
        "name": "admin_pinned",
        "label": "管理端置顶",
        "type": "boolean",
        "required": false,
        "testId": "field-admin_pinned",
        "selector": "[data-testid=\"field-admin_pinned\"]"
      },
      {
        "name": "user_deleted",
        "label": "用户是否可见",
        "type": "boolean",
        "required": false,
        "testId": "field-user_deleted",
        "selector": "[data-testid=\"field-user_deleted\"]"
      },
      {
        "name": "admin_deleted",
        "label": "管理员是否可见",
        "type": "boolean",
        "required": false,
        "testId": "field-admin_deleted",
        "selector": "[data-testid=\"field-admin_deleted\"]"
      },
      {
        "name": "admin_unread_message_count",
        "label": "管理员未读消息数",
        "type": "number",
        "required": false,
        "testId": "field-admin_unread_message_count",
        "selector": "[data-testid=\"field-admin_unread_message_count\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "ke-fu-conversation",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"ke-fu-conversation\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"ke-fu-conversation-form-overlay\"]",
      "dialog": "[data-testid=\"ke-fu-conversation-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "ke-fu-conversation:search",
      "reset": "ke-fu-conversation:reset",
      "refresh": "ke-fu-conversation:refresh",
      "create": "ke-fu-conversation:create",
      "edit": "ke-fu-conversation:edit",
      "delete": "ke-fu-conversation:delete",
      "submit": "ke-fu-conversation:submit",
      "cancel": "ke-fu-conversation:cancel",
      "close": "ke-fu-conversation:close",
      "row": "ke-fu-conversation:row",
      "pagination": "ke-fu-conversation:pagination",
      "fields": {
        "user_id": "ke-fu-conversation:field:user_id",
        "last_message_time": "ke-fu-conversation:field:last_message_time",
        "last_message_content": "ke-fu-conversation:field:last_message_content",
        "last_message_content_type": "ke-fu-conversation:field:last_message_content_type",
        "admin_pinned": "ke-fu-conversation:field:admin_pinned",
        "user_deleted": "ke-fu-conversation:field:user_deleted",
        "admin_deleted": "ke-fu-conversation:field:admin_deleted",
        "admin_unread_message_count": "ke-fu-conversation:field:admin_unread_message_count"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mall.ke-fu-conversation",
      "examples": [
        "mall.ke-fu-conversation__List__Refresh",
        "mall.ke-fu-conversation__ListItem__Open",
        "mall.ke-fu-conversation__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
