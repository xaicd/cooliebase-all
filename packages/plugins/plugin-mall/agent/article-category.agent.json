{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mall",
  "entity": "ArticleCategory",
  "kebab": "article-category",
  "businessName": "文章分类",
  "permissionPrefix": "mall:article_category",
  "page": {
    "route": "/admin/mall/article-category",
    "title": "文章分类管理",
    "titleSelector": "[data-testid=\"article-category-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mall/api",
    "bffMount": "/api/v1/admin/mall",
    "resource": "article-category",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/article-category",
        "query": [
          "page",
          "pageSize",
          "name",
          "status"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/article-category/:id"
      },
      "create": {
        "http": "POST",
        "path": "/article-category"
      },
      "update": {
        "http": "PUT",
        "path": "/article-category/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/article-category/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"article-category-title\"]",
    "refresh": "[data-testid=\"article-category-refresh\"]",
    "createButton": "[data-testid=\"article-category-create\"]",
    "searchForm": "[data-testid=\"article-category-search\"]",
    "searchSubmit": "[data-testid=\"article-category-search-submit\"]",
    "searchReset": "[data-testid=\"article-category-search-reset\"]",
    "total": "[data-testid=\"article-category-total\"]",
    "table": "[data-testid=\"article-category-table\"]",
    "row": "[data-testid=\"article-category-row\"]",
    "editButton": "[data-testid=\"article-category-edit\"]",
    "deleteButton": "[data-testid=\"article-category-delete\"]",
    "form": "[data-testid=\"article-category-form\"]",
    "formError": "[data-testid=\"article-category-form-error\"]",
    "formSubmit": "[data-testid=\"article-category-form-submit\"]",
    "formCancel": "[data-testid=\"article-category-form-cancel\"]",
    "formClose": "[data-testid=\"article-category-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "文章分类列表",
    "dialogLabel": {
      "create": "新增文章分类",
      "edit": "编辑文章分类"
    },
    "searchFields": [
      {
        "name": "name",
        "label": "文章分类名称",
        "testId": "search-name",
        "selector": "[data-testid=\"search-name\"]"
      },
      {
        "name": "status",
        "label": "状态",
        "testId": "search-status",
        "selector": "[data-testid=\"search-status\"]"
      }
    ],
    "fields": [
      {
        "name": "name",
        "label": "文章分类名称",
        "type": "string",
        "required": false,
        "testId": "field-name",
        "selector": "[data-testid=\"field-name\"]"
      },
      {
        "name": "pic_url",
        "label": "图标地址",
        "type": "string",
        "required": false,
        "testId": "field-pic_url",
        "selector": "[data-testid=\"field-pic_url\"]"
      },
      {
        "name": "status",
        "label": "状态",
        "type": "number",
        "required": false,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      },
      {
        "name": "sort",
        "label": "排序",
        "type": "number",
        "required": false,
        "testId": "field-sort",
        "selector": "[data-testid=\"field-sort\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "article-category",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"article-category\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"article-category-form-overlay\"]",
      "dialog": "[data-testid=\"article-category-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "article-category:search",
      "reset": "article-category:reset",
      "refresh": "article-category:refresh",
      "create": "article-category:create",
      "edit": "article-category:edit",
      "delete": "article-category:delete",
      "submit": "article-category:submit",
      "cancel": "article-category:cancel",
      "close": "article-category:close",
      "row": "article-category:row",
      "pagination": "article-category:pagination",
      "fields": {
        "name": "article-category:field:name",
        "pic_url": "article-category:field:pic_url",
        "status": "article-category:field:status",
        "sort": "article-category:field:sort"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mall.article-category",
      "examples": [
        "mall.article-category__List__Refresh",
        "mall.article-category__ListItem__Open",
        "mall.article-category__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
