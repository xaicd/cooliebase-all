{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mall",
  "entity": "DiyPage",
  "kebab": "diy-page",
  "businessName": "装修页面",
  "permissionPrefix": "mall:diy_page",
  "page": {
    "route": "/admin/mall/diy-page",
    "title": "装修页面管理",
    "titleSelector": "[data-testid=\"diy-page-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mall/api",
    "bffMount": "/api/v1/admin/mall",
    "resource": "diy-page",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/diy-page",
        "query": [
          "page",
          "pageSize",
          "template_id",
          "name"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/diy-page/:id"
      },
      "create": {
        "http": "POST",
        "path": "/diy-page"
      },
      "update": {
        "http": "PUT",
        "path": "/diy-page/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/diy-page/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"diy-page-title\"]",
    "refresh": "[data-testid=\"diy-page-refresh\"]",
    "createButton": "[data-testid=\"diy-page-create\"]",
    "searchForm": "[data-testid=\"diy-page-search\"]",
    "searchSubmit": "[data-testid=\"diy-page-search-submit\"]",
    "searchReset": "[data-testid=\"diy-page-search-reset\"]",
    "total": "[data-testid=\"diy-page-total\"]",
    "table": "[data-testid=\"diy-page-table\"]",
    "row": "[data-testid=\"diy-page-row\"]",
    "editButton": "[data-testid=\"diy-page-edit\"]",
    "deleteButton": "[data-testid=\"diy-page-delete\"]",
    "form": "[data-testid=\"diy-page-form\"]",
    "formError": "[data-testid=\"diy-page-form-error\"]",
    "formSubmit": "[data-testid=\"diy-page-form-submit\"]",
    "formCancel": "[data-testid=\"diy-page-form-cancel\"]",
    "formClose": "[data-testid=\"diy-page-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "装修页面列表",
    "dialogLabel": {
      "create": "新增装修页面",
      "edit": "编辑装修页面"
    },
    "searchFields": [
      {
        "name": "template_id",
        "label": "装修模板编号",
        "testId": "search-template_id",
        "selector": "[data-testid=\"search-template_id\"]"
      },
      {
        "name": "name",
        "label": "页面名称",
        "testId": "search-name",
        "selector": "[data-testid=\"search-name\"]"
      }
    ],
    "fields": [
      {
        "name": "template_id",
        "label": "装修模板编号",
        "type": "string",
        "required": false,
        "testId": "field-template_id",
        "selector": "[data-testid=\"field-template_id\"]"
      },
      {
        "name": "name",
        "label": "页面名称",
        "type": "string",
        "required": false,
        "testId": "field-name",
        "selector": "[data-testid=\"field-name\"]"
      },
      {
        "name": "remark",
        "label": "备注",
        "type": "string",
        "required": false,
        "testId": "field-remark",
        "selector": "[data-testid=\"field-remark\"]"
      },
      {
        "name": "preview_pic_urls",
        "label": "预览图，多个逗号分隔",
        "type": "string",
        "required": false,
        "testId": "field-preview_pic_urls",
        "selector": "[data-testid=\"field-preview_pic_urls\"]"
      },
      {
        "name": "property",
        "label": "页面属性，JSON 格式",
        "type": "string",
        "required": false,
        "testId": "field-property",
        "selector": "[data-testid=\"field-property\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "diy-page",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"diy-page\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"diy-page-form-overlay\"]",
      "dialog": "[data-testid=\"diy-page-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "diy-page:search",
      "reset": "diy-page:reset",
      "refresh": "diy-page:refresh",
      "create": "diy-page:create",
      "edit": "diy-page:edit",
      "delete": "diy-page:delete",
      "submit": "diy-page:submit",
      "cancel": "diy-page:cancel",
      "close": "diy-page:close",
      "row": "diy-page:row",
      "pagination": "diy-page:pagination",
      "fields": {
        "template_id": "diy-page:field:template_id",
        "name": "diy-page:field:name",
        "remark": "diy-page:field:remark",
        "preview_pic_urls": "diy-page:field:preview_pic_urls",
        "property": "diy-page:field:property"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mall.diy-page",
      "examples": [
        "mall.diy-page__List__Refresh",
        "mall.diy-page__ListItem__Open",
        "mall.diy-page__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
