{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mall",
  "entity": "Cart",
  "kebab": "cart",
  "businessName": "购物车的商品信息 DO每个商品，对应一条记录，通过 和 关联",
  "permissionPrefix": "mall:cart",
  "page": {
    "route": "/admin/mall/cart",
    "title": "购物车的商品信息 DO每个商品，对应一条记录，通过 和 关联管理",
    "titleSelector": "[data-testid=\"cart-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mall/api",
    "bffMount": "/api/v1/admin/mall",
    "resource": "cart",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/cart",
        "query": [
          "page",
          "pageSize",
          "user_id",
          "spu_id",
          "sku_id"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/cart/:id"
      },
      "create": {
        "http": "POST",
        "path": "/cart"
      },
      "update": {
        "http": "PUT",
        "path": "/cart/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/cart/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"cart-title\"]",
    "refresh": "[data-testid=\"cart-refresh\"]",
    "createButton": "[data-testid=\"cart-create\"]",
    "searchForm": "[data-testid=\"cart-search\"]",
    "searchSubmit": "[data-testid=\"cart-search-submit\"]",
    "searchReset": "[data-testid=\"cart-search-reset\"]",
    "total": "[data-testid=\"cart-total\"]",
    "table": "[data-testid=\"cart-table\"]",
    "row": "[data-testid=\"cart-row\"]",
    "editButton": "[data-testid=\"cart-edit\"]",
    "deleteButton": "[data-testid=\"cart-delete\"]",
    "form": "[data-testid=\"cart-form\"]",
    "formError": "[data-testid=\"cart-form-error\"]",
    "formSubmit": "[data-testid=\"cart-form-submit\"]",
    "formCancel": "[data-testid=\"cart-form-cancel\"]",
    "formClose": "[data-testid=\"cart-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "购物车的商品信息 DO每个商品，对应一条记录，通过 和 关联列表",
    "dialogLabel": {
      "create": "新增购物车的商品信息 DO每个商品，对应一条记录，通过 和 关联",
      "edit": "编辑购物车的商品信息 DO每个商品，对应一条记录，通过 和 关联"
    },
    "searchFields": [
      {
        "name": "user_id",
        "label": "用户编号",
        "testId": "search-user_id",
        "selector": "[data-testid=\"search-user_id\"]"
      },
      {
        "name": "spu_id",
        "label": "商品 SPU 编号",
        "testId": "search-spu_id",
        "selector": "[data-testid=\"search-spu_id\"]"
      },
      {
        "name": "sku_id",
        "label": "商品 SKU 编号",
        "testId": "search-sku_id",
        "selector": "[data-testid=\"search-sku_id\"]"
      }
    ],
    "fields": [
      {
        "name": "user_id",
        "label": "用户编号",
        "type": "string",
        "required": false,
        "testId": "field-user_id",
        "selector": "[data-testid=\"field-user_id\"]"
      },
      {
        "name": "spu_id",
        "label": "商品 SPU 编号",
        "type": "string",
        "required": false,
        "testId": "field-spu_id",
        "selector": "[data-testid=\"field-spu_id\"]"
      },
      {
        "name": "sku_id",
        "label": "商品 SKU 编号",
        "type": "string",
        "required": false,
        "testId": "field-sku_id",
        "selector": "[data-testid=\"field-sku_id\"]"
      },
      {
        "name": "count",
        "label": "商品购买数量",
        "type": "number",
        "required": false,
        "testId": "field-count",
        "selector": "[data-testid=\"field-count\"]"
      },
      {
        "name": "selected",
        "label": "是否选中",
        "type": "boolean",
        "required": false,
        "testId": "field-selected",
        "selector": "[data-testid=\"field-selected\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "cart",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"cart\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"cart-form-overlay\"]",
      "dialog": "[data-testid=\"cart-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "cart:search",
      "reset": "cart:reset",
      "refresh": "cart:refresh",
      "create": "cart:create",
      "edit": "cart:edit",
      "delete": "cart:delete",
      "submit": "cart:submit",
      "cancel": "cart:cancel",
      "close": "cart:close",
      "row": "cart:row",
      "pagination": "cart:pagination",
      "fields": {
        "user_id": "cart:field:user_id",
        "spu_id": "cart:field:spu_id",
        "sku_id": "cart:field:sku_id",
        "count": "cart:field:count",
        "selected": "cart:field:selected"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mall.cart",
      "examples": [
        "mall.cart__List__Refresh",
        "mall.cart__ListItem__Open",
        "mall.cart__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
