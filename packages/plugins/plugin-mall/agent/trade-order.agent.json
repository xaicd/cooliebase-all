{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mall",
  "entity": "TradeOrder",
  "kebab": "trade-order",
  "businessName": "交易订单",
  "permissionPrefix": "mall:trade_order",
  "page": {
    "route": "/admin/mall/trade-order",
    "title": "交易订单管理",
    "titleSelector": "[data-testid=\"trade-order-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mall/api",
    "bffMount": "/api/v1/admin/mall",
    "resource": "trade-order",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/trade-order",
        "query": [
          "page",
          "pageSize"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/trade-order/:id"
      },
      "create": {
        "http": "POST",
        "path": "/trade-order"
      },
      "update": {
        "http": "PUT",
        "path": "/trade-order/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/trade-order/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"trade-order-title\"]",
    "refresh": "[data-testid=\"trade-order-refresh\"]",
    "createButton": "[data-testid=\"trade-order-create\"]",
    "searchForm": "[data-testid=\"trade-order-search\"]",
    "searchSubmit": "[data-testid=\"trade-order-search-submit\"]",
    "searchReset": "[data-testid=\"trade-order-search-reset\"]",
    "total": "[data-testid=\"trade-order-total\"]",
    "table": "[data-testid=\"trade-order-table\"]",
    "row": "[data-testid=\"trade-order-row\"]",
    "editButton": "[data-testid=\"trade-order-edit\"]",
    "deleteButton": "[data-testid=\"trade-order-delete\"]",
    "form": "[data-testid=\"trade-order-form\"]",
    "formError": "[data-testid=\"trade-order-form-error\"]",
    "formSubmit": "[data-testid=\"trade-order-form-submit\"]",
    "formCancel": "[data-testid=\"trade-order-form-cancel\"]",
    "formClose": "[data-testid=\"trade-order-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "交易订单列表",
    "dialogLabel": {
