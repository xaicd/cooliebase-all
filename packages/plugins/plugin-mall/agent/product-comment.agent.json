{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "mall",
  "entity": "ProductComment",
  "kebab": "product-comment",
  "businessName": "商品评论",
  "permissionPrefix": "mall:product_comment",
  "page": {
    "route": "/admin/mall/product-comment",
    "title": "商品评论管理",
    "titleSelector": "[data-testid=\"product-comment-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.mall/api",
    "bffMount": "/api/v1/admin/mall",
    "resource": "product-comment",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/product-comment",
        "query": [
          "page",
          "pageSize",
          "user_id",
          "order_id",
          "order_item_id",
          "spu_id",
          "sku_id"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/product-comment/:id"
      },
      "create": {
        "http": "POST",
        "path": "/product-comment"
      },
      "update": {
        "http": "PUT",
        "path": "/product-comment/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/product-comment/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"product-comment-title\"]",
    "refresh": "[data-testid=\"product-comment-refresh\"]",
    "createButton": "[data-testid=\"product-comment-create\"]",
    "searchForm": "[data-testid=\"product-comment-search\"]",
    "searchSubmit": "[data-testid=\"product-comment-search-submit\"]",
    "searchReset": "[data-testid=\"product-comment-search-reset\"]",
    "total": "[data-testid=\"product-comment-total\"]",
    "table": "[data-testid=\"product-comment-table\"]",
    "row": "[data-testid=\"product-comment-row\"]",
    "editButton": "[data-testid=\"product-comment-edit\"]",
    "deleteButton": "[data-testid=\"product-comment-delete\"]",
    "form": "[data-testid=\"product-comment-form\"]",
    "formError": "[data-testid=\"product-comment-form-error\"]",
    "formSubmit": "[data-testid=\"product-comment-form-submit\"]",
    "formCancel": "[data-testid=\"product-comment-form-cancel\"]",
    "formClose": "[data-testid=\"product-comment-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "商品评论列表",
    "dialogLabel": {
      "create": "新增商品评论",
      "edit": "编辑商品评论"
    },
    "searchFields": [
      {
        "name": "user_id",
        "label": "评价人的用户编号",
        "testId": "search-user_id",
        "selector": "[data-testid=\"search-user_id\"]"
      },
      {
        "name": "order_id",
        "label": "交易订单编号",
        "testId": "search-order_id",
        "selector": "[data-testid=\"search-order_id\"]"
      },
      {
        "name": "order_item_id",
        "label": "交易订单项编号",
        "testId": "search-order_item_id",
        "selector": "[data-testid=\"search-order_item_id\"]"
      },
      {
        "name": "spu_id",
        "label": "商品 SPU 编号",
        "testId": "search-spu_id",
        "selector": "[data-testid=\"search-spu_id\"]"
      },
      {
        "name": "sku_id",
        "label": "商品 SKU 编号",
        "testId": "search-sku_id",
        "selector": "[data-testid=\"search-sku_id\"]"
      }
    ],
    "fields": [
      {
        "name": "user_id",
        "label": "评价人的用户编号",
        "type": "string",
        "required": false,
        "testId": "field-user_id",
        "selector": "[data-testid=\"field-user_id\"]"
      },
      {
        "name": "user_nickname",
        "label": "评价人名称",
        "type": "string",
        "required": false,
        "testId": "field-user_nickname",
        "selector": "[data-testid=\"field-user_nickname\"]"
      },
      {
        "name": "user_avatar",
        "label": "评价人头像",
        "type": "string",
        "required": false,
        "testId": "field-user_avatar",
        "selector": "[data-testid=\"field-user_avatar\"]"
      },
      {
        "name": "anonymous",
        "label": "是否匿名",
        "type": "boolean",
        "required": false,
        "testId": "field-anonymous",
        "selector": "[data-testid=\"field-anonymous\"]"
      },
      {
        "name": "order_id",
        "label": "交易订单编号",
        "type": "string",
        "required": false,
        "testId": "field-order_id",
        "selector": "[data-testid=\"field-order_id\"]"
      },
      {
        "name": "order_item_id",
        "label": "交易订单项编号",
        "type": "string",
        "required": false,
        "testId": "field-order_item_id",
        "selector": "[data-testid=\"field-order_item_id\"]"
      },
      {
        "name": "spu_id",
        "label": "商品 SPU 编号",
        "type": "string",
        "required": false,
        "testId": "field-spu_id",
        "selector": "[data-testid=\"field-spu_id\"]"
      },
      {
        "name": "spu_name",
        "label": "商品 SPU 名称",
        "type": "string",
        "required": false,
        "testId": "field-spu_name",
        "selector": "[data-testid=\"field-spu_name\"]"
      },
      {
        "name": "sku_id",
        "label": "商品 SKU 编号",
        "type": "string",
        "required": false,
        "testId": "field-sku_id",
        "selector": "[data-testid=\"field-sku_id\"]"
      },
      {
        "name": "sku_pic_url",
        "label": "商品 SKU 图片地址",
        "type": "string",
        "required": false,
        "testId": "field-sku_pic_url",
        "selector": "[data-testid=\"field-sku_pic_url\"]"
      },
      {
        "name": "sku_properties",
        "label": "属性数组，JSON 格式",
        "type": "string",
        "required": false,
        "testId": "field-sku_properties",
        "selector": "[data-testid=\"field-sku_properties\"]"
      },
      {
        "name": "visible",
        "label": "是否可见",
        "type": "boolean",
        "required": false,
        "testId": "field-visible",
        "selector": "[data-testid=\"field-visible\"]"
      },
      {
        "name": "scores",
        "label": "评分星级",
        "type": "number",
        "required": false,
        "testId": "field-scores",
        "selector": "[data-testid=\"field-scores\"]"
      },
      {
        "name": "description_scores",
        "label": "描述星级",
        "type": "number",
        "required": false,
        "testId": "field-description_scores",
        "selector": "[data-testid=\"field-description_scores\"]"
      },
      {
        "name": "benefit_scores",
        "label": "服务星级",
        "type": "number",
        "required": false,
        "testId": "field-benefit_scores",
        "selector": "[data-testid=\"field-benefit_scores\"]"
      },
      {
        "name": "content",
        "label": "评论内容",
        "type": "string",
        "required": false,
        "testId": "field-content",
        "selector": "[data-testid=\"field-content\"]"
      },
      {
        "name": "pic_urls",
        "label": "评论图片地址数组",
        "type": "string",
        "required": false,
        "testId": "field-pic_urls",
        "selector": "[data-testid=\"field-pic_urls\"]"
      },
      {
        "name": "reply_status",
        "label": "商家是否回复",
        "type": "boolean",
        "required": false,
        "testId": "field-reply_status",
        "selector": "[data-testid=\"field-reply_status\"]"
      },
      {
        "name": "reply_user_id",
        "label": "回复管理员编号",
        "type": "string",
        "required": false,
        "testId": "field-reply_user_id",
        "selector": "[data-testid=\"field-reply_user_id\"]"
      },
      {
        "name": "reply_content",
        "label": "商家回复内容",
        "type": "string",
        "required": false,
        "testId": "field-reply_content",
        "selector": "[data-testid=\"field-reply_content\"]"
      },
      {
        "name": "reply_time",
        "label": "商家回复时间",
        "type": "string",
        "required": false,
        "testId": "field-reply_time",
        "selector": "[data-testid=\"field-reply_time\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "product-comment",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"product-comment\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"product-comment-form-overlay\"]",
      "dialog": "[data-testid=\"product-comment-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "product-comment:search",
      "reset": "product-comment:reset",
      "refresh": "product-comment:refresh",
      "create": "product-comment:create",
      "edit": "product-comment:edit",
      "delete": "product-comment:delete",
      "submit": "product-comment:submit",
      "cancel": "product-comment:cancel",
      "close": "product-comment:close",
      "row": "product-comment:row",
      "pagination": "product-comment:pagination",
      "fields": {
        "user_id": "product-comment:field:user_id",
        "user_nickname": "product-comment:field:user_nickname",
        "user_avatar": "product-comment:field:user_avatar",
        "anonymous": "product-comment:field:anonymous",
        "order_id": "product-comment:field:order_id",
        "order_item_id": "product-comment:field:order_item_id",
        "spu_id": "product-comment:field:spu_id",
        "spu_name": "product-comment:field:spu_name",
        "sku_id": "product-comment:field:sku_id",
        "sku_pic_url": "product-comment:field:sku_pic_url",
        "sku_properties": "product-comment:field:sku_properties",
        "visible": "product-comment:field:visible",
        "scores": "product-comment:field:scores",
        "description_scores": "product-comment:field:description_scores",
        "benefit_scores": "product-comment:field:benefit_scores",
        "content": "product-comment:field:content",
        "pic_urls": "product-comment:field:pic_urls",
        "reply_status": "product-comment:field:reply_status",
        "reply_user_id": "product-comment:field:reply_user_id",
        "reply_content": "product-comment:field:reply_content",
        "reply_time": "product-comment:field:reply_time"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "mall.product-comment",
      "examples": [
        "mall.product-comment__List__Refresh",
        "mall.product-comment__ListItem__Open",
        "mall.product-comment__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
