{
  "$schema": "cooliebase-module-manifest/v1",
  "domain": "mall",
  "id": "cooliebase.mall",
  "apiVersion": 1,
  "displayName": "mall",
  "kind": "plugin",
  "stage": "B",
  "owner": "mall",
  "contractVersion": "v1",
  "implementation": "local-ts",
  "minimumHostVersion": "1.0.0",
  "capabilities": [
    "api.routes.register",
    "facade.invoke",
    "rpc.serve",
    "cmd.dispatch",
    "pack.independent"
  ],
  "entrypoints": {
    "facade": [
      "packages/plugins/plugin-mall/contract/mall.facade.ts"
    ],
    "proto": "packages/plugins/plugin-mall/contract/mall.proto",
    "actions": "packages/plugins/plugin-mall/contract/actions.ts"
  },
  "apiRoutes": {
    "publicPrefix": [
      "/api/v1/admin/mall",
      "/api/v1/app/mall"
    ],
    "adminPrefix": "/api/v1/admin/mall"
  },
  "auth": {
    "audience": "admin",
    "tenantPolicy": "required"
  },
  "messaging": {
    "queueGroup": "cooliebase.mall",
    "commandSubject": "cooliebase.cmd.mall.>",
    "eventSubject": "cooliebase.evt.mall.>"
  },
  "invoke": {
    "colocated": "sdk",
    "remote": "rpc",
    "protocol": "nats-rr",
    "serialization": "json"
  },
  "upstream": {
    "env": "COOLIEBASE_DOMAIN_MALL_UPSTREAM",
    "protocol": "http",
    "defaultPort": 3217
  },
  "resilience": {
    "timeoutMs": 5000,
    "retry": {
      "maxAttempts": 1,
      "safeMethodsOnly": true
    },
    "idempotencyRequired": true
  },
  "facadeMethods": [
    "ping",
    "listProducts",
    "listOrders",
    "issueCoupon"
  ],
  "rpc": [
    {
      "service": "MallService",
      "method": "Ping"
    },
    {
      "service": "MallService",
      "method": "ListProducts"
    },
    {
      "service": "MallService",
      "method": "ListOrders"
    },
    {
      "service": "MallService",
      "method": "IssueCoupon"
    }
  ],
  "actions": [
    "mall.ping",
    "mall.listProducts",
    "mall.listOrders",
    "mall.issueCoupon"
  ],
