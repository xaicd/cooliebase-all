{
  "$schema": "cooliebase-plugin-manifest/v1",
  "id": "cooliebase.mall",
  "apiVersion": 1,
  "version": "0.1.0",
  "displayName": "mall",
  "description": "mall 域（由 scripts/scaffold-domain-plugin.cjs 生成的第一方插件声明）",
  "author": "CoolieBase All",
  "categories": [
    "automation"
  ],
  "capabilities": [
    "api.routes.register"
  ],
  "entrypoints": {
    "merged": "./plugin-entry.ts"
  },
  "domain": {
    "kind": "business",
    "stage": "B",
    "contractVersion": "v1",
    "publicPrefixes": [
      "/api/v1/admin/mall",
      "/api/v1/app/mall"
    ],
    "upstreamEnv": "COOLIEBASE_DOMAIN_MALL_UPSTREAM",
    "defaultPort": 3217,
    "packable": true,
    "independentDatabase": false,
    "dependsOnModules": [
      "shared"
    ],
    "auth": {
      "audience": "admin",
      "tenantPolicy": "required"
    },
    "resilience": {
      "timeoutMs": 5000,
      "retryMaxAttempts": 1,
      "safeMethodsOnly": true,
      "idempotencyRequired": true
    }
  },
