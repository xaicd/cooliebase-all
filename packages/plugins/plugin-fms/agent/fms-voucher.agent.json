{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "fms",
  "entity": "FmsVoucher",
  "kebab": "fms-voucher",
  "businessName": "收支凭证",
  "permissionPrefix": "fms:voucher",
  "page": {
    "route": "/admin/fms/fms-voucher",
    "menuTitle": "收支凭证",
    "title": "收支凭证管理",
    "titleSelector": "[data-testid=\"fms-voucher-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.fms/api",
    "bffMount": "/api/v1/admin/fms",
    "resource": "fms-voucher",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/fms-voucher",
        "query": [
          "page",
          "pageSize",
          "voucher_no",
          "account_id",
          "direction",
          "summary",
          "status"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/fms-voucher/:id"
      },
      "create": {
        "http": "POST",
        "path": "/fms-voucher"
      },
      "update": {
        "http": "PUT",
        "path": "/fms-voucher/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/fms-voucher/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"fms-voucher-title\"]",
    "refresh": "[data-testid=\"fms-voucher-refresh\"]",
    "createButton": "[data-testid=\"fms-voucher-create\"]",
    "searchForm": "[data-testid=\"fms-voucher-search\"]",
    "searchSubmit": "[data-testid=\"fms-voucher-search-submit\"]",
    "searchReset": "[data-testid=\"fms-voucher-search-reset\"]",
    "total": "[data-testid=\"fms-voucher-total\"]",
    "table": "[data-testid=\"fms-voucher-table\"]",
    "row": "[data-testid=\"fms-voucher-row\"]",
    "editButton": "[data-testid=\"fms-voucher-edit\"]",
    "deleteButton": "[data-testid=\"fms-voucher-delete\"]",
    "form": "[data-testid=\"fms-voucher-form\"]",
    "formError": "[data-testid=\"fms-voucher-form-error\"]",
    "formSubmit": "[data-testid=\"fms-voucher-form-submit\"]",
    "formCancel": "[data-testid=\"fms-voucher-form-cancel\"]",
    "formClose": "[data-testid=\"fms-voucher-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "收支凭证列表",
    "dialogLabel": {
      "create": "新增收支凭证",
      "edit": "编辑收支凭证"
    },
    "searchFields": [
      {
        "name": "voucher_no",
        "label": "凭证字号",
        "testId": "search-voucher_no",
        "selector": "[data-testid=\"search-voucher_no\"]"
      },
      {
        "name": "account_id",
        "label": "资金账户ID",
        "testId": "search-account_id",
        "selector": "[data-testid=\"search-account_id\"]"
      },
      {
        "name": "direction",
        "label": "借贷方向",
        "testId": "search-direction",
        "selector": "[data-testid=\"search-direction\"]"
      },
      {
        "name": "summary",
        "label": "凭证摘要",
        "testId": "search-summary",
        "selector": "[data-testid=\"search-summary\"]"
      },
      {
        "name": "status",
        "label": "审核状态",
        "testId": "search-status",
        "selector": "[data-testid=\"search-status\"]"
      }
    ],
    "fields": [
      {
        "name": "voucher_no",
        "label": "凭证字号",
        "type": "string",
        "required": true,
        "testId": "field-voucher_no",
        "selector": "[data-testid=\"field-voucher_no\"]"
      },
      {
        "name": "account_id",
        "label": "资金账户ID",
        "type": "string",
        "required": true,
        "testId": "field-account_id",
        "selector": "[data-testid=\"field-account_id\"]"
      },
      {
        "name": "direction",
        "label": "借贷方向",
        "type": "string",
        "required": true,
        "testId": "field-direction",
        "selector": "[data-testid=\"field-direction\"]"
      },
      {
        "name": "amount",
        "label": "发生金额",
        "type": "number",
        "required": true,
        "testId": "field-amount",
        "selector": "[data-testid=\"field-amount\"]"
      },
      {
        "name": "summary",
        "label": "凭证摘要",
        "type": "string",
        "required": true,
        "testId": "field-summary",
        "selector": "[data-testid=\"field-summary\"]"
      },
      {
        "name": "voucher_time",
        "label": "记账时间",
        "type": "string",
        "required": true,
        "testId": "field-voucher_time",
        "selector": "[data-testid=\"field-voucher_time\"]"
      },
      {
        "name": "status",
        "label": "审核状态",
        "type": "string",
        "required": true,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "fms-voucher",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"fms-voucher\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"fms-voucher-form-overlay\"]",
      "dialog": "[data-testid=\"fms-voucher-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "fms-voucher:search",
      "reset": "fms-voucher:reset",
      "refresh": "fms-voucher:refresh",
      "create": "fms-voucher:create",
      "edit": "fms-voucher:edit",
      "delete": "fms-voucher:delete",
      "submit": "fms-voucher:submit",
      "cancel": "fms-voucher:cancel",
      "close": "fms-voucher:close",
      "row": "fms-voucher:row",
      "pagination": "fms-voucher:pagination",
      "fields": {
        "voucher_no": "fms-voucher:field:voucher_no",
        "account_id": "fms-voucher:field:account_id",
        "direction": "fms-voucher:field:direction",
        "amount": "fms-voucher:field:amount",
        "summary": "fms-voucher:field:summary",
        "voucher_time": "fms-voucher:field:voucher_time",
        "status": "fms-voucher:field:status"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "fms.fms-voucher",
      "examples": [
        "fms.fms-voucher__List__Refresh",
        "fms.fms-voucher__ListItem__Open",
        "fms.fms-voucher__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
