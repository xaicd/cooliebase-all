{
  "$schema": "cooliebase-plugin-manifest/v1",
  "id": "cooliebase.fms",
  "apiVersion": 1,
  "version": "0.1.0",
  "displayName": "fms",
  "description": "fms 域（由 scripts/scaffold-domain-plugin.cjs 生成的第一方插件声明）",
  "author": "CoolieBase All",
  "categories": [
    "automation"
  ],
  "capabilities": [
    "api.routes.register"
  ],
  "entrypoints": {
    "merged": "./plugin-entry.ts"
  },
  "domain": {
    "kind": "plugin",
    "stage": "B",
    "contractVersion": "v1",
    "publicPrefixes": [
      "/api/v1/admin/fms"
    ],
    "upstreamEnv": "COOLIEBASE_DOMAIN_FMS_UPSTREAM",
    "defaultPort": 3228,
    "packable": true,
    "independentDatabase": false,
    "dependsOnModules": [
      "shared"
    ],
    "auth": {
      "audience": "admin",
      "tenantPolicy": "required"
    },
    "resilience": {
      "timeoutMs": 15000,
      "retryMaxAttempts": 1,
      "safeMethodsOnly": true,
      "idempotencyRequired": true
    }
  },
  "apiRoutes": [
