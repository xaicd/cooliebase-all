{
  "$schema": "cooliebase-plugin-manifest/v1",
  "id": "cooliebase.hello-world",
  "apiVersion": 1,
  "version": "0.1.0",
  "displayName": "Hello World",
  "description": "最小参考插件：同时声明 worker（独立运行）与 merged（合并运行）两种入口，示范一个插件两种形态。",
  "author": "CoolieBase All Base",
  "categories": [
    "automation"
  ],
  "capabilities": [
    "api.routes.register",
    "plugin.state.read",
    "ui.page.register"
  ],
  "entrypoints": {
    "worker": "./worker.js",
    "merged": "./merged.js",
    "ui": "./ui"
  },
  "apiRoutes": [
    {
      "routeKey": "hello",
      "method": "GET",
      "path": "/hello",
      "auth": "operator"
    }
  ],
  "migrations": {
    "dir": "./migrations"
  },
  "ui": {
    "slots": [
      {
        "type": "dashboardWidget",
        "id": "hello-widget",
        "displayName": "Hello 组件",
        "exportName": "HelloWidget"
      }
    ]
  }
}
