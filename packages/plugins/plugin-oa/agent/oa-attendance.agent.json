{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "oa",
  "entity": "OaAttendance",
  "kebab": "oa-attendance",
  "businessName": "考勤打卡",
  "permissionPrefix": "oa:attendance",
  "page": {
    "route": "/admin/oa/oa-attendance",
    "menuTitle": "考勤打卡",
    "title": "考勤打卡管理",
    "titleSelector": "[data-testid=\"oa-attendance-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.oa/api",
    "bffMount": "/api/v1/admin/oa",
    "resource": "oa-attendance",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/oa-attendance",
        "query": [
          "page",
          "pageSize",
          "employee_id",
          "employee_name",
          "work_date",
          "status"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/oa-attendance/:id"
      },
      "create": {
        "http": "POST",
        "path": "/oa-attendance"
      },
      "update": {
        "http": "PUT",
        "path": "/oa-attendance/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/oa-attendance/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"oa-attendance-title\"]",
    "refresh": "[data-testid=\"oa-attendance-refresh\"]",
    "createButton": "[data-testid=\"oa-attendance-create\"]",
    "searchForm": "[data-testid=\"oa-attendance-search\"]",
    "searchSubmit": "[data-testid=\"oa-attendance-search-submit\"]",
    "searchReset": "[data-testid=\"oa-attendance-search-reset\"]",
    "total": "[data-testid=\"oa-attendance-total\"]",
    "table": "[data-testid=\"oa-attendance-table\"]",
    "row": "[data-testid=\"oa-attendance-row\"]",
    "editButton": "[data-testid=\"oa-attendance-edit\"]",
    "deleteButton": "[data-testid=\"oa-attendance-delete\"]",
    "form": "[data-testid=\"oa-attendance-form\"]",
    "formError": "[data-testid=\"oa-attendance-form-error\"]",
    "formSubmit": "[data-testid=\"oa-attendance-form-submit\"]",
    "formCancel": "[data-testid=\"oa-attendance-form-cancel\"]",
    "formClose": "[data-testid=\"oa-attendance-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "考勤打卡列表",
    "dialogLabel": {
      "create": "新增考勤打卡",
      "edit": "编辑考勤打卡"
    },
    "searchFields": [
      {
        "name": "employee_id",
        "label": "员工ID",
        "testId": "search-employee_id",
        "selector": "[data-testid=\"search-employee_id\"]"
      },
      {
        "name": "employee_name",
        "label": "员工姓名",
        "testId": "search-employee_name",
        "selector": "[data-testid=\"search-employee_name\"]"
      },
      {
        "name": "work_date",
        "label": "考勤日期",
        "testId": "search-work_date",
        "selector": "[data-testid=\"search-work_date\"]"
      },
      {
        "name": "status",
        "label": "考勤状态",
        "testId": "search-status",
        "selector": "[data-testid=\"search-status\"]"
      }
    ],
    "fields": [
      {
        "name": "employee_id",
        "label": "员工ID",
        "type": "string",
        "required": true,
        "testId": "field-employee_id",
        "selector": "[data-testid=\"field-employee_id\"]"
      },
      {
        "name": "employee_name",
        "label": "员工姓名",
        "type": "string",
        "required": true,
        "testId": "field-employee_name",
        "selector": "[data-testid=\"field-employee_name\"]"
      },
      {
        "name": "work_date",
        "label": "考勤日期",
        "type": "string",
        "required": true,
        "testId": "field-work_date",
        "selector": "[data-testid=\"field-work_date\"]"
      },
      {
        "name": "check_in_time",
        "label": "签到时间",
        "type": "string",
        "required": false,
        "testId": "field-check_in_time",
        "selector": "[data-testid=\"field-check_in_time\"]"
      },
      {
        "name": "check_out_time",
        "label": "签退时间",
        "type": "string",
        "required": false,
        "testId": "field-check_out_time",
        "selector": "[data-testid=\"field-check_out_time\"]"
      },
      {
        "name": "status",
        "label": "考勤状态",
        "type": "string",
        "required": true,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "oa-attendance",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"oa-attendance\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"oa-attendance-form-overlay\"]",
      "dialog": "[data-testid=\"oa-attendance-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "oa-attendance:search",
      "reset": "oa-attendance:reset",
      "refresh": "oa-attendance:refresh",
      "create": "oa-attendance:create",
      "edit": "oa-attendance:edit",
      "delete": "oa-attendance:delete",
      "submit": "oa-attendance:submit",
      "cancel": "oa-attendance:cancel",
      "close": "oa-attendance:close",
      "row": "oa-attendance:row",
      "pagination": "oa-attendance:pagination",
      "fields": {
        "employee_id": "oa-attendance:field:employee_id",
        "employee_name": "oa-attendance:field:employee_name",
        "work_date": "oa-attendance:field:work_date",
        "check_in_time": "oa-attendance:field:check_in_time",
        "check_out_time": "oa-attendance:field:check_out_time",
        "status": "oa-attendance:field:status"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "oa.oa-attendance",
      "examples": [
        "oa.oa-attendance__List__Refresh",
        "oa.oa-attendance__ListItem__Open",
        "oa.oa-attendance__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
