{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "oa",
  "entity": "OaNotice",
  "kebab": "oa-notice",
  "businessName": "通知公告",
  "permissionPrefix": "oa:notice",
  "page": {
    "route": "/admin/oa/oa-notice",
    "menuTitle": "通知公告",
    "title": "通知公告管理",
    "titleSelector": "[data-testid=\"oa-notice-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.oa/api",
    "bffMount": "/api/v1/admin/oa",
    "resource": "oa-notice",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/oa-notice",
        "query": [
          "page",
          "pageSize",
          "notice_no",
          "title",
          "notice_type",
          "status"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/oa-notice/:id"
      },
      "create": {
        "http": "POST",
        "path": "/oa-notice"
      },
      "update": {
        "http": "PUT",
        "path": "/oa-notice/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/oa-notice/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"oa-notice-title\"]",
    "refresh": "[data-testid=\"oa-notice-refresh\"]",
    "createButton": "[data-testid=\"oa-notice-create\"]",
    "searchForm": "[data-testid=\"oa-notice-search\"]",
    "searchSubmit": "[data-testid=\"oa-notice-search-submit\"]",
    "searchReset": "[data-testid=\"oa-notice-search-reset\"]",
    "total": "[data-testid=\"oa-notice-total\"]",
    "table": "[data-testid=\"oa-notice-table\"]",
    "row": "[data-testid=\"oa-notice-row\"]",
    "editButton": "[data-testid=\"oa-notice-edit\"]",
    "deleteButton": "[data-testid=\"oa-notice-delete\"]",
    "form": "[data-testid=\"oa-notice-form\"]",
    "formError": "[data-testid=\"oa-notice-form-error\"]",
    "formSubmit": "[data-testid=\"oa-notice-form-submit\"]",
    "formCancel": "[data-testid=\"oa-notice-form-cancel\"]",
    "formClose": "[data-testid=\"oa-notice-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "通知公告列表",
    "dialogLabel": {
      "create": "新增通知公告",
      "edit": "编辑通知公告"
    },
    "searchFields": [
      {
        "name": "notice_no",
        "label": "公告编号",
        "testId": "search-notice_no",
        "selector": "[data-testid=\"search-notice_no\"]"
      },
      {
        "name": "title",
        "label": "公告标题",
        "testId": "search-title",
        "selector": "[data-testid=\"search-title\"]"
      },
      {
        "name": "notice_type",
        "label": "公告类别",
        "testId": "search-notice_type",
        "selector": "[data-testid=\"search-notice_type\"]"
      },
      {
        "name": "status",
        "label": "发布状态",
        "testId": "search-status",
        "selector": "[data-testid=\"search-status\"]"
      }
    ],
    "fields": [
      {
        "name": "notice_no",
        "label": "公告编号",
        "type": "string",
        "required": true,
        "testId": "field-notice_no",
        "selector": "[data-testid=\"field-notice_no\"]"
      },
      {
        "name": "title",
        "label": "公告标题",
        "type": "string",
        "required": true,
        "testId": "field-title",
        "selector": "[data-testid=\"field-title\"]"
      },
      {
        "name": "notice_type",
        "label": "公告类别",
        "type": "string",
        "required": true,
        "testId": "field-notice_type",
        "selector": "[data-testid=\"field-notice_type\"]"
      },
      {
        "name": "content",
        "label": "正文内容",
        "type": "string",
        "required": false,
        "testId": "field-content",
        "selector": "[data-testid=\"field-content\"]"
      },
      {
        "name": "status",
        "label": "发布状态",
        "type": "string",
        "required": true,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      },
      {
        "name": "publish_time",
        "label": "发布时间",
        "type": "string",
        "required": false,
        "testId": "field-publish_time",
        "selector": "[data-testid=\"field-publish_time\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "oa-notice",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"oa-notice\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"oa-notice-form-overlay\"]",
      "dialog": "[data-testid=\"oa-notice-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "oa-notice:search",
      "reset": "oa-notice:reset",
      "refresh": "oa-notice:refresh",
      "create": "oa-notice:create",
      "edit": "oa-notice:edit",
      "delete": "oa-notice:delete",
      "submit": "oa-notice:submit",
      "cancel": "oa-notice:cancel",
      "close": "oa-notice:close",
      "row": "oa-notice:row",
      "pagination": "oa-notice:pagination",
      "fields": {
        "notice_no": "oa-notice:field:notice_no",
        "title": "oa-notice:field:title",
        "notice_type": "oa-notice:field:notice_type",
        "content": "oa-notice:field:content",
        "status": "oa-notice:field:status",
        "publish_time": "oa-notice:field:publish_time"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "oa.oa-notice",
      "examples": [
        "oa.oa-notice__List__Refresh",
        "oa.oa-notice__ListItem__Open",
        "oa.oa-notice__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
