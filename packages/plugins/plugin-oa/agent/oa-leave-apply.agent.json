{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "oa",
  "entity": "OaLeaveApply",
  "kebab": "oa-leave-apply",
  "businessName": "请假用印",
  "permissionPrefix": "oa:leave-apply",
  "page": {
    "route": "/admin/oa/oa-leave-apply",
    "menuTitle": "请假用印",
    "title": "请假用印管理",
    "titleSelector": "[data-testid=\"oa-leave-apply-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.oa/api",
    "bffMount": "/api/v1/admin/oa",
    "resource": "oa-leave-apply",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/oa-leave-apply",
        "query": [
          "page",
          "pageSize",
          "apply_no",
          "applicant_id",
          "apply_type",
          "status"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/oa-leave-apply/:id"
      },
      "create": {
        "http": "POST",
        "path": "/oa-leave-apply"
      },
      "update": {
        "http": "PUT",
        "path": "/oa-leave-apply/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/oa-leave-apply/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"oa-leave-apply-title\"]",
    "refresh": "[data-testid=\"oa-leave-apply-refresh\"]",
    "createButton": "[data-testid=\"oa-leave-apply-create\"]",
    "searchForm": "[data-testid=\"oa-leave-apply-search\"]",
    "searchSubmit": "[data-testid=\"oa-leave-apply-search-submit\"]",
    "searchReset": "[data-testid=\"oa-leave-apply-search-reset\"]",
    "total": "[data-testid=\"oa-leave-apply-total\"]",
    "table": "[data-testid=\"oa-leave-apply-table\"]",
    "row": "[data-testid=\"oa-leave-apply-row\"]",
    "editButton": "[data-testid=\"oa-leave-apply-edit\"]",
    "deleteButton": "[data-testid=\"oa-leave-apply-delete\"]",
    "form": "[data-testid=\"oa-leave-apply-form\"]",
    "formError": "[data-testid=\"oa-leave-apply-form-error\"]",
    "formSubmit": "[data-testid=\"oa-leave-apply-form-submit\"]",
    "formCancel": "[data-testid=\"oa-leave-apply-form-cancel\"]",
    "formClose": "[data-testid=\"oa-leave-apply-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "请假用印列表",
    "dialogLabel": {
      "create": "新增请假用印",
      "edit": "编辑请假用印"
    },
    "searchFields": [
      {
        "name": "apply_no",
        "label": "申请单号",
        "testId": "search-apply_no",
        "selector": "[data-testid=\"search-apply_no\"]"
      },
      {
        "name": "applicant_id",
        "label": "申请人ID",
        "testId": "search-applicant_id",
        "selector": "[data-testid=\"search-applicant_id\"]"
      },
      {
        "name": "apply_type",
        "label": "单据类型",
        "testId": "search-apply_type",
        "selector": "[data-testid=\"search-apply_type\"]"
      },
      {
        "name": "status",
        "label": "审批状态",
        "testId": "search-status",
        "selector": "[data-testid=\"search-status\"]"
      }
    ],
    "fields": [
      {
        "name": "apply_no",
        "label": "申请单号",
        "type": "string",
        "required": true,
        "testId": "field-apply_no",
        "selector": "[data-testid=\"field-apply_no\"]"
      },
      {
        "name": "applicant_id",
        "label": "申请人ID",
        "type": "string",
        "required": true,
        "testId": "field-applicant_id",
        "selector": "[data-testid=\"field-applicant_id\"]"
      },
      {
        "name": "apply_type",
        "label": "单据类型",
        "type": "string",
        "required": true,
        "testId": "field-apply_type",
        "selector": "[data-testid=\"field-apply_type\"]"
      },
      {
        "name": "days",
        "label": "请假天数",
        "type": "number",
        "required": true,
        "testId": "field-days",
        "selector": "[data-testid=\"field-days\"]"
      },
      {
        "name": "start_time",
        "label": "开始时间",
        "type": "string",
        "required": true,
        "testId": "field-start_time",
        "selector": "[data-testid=\"field-start_time\"]"
      },
      {
        "name": "end_time",
        "label": "结束时间",
        "type": "string",
        "required": true,
        "testId": "field-end_time",
        "selector": "[data-testid=\"field-end_time\"]"
      },
      {
        "name": "reason",
        "label": "事由说明",
        "type": "string",
        "required": false,
        "testId": "field-reason",
        "selector": "[data-testid=\"field-reason\"]"
      },
      {
        "name": "status",
        "label": "审批状态",
        "type": "string",
        "required": true,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "oa-leave-apply",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"oa-leave-apply\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"oa-leave-apply-form-overlay\"]",
      "dialog": "[data-testid=\"oa-leave-apply-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "oa-leave-apply:search",
      "reset": "oa-leave-apply:reset",
      "refresh": "oa-leave-apply:refresh",
      "create": "oa-leave-apply:create",
      "edit": "oa-leave-apply:edit",
      "delete": "oa-leave-apply:delete",
      "submit": "oa-leave-apply:submit",
      "cancel": "oa-leave-apply:cancel",
      "close": "oa-leave-apply:close",
      "row": "oa-leave-apply:row",
      "pagination": "oa-leave-apply:pagination",
      "fields": {
        "apply_no": "oa-leave-apply:field:apply_no",
        "applicant_id": "oa-leave-apply:field:applicant_id",
        "apply_type": "oa-leave-apply:field:apply_type",
        "days": "oa-leave-apply:field:days",
        "start_time": "oa-leave-apply:field:start_time",
        "end_time": "oa-leave-apply:field:end_time",
        "reason": "oa-leave-apply:field:reason",
        "status": "oa-leave-apply:field:status"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "oa.oa-leave-apply",
      "examples": [
        "oa.oa-leave-apply__List__Refresh",
        "oa.oa-leave-apply__ListItem__Open",
        "oa.oa-leave-apply__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
