{
  "$schema": "cooliebase.agent.contract/v1",
  "domain": "bpm",
  "entity": "BpmProcessListener",
  "kebab": "bpm-process-listener",
  "businessName": "BPM 流程监听器 DO目的：本质上它是流程监听器的模版，用于 BPMN 在设计时，直接选择这些模版",
  "permissionPrefix": "bpm:bpm_process_listener",
  "page": {
    "route": "/admin/bpm/bpm-process-listener",
    "title": "BPM 流程监听器 DO目的：本质上它是流程监听器的模版，用于 BPMN 在设计时，直接选择这些模版管理",
    "titleSelector": "[data-testid=\"bpm-process-listener-title\"]"
  },
  "api": {
    "pluginMount": "/api/v1/plugins/cooliebase.bpm/api",
    "bffMount": "/api/v1/admin/bpm",
    "resource": "bpm-process-listener",
    "methods": {
      "list": {
        "http": "GET",
        "path": "/bpm-process-listener",
        "query": [
          "page",
          "pageSize"
        ]
      },
      "get": {
        "http": "GET",
        "path": "/bpm-process-listener/:id"
      },
      "create": {
        "http": "POST",
        "path": "/bpm-process-listener"
      },
      "update": {
        "http": "PUT",
        "path": "/bpm-process-listener/:id"
      },
      "delete": {
        "http": "DELETE",
        "path": "/bpm-process-listener/:id"
      }
    }
  },
  "auth": {
    "login": {
      "http": "POST",
      "path": "/api/v1/admin/system/auth",
      "payload": {
        "username": "$COOLIEBASE_AGENT_USERNAME",
        "password": "$COOLIEBASE_AGENT_PASSWORD"
      }
    },
    "tokenField": "data.token",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "selectors": {
    "title": "[data-testid=\"bpm-process-listener-title\"]",
    "refresh": "[data-testid=\"bpm-process-listener-refresh\"]",
    "createButton": "[data-testid=\"bpm-process-listener-create\"]",
    "searchForm": "[data-testid=\"bpm-process-listener-search\"]",
    "searchSubmit": "[data-testid=\"bpm-process-listener-search-submit\"]",
    "searchReset": "[data-testid=\"bpm-process-listener-search-reset\"]",
    "total": "[data-testid=\"bpm-process-listener-total\"]",
    "table": "[data-testid=\"bpm-process-listener-table\"]",
    "row": "[data-testid=\"bpm-process-listener-row\"]",
    "editButton": "[data-testid=\"bpm-process-listener-edit\"]",
    "deleteButton": "[data-testid=\"bpm-process-listener-delete\"]",
    "form": "[data-testid=\"bpm-process-listener-form\"]",
    "formError": "[data-testid=\"bpm-process-listener-form-error\"]",
    "formSubmit": "[data-testid=\"bpm-process-listener-form-submit\"]",
    "formCancel": "[data-testid=\"bpm-process-listener-form-cancel\"]",
    "formClose": "[data-testid=\"bpm-process-listener-form-close\"]"
  },
  "accessibility": {
    "tableLabel": "BPM 流程监听器 DO目的：本质上它是流程监听器的模版，用于 BPMN 在设计时，直接选择这些模版列表",
    "dialogLabel": {
      "create": "新增BPM 流程监听器 DO目的：本质上它是流程监听器的模版，用于 BPMN 在设计时，直接选择这些模版",
      "edit": "编辑BPM 流程监听器 DO目的：本质上它是流程监听器的模版，用于 BPMN 在设计时，直接选择这些模版"
    },
    "searchFields": [],
    "fields": [
      {
        "name": "name",
        "label": "监听器名字",
        "type": "string",
        "required": false,
        "testId": "field-name",
        "selector": "[data-testid=\"field-name\"]"
      },
      {
        "name": "status",
        "label": "状态",
        "type": "number",
        "required": false,
        "testId": "field-status",
        "selector": "[data-testid=\"field-status\"]"
      },
      {
        "name": "type",
        "label": "监听类型",
        "type": "string",
        "required": false,
        "testId": "field-type",
        "selector": "[data-testid=\"field-type\"]"
      },
      {
        "name": "event",
        "label": "监听事件",
        "type": "string",
        "required": false,
        "testId": "field-event",
        "selector": "[data-testid=\"field-event\"]"
      },
      {
        "name": "value_type",
        "label": "值类型",
        "type": "string",
        "required": false,
        "testId": "field-value_type",
        "selector": "[data-testid=\"field-value_type\"]"
      },
      {
        "name": "value",
        "label": "值",
        "type": "string",
        "required": false,
        "testId": "field-value",
        "selector": "[data-testid=\"field-value\"]"
      }
    ]
  },
  "agentNative": {
    "scheme": "cooliebase.agent.native/v1",
    "scope": "bpm-process-listener",
    "readiness": {
      "attribute": "data-agent-page-ready",
      "readySelector": "[data-agent-scope=\"bpm-process-listener\"][data-agent-page-ready=\"true\"]",
      "states": [
        "true",
        "false"
      ]
    },
    "state": {
      "attribute": "data-agent-state",
      "page": [
        "loading",
        "modal-open",
        "empty",
        "ready"
      ],
      "row": [
        "idle",
        "editing"
      ],
      "form": [
        "open",
        "submitting",
        "error"
      ]
    },
    "modal": {
      "overlay": "[data-testid=\"bpm-process-listener-form-overlay\"]",
      "dialog": "[data-testid=\"bpm-process-listener-form\"]",
      "pruneAttribute": "inert",
      "pruneTarget": "页面基底内容容器"
    },
    "targets": {
      "search": "bpm-process-listener:search",
      "reset": "bpm-process-listener:reset",
      "refresh": "bpm-process-listener:refresh",
      "create": "bpm-process-listener:create",
      "edit": "bpm-process-listener:edit",
      "delete": "bpm-process-listener:delete",
      "submit": "bpm-process-listener:submit",
      "cancel": "bpm-process-listener:cancel",
      "close": "bpm-process-listener:close",
      "row": "bpm-process-listener:row",
      "pagination": "bpm-process-listener:pagination",
      "fields": {
        "name": "bpm-process-listener:field:name",
        "status": "bpm-process-listener:field:status",
        "type": "bpm-process-listener:field:type",
        "event": "bpm-process-listener:field:event",
        "value_type": "bpm-process-listener:field:value_type",
        "value": "bpm-process-listener:field:value"
      }
    },
    "mobile": {
      "testIdScheme": "[Screen]__[Component]__[Action]",
      "screen": "bpm.bpm-process-listener",
      "examples": [
        "bpm.bpm-process-listener__List__Refresh",
        "bpm.bpm-process-listener__ListItem__Open",
        "bpm.bpm-process-listener__Form__Submit"
      ]
    }
  },
  "journey": [
    "goto",
    "assertTitle",
    "search",
    "openCreateForm",
    "fillForm",
    "submitForm",
    "edit",
    "delete"
  ],
  "ops": {
    "automations": [
      {
        "name": "health",
        "kind": "query",
        "description": "列表接口连通性 + 返回结构",
        "method": "list"
      },
      {
        "name": "seed-sample",
        "kind": "mutation",
        "description": "写入一条样例数据（幂等靠业务字段）",
        "method": "create"
      },
      {
        "name": "purge-sample",
        "kind": "mutation",
        "description": "清理本契约造的样例数据",
        "method": "delete"
      }
    ]
  }
}
