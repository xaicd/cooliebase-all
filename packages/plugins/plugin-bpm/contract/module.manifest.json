{
  "$schema": "cooliebase-module-manifest/v1",
  "domain": "bpm",
  "id": "cooliebase.bpm",
  "apiVersion": 1,
  "displayName": "流程中心",
  "kind": "plugin",
  "stage": "A",
  "owner": "bpm",
  "contractVersion": "v1",
  "implementation": "local-ts",
  "minimumHostVersion": "1.0.0",
  "capabilities": [
    "api.routes.register",
    "facade.invoke",
    "rpc.serve",
    "cmd.dispatch",
    "pack.independent"
  ],
  "entrypoints": {
    "facade": [
      "packages/plugins/plugin-bpm/contract/bpm.facade.ts"
    ],
    "proto": "packages/plugins/plugin-bpm/contract/bpm.proto",
    "actions": "packages/plugins/plugin-bpm/contract/actions.ts"
  },
  "apiRoutes": {
    "publicPrefix": [
      "/api/v1/admin/bpm"
    ],
    "adminPrefix": "/api/v1/admin/bpm"
  },
  "auth": {
    "audience": "admin",
    "tenantPolicy": "required"
  },
  "messaging": {
    "queueGroup": "cooliebase.bpm",
    "commandSubject": "cooliebase.cmd.bpm.>",
    "eventSubject": "cooliebase.evt.bpm.>"
  },
  "invoke": {
    "colocated": "sdk",
    "remote": "rpc",
    "protocol": "nats-rr",
    "serialization": "json"
  },
  "upstream": {
    "env": "COOLIEBASE_DOMAIN_BPM_UPSTREAM",
    "protocol": "http",
    "defaultPort": 3213
  },
  "resilience": {
    "timeoutMs": 8000,
    "retry": {
      "maxAttempts": 1,
      "safeMethodsOnly": true
    },
    "idempotencyRequired": true
  },
  "facadeMethods": [
    "ping",
    "listDefinitions",
    "listTasks",
    "actionTask"
  ],
  "rpc": [
    {
      "service": "BpmService",
      "method": "Ping"
    },
    {
      "service": "BpmService",
      "method": "ListDefinitions"
    },
    {
      "service": "BpmService",
      "method": "ListTasks"
    },
    {
      "service": "BpmService",
      "method": "ActionTask"
    }
  ],
  "actions": [
    "bpm.ping",
    "bpm.listDefinitions",
    "bpm.listTasks",
    "bpm.actionTask"
  ],
  "permissions": [
    "bpm:category:create",
    "bpm:category:delete",
    "bpm:category:query",
    "bpm:category:update",
    "bpm:form:create",
    "bpm:form:delete",
    "bpm:form:query",
    "bpm:form:update",
    "bpm:oaleave:create",
    "bpm:oaleave:delete",
    "bpm:oaleave:query",
    "bpm:oaleave:update",
    "bpm:process-definition-info:create",
    "bpm:process-definition-info:delete",
    "bpm:process-definition-info:query",
    "bpm:process-definition-info:update",
    "bpm:process-definition:view",
    "bpm:process-expression:create",
    "bpm:process-expression:delete",
    "bpm:process-expression:query",
    "bpm:process-expression:update",
    "bpm:process-instance-copy:create",
    "bpm:process-instance-copy:delete",
    "bpm:process-instance-copy:query",
    "bpm:process-instance-copy:update",
    "bpm:process-listener:create",
    "bpm:process-listener:delete",
    "bpm:process-listener:query",
    "bpm:process-listener:update",
    "bpm:task:approve",
    "bpm:task:view",
    "bpm:user-group:create",
    "bpm:user-group:delete",
    "bpm:user-group:query",
    "bpm:user-group:update"
  ],
  "dependsOn": [
    "shared"
  ],
  "pack": {
    "enabled": true,
    "kind": "api-only",
    "independentDatabase": false
  }
}
