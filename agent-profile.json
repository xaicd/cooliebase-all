{
  "version": 1,
  "kind": "workspace-bundle",
  "role": "business-project-template",
  "not": ["agent-runtime", "cordis-host", "llm-loop", "privileged-core-to-patch"],
  "description": "CoolieBase All is the DigitalStaff NPC workspace template. Agent loop stays in DigitalStaff Native. This repo is the composable environment.",
  "harnessPartners": {
    "runtime": "DigitalStaff NativeCodingEngine",
    "runtimePath": "D:/workspace/cw/ai/DigitalStaff",
    "reference": "https://github.com/deepseek-ai/deepseek-harness",
    "referencePhilosophy": "Everything is a Plugin. Every run is traceable.",
    "doNotVendor": ["cordis", "dsh-agent-loop", "self-modification"]
  },
  "promptAssembly": {
    "file": ".agents/context/ASSEMBLY.md",
    "sections": [
      { "name": "identity", "order": -100, "path": ".agents/context/IDENTITY.md" },
      { "name": "rule-0-universal-directives", "order": -60, "path": ".agents/rules/RULE-0-UNIVERSAL-DIRECTIVES.md" },
      { "name": "high-order-inverse-thinking", "order": -50, "path": ".agents/rules/HIGH-ORDER-INVERSE-THINKING.md" },
      { "name": "spec-first-artifacts", "order": -45, "path": ".agents/rules/SPEC-FIRST-ENGINEERING-ARTIFACTS.md" },
      { "name": "project-init-and-refactor", "order": -43, "path": ".agents/rules/PROJECT-INIT-AND-REFACTOR.md" },
      { "name": "multi-tenant-isolation", "order": -42, "path": ".agents/rules/MULTI-TENANT-ISOLATION.md" },
      { "name": "high-order-prompts", "order": -40, "path": "docs/architecture/universal-high-order-inverse-prompts.md" },
      { "name": "soul", "order": 0, "path": ".agents/context/SOUL.md" },
      { "name": "seams", "order": 50, "path": "packages/shared/contract/agent-profile.json" },
      { "name": "seam-graph", "order": 55, "path": "packages/shared/contract/seam-graph.json" },
      { "name": "catalog", "order": 60, "path": "packages/shared/backend/constants/domain-catalog.json" },
      { "name": "skill", "order": 100, "path": ".agents/skills", "load": "on-demand" },
      { "name": "project-identity", "order": 150, "path": "packages/shared/contract/project-profile.json" },
      { "name": "gates", "order": 200, "path": "AGENTS.md", "mode": "cite-section-not-full-file" }
    ]
  },
  "bundles": {
    "base": {
      "modules": ["shared"],
      "deployable": false,
      "note": "SDK packed into every process. Never a microservice."
    },
    "platform": {
      "domains": ["system", "infra"],
      "deployable": true
    },
    "business": {
      "source": "domain-catalog.json layers.business",
      "note": "Do not duplicate domain names here. Catalog is the runtime source of truth."
    },
    "clients": {
      "channels": ["expo"]
    }
  },
  "profiles": {
    "minimal": { "stacks": ["base", "platform"], "companions": ["online", "ai", "aigw"], "use": "identity-only hatch; keep menu-catalog and codegen facades" },
    "standard": { "stacks": ["base", "platform", "business", "clients"], "use": "default DigitalStaff NPC template" },
    "vertical": { "stacks": ["base", "platform", "business:allowlist", "clients"], "use": "ontology-driven hatch" },
    "creator": { "stacks": ["standard", "online-codegen"], "use": "lowcode + codegen" }
  },
  "seamGraph": {
    "path": "packages/shared/contract/seam-graph.json",
    "source": "packages/shared/backend/constants/domain-catalog.json",
    "generated": true,
    "rule": "Generated from catalog + contract. Do not hand-edit domain names."
  },
  "consumptionSurface": {
    "note": "How an external agent consumes this repository. Domain names stay in domain-catalog.json; tool and skill surfaces are declared once in the compat manifest.",
    "compatManifest": "packages/shared/contract/compat-manifest.json",
    "declaredIn": "packages/shared/contract/compat-manifest.json",
    "mcp": {
      "start": "npm run mcp:serve",
      "transport": "stdio",
      "declaredIn": "packages/shared/contract/compat-manifest.json"
    },
    "skills": {
      "source": ".agents/skills",
      "check": "npm run skills:check",
      "sync": "npm run skills:sync"
    }
  },
  "seams": [
    {
      "id": "domain-facade",
      "definition": "packages/domains/<domain>/contract/",
      "provider": "packages/domains/<domain>/backend/services/",
      "consumer": "src/app/api/v1/** and other domain facades",
      "rule": "Cross-domain must use Facade / broker.call. Never import another domain Service."
    },
    {
      "id": "http-api",
      "definition": "versioned /api/v{n}/ DTO + actions schema",
      "provider": "src/app/api/v1/**/route.ts",
      "consumer": "frontend api/*.api.ts and client channels",
      "rule": "Pages depend on API Port only, not Next Service or Prisma types."
    },
    {
      "id": "tenant-scope",
      "definition": "getCurrentTenantId() in biz-tenant.ts",
      "provider": "withAdminRoute + Repository currentTenantId()",
      "consumer": "all business tables",
      "rule": "No explicit tenantId passthrough as long-term pattern."
    },
    {
      "id": "permission",
      "definition": "packages/shared/backend/constants/permissions.ts",
      "provider": "RBAC + system_menu",
      "consumer": "Route withAdminRoute permission + page visibility",
      "rule": "No hardcoded roles as long-term scheme."
    }
  ],
  "trace": {
    "sprintProd": "docs/features/sprint-prod/",
    "gateArtifact": "docs/architecture/artifacts/harness-trace-latest.json",
    "writer": "scripts/write-harness-trace.cjs",
    "note": "Human log is append-only sprint-prod. Gate stamp is written by npm run check. Session events stay in DigitalStaff."
  },
  "npc": {
    "hatchCommand": "npm run project:create -- <target-path> [--profile minimal|standard|vertical|creator] [--bundle mall,crm]",
    "identityFile": "packages/shared/contract/project-profile.json",
    "brandingDir": "public/branding/",
    "businessZone": ["packages/domains/<domain>/", "src/app/api/v1/admin/<domain>/", "src/app/(admin-pages)/admin/<domain>/", "clients/<channel>/modules/<domain>/"],
    "coreZone": ["packages/shared/", "packages/domains/system/", "packages/domains/infra/", "scripts/", "deploy/", "prisma/data/"],
    "gates": ["npm run check", "npm run harness:check"],
    "strictGates": ["npm run cooliebase:matrix:check:strict", "npm run cooliebase:governance:check:strict"],
    "seamCommand": "npm run domain:seams",
    "skillsDir": ".agents/skills",
    "forbiddenSkillSources": ["crush", "pod"],
    "layers": {
      "L0": { "role": "code-maintain", "skills": ["coding", "automated-testing", "agent-harness", "project-init"] },
      "L1": { "role": "service-governance", "skills": ["service-governance", "microservice-evolution", "sre-slo-manager", "postmortem-analyzer"] },
      "L2": { "role": "api-contract", "skills": ["api-design", "architecture-design", "adr-architect", "archify"] },
      "L3": { "role": "observability", "skills": ["devops", "security", "sre-slo-manager", "strix-penetration-testing"] },
      "L4": { "role": "deploy", "skills": ["devops"] },
      "L5": { "role": "docs", "skills": ["product-requirements", "ears-spec-writer", "dar-decision-matrix"] },
      "L6": { "role": "database", "skills": ["database-design", "database-compatibility"] },
      "L7": { "role": "ui", "skills": ["ui-design", "ui-framework-governance", "frontend-design", "archify"] },
      "L8": { "role": "test", "skills": ["automated-testing", "mutation-tester", "compliance-auditor", "webapp-testing", "strix-penetration-testing"] },
      "business": { "role": "full-delivery", "skills": ["product-requirements", "new-feature", "new-business-plugin", "financial-reconciliation-agent"] }
    },
    "portBack": ["packages/domains/{domain}/", "src/app/api/v1/admin/{domain}/", "src/app/(admin-pages)/admin/{domain}/", "prisma/migrations/", "permissions.ts", "domain-catalog.json"]
  },
  "absorbFromDeepseekHarness": [
    "plugin-shaped domains",
    "capability-seams",
    "profile-bundle-patch",
    "prompt-section-assembly",
    "scoped-tools-via-rbac-tenant",
    "append-only-trace-via-sprint-and-gates",
    "skills-as-plugins"
  ],
  "forbidden": [
    "introduce-cordis",
    "host-agent-loop-in-this-repo",
    "runtime-self-modification",
    "skip-npm-run-check",
    "duplicate-domain-names-outside-catalog",
    "patch-core-zone-from-business-projects"
  ]
}
