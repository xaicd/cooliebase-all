{
  "version": 1,
  "kind": "compat-manifest",
  "description": "Machine-readable compatibility contract for this Workspace Bundle. Downstream projects hatched via `npm run project:create` and external agents (Claude Code / Cursor / Command Code / DSH / hermes) bind to what is declared here. Verified by scripts/check-compat-manifest.cjs in `npm run check`.",
  "framework": {
    "name": "cooliebase-all",
    "role": "workspace-bundle",
    "templateVersion": "1.2.0",
    "releasedAt": "2026-10-10",
    "note": "templateVersion tracks the TEMPLATE, not the hatched project. package.json version is the project's own and is deliberately not compared."
  },
  "toolchain": {
    "engine": {
      "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
    },
    "verified": {
      "next": "^16.4.2",
      "react": "19.3.0",
      "kysely": "^0.29.4",
      "zod": "^4.6.5",
      "@prisma/client": "^7.10.0",
      "typescript": "^5.9.2"
    }
  },
  "contracts": {
    "domainCatalog": {
      "path": "packages/shared/backend/constants/domain-catalog.json",
      "version": 1,
      "domains": 17
    },
    "rpcActions": {
      "path": "packages/shared/backend/constants/rpc-actions.json",
      "domains": 17
    },
    "messagingProtocol": "v1",
    "agentProfile": {
      "path": "packages/shared/contract/agent-profile.json",
      "version": 1
    },
    "seamGraph": {
      "path": "packages/shared/contract/seam-graph.json"
    },
    "projectProfile": {
      "path": "packages/shared/contract/project-profile.json"
    }
  },
  "consumptionSurface": {
    "discovery": [
      "compat-manifest.json",
      "agent-profile.json",
      ".well-known/agent.json",
      "llms.txt",
      "packages/shared/contract/agent-profile.json"
    ],
    "hatch": {
      "oneLine": "curl -fsSL https://raw.githubusercontent.com/xaicd/cooliebase-all/main/scripts/hatch.sh | bash -s -- <my-app> --profile base",
      "degit": "npx degit xaicd/cooliebase-all#main <my-app>",
      "inRepo": "npm run project:create -- <target-dir> --profile base"
    },
    "skills": {
      "sourceDir": ".agents/skills",
      "count": 38
    },
    "mcp": {
      "server": "scripts/mcp/cooliebase-mcp-server.cjs",
      "transport": "stdio",
      "protocolVersions": [
        "2025-06-18",
        "2024-11-05"
      ],
      "tools": [
        "cooliebase_action_lookup",
        "cooliebase_cmmi_list",
        "cooliebase_codegen_preview",
        "cooliebase_codegen_targets",
        "cooliebase_compat_info",
        "cooliebase_delivery_status",
        "cooliebase_domain_list",
        "cooliebase_domain_resolve",
        "cooliebase_domain_seam",
        "cooliebase_evolution_backlog",
        "cooliebase_gate_run",
        "cooliebase_plugin_list",
        "cooliebase_scaffold_plan",
        "cooliebase_skills_list",
        "cooliebase_spec_list",
        "cooliebase_standards_report",
        "cooliebase_table_migration_plan"
      ],
      "count": 17
    },
    "evolution": {
      "traceArtifact": "docs/architecture/artifacts/harness-trace-latest.json",
      "backlogArtifact": "docs/architecture/artifacts/evolution-backlog.json",
      "builder": "npm run evolution:backlog",
      "note": "Gates produce evidence on every `npm run check`; the backlog aggregates that evidence into prioritised work for an external agent. No agent loop runs in this repository."
    },
    "gates": [
      "domain:check",
      "microservice:check",
      "harness:check",
      "admin:routes:check",
      "foundation:ontology:check",
      "skills:check",
      "compat:check",
      "standards:check",
      "deps:audit",
      "clients:build:check",
      "version:check",
      "llms:check",
      "sbom:check"
    ]
  },
  "compatibility": {
    "frozen": [
      "versioned HTTP paths under /api/v{n}/",
      "domain names in domain-catalog.json",
      "RPC subjects cooliebase.cmd.<domain>.<method> and cooliebase.evt.<domain>.<entity>.<action>",
      "messaging header keys (x-contract-version / x-trace-id / x-tenant-id / x-actor-id / x-idempotency-key / x-source-domain)",
      "cross-domain integration via Domain Facade only",
      "tenant isolation via getCurrentTenantId() plus the 8 base audit columns",
      "seam roles definition / provider / consumer"
    ],
    "additive": [
      "new domains (append to catalog layers and domains)",
      "new actions and new permission codes",
      "new skills under .agents/skills",
      "new MCP tools that are read-only or plan/preview only (never writing to the repository)",
      "new gates wired into npm run check"
    ],
    "breaking": [
      "removing or renaming a domain",
      "changing an existing action payload or error contract",
      "changing or removing an RPC subject or messaging header key",
      "dropping a permission code",
      "changing a domain tenantPolicy default"
    ],
    "breakingProcedure": [
      "bump contracts.*.version and/or messagingProtocol",
      "bump framework.templateVersion (major)",
      "regenerate contracts: npm run domain:contracts && npm run domain:manifests && npm run domain:seams",
      "record the change in docs/features/sprint-prod/ and re-run npm run check"
    ]
  }
}
