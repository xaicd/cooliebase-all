{
  "name": "@cooliebase/clients-miniapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CoolieBase All MiniApp & H5 Client (Uni-App Vue 3 + TypeScript + Vite)",
  "scripts": {
    "dev": "vite --port 3202",
