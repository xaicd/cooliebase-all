      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$COMMANDCODE_PROJECT_DIR\"/.commandcode/hooks/route-contract.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
