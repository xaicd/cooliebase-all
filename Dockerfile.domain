# ============================================================
# cooliebase-all 单域独立构建（API-only standalone）
# 用法：docker build -f Dockerfile.domain --build-arg COOLIEBASE_PACK_DOMAIN=pay -t cooliebase-domain-pay .
# ============================================================

ARG COOLIEBASE_PACK_DOMAIN=pay

FROM node:24-alpine AS deps
WORKDIR /app
# pnpm 迁移后锁文件是 pnpm-lock.yaml（package-lock.json 已删除）——
# 必须把锁文件与 pnpm-workspace.yaml 一起拷进来，否则 --frozen-lockfile 无锁可依。
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
# 构建工具只装在 deps 阶段（最终 runner 镜像不含它们）。
# 原因: better-sqlite3 的安装脚本是 `prebuild-install || node-gyp rebuild`，
# 一旦从 GitHub 拉预编译包超时, 就会回退到源码编译 —— 而 alpine 默认没有
# python3/make/g++, 于是整个镜像构建失败。装上这三样让回退路径真正可用,
# 构建就不再单点依赖一次外部下载。
RUN apk add --no-cache python3 make g++
# 与 Dockerfile 同理：npm workspaces 要求各成员的 package.json 在 install 时已存在，
# 否则 pnpm install --frozen-lockfile 会因 workspace glob 指向不存在的目录而失败（本文件此前漏了这一步）。
COPY packages/plugins/sdk/package.json ./packages/plugins/sdk/package.json
COPY packages/plugins/examples/hello-world/package.json ./packages/plugins/examples/hello-world/package.json
# 包管理器切到 pnpm。corepack 的 shim 会读 package.json 的 packageManager 字段选版本，
# 故只需 enable，不必再 prepare（少一步不确定性）。
# --frozen-lockfile: CI/镜像构建必须用锁文件，不允许隐式升级依赖。
RUN corepack enable
RUN pnpm install --frozen-lockfile
# npm workspaces 会在 node_modules/@cooliebase 下建立指向 ../../packages/... 的符号链接。
# BuildKit 的 COPY 解析「落在被复制目录之外」的链接时会报
# "evalSymlinksInScope: too many links"，导致下一阶段的 COPY --from=deps 失败。
# 域构建不依赖这些插件包（plugin SDK 只给插件作者使用），故在 deps 层裁掉。
RUN rm -rf node_modules/@cooliebase node_modules/.pnpm/node_modules/@cooliebase

FROM node:24-alpine AS packer
WORKDIR /app
ARG COOLIEBASE_PACK_DOMAIN
# 【未验证项·迁移到 pnpm 后的已知风险】与 Dockerfile 同理:
# pnpm 的 node_modules 大量使用符号链接, BuildKit 跨阶段 COPY 解析这类链接会报
# "evalSymlinksInScope: too many links"(npm 阶段已实测过该报错)。
# 若在此处失败, 标准解法: `pnpm deploy --prod` 产出自包含目录, 或在 .npmrc 设 node-linker=hoisted。
# 本条未实测(镜像构建卡在更早的 apk 阶段, 属环境网络问题), 故标注而非声称通过。
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN node scripts/pack-domain.cjs ${COOLIEBASE_PACK_DOMAIN} --materialize

FROM node:24-alpine AS builder
WORKDIR /app
ARG COOLIEBASE_PACK_DOMAIN
ENV COOLIEBASE_PACK_DOMAIN=${COOLIEBASE_PACK_DOMAIN}
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=packer /app/dist/domain-packs/${COOLIEBASE_PACK_DOMAIN} ./
# 打包产物把 node_modules 做成了符号链接（供本地 `domain:dev` 直接跑）。
# 在镜像里这个链接要么自引用、要么指向不存在的路径，且 deps 阶段已提供真实
# node_modules —— 必须先删掉，否则下一步 COPY 会遍历它并报
# "evalSymlinksInScope: too many links"。注意用 rm -f（删链接本身，不递归目标）。
RUN rm -f node_modules
COPY --from=deps /app/node_modules ./node_modules
RUN pnpm exec prisma generate
RUN pnpm exec next build

FROM node:24-alpine AS runner
WORKDIR /app
ARG COOLIEBASE_PACK_DOMAIN
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3100
ENV HOSTNAME="0.0.0.0"
ENV COOLIEBASE_PACK_DOMAIN=${COOLIEBASE_PACK_DOMAIN}

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next-cooliebase/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next-cooliebase/static ./.next-cooliebase/static
COPY --from=builder /app/prisma ./prisma

USER nextjs
EXPOSE 3100
CMD ["node", "server.js"]
